-- ============================================================
-- src/test/ridgun/test wasm backend.ridgun
-- The WebAssembly backend with the IR runtime (FR-COMP-026, ADR-0011,
-- ADR-0013). Needs wabt 1.0.36 (wasm-validate, wasm2c) and cc: the program
-- runs through tests/wasm/run-wasm.sh. The expected outputs are those of
-- the x86-64 build of the same programs.
-- @tests FR-COMP-026
-- ============================================================
import test
import ast
import lexer
import parser
import typecheck
import compiler

fn :: wasm ints program => String
      wasm ints program =
        p_fib = "fn :: fib Int => Int\n      fib n\n        | n < 2 = n\n        | otherwise = (fib (n - 1)) + (fib (n - 2))\n\n"
        p_sum = "fn :: sum to Int Int => Int\n      sum to 0 acc = acc\n      sum to n acc = sum to (n - 1) (acc + n)\n\n"
        p_col = "fn :: collatz Int Int => Int\n      collatz 1 steps = steps\n      collatz n steps\n        | n % 2 == 0 = collatz (n / 2) (steps + 1)\n        | otherwise = collatz ((3 * n) + 1) (steps + 1)\n\n"
        p_pick = "fn :: pick Bool Int Int => Int\n      pick True a _ = a\n      pick False _ b = b\n\n"
        p_main = "fn :: main => ()\n      main =\n        a = fib 20\n        b = sum to 100000 0\n        c = collatz 27 0\n        d = pick (a > b) 1 0\n        f = (0 - 17) % 5\n        echo ((a * 1000000000) + (b % 1000000) + (c * 1000) + d + f)\n"
        p_fib + p_sum + p_col + p_pick + p_main

fn :: wasm values program => String
      wasm values program =
        p_ty = "type Shape = Circle Int | Rect Int Int | Dot\n\n"
        p_area = "fn :: area Shape => Int\n      area (Circle r) = 3 * r * r\n      area (Rect w h) = w * h\n      area Dot = 0\n\n"
        p_total = "fn :: total [Int] Int => Int\n      total [] acc = acc\n      total (x:xs) acc = total xs (acc + x)\n\n"
        p_greet = "fn :: greet String => String\n      greet name = \"hello, \" + name\n\n"
        m1 = "fn :: main => ()\n      main =\n        shapes = [Circle 2, Rect 3 4, Dot]\n        echo (map (s => area s) shapes)\n        echo (total [1, 2, 3, 4] 0) (fold (a x => a * x) 1 [1, 2, 3, 4, 5])\n        k = 10\n"
        m2 = "        echo (filter (x => x > k) [5, 15, 25]) (map (x => x + k) [1, 2])\n        echo (greet \"wasm\") (\"ab\" < \"b\") ([1, 2] == [1, 2]) ((1, \"x\") == (1, \"y\"))\n"
        m3 = "        echo (1.5 * 4.0) (10.0 / 4.0) (Rect 1 2) shapes\n        t = (7, \"seven\", [7])\n        echo t \"\{k} items, \{1.25} each\"\n"
        m4 = "        echo (str len \"héllo\") (str slice \"abcdef\" 2 4) (int to str 99) (str to int \"  -5\")\n        echo ([1] :: [2, 3]) (str contains \"needle\" \"ed\")\n"
        p_ty + p_area + p_total + p_greet + m1 + m2 + m3 + m4

fn :: wasm values expected => String
      wasm values expected =
        l1 = "[12, 12, 0]\n10 120\n[15, 25] [11, 12]\nhello, wasm True True False\n"
        l2 = "6.0 2.5 (Rect 1 2) [(Circle 2), (Rect 3 4), Dot]\n(7, seven, [7]) 10 items, 1.25 each\n6 cd 99 -5\n[1, 2, 3] True\n"
        l1 + l2

-- Build `src` for wasm32, validate it and run it; its standard output.
fn :: wasm run String String => String
      wasm run name src =
        shell exec "mkdir -p target/test_wasm" -> ()
        path = "target/test_wasm/" + name
        write file (path + ".ridgun") src
        assert equals (build native target executable (path + ".ridgun") (path + ".wasm") "wasm32") 0
        assert equals (shell exec ("wasm-validate --enable-tail-call " + path + ".wasm")) 0
        assert equals (shell exec ("sh tests/wasm/run-wasm.sh " + path + ".wasm > " + path + ".txt 2>&1")) 0
        read file (path + ".txt")

-- AC3 (value part): recursion, guards, a self tail call over 100 000 rounds,
-- Bool patterns and signed division give the Linux value 6765000160998.
fn :: test wasm runs ints => ()
      test wasm runs ints =
        echo "--- wasm32: arithmetic, guards, recursion, tail calls ---"
        assert equals (wasm run "ints" (wasm ints program)) "6765000160998\n"

-- The runtime: ADTs and patterns, list patterns, closures with map, filter
-- and fold, Strings, Reals, tuples, interpolation, echo of every kind.
fn :: test wasm runs values => ()
      test wasm runs values =
        echo "--- wasm32: values, closures, strings, reals ---"
        assert equals (wasm run "values" (wasm values program)) (wasm values expected)

fn :: main => ()
      main =
        echo "test wasm backend: NIR to wasm with the IR runtime"
        test wasm runs ints
        test wasm runs values
        echo "test wasm backend: done"
