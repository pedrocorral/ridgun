      matrix row 365 =  "E|U32|xor|U32|ok|15 7"
      matrix row 366 =  "E|U32|shl|U32|ok|96 20"
      matrix row 367 =  "E|U32|shr|U32|ok|1 1"
      matrix row 368 =  "E|U32|rotl|U32|ok|96 20"
      matrix row 369 =  "E|U32|rotr|U32|ok|2147483649 1073741825"
      matrix row 370 =  "E|U32|mulhi|U32|ok|0 0"
      matrix row 371 =  "E|U32|clmul|U32|ok|20 10"
      matrix row 372 =  "E|U32|clmulhi|U32|ok|0 0"
      matrix row _ =  ""

fn :: resolve ridgunc bin => String
      resolve ridgunc bin
        | is file "target/ridgunc_candidate" = "target/ridgunc_candidate"
        | is file "target/ridgunc"           = "target/ridgunc"
        | otherwise                         = "bin/ridgunc"

-- The lines that give a (which 0) or b (which 1) a value of the type.
fn :: value lines String String Int => String
      value lines v "Int" 0 =  "        " + v + " = 7\n"
      value lines v "Int" _ =  "        " + v + " = 2\n"
      value lines v "Real" 0 =  "        " + v + " = 7.5\n"
      value lines v "Real" _ =  "        " + v + " = 2.0\n"
      value lines v "Bool" 0 =  "        " + v + " = True\n"
      value lines v "Bool" _ =  "        " + v + " = False\n"
      value lines v "Str" 0 =  "        " + v + " = \"ab\"\n"
      value lines v "Str" _ =  "        " + v + " = \"cd\"\n"
      value lines v "List" 0 =  "        " + v + " = [1, 2]\n"
      value lines v "List" _ =  "        " + v + " = [3]\n"
      value lines v "TenU" 0 =  tensor lines v "U64" "12" "5"
      value lines v "TenU" _ =  tensor lines v "U64" "3" "2"
      value lines v "TenR" 0 =  tensor lines v "Real" "7.5" "1.5"
      value lines v _ 0 =  tensor lines v "Real" "7.5" "1.5"
      value lines v _ _ =  tensor lines v "Real" "2.0" "0.5"

-- The lines that give a (which 0) or b (which 1) a tensor of two elements of that type.
fn :: elem lines String String Int => String
      elem lines v "U64" 0 =  tensor lines v "U64" "12" "5"
      elem lines v "U64" _ =  tensor lines v "U64" "3" "2"
      elem lines v "U8" 0 =  tensor lines v "U8" "12" "5"
      elem lines v "U8" _ =  tensor lines v "U8" "3" "2"
      elem lines v "U16" 0 =  tensor lines v "U16" "12" "5"
      elem lines v "U16" _ =  tensor lines v "U16" "3" "2"
      elem lines v "U32" 0 =  tensor lines v "U32" "12" "5"
      elem lines v "U32" _ =  tensor lines v "U32" "3" "2"
      elem lines v _ 0 =  tensor lines v "Real" "7.5" "1.5"
      elem lines v _ _ =  tensor lines v "Real" "2.0" "0.5"

fn :: tensor lines String String String String => String
      tensor lines v el x y =
        "        " + v + " = Tensor[" + el + " * 2]\n        " + v + "_(0) = " + x + "\n        " + v + "_(1) = " + y + "\n"

fn :: program String String String String => String
      program "S" ta oper tb =
        "fn :: main => ()\n      main =\n" + (value lines "a" ta 0) + (value lines "b" tb 1) + "        r = a " + oper + " b\n        echo \"{{r}}\"\n"
      program _ el oper _ =
        "fn :: f Tensor[" + el + " * 2] Tensor[" + el + " * 2] => Tensor[" + el + " * 2]\n      f a b =  a_ij " + oper + " b_ij\n\nfn :: main => ()\n      main =\n" + (elem lines "a" el 0) + (elem lines "b" el 1) + "        r = f a b\n        echo \"{{r_(0)}} {{r_(1)}}\"\n"

fn :: field [String] Int => String
      field [] _ =  ""
      field (x:_) 0 =  x
      field (_:xs) i =  field xs (i - 1)

-- 0 when the row holds with this backend, 1 and a line that says what happened otherwise.
fn :: check row String [String] String String => Int
      check row rgc cols flag tag =
        dir = "target/test_matrix"
        write file (dir + "/t.ridgun") (program (field cols 0) (field cols 1) (field cols 2) (field cols 3))
        st = shell exec ("cd " + dir + " && rm -f t && \"" + rgc + "\" build " + flag + " t.ridgun -o t --quiet > build.txt 2>&1")
        verdict row cols tag st dir

fn :: verdict row [String] String Int String => Int
      verdict row cols tag st dir
        | (field cols 4) == "err" and st != 0 and (str contains (read file (dir + "/build.txt")) "error") = 0
        | (field cols 4) == "err" = report row cols tag ("it had to be a compile error, the build gave status " + (int to str st))
        | st != 0 = report row cols tag ("it does not build: " + (read file (dir + "/build.txt")))
        | otherwise = run row cols tag dir (shell exec ("cd " + dir + " && ./t > run.txt 2>&1"))

fn :: run row [String] String String Int => Int
      run row cols tag dir st
        | st != 0 = report row cols tag ("it fails when it runs (status " + (int to str st) + "): " + (read file (dir + "/run.txt")))
        | (read file (dir + "/run.txt")) == ((field cols 5) + "\n") = 0
        | otherwise = report row cols tag ("it prints '" + (read file (dir + "/run.txt")) + "', expected '" + (field cols 5) + "'")

fn :: report row [String] String String => Int
      report row cols tag what =
        echo ("[FAIL] " + tag + ": " + (field cols 1) + " " + (field cols 2) + " " + (field cols 3) + " (" + (field cols 0) + "): " + what)
        1

fn :: all rows String Int Int Int => Int
      all rows rgc i n bad
        | i >= n = bad
        | otherwise = all rows rgc (i + 1) n (bad + (one row rgc (str split (matrix row i) "|")))

fn :: one row String [String] => Int
      one row rgc cols =  (check row rgc cols "" "llvm") + (check row rgc cols "--target x86_64-linux-pure" "pure")

fn :: main => ()
      main =
        rgc = (sys getcwd) + "/" + (resolve ridgunc bin)
        shell exec "rm -rf target/test_matrix && mkdir -p target/test_matrix"
        echo "=== FR-COMP-030: every operator against every pair of types ==="
        bad = all rows rgc 0 matrix rows 0
        finish bad

fn :: finish Int => ()
      finish 0 =
        echo ("=== operator matrix: " + (int to str matrix rows) + " rows hold on both backends ===")
      finish bad =
        echo ("=== operator matrix: " + (int to str bad) + " failure(s) ===")
        sys exit 1
