        h10 = "define i64 @__rg_builtin_tensor_row_slice(ptr %slots_ptr) noinline nounwind {{\nentry:\n  %vec_tmp = alloca [3 x i64], align 8\n  %s0 = getelementptr inbounds i64, ptr %slots_ptr, i64 0\n  %s1 = getelementptr inbounds i64, ptr %slots_ptr, i64 1\n  %vm = load i64, ptr %s0, align 8\n  %vr = load i64, ptr %s1, align 8\n  store i64 0, ptr %s1, align 8\n  %r = ashr i64 %vr, 1\n  %pm = inttoptr i64 %vm to ptr\n  %mshp_p = getelementptr inbounds i8, ptr %pm, i64 8\n  %mshdr = load ptr, ptr %mshp_p, align 8\n  %msdp_p = getelementptr inbounds i8, ptr %mshdr, i64 8\n  %msptr = load ptr, ptr %msdp_p, align 8\n  %d0 = load i64, ptr %msptr, align 8\n  %d1_p = getelementptr inbounds i64, ptr %msptr, i64 1\n  %d1 = load i64, ptr %d1_p, align 8\n  %s_buf = call ptr @__rg_rt_alloc_buf(i64 8)\n  store i64 %d1, ptr %s_buf, align 8\n  %vp0 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 0\n  %vp1 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 1\n  %vp2 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 2\n  store i64 1, ptr %vp0, align 8\n  %s_buf_int = ptrtoint ptr %s_buf to i64\n  store i64 %s_buf_int, ptr %vp1, align 8\n  store i64 1, ptr %vp2, align 8\n  %shdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  %d_bytes = shl i64 %d1, 3\n  %d_buf = call ptr @__rg_rt_alloc_buf(i64 %d_bytes)\n  %ge0 = icmp sge i64 %r, 0\n  %lt0 = icmp slt i64 %r, %d0\n  %in_b = and i1 %ge0, %lt0\n  br i1 %in_b, label %copy_row, label %zero_row\ncopy_row:\n  %mdhp_p = getelementptr inbounds i8, ptr %pm, i64 16\n  %mdhdr = load ptr, ptr %mdhp_p, align 8\n  %mddp_p = getelementptr inbounds i8, ptr %mdhdr, i64 8\n  %mdata = load ptr, ptr %mddp_p, align 8\n  %row_off = mul i64 %r, %d1\n  %src_p = getelementptr inbounds i64, ptr %mdata, i64 %row_off\n  call void @__rg_memcpy(ptr %d_buf, ptr %src_p, i64 %d_bytes)\n  br label %box_out\nzero_row:\n  call void @__rg_memset(ptr %d_buf, i8 0, i64 %d_bytes)\n  br label %box_out\nbox_out:\n  store i64 %d1, ptr %vp0, align 8\n  %d_buf_int = ptrtoint ptr %d_buf to i64\n  store i64 %d_buf_int, ptr %vp1, align 8\n  store i64 %d1, ptr %vp2, align 8\n  %dhdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  store i64 5, ptr %vp0, align 8\n  %shdr_int = ptrtoint ptr %shdr to i64\n  %dhdr_int = ptrtoint ptr %dhdr to i64\n  store i64 %shdr_int, ptr %vp1, align 8\n  store i64 %dhdr_int, ptr %vp2, align 8\n  %res = call i64 @__rg_rt_box_rval(ptr %vec_tmp)\n  call void @__rg_rt_drop_slot(ptr %s0)\n  ret i64 %res\n}}\ndefine i64 @__rg_builtin_tensor_set_row(ptr %slots_ptr) noinline nounwind {{\nentry:\n  %s0 = getelementptr inbounds i64, ptr %slots_ptr, i64 0\n  %s1 = getelementptr inbounds i64, ptr %slots_ptr, i64 1\n  %s2 = getelementptr inbounds i64, ptr %slots_ptr, i64 2\n  %vm = load i64, ptr %s0, align 8\n  %vr = load i64, ptr %s1, align 8\n  %vv = load i64, ptr %s2, align 8\n  store i64 0, ptr %s0, align 8\n  store i64 0, ptr %s1, align 8\n  %r = ashr i64 %vr, 1\n  %pm = inttoptr i64 %vm to ptr\n  %mshp_p = getelementptr inbounds i8, ptr %pm, i64 8\n  %mshdr = load ptr, ptr %mshp_p, align 8\n  %msdp_p = getelementptr inbounds i8, ptr %mshdr, i64 8\n  %msptr = load ptr, ptr %msdp_p, align 8\n  %d0 = load i64, ptr %msptr, align 8\n  %d1_p = getelementptr inbounds i64, ptr %msptr, i64 1\n  %d1 = load i64, ptr %d1_p, align 8\n  %ge0 = icmp sge i64 %r, 0\n  %lt0 = icmp slt i64 %r, %d0\n  %in_b = and i1 %ge0, %lt0\n  br i1 %in_b, label %do_copy, label %done\ndo_copy:\n  %pv = inttoptr i64 %vv to ptr\n  %vdhp_p = getelementptr inbounds i8, ptr %pv, i64 16\n  %vdhdr = load ptr, ptr %vdhp_p, align 8\n  %vddp_p = getelementptr inbounds i8, ptr %vdhdr, i64 8\n  %vdata = load ptr, ptr %vddp_p, align 8\n  %vlen_p = getelementptr inbounds i8, ptr %vdhdr, i64 16\n  %vlen = load i64, ptr %vlen_p, align 8\n  %use_vlen = icmp slt i64 %vlen, %d1\n  %cnt = select i1 %use_vlen, i64 %vlen, i64 %d1\n  %nbytes = shl i64 %cnt, 3\n  %mdhp_p = getelementptr inbounds i8, ptr %pm, i64 16\n  %mdhdr = load ptr, ptr %mdhp_p, align 8\n  %mddp_p = getelementptr inbounds i8, ptr %mdhdr, i64 8\n  %mdata = load ptr, ptr %mddp_p, align 8\n  %row_off = mul i64 %r, %d1\n  %dst_p = getelementptr inbounds i64, ptr %mdata, i64 %row_off\n  call void @__rg_memcpy(ptr %dst_p, ptr %vdata, i64 %nbytes)\n  br label %done\ndone:\n  call void @__rg_rt_drop_slot(ptr %s2)\n  ret i64 %vm\n}}\ndefine i64 @__rg_builtin_tensor_col_slice(ptr %slots_ptr) noinline nounwind {{\nentry:\n  %vec_tmp = alloca [3 x i64], align 8\n  %s0 = getelementptr inbounds i64, ptr %slots_ptr, i64 0\n  %s1 = getelementptr inbounds i64, ptr %slots_ptr, i64 1\n  %vm = load i64, ptr %s0, align 8\n  %vc = load i64, ptr %s1, align 8\n  store i64 0, ptr %s1, align 8\n  %c = ashr i64 %vc, 1\n  %pm = inttoptr i64 %vm to ptr\n  %mshp_p = getelementptr inbounds i8, ptr %pm, i64 8\n  %mshdr = load ptr, ptr %mshp_p, align 8\n  %msdp_p = getelementptr inbounds i8, ptr %mshdr, i64 8\n  %msptr = load ptr, ptr %msdp_p, align 8\n  %d0 = load i64, ptr %msptr, align 8\n  %d1_p = getelementptr inbounds i64, ptr %msptr, i64 1\n  %d1 = load i64, ptr %d1_p, align 8\n  %s_buf = call ptr @__rg_rt_alloc_buf(i64 8)\n  store i64 %d0, ptr %s_buf, align 8\n  %vp0 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 0\n  %vp1 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 1\n  %vp2 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 2\n  store i64 1, ptr %vp0, align 8\n  %s_buf_int = ptrtoint ptr %s_buf to i64\n  store i64 %s_buf_int, ptr %vp1, align 8\n  store i64 1, ptr %vp2, align 8\n  %shdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  %d_bytes = shl i64 %d0, 3\n  %d_buf = call ptr @__rg_rt_alloc_buf(i64 %d_bytes)\n  %mdhp_p = getelementptr inbounds i8, ptr %pm, i64 16\n  %mdhdr = load ptr, ptr %mdhp_p, align 8\n  %mddp_p = getelementptr inbounds i8, ptr %mdhdr, i64 8\n  %mdata = load ptr, ptr %mddp_p, align 8\n  br label %loop\nloop:\n  %r = phi i64 [ 0, %entry ], [ %r_next, %body ]\n  %cond = icmp slt i64 %r, %d0\n  br i1 %cond, label %body, label %box_out\nbody:\n  %row_off = mul i64 %r, %d1\n  %idx = add i64 %row_off, %c\n  %sp = getelementptr inbounds i64, ptr %mdata, i64 %idx\n  %val = load i64, ptr %sp, align 8\n  %dp = getelementptr inbounds i64, ptr %d_buf, i64 %r\n  store i64 %val, ptr %dp, align 8\n  %r_next = add i64 %r, 1\n  br label %loop\nbox_out:\n  store i64 %d0, ptr %vp0, align 8\n  %d_buf_int = ptrtoint ptr %d_buf to i64\n  store i64 %d_buf_int, ptr %vp1, align 8\n  store i64 %d0, ptr %vp2, align 8\n  %dhdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  store i64 5, ptr %vp0, align 8\n  %shdr_int = ptrtoint ptr %shdr to i64\n  %dhdr_int = ptrtoint ptr %dhdr to i64\n  store i64 %shdr_int, ptr %vp1, align 8\n  store i64 %dhdr_int, ptr %vp2, align 8\n  %res = call i64 @__rg_rt_box_rval(ptr %vec_tmp)\n  call void @__rg_rt_drop_slot(ptr %s0)\n  ret i64 %res\n}}\ndefine i64 @__rg_builtin_tensor_set_col(ptr %slots_ptr) noinline nounwind {{\nentry:\n  %s0 = getelementptr inbounds i64, ptr %slots_ptr, i64 0\n  %s1 = getelementptr inbounds i64, ptr %slots_ptr, i64 1\n  %s2 = getelementptr inbounds i64, ptr %slots_ptr, i64 2\n  %vm = load i64, ptr %s0, align 8\n  %vc = load i64, ptr %s1, align 8\n  %vv = load i64, ptr %s2, align 8\n  store i64 0, ptr %s0, align 8\n  store i64 0, ptr %s1, align 8\n  %c = ashr i64 %vc, 1\n  %pm = inttoptr i64 %vm to ptr\n  %mshp_p = getelementptr inbounds i8, ptr %pm, i64 8\n  %mshdr = load ptr, ptr %mshp_p, align 8\n  %msdp_p = getelementptr inbounds i8, ptr %mshdr, i64 8\n  %msptr = load ptr, ptr %msdp_p, align 8\n  %d0 = load i64, ptr %msptr, align 8\n  %d1_p = getelementptr inbounds i64, ptr %msptr, i64 1\n  %d1 = load i64, ptr %d1_p, align 8\n  %pv = inttoptr i64 %vv to ptr\n  %vdhp_p = getelementptr inbounds i8, ptr %pv, i64 16\n  %vdhdr = load ptr, ptr %vdhp_p, align 8\n  %vddp_p = getelementptr inbounds i8, ptr %vdhdr, i64 8\n  %vdata = load ptr, ptr %vddp_p, align 8\n  %vlen_p = getelementptr inbounds i8, ptr %vdhdr, i64 16\n  %vlen = load i64, ptr %vlen_p, align 8\n  %use_vlen = icmp slt i64 %vlen, %d0\n  %limit = select i1 %use_vlen, i64 %vlen, i64 %d0\n  %mdhp_p = getelementptr inbounds i8, ptr %pm, i64 16\n  %mdhdr = load ptr, ptr %mdhp_p, align 8\n  %mddp_p = getelementptr inbounds i8, ptr %mdhdr, i64 8\n  %mdata = load ptr, ptr %mddp_p, align 8\n  br label %loop\nloop:\n  %r = phi i64 [ 0, %entry ], [ %r_next, %body ]\n  %cond = icmp slt i64 %r, %limit\n  br i1 %cond, label %body, label %done\nbody:\n  %vp = getelementptr inbounds i64, ptr %vdata, i64 %r\n  %val = load i64, ptr %vp, align 8\n  %row_off = mul i64 %r, %d1\n  %idx = add i64 %row_off, %c\n  %dp = getelementptr inbounds i64, ptr %mdata, i64 %idx\n  store i64 %val, ptr %dp, align 8\n  %r_next = add i64 %r, 1\n  br label %loop\ndone:\n  call void @__rg_rt_drop_slot(ptr %s2)\n  ret i64 %vm\n}}\n"
        h11 = "define i64 @__rg_fast_einsum(ptr %slots_ptr, i64 %count, ptr %spec_ptr, i64 %spec_len) noinline nounwind {{\nentry:\n  %vec_tmp = alloca [3 x i64], align 8\n  %is_c2 = icmp eq i64 %count, 2\n  %is_s5 = icmp eq i64 %spec_len, 5\n  %ok_cs = and i1 %is_c2, %is_s5\n  br i1 %ok_cs, label %chk_spec, label %slow\nchk_spec:\n  %c0 = load i8, ptr %spec_ptr, align 1\n  %p1 = getelementptr inbounds i8, ptr %spec_ptr, i64 1\n  %c1 = load i8, ptr %p1, align 1\n  %p2 = getelementptr inbounds i8, ptr %spec_ptr, i64 2\n  %c2 = load i8, ptr %p2, align 1\n  %p3 = getelementptr inbounds i8, ptr %spec_ptr, i64 3\n  %c3 = load i8, ptr %p3, align 1\n  %p4 = getelementptr inbounds i8, ptr %spec_ptr, i64 4\n  %c4 = load i8, ptr %p4, align 1\n  %is_comma = icmp eq i8 %c2, 44\n  %mid_eq = icmp eq i8 %c1, %c3\n  %out_ne = icmp ne i8 %c0, %c4\n  %c0_ne_c1 = icmp ne i8 %c0, %c1\n  %c4_ne_c1 = icmp ne i8 %c4, %c1\n  %ok1 = and i1 %is_comma, %mid_eq\n  %ok2 = and i1 %out_ne, %c0_ne_c1\n  %ok3 = and i1 %ok1, %ok2\n  %ok_spec = and i1 %ok3, %c4_ne_c1\n  br i1 %ok_spec, label %chk_tensors, label %slow\nchk_tensors:\n  %s0 = getelementptr inbounds i64, ptr %slots_ptr, i64 0\n  %s1 = getelementptr inbounds i64, ptr %slots_ptr, i64 1\n  %va = load i64, ptr %s0, align 8\n  %vb = load i64, ptr %s1, align 8\n  %ann = icmp ne i64 %va, 0\n  %al3 = and i64 %va, 7\n  %ap_ok = icmp eq i64 %al3, 0\n  %a_ok = and i1 %ann, %ap_ok\n  %bnn = icmp ne i64 %vb, 0\n  %bl3 = and i64 %vb, 7\n  %bp_ok = icmp eq i64 %bl3, 0\n  %b_ok = and i1 %bnn, %bp_ok\n  %both_ok = and i1 %a_ok, %b_ok\n  br i1 %both_ok, label %chk_tags, label %slow\nchk_tags:\n  %pa = inttoptr i64 %va to ptr\n  %pb = inttoptr i64 %vb to ptr\n  %atag = load i32, ptr %pa, align 4\n  %btag = load i32, ptr %pb, align 4\n  %at5 = icmp eq i32 %atag, 5\n  %bt5 = icmp eq i32 %btag, 5\n  %tags_ok = and i1 %at5, %bt5\n  br i1 %tags_ok, label %chk_ranks, label %slow\nchk_ranks:\n  %ashp_p = getelementptr inbounds i8, ptr %pa, i64 8\n  %ashdr = load ptr, ptr %ashp_p, align 8\n  %ark_p = getelementptr inbounds i8, ptr %ashdr, i64 16\n  %ark = load i64, ptr %ark_p, align 8\n  %bshp_p = getelementptr inbounds i8, ptr %pb, i64 8\n  %bshdr = load ptr, ptr %bshp_p, align 8\n  %brk_p = getelementptr inbounds i8, ptr %bshdr, i64 16\n  %brk = load i64, ptr %brk_p, align 8\n  %ar2 = icmp eq i64 %ark, 2\n  %br2 = icmp eq i64 %brk, 2\n  %rks_ok = and i1 %ar2, %br2\n  br i1 %rks_ok, label %chk_dims, label %slow\nchk_dims:\n  %asdp_p = getelementptr inbounds i8, ptr %ashdr, i64 8\n  %asptr = load ptr, ptr %asdp_p, align 8\n  %M = load i64, ptr %asptr, align 8\n  %ak_p = getelementptr inbounds i64, ptr %asptr, i64 1\n  %K = load i64, ptr %ak_p, align 8\n  %bsdp_p = getelementptr inbounds i8, ptr %bshdr, i64 8\n  %bsptr = load ptr, ptr %bsdp_p, align 8\n  %bK = load i64, ptr %bsptr, align 8\n  %bn_p = getelementptr inbounds i64, ptr %bsptr, i64 1\n  %N = load i64, ptr %bn_p, align 8\n  %k_eq = icmp eq i64 %K, %bK\n  %m_gt0 = icmp sgt i64 %M, 0\n  %k_gt0 = icmp sgt i64 %K, 0\n  %n_gt0 = icmp sgt i64 %N, 0\n  %mk_ok = and i1 %m_gt0, %k_gt0\n  %mkn_ok = and i1 %mk_ok, %n_gt0\n  %dims_ok = and i1 %k_eq, %mkn_ok\n  br i1 %dims_ok, label %init_c, label %slow\ninit_c:\n  %s_buf = call ptr @__rg_rt_alloc_buf(i64 16)\n  store i64 %M, ptr %s_buf, align 8\n  %s_buf1 = getelementptr inbounds i64, ptr %s_buf, i64 1\n  store i64 %N, ptr %s_buf1, align 8\n  %vp0 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 0\n  %vp1 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 1\n  %vp2 = getelementptr inbounds [3 x i64], ptr %vec_tmp, i64 0, i64 2\n  store i64 2, ptr %vp0, align 8\n  %s_buf_int = ptrtoint ptr %s_buf to i64\n  store i64 %s_buf_int, ptr %vp1, align 8\n  store i64 2, ptr %vp2, align 8\n  %shdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  %tot = mul i64 %M, %N\n  %d_bytes = shl i64 %tot, 3\n  %d_buf = call ptr @__rg_rt_alloc_buf(i64 %d_bytes)\n  call void asm sideeffect \"rep stosq\", \"{{rdi}},{{rax}},{{rcx}},~{{rdi}},~{{rcx}},~{{memory}},~{{dirflag}},~{{fpsr}},~{{flags}}\"(ptr %d_buf, i64 0, i64 %tot)\n  %adhp_p = getelementptr inbounds i8, ptr %pa, i64 16\n  %adhdr = load ptr, ptr %adhp_p, align 8\n  %addp_p = getelementptr inbounds i8, ptr %adhdr, i64 8\n  %adata = load ptr, ptr %addp_p, align 8\n  %bdhp_p = getelementptr inbounds i8, ptr %pb, i64 16\n  %bdhdr = load ptr, ptr %bdhp_p, align 8\n  %bddp_p = getelementptr inbounds i8, ptr %bdhdr, i64 8\n  %bdata = load ptr, ptr %bddp_p, align 8\n  br label %loop_i\nloop_i:\n  %i = phi i64 [ 0, %init_c ], [ %i_next, %next_i ]\n  %ci = icmp slt i64 %i, %M\n  br i1 %ci, label %loop_k, label %box_out\nloop_k:\n  %k = phi i64 [ 0, %loop_i ], [ %k_next, %next_k ]\n  %ck = icmp slt i64 %k, %K\n  br i1 %ck, label %prep_j, label %next_i\nprep_j:\n  %ai_off = mul i64 %i, %K\n  %aik_idx = add i64 %ai_off, %k\n  %aik_p = getelementptr inbounds i64, ptr %adata, i64 %aik_idx\n  %aik = load i64, ptr %aik_p, align 8\n  %bk_off = mul i64 %k, %N\n  %ci_off = mul i64 %i, %N\n  br label %loop_j\nloop_j:\n  %j = phi i64 [ 0, %prep_j ], [ %j_next, %body_j ]\n  %cj = icmp slt i64 %j, %N\n  br i1 %cj, label %body_j, label %next_k\nbody_j:\n  %bkj_idx = add i64 %bk_off, %j\n  %bkj_p = getelementptr inbounds i64, ptr %bdata, i64 %bkj_idx\n  %bkj = load i64, ptr %bkj_p, align 8\n  %cij_idx = add i64 %ci_off, %j\n  %cij_p = getelementptr inbounds i64, ptr %d_buf, i64 %cij_idx\n  %cij_old = load i64, ptr %cij_p, align 8\n  %prod = mul i64 %aik, %bkj\n  %cij_new = add i64 %cij_old, %prod\n  store i64 %cij_new, ptr %cij_p, align 8\n  %j_next = add i64 %j, 1\n  br label %loop_j\nnext_k:\n  %k_next = add i64 %k, 1\n  br label %loop_k\nnext_i:\n  %i_next = add i64 %i, 1\n  br label %loop_i\nbox_out:\n  store i64 %tot, ptr %vp0, align 8\n  %d_buf_int = ptrtoint ptr %d_buf to i64\n  store i64 %d_buf_int, ptr %vp1, align 8\n  store i64 %tot, ptr %vp2, align 8\n  %dhdr = call ptr @__rg_rt_box_rc_vec(ptr %vec_tmp)\n  store i64 5, ptr %vp0, align 8\n  %shdr_int = ptrtoint ptr %shdr to i64\n  %dhdr_int = ptrtoint ptr %dhdr to i64\n  store i64 %shdr_int, ptr %vp1, align 8\n  store i64 %dhdr_int, ptr %vp2, align 8\n  %res = call i64 @__rg_rt_box_rval(ptr %vec_tmp)\n  call void @__rg_rt_drop_slot(ptr %s0)\n  call void @__rg_rt_drop_slot(ptr %s1)\n  ret i64 %res\nslow:\n  %res_s = call i64 @__rg_rt_einsum(ptr %slots_ptr, i64 %count, ptr %spec_ptr, i64 %spec_len)\n  ret i64 %res_s\n}}\n"
        join str tree [h1, h1b, h1c, h1d, h1e, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11]

-- ── RNativeInstr => LLVM IR Instruction Emitter ─────────────

fn :: llvm bool tag Int => Int
      llvm bool tag 0   =  2
      llvm bool tag _   =  6

fn :: llvm unroll clear locals Int Int Int [String] => String
      llvm unroll clear locals cur end_slot step acc
        | cur >= end_slot = join str tree acc
        | otherwise =
          line = "  %clp_{step}_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  %clv_{step}_{cur} = load i64, ptr %clp_{step}_{cur}, align 8\n  store i64 0, ptr %clp_{step}_{cur}, align 8\n  %cld_{step}_{cur} = call i64 @__rg_fast_drop_val(i64 %clv_{step}_{cur})\n"
          llvm unroll clear locals (cur + 1) end_slot step (acc :: [line])

fn :: llvm unroll init frame Int Int Int [String] => String
      llvm unroll init frame cur arity num_slots acc
        | cur >= num_slots = join str tree acc
        | cur < arity =
          line = "  %ap_{cur} = getelementptr inbounds i64, ptr %args, i64 {cur}\n  %av_{cur} = load i64, ptr %ap_{cur}, align 8\n  store i64 0, ptr %ap_{cur}, align 8\n  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 %av_{cur}, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame (cur + 1) arity num_slots (acc :: [line])
        | otherwise =
          line = "  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 0, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame (cur + 1) arity num_slots (acc :: [line])

fn :: llvm unroll epilogue Int Int [String] => String
      llvm unroll epilogue cur num_slots acc
        | cur >= num_slots = join str tree acc
        | otherwise =
          line = "  %epp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  %epv_{cur} = load i64, ptr %epp_{cur}, align 8\n  store i64 0, ptr %epp_{cur}, align 8\n  %epd_{cur} = call i64 @__rg_fast_drop_val(i64 %epv_{cur})\n"
          llvm unroll epilogue (cur + 1) num_slots (acc :: [line])

fn :: llvm instr is tco RNativeInstr => Bool
      llvm instr is tco (NTailCall _ _) = True
      llvm instr is tco _               = False

fn :: llvm fn has tco [RNativeInstr] => Bool
      llvm fn has tco [] = False
      llvm fn has tco (ins:rest)
        | llvm instr is tco ins = True
        | otherwise = llvm fn has tco rest

fn :: emit llvm instr RNativeInstr Int Int Int => String
      emit llvm instr (NLabel lid) _ _ _ =
        "  br label %L_{lid}\nL_{lid}:\n"
      emit llvm instr (NJump lid) step _ _ =
        "  br label %L_{lid}\ndead_{step}:\n"
      emit llvm instr (NJumpIfZero lid) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %c_{step} = icmp eq i64 %a_{step}, 0\n  br i1 %c_{step}, label %L_{lid}, label %next_{step}\nnext_{step}:\n"
      emit llvm instr (NJumpIfNonZero lid) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %c_{step} = icmp ne i64 %a_{step}, 0\n  br i1 %c_{step}, label %L_{lid}, label %next_{step}\nnext_{step}:\n"
      emit llvm instr (NLoadImmInt n) _ _ _ =
        tagged = (n * 2) + 1
        "  store i64 {tagged}, ptr %acc, align 8\n"
      emit llvm instr (NLoadImmRaw raw) _ _ _ =
        "  store i64 {raw}, ptr %acc, align 8\n"
      emit llvm instr (NLoadRealLit off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_real_lit(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadStrLit off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_str_lit(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadAdt0 -1 0) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 22\n  %r_{step} = call i64 @__rg_rt_load_adt0(ptr %p_{step}, i64 6)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadAdt0 off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_adt0(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCloneSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_fast_clone_slot(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMoveSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  store i64 %v_{step}, ptr %acc, align 8\n"
      emit llvm instr (NStoreSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_store_slot(ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NRebindSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_rebind_slot(ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCmmDropSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %r_{step} = call i64 @__rg_fast_cmm_drop_slot(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NDropVal step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_drop_val(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NClearLocals start_slot end_slot) step _ _
        | end_slot <= start_slot = ""
        | (end_slot - start_slot) <= 8 = llvm unroll clear locals start_slot end_slot step []
        | otherwise =
          "  call void @__rg_rt_clear_locals(ptr %frame, i64 {start_slot}, i64 {end_slot})\n"
      emit llvm instr (NMatchInt slot n) step _ _ =
        tagged = (n * 2) + 1
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %c_{step} = icmp eq i64 %v_{step}, {tagged}\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchReal slot off len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_match_real(i64 %v_{step}, ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchStr slot off len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_match_str(i64 %v_{step}, ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchBool slot b_int) step _ _ =
        btag = llvm bool tag b_int
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %c_{step} = icmp eq i64 %v_{step}, {btag}\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchEmpty slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_empty(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchNonEmpty slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_nonempty(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchTuple slot arity) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_tuple(i64 %v_{step}, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -1) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = and i64 %v_{step}, 1\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -2) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %m_{step} = and i64 %v_{step}, -5\n  %c_{step} = icmp eq i64 %m_{step}, 2\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -3) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 1)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -4) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 0)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -5) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 5)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot off len arity) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_match_adt(i64 %v_{step}, ptr %p_{step}, i64 {len}, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListHead slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_list_head(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListTail slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_list_tail(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NTupleGet slot idx) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_tuple_get(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NAdtField slot idx) step _ _
        | idx < 0 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_adt_field_neg(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_adt_field(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NPackSeq arity) step _ _ =
        "  %r_{step} = call i64 @__rg_rt_pack_seq(ptr %frame, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NAsBool step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_as_bool(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NNot step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_not_op(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NOut step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_out(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NBinOp op_id lhs_slot) step _ _
        | op_id == 14 OR op_id == 15 OR op_id == 16 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_bin_op(i64 {op_id}, ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_bin_op(i64 {op_id}, ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NAdtSet rec_slot idx) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {rec_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_adt_set(ptr %s_{step}, i64 {idx}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeList start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_list(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeTuple start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_tuple(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeTensor start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_tensor(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeAdt off len start_slot count) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_adt(ptr %p_{step}, i64 {len}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NEcho start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_echo(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NStrInterp start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_str_interp(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start -1) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %r_{step} = call i64 @__rg_tensor_index_1d(i64 %bv_{step}, ptr %is_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start -2) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %r_{step} = call i64 @__rg_tensor_index_2d(i64 %bv_{step}, ptr %is_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start count) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %r_{step} = call i64 @__rg_rt_index(ptr %bs_{step}, ptr %is_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start 1) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_tensor_index_set_1d(ptr %bs_{step}, ptr %is_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start 2) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_tensor_index_set_2d(ptr %bs_{step}, ptr %is_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start count) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_index_set(ptr %bs_{step}, ptr %is_{step}, i64 {count}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NSeqSelect mask_off mask_len) step _ rodata_len =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {mask_off}\n  %r_{step} = call i64 @__rg_rt_seq_select(i64 %a_{step}, ptr %p_{step}, i64 {mask_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NEinsum start_slot count spec_off spec_len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {spec_off}\n  %r_{step} = call i64 @__rg_fast_einsum(ptr %s_{step}, i64 {count}, ptr %p_{step}, i64 {spec_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NHadamard op_id lhs_slot subs_off subs_len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {subs_off}\n  %r_{step} = call i64 @__rg_rt_hadamard(i64 {op_id}, ptr %s_{step}, i64 %a_{step}, ptr %p_{step}, i64 {subs_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NEnterRegion step _ _ =
        "  %r_{step} = call i64 @__rg_rt_enter_region()\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NExitRegion quota) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_exit_region(i64 {quota}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallFn fid start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_fn_{fid}(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 36 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sha256_raw(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 40 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_str_char_at(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 86 _ _) step _ _ =
        "  %r_{step} = call i64 @__rg_builtin_sys_pipe()\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 87 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sys_waitpid(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 88 start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_fill(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 89 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sha256_concat(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 90 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_bitop(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 91 s_slot _) step _ _ =
        "  %ss_{step} = getelementptr inbounds i64, ptr %frame, i64 {s_slot}\n  %sv_{step} = load i64, ptr %ss_{step}, align 8\n  %iv_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_str_char_at_fast(i64 %sv_{step}, i64 %iv_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 92 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_row_slice(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 93 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_set_row(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 94 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_col_slice(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 95 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_set_col(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin b_id start_slot count) step _ _
        | b_id >= 70 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_pal_dispatch(i64 {b_id}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_builtin(i64 {b_id}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallIndirect1 fn_slot arg_slot) step _ _ =
        "  %fs_{step} = getelementptr inbounds i64, ptr %frame, i64 {fn_slot}\n  %fv_{step} = load i64, ptr %fs_{step}, align 8\n  %as_{step} = getelementptr inbounds i64, ptr %frame, i64 {arg_slot}\n  %r_{step} = call i64 @__rg_rt_call_indirect1(i64 %fv_{step}, ptr %as_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallIndirect2 fn_slot start_slot) step _ _ =
        "  %fs_{step} = getelementptr inbounds i64, ptr %frame, i64 {fn_slot}\n  %fv_{step} = load i64, ptr %fs_{step}, align 8\n  %as_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_call_indirect2(i64 %fv_{step}, ptr %as_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NTailCall start_slot arity) step num_slots _ =
        "  call void @__rg_rt_tco_copy(ptr %frame, i64 {start_slot}, i64 {arity}, i64 {num_slots})\n  br label %tco_entry\ndead_{step}:\n"
      emit llvm instr NReturn step _ _ =
        "  br label %epilogue_exit\ndead_{step}:\n"

fn :: emit llvm instr list [RNativeInstr] Int Int Int [String] => [String]
      emit llvm instr list [] _ _ _ acc = acc
      emit llvm instr list (ins:rest) step num_slots rodata_len acc =
        line = emit llvm instr ins step num_slots rodata_len
        emit llvm instr list rest (step + 1) num_slots rodata_len (acc :: [line])

fn :: llvm alloc slots Int => Int
      llvm alloc slots n
        | n <= 0 = 1
        | otherwise = n

fn :: llvm fn attrs Int => String
      llvm fn attrs 2   =  "noinline optnone nounwind"
      llvm fn attrs 3   =  "noinline optnone nounwind"
      llvm fn attrs _   =  "nounwind"

fn :: emit llvm fn RNativeFn Int => String
      emit llvm fn (NativeFn fid _ arity num_slots instrs) rodata_len
        | fid >= 5 AND num_slots <= 24 AND (NOT (llvm fn has tco instrs)) =
          aslots = llvm alloc slots num_slots
          fattrs = llvm fn attrs fid
          init_ir = llvm unroll init frame 0 arity num_slots []
          epi_ir = llvm unroll epilogue 0 num_slots []
          hdr = "define i64 @__rg_fn_{fid}(ptr %args) {fattrs} {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n" + init_ir + "  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n" + epi_ir + "  ret i64 %a_end\n}}\n\n"
          join str tree ([hdr] :: body_chunks :: [ftr])
        | otherwise =
          aslots = llvm alloc slots num_slots
          fattrs = llvm fn attrs fid
          hdr = "define i64 @__rg_fn_{fid}(ptr %args) {fattrs} {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n  call void @__rg_rt_init_frame(ptr %frame, ptr %args, i64 {arity}, i64 {num_slots})\n  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n  %r_end = call i64 @__rg_rt_epilogue(ptr %frame, i64 {num_slots}, i64 %a_end)\n  ret i64 %r_end\n}}\n\n"
          join str tree ([hdr] :: body_chunks :: [ftr])

fn :: emit llvm fn list [RNativeFn] Int [String] => [String]
      emit llvm fn list [] _ acc = acc
      emit llvm fn list (f:fs) rodata_len acc =
        fn_ir = emit llvm fn f rodata_len
        emit llvm fn list fs rodata_len (acc :: [fn_ir])

fn :: llvm target triple String => String
      llvm target triple "arm64"       =  "aarch64-unknown-linux-gnu"
      llvm target triple "arm64-linux" =  "aarch64-unknown-linux-gnu"
      llvm target triple "aarch64"     =  "aarch64-unknown-linux-gnu"
      llvm target triple _             =  "x86_64-unknown-linux-gnu"

fn :: emit llvm ir for target RNativeProg String => String
      emit llvm ir for target (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) target_arch =
        triple = llvm target triple target_arch
        rlen = llvm rodata len rodata_str
        resc = llvm escape rodata rodata_str
        mod_hdr = "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\ntarget triple = \"{triple}\"\n\n@__rg_page0 = global {{ ptr, ptr, ptr, ptr, [3936 x i8] }} {{ ptr @__rg_fn_{main_fid}, ptr @__rg_fn_{spawn_fid}, ptr @__rg_fn_{call2_fid}, ptr @__rg_fn_{binop_fid}, [3936 x i8] zeroinitializer }}, section \".rg_page0\", align 8\n@__rg_rodata = private unnamed_addr constant [{rlen} x i8] c\"{resc}\", align 16\n\n"
        decls = llvm runtime declarations
        sha_ir = llvm sha256 helpers
        hlp_ir = llvm tensor and builtin helpers
        fn_chunks = emit llvm fn list fns rlen []
        join str tree ([mod_hdr, decls, "\n", sha_ir, "\n", hlp_ir, "\n"] :: fn_chunks :: ["!0 = !{{}}\n"])

fn :: emit llvm ir RNativeProg => String
      emit llvm ir nprog       =  emit llvm ir for target nprog "x86_64-linux"

-- ── Linker Script & llc + ld Execution Driver ───────────────

fn :: emit llvm linker script => String
      emit llvm linker script =
        s1 = "ENTRY(_start)\nPHDRS {{\n  all PT_LOAD FILEHDR PHDRS FLAGS(7);\n}}\nSECTIONS {{\n  . = 0x400080;\n  .rg_page0 : {{ KEEP(*(.rg_page0)) }} :all\n  . = 0x401000;\n  _start = .;\n  .rg_rt : {{ KEEP(*__rg_llvm_*.rt(.data)) }} :all\n  .text : ALIGN(16) {{ *(.text .text.*) }} :all\n  .rodata : ALIGN(16) {{ *(.rodata .rodata.*) }} :all\n  .data : ALIGN(16) {{ *(.data .data.*) }} :all\n  .bss : ALIGN(16) {{ *(.bss .bss.* COMMON) . = . + 131072; }} :all\n  /DISCARD/ : {{ *(.note*) *(.eh_frame*) *(.comment*) }}\n}}\n"
        s2 = "__rg_rt_init_frame = 4214136;\n__rg_rt_epilogue = 4214193;\n__rg_rt_tco_copy = 4214263;\n__rg_rt_clear_locals = 4214429;\n__rg_rt_clone_slot = 4214484;\n__rg_rt_drop_val = 4214519;\n__rg_rt_cmm_move = 4214549;\n__rg_rt_store_slot = 4214557;\n__rg_rt_rebind_slot = 4214596;\n__rg_rt_cmm_drop_slot = 4214624;\n__rg_rt_load_real_lit = 4214724;\n__rg_rt_load_str_lit = 4214782;\n__rg_rt_load_adt0 = 4214814;\n__rg_rt_make_adt = 4214846;\n__rg_rt_make_list = 4214925;\n__rg_rt_make_tuple = 4214963;\n__rg_rt_make_tensor = 4215291;\n__rg_rt_str_interp = 4215765;\n__rg_rt_pack_seq = 4215982;\n__rg_rt_as_bool = 4216188;\n"
        s3 = "__rg_rt_match_int = 4216208;\n__rg_rt_match_real = 4216225;\n__rg_rt_match_str = 4216329;\n__rg_rt_match_bool = 4216427;\n__rg_rt_match_empty = 4216452;\n__rg_rt_match_nonempty = 4216495;\n__rg_rt_list_head = 4216538;\n__rg_rt_list_tail = 4216614;\n__rg_rt_match_tuple = 4216754;\n__rg_rt_tuple_get = 4216825;\n__rg_rt_match_adt = 4216940;\n__rg_rt_adt_field = 4217065;\n__rg_rt_adt_set = 4217137;\n__rg_rt_bool_inv = 4217445;\n__rg_rt_out = 4217469;\n__rg_rt_echo = 4217589;\n__rg_rt_bin_op = 4217830;\n__rg_rt_index = 4222964;\n__rg_rt_index_set = 4223746;\n__rg_rt_seq_select = 4224237;\n"
        s4 = "__rg_rt_einsum = 4227142;\n__rg_rt_hadamard = 4227321;\n__rg_rt_enter_region = 4229186;\n__rg_rt_exit_region = 4229444;\n__rg_rt_call_indirect1 = 4230596;\n__rg_rt_call_indirect2 = 4230720;\n__rg_rt_builtin = 4241227;\n__rg_rt_pal_dispatch = 4286080;\n__rg_rt_drop_slot = 4200437;\n__rg_rt_alloc_buf = 4205566;\n__rg_rt_box_rc_vec = 4208821;\n__rg_rt_box_rval = 4209847;\n__rg_rt_pop_i64 = 4212364;\n__rg_rt_alloc_str = 4212489;\nmemcpy = __rg_memcpy;\nmemset = __rg_memset;\n"
        join str tree [s1, s2, s3, s4]

fn :: finish llvm link Int String String => Int
      finish llvm link 0 output_bin tmp_base =
        _ = shell exec ("rm -f \"" + tmp_base + "\".*")
        rc = sys chmod output_bin 493
        check chmod status rc
      finish llvm link _ _ tmp_base =
        _ = shell exec ("rm -f \"" + tmp_base + "\".*")
        _ = echo "[ridgunc llvm] Error: llc/ld native compilation failed"
        1

fn :: write cached rt files String String => ()
      write cached rt files rt_path lds_path =
        rt_bytes = build x8664 rt kernel
        _ = write bytes rt_path rt_bytes
        lds_text = emit llvm linker script
        _ = write file lds_path lds_text
        ()

fn :: ensure cached rt files String String => ()
      ensure cached rt files rt_path lds_path
        | (str len (read file lds_path)) > 0 = ()
        | otherwise = write cached rt files rt_path lds_path

fn :: build llvm x8664 executable RNativeProg String     => Int
      build llvm x8664 executable nprog       output_bin =
        pid_s = int to str (sys getpid)
        tmp_base = "/tmp/__rg_llvm_" + pid_s
        ll_path = tmp_base + ".ll"
        bc_path = tmp_base + ".bc"
        obj_path = tmp_base + ".o"
        rt_path = "/tmp/__rg_llvm_cache_v0_9_21_s2.rt"
        lds_path = "/tmp/__rg_llvm_cache_v0_9_21_s2.lds"
        _ = ensure cached rt files rt_path lds_path
        ll_text = emit llvm ir nprog
        _ = write file ll_path ll_text
        cmd = "/usr/bin/opt -O2 \"" + ll_path + "\" -o \"" + bc_path + "\" && /usr/bin/llc -O2 -filetype=obj \"" + bc_path + "\" -o \"" + obj_path + "\" && /usr/bin/ld -n --no-warn-rwx-segments -T \"" + lds_path + "\" -b binary \"" + rt_path + "\" -b elf64-x86-64 \"" + obj_path + "\" -o \"" + output_bin + "\""
        res = shell exec cmd
        finish llvm link res output_bin tmp_base

fn :: build llvm x8664 so library RNativeProg String    => Int
      build llvm x8664 so library nprog       output_so =
        pid_s = int to str (sys getpid)
        tmp_base = "/tmp/__rg_llvm_so_" + pid_s
        ll_path = tmp_base + ".ll"
        bc_path = tmp_base + ".bc"
        obj_path = tmp_base + ".o"
        rt_path = "/tmp/__rg_llvm_cache_v0_9_21_s2.rt"
        lds_path = "/tmp/__rg_llvm_cache_v0_9_21_s2.lds"
        _ = ensure cached rt files rt_path lds_path
        ll_text = emit llvm ir nprog
        _ = write file ll_path ll_text
        cmd = "/usr/bin/opt -O2 \"" + ll_path + "\" -o \"" + bc_path + "\" && /usr/bin/llc -O2 -relocation-model=pic -filetype=obj \"" + bc_path + "\" -o \"" + obj_path + "\" && /usr/bin/ld -shared -n --no-warn-rwx-segments -T \"" + lds_path + "\" -b binary \"" + rt_path + "\" -b elf64-x86-64 \"" + obj_path + "\" -o \"" + output_so + "\""
        res = shell exec cmd
        finish llvm link res output_so tmp_base
