fn :: x86 build rt jump table Int [Int] => [Int]
      x86 build rt jump table idx acc
        | idx >= 56 = acc
        | otherwise =
          entry = x86 rt slot entry idx
          x86 build rt jump table (idx + 1) (acc :: entry)

