-- ============================================================
-- src/main/ridgun/lib/x86_64.rg
-- Pure-Ridgun Native x86_64 Machine-Code Assembler & ELF64 Emitter
-- @implements FR-COMP-004
-- @implements FR-COMP-007
-- ============================================================

import elf64

-- ── Low-Level x86_64 Instruction Encoders ────────────────────

fn :: x86_mov_imm64_rax Int => [Int]
      x86_mov_imm64_rax val =  [72, 184] :: (u64_le val)

fn :: x86_mov_imm64_rdi Int => [Int]
      x86_mov_imm64_rdi val =  [72, 191] :: (u64_le val)

fn :: x86_mov_imm64_rsi Int => [Int]
      x86_mov_imm64_rsi val =  [72, 190] :: (u64_le val)

fn :: x86_mov_imm64_rdx Int => [Int]
      x86_mov_imm64_rdx val =  [72, 186] :: (u64_le val)

fn :: x86_mov_imm64_rcx Int => [Int]
      x86_mov_imm64_rcx val =  [72, 185] :: (u64_le val)

fn :: x86_mov_imm64_r8 Int => [Int]
      x86_mov_imm64_r8 val =  [73, 184] :: (u64_le val)

fn :: x86_mov_slot_rdi Int  => [Int]
      x86_mov_slot_rdi slot =  [72, 139, 188, 36] :: (i32_le (slot * 8))

fn :: x86_lea_slot_rdi Int  => [Int]
      x86_lea_slot_rdi slot =  [72, 141, 188, 36] :: (i32_le (slot * 8))

fn :: x86_lea_slot_rsi Int  => [Int]
      x86_lea_slot_rsi slot =  [72, 141, 180, 36] :: (i32_le (slot * 8))

fn :: x86_lea_slot_rdx Int  => [Int]
      x86_lea_slot_rdx slot =  [72, 141, 148, 36] :: (i32_le (slot * 8))

fn :: x86_call_rel Int          Int        => [Int]
      x86_call_rel target_vaddr next_vaddr =  [232] :: (i32_le (target_vaddr - next_vaddr))

fn :: x86_call_rt Int   Int        => [Int]
      x86_call_rt rt_id next_vaddr =  x86_call_rel (4198400 + (rt_id * 8)) next_vaddr

fn :: x86_jmp_rel Int          Int        => [Int]
      x86_jmp_rel target_vaddr next_vaddr =  [233] :: (i32_le (target_vaddr - next_vaddr))

-- ── Fixed-Width Instruction Size Table (Pass 1) ──────────────

fn :: x86_64_instr_size RNativeInstr       => Int
      x86_64_instr_size (NLabel _)         =  0
      x86_64_instr_size (NJump _)          =  5
      x86_64_instr_size (NJumpIfZero _)    =  9
      x86_64_instr_size (NJumpIfNonZero _) =  9
      x86_64_instr_size (NLoadImmInt _)    =  10
      x86_64_instr_size (NLoadImmRaw _)    =  10
      x86_64_instr_size (NLoadRealLit _ _) =  25
      x86_64_instr_size (NLoadStrLit _ _)  =  25
      x86_64_instr_size (NLoadAdt0 _ _)    =  25
      x86_64_instr_size (NCloneSlot _)     =  13
      x86_64_instr_size (NMoveSlot _)      =  13
      x86_64_instr_size (NStoreSlot _)     =  16
      x86_64_instr_size (NRebindSlot _)    =  16
      x86_64_instr_size (NCmmDropSlot _)   =  13
      x86_64_instr_size NDropVal           =  8
      x86_64_instr_size (NClearLocals _ _) =  28
      x86_64_instr_size (NMatchInt _ _)    =  23
      x86_64_instr_size (NMatchReal _ _ _) =  33
      x86_64_instr_size (NMatchStr _ _ _)  =  33
      x86_64_instr_size (NMatchBool _ _)   =  23
      x86_64_instr_size (NMatchEmpty _)    =  13
      x86_64_instr_size (NMatchNonEmpty _) =  13
      x86_64_instr_size (NMatchTuple _ _)  =  23
      x86_64_instr_size (NMatchAdt _ _ _ -1) = 13
      x86_64_instr_size (NMatchAdt _ _ _ -2) = 21
      x86_64_instr_size (NMatchAdt _ _ _ -3) = 28
      x86_64_instr_size (NMatchAdt _ _ _ -4) = 28
      x86_64_instr_size (NMatchAdt _ _ _ _) = 43
      x86_64_instr_size (NListHead _)      =  13
      x86_64_instr_size (NListTail _)      =  13
      x86_64_instr_size (NTupleGet _ _)    =  23
      x86_64_instr_size (NAdtField _ _)    =  23
      x86_64_instr_size (NPackSeq _)       =  18
      x86_64_instr_size NAsBool            =  8
      x86_64_instr_size NNot               =  8
      x86_64_instr_size NOut               =  8
      x86_64_instr_size (NBinOp _ _)       =  26
      x86_64_instr_size (NAdtSet _ _)      =  26
      x86_64_instr_size (NMakeList _ _)    =  23
      x86_64_instr_size (NMakeTuple _ _)   =  23
      x86_64_instr_size (NMakeTensor _ _)  =  23
      x86_64_instr_size (NMakeAdt _ _ _ _) =  43
      x86_64_instr_size (NEcho _ _)        =  23
      x86_64_instr_size (NStrInterp _ _)   =  23
      x86_64_instr_size (NIndex _ _ _)     =  31
      x86_64_instr_size (NIndexSet _ _ _)  =  34
      x86_64_instr_size (NSeqSelect _ _)   =  28
      x86_64_instr_size (NEinsum _ _ _ _)  =  43
      x86_64_instr_size (NHadamard _ _ _ _) = 46
      x86_64_instr_size (NPushCtx _ _)     =  28
      x86_64_instr_size (NPopCtx _ _)      =  28
      x86_64_instr_size (NHasCtx _ _)      =  25
      x86_64_instr_size (NGetCtx _ _)      =  25
      x86_64_instr_size NEnterRegion       =  5
      x86_64_instr_size (NExitRegion _)    =  18
      x86_64_instr_size (NHasShared _ _)   =  25
      x86_64_instr_size (NGetShared _ _)   =  25
      x86_64_instr_size (NInitShared _ _)  =  28
      x86_64_instr_size (NStoreShared _ _) =  28
      x86_64_instr_size (NCallFn _ _ _)    =  13
      x86_64_instr_size (NCallBuiltin _ _ _) = 33
      x86_64_instr_size (NCallIndirect1 _ _) = 21
      x86_64_instr_size (NCallIndirect2 _ _) = 21
      x86_64_instr_size (NTailCall _ _)    =  43
      x86_64_instr_size NReturn            =  30

fn :: x86_64_scan_instrs [RNativeInstr] Int     [RLabelEntry] => RScanResult
      x86_64_scan_instrs []             cur_off labels        =  ScanResult cur_off labels
      x86_64_scan_instrs ((NLabel lid):rest) cur_off labels   =
        x86_64_scan_instrs rest cur_off (labels :: [LabelEntry lid cur_off])
      x86_64_scan_instrs (ins:rest)     cur_off labels        =
        sz = x86_64_instr_size ins
        x86_64_scan_instrs rest (cur_off + sz) labels

fn :: x86_64_scan_fns [RNativeFn] Int       [RLabelEntry] => RScanResult
      x86_64_scan_fns []          cur_vaddr fn_table      =  ScanResult cur_vaddr fn_table
      x86_64_scan_fns ((NativeFn fid _ _ _ instrs):rest) cur_vaddr fn_table =
        sr = x86_64_scan_instrs instrs (cur_vaddr + 42) []
        end_vaddr = scan_offset sr
        x86_64_scan_fns rest end_vaddr (fn_table :: [LabelEntry fid cur_vaddr])

-- ── Instruction Machine-Code Encoder (Pass 2) ────────────────

fn :: x86_64_frame_size Int       => Int
      x86_64_frame_size num_slots =  (((num_slots + 1) / 2) * 16)

fn :: x86_64_prologue Int      Int   Int       => [Int]
      x86_64_prologue fn_vaddr arity num_slots =
        fsz = x86_64_frame_size num_slots
        [85, 72, 137, 229, 72, 129, 236] :: (i32_le fsz) :: [72, 137, 254, 72, 137, 231] :: (x86_mov_imm64_rdx arity) :: (x86_mov_imm64_rcx num_slots) :: (x86_call_rt 1 (fn_vaddr + 42))

fn :: x86_64_encode_instr RNativeInstr Int Int Int Int [RLabelEntry] [RLabelEntry] => [Int]
      x86_64_encode_instr (NLabel _) _ _ _ _ _ _ = []
      x86_64_encode_instr (NJump lid) cur_vaddr _ _ _ lbl_table _ =
        target = lookup_label_offset lbl_table lid
        x86_jmp_rel target (cur_vaddr + 5)
      x86_64_encode_instr (NJumpIfZero lid) cur_vaddr _ _ _ lbl_table _ =
        target = lookup_label_offset lbl_table lid
        [72, 133, 192, 15, 132] :: (i32_le (target - (cur_vaddr + 9)))
      x86_64_encode_instr (NJumpIfNonZero lid) cur_vaddr _ _ _ lbl_table _ =
        target = lookup_label_offset lbl_table lid
        [72, 133, 192, 15, 133] :: (i32_le (target - (cur_vaddr + 9)))
      x86_64_encode_instr (NLoadImmInt n) _ _ _ _ _ _ =
        x86_mov_imm64_rax ((n * 2) + 1)
      x86_64_encode_instr (NLoadImmRaw raw) _ _ _ _ _ _ =
        x86_mov_imm64_rax raw
      x86_64_encode_instr (NLoadRealLit off len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + off)) :: (x86_mov_imm64_rsi len) :: (x86_call_rt 11 (cur_vaddr + 25))
      x86_64_encode_instr (NLoadStrLit off len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + off)) :: (x86_mov_imm64_rsi len) :: (x86_call_rt 12 (cur_vaddr + 25))
      x86_64_encode_instr (NLoadAdt0 -1 0) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + 22)) :: (x86_mov_imm64_rsi 6) :: (x86_call_rt 13 (cur_vaddr + 25))
      x86_64_encode_instr (NLoadAdt0 off len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + off)) :: (x86_mov_imm64_rsi len) :: (x86_call_rt 13 (cur_vaddr + 25))
      x86_64_encode_instr (NCloneSlot slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_call_rt 5 (cur_vaddr + 13))
      x86_64_encode_instr (NMoveSlot slot) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi slot) :: (x86_call_rt 7 (cur_vaddr + 13))
      x86_64_encode_instr (NStoreSlot slot) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi slot) :: [72, 137, 198] :: (x86_call_rt 8 (cur_vaddr + 16))
      x86_64_encode_instr (NRebindSlot slot) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi slot) :: [72, 137, 198] :: (x86_call_rt 9 (cur_vaddr + 16))
      x86_64_encode_instr (NCmmDropSlot slot) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi slot) :: (x86_call_rt 10 (cur_vaddr + 13))
      x86_64_encode_instr NDropVal cur_vaddr _ _ _ _ _ =
        [72, 137, 199] :: (x86_call_rt 6 (cur_vaddr + 8))
      x86_64_encode_instr (NClearLocals start_slot end_slot) cur_vaddr _ _ _ _ _ =
        [72, 137, 231] :: (x86_mov_imm64_rsi start_slot) :: (x86_mov_imm64_rdx end_slot) :: (x86_call_rt 4 (cur_vaddr + 28))
      x86_64_encode_instr (NMatchInt slot n) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi n) :: (x86_call_rt 21 (cur_vaddr + 23))
      x86_64_encode_instr (NMatchReal slot off len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi (rodata_vaddr + off)) :: (x86_mov_imm64_rdx len) :: (x86_call_rt 22 (cur_vaddr + 33))
      x86_64_encode_instr (NMatchStr slot off len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi (rodata_vaddr + off)) :: (x86_mov_imm64_rdx len) :: (x86_call_rt 23 (cur_vaddr + 33))
      x86_64_encode_instr (NMatchBool slot b_int) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi b_int) :: (x86_call_rt 24 (cur_vaddr + 23))
      x86_64_encode_instr (NMatchEmpty slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_call_rt 25 (cur_vaddr + 13))
      x86_64_encode_instr (NMatchNonEmpty slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_call_rt 26 (cur_vaddr + 13))
      x86_64_encode_instr (NMatchTuple slot arity) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi arity) :: (x86_call_rt 29 (cur_vaddr + 23))
      x86_64_encode_instr (NMatchAdt slot _ _ -1) _ _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: [137, 248, 131, 224, 1]
      x86_64_encode_instr (NMatchAdt slot _ _ -2) _ _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: [72, 131, 231, 251, 49, 192, 72, 131, 255, 2, 15, 148, 192]
      x86_64_encode_instr (NMatchAdt slot _ _ -3) _ _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: [49, 192, 72, 133, 255, 116, 13, 64, 246, 199, 7, 117, 7, 72, 131, 63, 1, 15, 148, 192]
      x86_64_encode_instr (NMatchAdt slot _ _ -4) _ _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: [49, 192, 72, 133, 255, 116, 13, 64, 246, 199, 7, 117, 7, 72, 131, 63, 0, 15, 148, 192]
      x86_64_encode_instr (NMatchAdt slot off len arity) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi (rodata_vaddr + off)) :: (x86_mov_imm64_rdx len) :: (x86_mov_imm64_rcx arity) :: (x86_call_rt 31 (cur_vaddr + 43))
      x86_64_encode_instr (NListHead slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_call_rt 27 (cur_vaddr + 13))
      x86_64_encode_instr (NListTail slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_call_rt 28 (cur_vaddr + 13))
      x86_64_encode_instr (NTupleGet slot idx) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi idx) :: (x86_call_rt 30 (cur_vaddr + 23))
      x86_64_encode_instr (NAdtField slot idx) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi slot) :: (x86_mov_imm64_rsi idx) :: (x86_call_rt 32 (cur_vaddr + 23))
      x86_64_encode_instr (NPackSeq arity) cur_vaddr _ _ _ _ _ =
        [72, 137, 231] :: (x86_mov_imm64_rsi arity) :: (x86_call_rt 19 (cur_vaddr + 18))
      x86_64_encode_instr NAsBool cur_vaddr _ _ _ _ _ =
        [72, 137, 199] :: (x86_call_rt 20 (cur_vaddr + 8))
      x86_64_encode_instr NNot cur_vaddr _ _ _ _ _ =
        [72, 137, 199] :: (x86_call_rt 34 (cur_vaddr + 8))
      x86_64_encode_instr NOut cur_vaddr _ _ _ _ _ =
        [72, 137, 199] :: (x86_call_rt 35 (cur_vaddr + 8))
      x86_64_encode_instr (NBinOp op_id lhs_slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_imm64_rdi op_id) :: (x86_lea_slot_rsi lhs_slot) :: [72, 137, 194] :: (x86_call_rt 37 (cur_vaddr + 26))
      x86_64_encode_instr (NAdtSet rec_slot idx) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi rec_slot) :: (x86_mov_imm64_rsi idx) :: [72, 137, 194] :: (x86_call_rt 33 (cur_vaddr + 26))
      x86_64_encode_instr (NMakeList start_slot count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_call_rt 15 (cur_vaddr + 23))
      x86_64_encode_instr (NMakeTuple start_slot count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_call_rt 16 (cur_vaddr + 23))
      x86_64_encode_instr (NMakeTensor start_slot count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_call_rt 17 (cur_vaddr + 23))
      x86_64_encode_instr (NMakeAdt off len start_slot count) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + off)) :: (x86_mov_imm64_rsi len) :: (x86_lea_slot_rdx start_slot) :: (x86_mov_imm64_rcx count) :: (x86_call_rt 14 (cur_vaddr + 43))
      x86_64_encode_instr (NEcho start_slot count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_call_rt 36 (cur_vaddr + 23))
      x86_64_encode_instr (NStrInterp start_slot count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_call_rt 18 (cur_vaddr + 23))
      x86_64_encode_instr (NIndex base_slot idx_start count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi base_slot) :: (x86_lea_slot_rsi idx_start) :: (x86_mov_imm64_rdx count) :: (x86_call_rt 38 (cur_vaddr + 31))
      x86_64_encode_instr (NIndexSet base_slot idx_start count) cur_vaddr _ _ _ _ _ =
        (x86_lea_slot_rdi base_slot) :: (x86_lea_slot_rsi idx_start) :: (x86_mov_imm64_rdx count) :: [72, 137, 193] :: (x86_call_rt 39 (cur_vaddr + 34))
      x86_64_encode_instr (NSeqSelect mask_off mask_len) cur_vaddr _ _ rodata_vaddr _ _ =
        [72, 137, 199] :: (x86_mov_imm64_rsi (rodata_vaddr + mask_off)) :: (x86_mov_imm64_rdx mask_len) :: (x86_call_rt 40 (cur_vaddr + 28))
      x86_64_encode_instr (NEinsum start_slot count spec_off spec_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_lea_slot_rdi start_slot) :: (x86_mov_imm64_rsi count) :: (x86_mov_imm64_rdx (rodata_vaddr + spec_off)) :: (x86_mov_imm64_rcx spec_len) :: (x86_call_rt 41 (cur_vaddr + 43))
      x86_64_encode_instr (NHadamard op_id lhs_slot subs_off subs_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi op_id) :: (x86_lea_slot_rsi lhs_slot) :: [72, 137, 194] :: (x86_mov_imm64_rcx (rodata_vaddr + subs_off)) :: (x86_mov_imm64_r8 subs_len) :: (x86_call_rt 42 (cur_vaddr + 46))
      x86_64_encode_instr (NPushCtx key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: [72, 137, 194] :: (x86_call_rt 43 (cur_vaddr + 28))
      x86_64_encode_instr (NPopCtx key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: [72, 137, 194] :: (x86_call_rt 44 (cur_vaddr + 28))
      x86_64_encode_instr (NHasCtx key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: (x86_call_rt 45 (cur_vaddr + 25))
      x86_64_encode_instr (NGetCtx key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: (x86_call_rt 46 (cur_vaddr + 25))
      x86_64_encode_instr NEnterRegion cur_vaddr _ _ _ _ _ =
        x86_call_rt 47 (cur_vaddr + 5)
      x86_64_encode_instr (NExitRegion quota) cur_vaddr _ _ _ _ _ =
        (x86_mov_imm64_rdi quota) :: [72, 137, 198] :: (x86_call_rt 48 (cur_vaddr + 18))
      x86_64_encode_instr (NHasShared key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: (x86_call_rt 49 (cur_vaddr + 25))
      x86_64_encode_instr (NGetShared key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: (x86_call_rt 50 (cur_vaddr + 25))
      x86_64_encode_instr (NInitShared key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: [72, 137, 194] :: (x86_call_rt 51 (cur_vaddr + 28))
      x86_64_encode_instr (NStoreShared key_off key_len) cur_vaddr _ _ rodata_vaddr _ _ =
        (x86_mov_imm64_rdi (rodata_vaddr + key_off)) :: (x86_mov_imm64_rsi key_len) :: [72, 137, 194] :: (x86_call_rt 52 (cur_vaddr + 28))
      x86_64_encode_instr (NCallFn fid start_slot _) cur_vaddr _ _ _ _ fn_table =
        target_fn = lookup_label_offset fn_table fid
        (x86_lea_slot_rdi start_slot) :: (x86_call_rel target_fn (cur_vaddr + 13))
      x86_64_encode_instr (NCallBuiltin b_id start_slot count) cur_vaddr _ _ _ _ _
        | b_id >= 70 =
          (x86_mov_imm64_rdi b_id) :: (x86_lea_slot_rsi start_slot) :: (x86_mov_imm64_rdx count) :: (x86_call_rel 4286080 (cur_vaddr + 33))
        | otherwise =
          (x86_mov_imm64_rdi b_id) :: (x86_lea_slot_rsi start_slot) :: (x86_mov_imm64_rdx count) :: (x86_call_rt 55 (cur_vaddr + 33))
      x86_64_encode_instr (NCallIndirect1 fn_slot arg_slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi fn_slot) :: (x86_lea_slot_rsi arg_slot) :: (x86_call_rt 53 (cur_vaddr + 21))
      x86_64_encode_instr (NCallIndirect2 fn_slot start_slot) cur_vaddr _ _ _ _ _ =
        (x86_mov_slot_rdi fn_slot) :: (x86_lea_slot_rsi start_slot) :: (x86_call_rt 54 (cur_vaddr + 21))
      x86_64_encode_instr (NTailCall start_slot arity) cur_vaddr fn_vaddr num_slots _ _ _ =
        [72, 137, 231] :: (x86_mov_imm64_rsi start_slot) :: (x86_mov_imm64_rdx arity) :: (x86_mov_imm64_rcx num_slots) :: (x86_call_rt 3 (cur_vaddr + 38)) :: (x86_jmp_rel (fn_vaddr + 42) (cur_vaddr + 43))
      x86_64_encode_instr NReturn cur_vaddr _ num_slots _ _ _ =
        fsz = x86_64_frame_size num_slots
        [72, 137, 231] :: (x86_mov_imm64_rsi num_slots) :: [72, 137, 194] :: (x86_call_rt 2 (cur_vaddr + 21)) :: [72, 129, 196] :: (i32_le fsz) :: [93, 195]

fn :: x86_64_encode_instrs [RNativeInstr] Int Int Int Int [RLabelEntry] [RLabelEntry] [Int] => [Int]
      x86_64_encode_instrs [] _ _ _ _ _ _ acc = acc
      x86_64_encode_instrs (ins:rest) cur_vaddr fn_vaddr num_slots rodata_vaddr lbl_table fn_table acc =
        sz = x86_64_instr_size ins
        bytes = x86_64_encode_instr ins cur_vaddr fn_vaddr num_slots rodata_vaddr lbl_table fn_table
        x86_64_encode_instrs rest (cur_vaddr + sz) fn_vaddr num_slots rodata_vaddr lbl_table fn_table (acc :: bytes)

fn :: x86_64_encode_fns [RNativeFn] Int          [RLabelEntry] [Int] => [Int]
      x86_64_encode_fns []          _            _             acc   =  acc
      x86_64_encode_fns ((NativeFn fid _ arity num_slots instrs):rest) rodata_vaddr fn_table acc =
        fn_vaddr = lookup_label_offset fn_table fid
        sr = x86_64_scan_instrs instrs (fn_vaddr + 42) []
        lbl_table = scan_labels sr
        pro = x86_64_prologue fn_vaddr arity num_slots
        fn_bytes = x86_64_encode_instrs instrs (fn_vaddr + 42) fn_vaddr num_slots rodata_vaddr lbl_table fn_table pro
        x86_64_encode_fns rest rodata_vaddr fn_table (acc :: fn_bytes)

-- ── Freestanding Linux x86_64 Syscall Runtime Kernel (Region 1) ──

fn :: rt_x86_64_kernel_hex => String
      rt_x86_64_kernel_hex =  ''

fn :: rt_x86_64_pal_hex => String
      rt_x86_64_pal_hex =  ''

-- ── Public x86_64 ELF64 Image Builder ────────────────────────

fn :: emit_x86_64_elf_type Int    RNativeProg => [Int]
      emit_x86_64_elf_type e_type (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) =
        rt_hex = (rt_x86_64_kernel_hex) + (rt_x86_64_pal_hex)
        rt_len = (str_len rt_hex) / 2
        rt_bytes = hex_to_bytes rt_hex
        region2_vaddr = 4198400 + rt_len
        sr = x86_64_scan_fns fns region2_vaddr []
        rodata_vaddr = scan_offset sr
        fn_table = scan_labels sr
        code_len = rodata_vaddr - region2_vaddr
        code_bytes = x86_64_encode_fns fns rodata_vaddr fn_table []
        main_vaddr = lookup_label_offset fn_table main_fid
        spawn_vaddr = lookup_label_offset fn_table spawn_fid
        call2_vaddr = lookup_label_offset fn_table call2_fid
        binop_vaddr = lookup_label_offset fn_table binop_fid
        build_elf64_image_type e_type 62 main_vaddr spawn_vaddr call2_vaddr binop_vaddr rt_bytes rt_len code_bytes code_len rodata_str

fn :: emit_x86_64_elf RNativeProg => [Int]
      emit_x86_64_elf nprog       =  emit_x86_64_elf_type 2 nprog

fn :: emit_x86_64_shared_elf RNativeProg => [Int]
      emit_x86_64_shared_elf nprog       =  emit_x86_64_elf_type 3 nprog
