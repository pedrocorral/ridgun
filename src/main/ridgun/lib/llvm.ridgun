-- ============================================================
-- src/main/ridgun/lib/llvm.ridgun
-- Pure-Ridgun LLVM IR (.ll) Code Generator & Native Linker Driver
-- @implements FR-COMP-004
-- @implements FR-COMP-006
-- @implements FR-COMP-007
-- @implements FR-COMP-009
