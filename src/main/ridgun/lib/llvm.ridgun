import elf64
import x86_64
import x86rt
import llvminl
import timing

-- ── Tree-Based O(N log N) String Concatenation ──────────────

fn :: join str pairs [String] [String] => [String]
      join str pairs [] acc = list reverse acc
      join str pairs (a:[]) acc = list reverse ([a] :: acc)
      join str pairs (a:b:rest) acc = join str pairs rest ([a + b] :: acc)

fn :: join str tree [String] => String
      join str tree []       =  ""
      join str tree (s:[])   =  s
      join str tree xs       =  join str tree (join str pairs xs [])

-- ── Rodata String Escaping for LLVM IR Constant ─────────────

fn :: llvm hex digit Int => String
      llvm hex digit 0   =  "0"
      llvm hex digit 1   =  "1"
      llvm hex digit 2   =  "2"
      llvm hex digit 3   =  "3"
      llvm hex digit 4   =  "4"
      llvm hex digit 5   =  "5"
      llvm hex digit 6   =  "6"
      llvm hex digit 7   =  "7"
      llvm hex digit 8   =  "8"
      llvm hex digit 9   =  "9"
      llvm hex digit 10  =  "A"
      llvm hex digit 11  =  "B"
      llvm hex digit 12  =  "C"
      llvm hex digit 13  =  "D"
      llvm hex digit 14  =  "E"
      llvm hex digit _   =  "F"

fn :: llvm escape byte Int => String
      llvm escape byte b
        | b >= 32 and b <= 126 and b != 34 and b != 92 and b != 123 and b != 125 = char from code b
        | otherwise =
          u = (b + 256) % 256
          "\\" + (llvm hex digit (u / 16)) + (llvm hex digit (u % 16))

fn :: llvm escape chunk String Int Int String => String
      llvm escape chunk s pos end acc
        | pos >= end = acc
        | otherwise =
          ch = llvm escape byte (str char at s pos)
          llvm escape chunk s (pos + 1) end (acc + ch)

fn :: llvm escape range String Int Int => String
      llvm escape range s start end
        | start >= end = ""
        | (end - start) <= 16 = llvm escape chunk s start end ""
        | otherwise =
          mid = start + ((end - start) / 2)
          (llvm escape range s start mid) + (llvm escape range s mid end)

fn :: llvm escape rodata String => String
      llvm escape rodata ""     =  "\\00"
      llvm escape rodata s      =  llvm escape range s 0 (str len s)

fn :: llvm rodata len String => Int
      llvm rodata len ""     =  1
      llvm rodata len s      =  str len s

-- ── Runtime Declarations & Pure LLVM IR Runtime Helpers ──────

-- ── RNativeInstr => LLVM IR Instruction Emitter ─────────────

fn :: llvm bool tag Int => Int
      llvm bool tag 0   =  2
      llvm bool tag _   =  6

fn :: llvm reg param list Int Int [String] => String
      llvm reg param list cur arity acc
        | cur >= arity = str join acc ", "
        | otherwise =
          llvm reg param list (cur + 1) arity (acc :: ["i64 %arg_{cur}"])

fn :: llvm unroll clear locals Int Int Int [String] => String
      llvm unroll clear locals cur end_slot step acc
        | cur >= end_slot = join str tree acc
        | otherwise =
          line = "  %clp_{step}_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  %clv_{step}_{cur} = load i64, ptr %clp_{step}_{cur}, align 8\n  store i64 0, ptr %clp_{step}_{cur}, align 8\n  %cld_{step}_{cur} = call i64 @__rg_fast_drop_val(i64 %clv_{step}_{cur})\n"
          llvm unroll clear locals (cur + 1) end_slot step (acc :: [line])

fn :: llvm unroll init frame Int Int Int [String] => String
      llvm unroll init frame cur arity num_slots acc
        | cur >= num_slots = join str tree acc
        | cur < arity =
          line = "  %ap_{cur} = getelementptr inbounds i64, ptr %args, i64 {cur}\n  %av_{cur} = load i64, ptr %ap_{cur}, align 8\n  store i64 0, ptr %ap_{cur}, align 8\n  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 %av_{cur}, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame (cur + 1) arity num_slots (acc :: [line])
        | otherwise =
          line = "  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 0, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame (cur + 1) arity num_slots (acc :: [line])

fn :: llvm unroll init frame reg Int Int Int [String] => String
      llvm unroll init frame reg cur arity num_slots acc
        | cur >= num_slots = join str tree acc
        | cur < arity =
          line = "  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 %arg_{cur}, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame reg (cur + 1) arity num_slots (acc :: [line])
        | otherwise =
          line = "  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 0, ptr %fp_{cur}, align 8\n"
          llvm unroll init frame reg (cur + 1) arity num_slots (acc :: [line])

fn :: llvm store reg args Int Int [String] => String
      llvm store reg args cur arity acc
        | cur >= arity = join str tree acc
        | otherwise =
          line = "  %fp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 %arg_{cur}, ptr %fp_{cur}, align 8\n"
          llvm store reg args (cur + 1) arity (acc :: [line])

fn :: llvm load wrapper args Int Int [String] => String
      llvm load wrapper args cur arity acc
        | cur >= arity = join str tree acc
        | otherwise =
          line = "  %ap_{cur} = getelementptr inbounds i64, ptr %args, i64 {cur}\n  %av_{cur} = load i64, ptr %ap_{cur}, align 8\n  store i64 0, ptr %ap_{cur}, align 8\n"
          llvm load wrapper args (cur + 1) arity (acc :: [line])

fn :: llvm wrapper arg list Int Int [String] => String
      llvm wrapper arg list cur arity acc
        | cur >= arity = str join acc ", "
        | otherwise =
          llvm wrapper arg list (cur + 1) arity (acc :: ["i64 %av_{cur}"])

fn :: llvm load call args Int Int Int Int [String] => String
      llvm load call args start_slot idx count step acc
        | idx >= count = join str tree acc
        | otherwise =
          slot = start_slot + idx
          line = "  %cap_{step}_{idx} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %cav_{step}_{idx} = load i64, ptr %cap_{step}_{idx}, align 8\n  store i64 0, ptr %cap_{step}_{idx}, align 8\n"
          llvm load call args start_slot (idx + 1) count step (acc :: [line])

fn :: llvm call arg list Int Int Int [String] => String
      llvm call arg list idx count step acc
        | idx >= count = str join acc ", "
        | otherwise =
          llvm call arg list (idx + 1) count step (acc :: ["i64 %cav_{step}_{idx}"])

fn :: llvm unroll epilogue Int Int [String] => String
      llvm unroll epilogue cur num_slots acc
        | cur >= num_slots = join str tree acc
        | otherwise =
          line = "  %epp_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  %epv_{cur} = load i64, ptr %epp_{cur}, align 8\n  store i64 0, ptr %epp_{cur}, align 8\n  %epd_{cur} = call i64 @__rg_fast_drop_val(i64 %epv_{cur})\n"
          llvm unroll epilogue (cur + 1) num_slots (acc :: [line])

-- Inline form of the runtime tail-call copy: move the new arguments out of
-- their slots, drop every slot of the frame, then store the arguments in
-- slots 0..arity-1. Same order of effects as __rg_rt_tco_copy.
fn :: llvm unroll tco copy Int Int Int Int => String
      llvm unroll tco copy start arity num_slots step =
        takes = llvm tco take args start 0 arity step []
        drops = llvm tco drop slots 0 num_slots step []
        puts = llvm tco put args 0 arity step []
        takes + drops + puts

fn :: llvm tco take args Int Int Int Int [String] => String
      llvm tco take args start cur arity step acc
        | cur >= arity = join str tree acc
        | otherwise =
          slot = start + cur
          line = "  %tcp_{step}_{cur} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %tcv_{step}_{cur} = load i64, ptr %tcp_{step}_{cur}, align 8\n  store i64 0, ptr %tcp_{step}_{cur}, align 8\n"
          llvm tco take args start (cur + 1) arity step (acc :: [line])

fn :: llvm tco drop slots Int Int Int [String] => String
      llvm tco drop slots cur num_slots step acc
        | cur >= num_slots = join str tree acc
        | otherwise =
          line = "  %tdp_{step}_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  %tdv_{step}_{cur} = load i64, ptr %tdp_{step}_{cur}, align 8\n  store i64 0, ptr %tdp_{step}_{cur}, align 8\n  %tdd_{step}_{cur} = call i64 @__rg_fast_drop_val(i64 %tdv_{step}_{cur})\n"
          llvm tco drop slots (cur + 1) num_slots step (acc :: [line])

fn :: llvm tco put args Int Int Int [String] => String
      llvm tco put args cur arity step acc
        | cur >= arity = join str tree acc
        | otherwise =
          line = "  %tsp_{step}_{cur} = getelementptr inbounds i64, ptr %frame, i64 {cur}\n  store i64 %tcv_{step}_{cur}, ptr %tsp_{step}_{cur}, align 8\n"
          llvm tco put args (cur + 1) arity step (acc :: [line])

-- OPT-019: before a tail call to another function, drop every slot of the
-- frame (the arguments were already moved out), as the epilogue would.
fn :: llvm tail teardown Int Int => String
      llvm tail teardown num_slots step
        | num_slots <= 24 = llvm tco drop slots 0 num_slots step []
        | otherwise = "  %te_{step} = call i64 @__rg_rt_epilogue(ptr %frame, i64 {num_slots}, i64 0)\n"

fn :: llvm instr is tco RNativeInstr => Bool
      llvm instr is tco (NTailCall _ _) = True
      llvm instr is tco _               = False

fn :: llvm fn has tco [RNativeInstr] => Bool
      llvm fn has tco [] = False
      llvm fn has tco (ins:rest)
        | llvm instr is tco ins = True
        | otherwise = llvm fn has tco rest

fn :: emit llvm instr RNativeInstr Int Int Int => String
      emit llvm instr (NLabel lid) _ _ _ =
        "  br label %L_{lid}\nL_{lid}:\n"
      emit llvm instr (NJump lid) step _ _ =
        "  br label %L_{lid}\ndead_{step}:\n"
      emit llvm instr (NJumpIfZero lid) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %c_{step} = icmp eq i64 %a_{step}, 0\n  br i1 %c_{step}, label %L_{lid}, label %next_{step}\nnext_{step}:\n"
      emit llvm instr (NJumpIfNonZero lid) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %c_{step} = icmp ne i64 %a_{step}, 0\n  br i1 %c_{step}, label %L_{lid}, label %next_{step}\nnext_{step}:\n"
      emit llvm instr (NLoadImmInt n) _ _ _ =
        tagged = (n * 2) + 1
        "  store i64 {tagged}, ptr %acc, align 8\n"
      emit llvm instr (NLoadImmRaw raw) _ _ _ =
        "  store i64 {raw}, ptr %acc, align 8\n"
      emit llvm instr (NLoadRealLit off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_real_lit(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadStrLit off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_str_lit(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadAdt0 -2 0) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 5\n  %r_{step} = call i64 @__rg_rt_load_adt0(ptr %p_{step}, i64 5)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadAdt0 -1 0) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 22\n  %r_{step} = call i64 @__rg_rt_load_adt0(ptr %p_{step}, i64 6)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NLoadAdt0 off len) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_load_adt0(ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCloneSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_fast_clone_slot(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NPeekSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  store i64 %v_{step}, ptr %acc, align 8\n"
      emit llvm instr (NForgetSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  store i64 0, ptr %s_{step}, align 8\n"
      emit llvm instr (NMoveSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  store i64 %v_{step}, ptr %acc, align 8\n"
      emit llvm instr (NStoreSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_store_slot(ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NRebindSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_rebind_slot(ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCmmDropSlot slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %r_{step} = call i64 @__rg_fast_cmm_drop_slot(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NDropVal step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_drop_val(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NClearLocals start_slot end_slot) step _ _
        | end_slot <= start_slot = ""
        | (end_slot - start_slot) <= 24 = llvm unroll clear locals start_slot end_slot step []
        | otherwise =
          "  call void @__rg_rt_clear_locals(ptr %frame, i64 {start_slot}, i64 {end_slot})\n"
      emit llvm instr (NMatchInt slot n) step _ _ =
        tagged = (n * 2) + 1
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %c_{step} = icmp eq i64 %v_{step}, {tagged}\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchReal slot off len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_match_real(i64 %v_{step}, ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchStr slot off len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_rt_match_str(i64 %v_{step}, ptr %p_{step}, i64 {len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchBool slot b_int) step _ _ =
        btag = llvm bool tag b_int
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %c_{step} = icmp eq i64 %v_{step}, {btag}\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchEmpty slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_empty(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchNonEmpty slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_nonempty(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchTuple slot arity) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_match_tuple(i64 %v_{step}, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -1) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = and i64 %v_{step}, 1\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -2) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %m_{step} = and i64 %v_{step}, -5\n  %c_{step} = icmp eq i64 %m_{step}, 2\n  %r_{step} = zext i1 %c_{step} to i64\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -3) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 1)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -4) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 0)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot _ _ -5) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_match_heap_tag(i64 %v_{step}, i32 5)\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMatchAdt slot off len arity) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %r_{step} = call i64 @__rg_match_adt_fast(i64 %v_{step}, ptr %p_{step}, i64 {len}, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListHead slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_list_head(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListTail slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_list_tail(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NTupleGet slot idx) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_rt_tuple_get(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NAdtField slot idx) step _ _
        | idx < 0 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_adt_field_neg(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_adt_field_fast(i64 %v_{step}, i64 {idx})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NPackSeq arity) step _ _ =
        "  %r_{step} = call i64 @__rg_rt_pack_seq(ptr %frame, i64 {arity})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NRealToBits step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_real_to_int_bits(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NRealFromBits step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_real_from_bits(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NGtConv slot mode) step _ _ =
        fname = llvm gt conv fn mode
        extra = llvm gt conv extra mode
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 {fname}{step}{extra})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIsList slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_is_list(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIsGen slot) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_is_gen(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NSortBy slot mode) step _ _ =
        k_slot = slot + 1
        "  %xs_{step} = getelementptr inbounds i64, ptr %frame, i64 {slot}\n  %xv_{step} = load i64, ptr %xs_{step}, align 8\n  %ks_{step} = getelementptr inbounds i64, ptr %frame, i64 {k_slot}\n  %kv_{step} = load i64, ptr %ks_{step}, align 8\n  %r_{step} = call i64 @__rg_sort_by(i64 %xv_{step}, i64 %kv_{step}, i64 {mode})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListGet base_slot idx_slot) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_slot}\n  %iv_{step} = load i64, ptr %is_{step}, align 8\n  %r_{step} = call i64 @__rg_list_get(i64 %bv_{step}, i64 %iv_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NListSet base_slot idx_slot) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_slot}\n  %iv_{step} = load i64, ptr %is_{step}, align 8\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_list_set(i64 %bv_{step}, i64 %iv_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NAsBool step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_as_bool(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NNot step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_not_op(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NOut step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_out(i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NBinOp op_id lhs_slot) step _ _
        | op_id == 14 or op_id == 15 or op_id == 16 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %lv_{step} = load i64, ptr %s_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_bin_op_u64_or_slow(i64 {op_id}, i64 %lv_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_fast_bin_op(i64 {op_id}, ptr %s_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NAdtSet rec_slot idx) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {rec_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_adt_set(ptr %s_{step}, i64 {idx}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeList _ 0) step _ _ =
        "  %r_{step} = call i64 @__rg_make_empty_list()\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeList start_slot 1) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %v_{step} = load i64, ptr %s_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  %r_{step} = call i64 @__rg_make_list_1(i64 %v_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeList start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_list(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeTuple start_slot 2) step _ _ =
        s1 = start_slot + 1
        "  %s0_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %v0_{step} = load i64, ptr %s0_{step}, align 8\n  store i64 0, ptr %s0_{step}, align 8\n  %s1_{step} = getelementptr inbounds i64, ptr %frame, i64 {s1}\n  %v1_{step} = load i64, ptr %s1_{step}, align 8\n  store i64 0, ptr %s1_{step}, align 8\n  %r_{step} = call i64 @__rg_make_tuple_2(i64 %v0_{step}, i64 %v1_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeTuple start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_tuple(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeTensor start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_tensor(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NMakeAdt off len start_slot count) step _ rodata_len =
        "  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {off}\n  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_make_adt(ptr %p_{step}, i64 {len}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NEcho start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_echo(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NStrInterp start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_str_interp(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start -1) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %r_{step} = call i64 @__rg_tensor_index_1d(i64 %bv_{step}, ptr %is_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start -2) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %r_{step} = call i64 @__rg_tensor_index_2d(i64 %bv_{step}, ptr %is_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndex base_slot idx_start count) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %bc_{step} = call i64 @__rg_tensor_bounds(i64 %bv_{step}, ptr %is_{step}, i64 {count})\n  %r_{step} = call i64 @__rg_rt_index(ptr %bs_{step}, ptr %is_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start 1) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_tensor_index_set_1d(ptr %bs_{step}, ptr %is_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start 2) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_tensor_index_set_2d(ptr %bs_{step}, ptr %is_{step}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NIndexSet base_slot idx_start count) step _ _ =
        "  %bs_{step} = getelementptr inbounds i64, ptr %frame, i64 {base_slot}\n  %is_{step} = getelementptr inbounds i64, ptr %frame, i64 {idx_start}\n  %a_{step} = load i64, ptr %acc, align 8\n  %ab_{step} = call i64 @__rg_real_to_int_bits(i64 %a_{step})\n  %bv_{step} = load i64, ptr %bs_{step}, align 8\n  %bc_{step} = call i64 @__rg_tensor_bounds(i64 %bv_{step}, ptr %is_{step}, i64 {count})\n  %r_{step} = call i64 @__rg_rt_index_set(ptr %bs_{step}, ptr %is_{step}, i64 {count}, i64 %ab_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NSeqSelect mask_off mask_len) step _ rodata_len =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {mask_off}\n  %r_{step} = call i64 @__rg_rt_seq_select(i64 %a_{step}, ptr %p_{step}, i64 {mask_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NEinsum start_slot count spec_off spec_len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {spec_off}\n  %r_{step} = call i64 @__rg_fast_einsum(ptr %s_{step}, i64 {count}, ptr %p_{step}, i64 {spec_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NEinsumReal start_slot count spec_off spec_len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {spec_off}\n  %r_{step} = call i64 @__rg_fast_einsum_real(ptr %s_{step}, i64 {count}, ptr %p_{step}, i64 {spec_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NHadamard op_id lhs_slot subs_off _) step _ _
        | op_id >= 1000 =
          kinds = op_id - 1000
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %r_{step} = call i64 @__rg_fuse_{subs_off}_{kinds}(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NHadamard op_id lhs_slot subs_off subs_len) step _ rodata_len =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {lhs_slot}\n  %a_{step} = load i64, ptr %acc, align 8\n  %p_{step} = getelementptr inbounds [{rodata_len} x i8], ptr @__rg_rodata, i64 0, i64 {subs_off}\n  %r_{step} = call i64 @__rg_rt_hadamard(i64 {op_id}, ptr %s_{step}, i64 %a_{step}, ptr %p_{step}, i64 {subs_len})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr NEnterRegion step _ _ =
        "  %r_{step} = call i64 @__rg_rt_enter_region()\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NExitRegion quota) step _ _ =
        "  %a_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_rt_exit_region(i64 {quota}, i64 %a_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallFn fid start_slot count) step _ _
        | fid >= 5 and count >= 0 and count <= 8 =
          load_ir = llvm load call args start_slot 0 count step []
          arg_list = llvm call arg list 0 count step []
          load_ir + "  %r_{step} = call tailcc i64 @__rg_fn_{fid}_reg(" + arg_list + ")\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_fn_{fid}(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      -- A builtin the runtime owns, marked (id + 10000) by `x86 mark ir fns`.
      emit llvm instr (NCallBuiltin b_id start_slot count) step _ _
        | b_id >= 10000 =
          rid = b_id - 10000
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_builtin(i64 {rid}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 36 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sha256_raw(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 10 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_str_len(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 40 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_str_char_at(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 86 _ _) step _ _ =
        "  %r_{step} = call i64 @__rg_builtin_sys_pipe()\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 87 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sys_waitpid(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 88 start_slot count) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_fill(ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 89 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_sha256_concat(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 90 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_bitop(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 91 s_slot _) step _ _ =
        "  %ss_{step} = getelementptr inbounds i64, ptr %frame, i64 {s_slot}\n  %sv_{step} = load i64, ptr %ss_{step}, align 8\n  %iv_{step} = load i64, ptr %acc, align 8\n  %r_{step} = call i64 @__rg_str_char_at_fast(i64 %sv_{step}, i64 %iv_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 92 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_row_slice(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 93 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_set_row(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 94 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_col_slice(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 95 start_slot _) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_builtin_tensor_set_col(ptr %s_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 105 start_slot 2) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %t_{step} = getelementptr inbounds i64, ptr %s_{step}, i64 1\n  %iv_{step} = load i64, ptr %s_{step}, align 8\n  %tv_{step} = load i64, ptr %t_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  store i64 0, ptr %t_{step}, align 8\n  %r_{step} = call i64 @__rg_u8_get1(i64 %tv_{step}, i64 %iv_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin 106 start_slot 3) step _ _ =
        "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %v_{step} = getelementptr inbounds i64, ptr %s_{step}, i64 1\n  %t_{step} = getelementptr inbounds i64, ptr %s_{step}, i64 2\n  %iv_{step} = load i64, ptr %s_{step}, align 8\n  %vv_{step} = load i64, ptr %v_{step}, align 8\n  %tv_{step} = load i64, ptr %t_{step}, align 8\n  store i64 0, ptr %s_{step}, align 8\n  store i64 0, ptr %v_{step}, align 8\n  store i64 0, ptr %t_{step}, align 8\n  call void @__rg_u8_set1(i64 %tv_{step}, i64 %iv_{step}, i64 %vv_{step})\n  store i64 0, ptr %acc, align 8\n"
      emit llvm instr (NCallBuiltin b_id start_slot count) step _ _
        | b_id >= 100 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_ext(i64 {b_id}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | b_id >= 70 =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_pal_dispatch(i64 {b_id}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
        | otherwise =
          "  %s_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_builtin(i64 {b_id}, ptr %s_{step}, i64 {count})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallIndirect1 fn_slot arg_slot) step _ _ =
        "  %fs_{step} = getelementptr inbounds i64, ptr %frame, i64 {fn_slot}\n  %fv_{step} = load i64, ptr %fs_{step}, align 8\n  %as_{step} = getelementptr inbounds i64, ptr %frame, i64 {arg_slot}\n  %r_{step} = call i64 @__rg_rt_call_indirect1(i64 %fv_{step}, ptr %as_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NCallIndirect2 fn_slot start_slot) step _ _ =
        "  %fs_{step} = getelementptr inbounds i64, ptr %frame, i64 {fn_slot}\n  %fv_{step} = load i64, ptr %fs_{step}, align 8\n  %as_{step} = getelementptr inbounds i64, ptr %frame, i64 {start_slot}\n  %r_{step} = call i64 @__rg_rt_call_indirect2(i64 %fv_{step}, ptr %as_{step})\n  store i64 %r_{step}, ptr %acc, align 8\n"
      emit llvm instr (NTailCall start_slot arity) step num_slots _
        | num_slots <= 24 and arity <= num_slots =
          llvm unroll tco copy start_slot arity num_slots step + "  br label %tco_entry\ndead_{step}:\n"
        | otherwise =
        "  call void @__rg_rt_tco_copy(ptr %frame, i64 {start_slot}, i64 {arity}, i64 {num_slots})\n  br label %tco_entry\ndead_{step}:\n"
      emit llvm instr (NTailCallFn fid start_slot count _) step num_slots rodata_len
        | fid >= 5 and count >= 0 and count <= 8 =
          load_ir = llvm load call args start_slot 0 count step []
          arg_list = llvm call arg list 0 count step []
          load_ir + (llvm tail teardown num_slots step) + "  %r_{step} = tail call tailcc i64 @__rg_fn_{fid}_reg(" + arg_list + ")\n  ret i64 %r_{step}\ndead_{step}:\n"
        | otherwise =
          (emit llvm instr (NCallFn fid start_slot count) step num_slots rodata_len) + (emit llvm instr NReturn step num_slots rodata_len)
      emit llvm instr NReturn step _ _ =
        "  br label %epilogue_exit\ndead_{step}:\n"

fn :: emit llvm instr list [RNativeInstr] Int Int Int [String] => [String]
      emit llvm instr list [] _ _ _ acc = list reverse acc
      emit llvm instr list (ins:rest) step num_slots rodata_len acc =
        line = emit llvm instr ins step num_slots rodata_len
        emit llvm instr list rest (step + 1) num_slots rodata_len ([line] :: acc)

fn :: llvm alloc slots Int => Int
      llvm alloc slots n
        | n <= 0 = 1
        | otherwise = n

fn :: llvm fn attrs Int => String
      llvm fn attrs 2   =  "noinline optnone nounwind"
      llvm fn attrs 3   =  "noinline optnone nounwind"
      llvm fn attrs _   =  "nounwind"

fn :: emit llvm reg wrapper Int Int => String
      emit llvm reg wrapper fid arity =
        load_ir = llvm load wrapper args 0 arity []
        arg_list = llvm wrapper arg list 0 arity []
        "define i64 @__rg_fn_{fid}(ptr %args) nounwind {{\nentry:\n" + load_ir + "  %r = call tailcc i64 @__rg_fn_{fid}_reg(" + arg_list + ")\n  ret i64 %r\n}}\n\n"

fn :: emit llvm fn RNativeFn Int => String
      emit llvm fn nf rodata_len =  emit llvm fn linked nf rodata_len ""

-- `lk` is the linkage prefix of the `_reg` definition: "" (external) or
-- "weak_odr " for the targets of `NTailCallFn` (OPT-019). Without it LLVM
-- may prove that the callee always returns the same value (a unit function
-- returns 0) and return that constant instead of the call's result; the call
-- is then no longer in tail position and the stack grows. `weak_odr` keeps
-- the function inlinable but stops that deduction.
fn :: emit llvm fn linked RNativeFn Int String => String
      emit llvm fn linked (NativeFn fid _ arity num_slots instrs) rodata_len lk
        | fid >= 5 and arity >= 0 and arity <= 8 and num_slots <= 24 and (not (llvm fn has tco instrs)) =
          aslots = llvm alloc slots num_slots
          rparams = llvm reg param list 0 arity []
          init_ir = llvm unroll init frame reg 0 arity num_slots []
          epi_ir = llvm unroll epilogue 0 num_slots []
          hdr = "define " + lk + "tailcc i64 @__rg_fn_{fid}_reg(" + rparams + ") inlinehint nounwind {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n" + init_ir + "  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n" + epi_ir + "  ret i64 %a_end\n}}\n\n"
          wrap = emit llvm reg wrapper fid arity
          join str tree ([hdr] :: body_chunks :: [ftr, wrap])
        | fid >= 5 and arity >= 0 and arity <= 8 and num_slots <= 24 =
          aslots = llvm alloc slots num_slots
          rparams = llvm reg param list 0 arity []
          init_ir = llvm unroll init frame reg 0 arity num_slots []
          epi_ir = llvm unroll epilogue 0 num_slots []
          hdr = "define " + lk + "tailcc i64 @__rg_fn_{fid}_reg(" + rparams + ") nounwind {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n" + init_ir + "  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n" + epi_ir + "  ret i64 %a_end\n}}\n\n"
          wrap = emit llvm reg wrapper fid arity
          join str tree ([hdr] :: body_chunks :: [ftr, wrap])
        | fid >= 5 and arity >= 0 and arity <= 8 =
          aslots = llvm alloc slots num_slots
          fbytes = aslots * 8
          rparams = llvm reg param list 0 arity []
          init_ir = llvm store reg args 0 arity []
          hdr = "define " + lk + "tailcc i64 @__rg_fn_{fid}_reg(" + rparams + ") nounwind {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n  call void @llvm.memset.p0.i64(ptr align 8 %frame, i8 0, i64 {fbytes}, i1 false)\n" + init_ir + "  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n  %r_end = call i64 @__rg_rt_epilogue(ptr %frame, i64 {num_slots}, i64 %a_end)\n  ret i64 %r_end\n}}\n\n"
          wrap = emit llvm reg wrapper fid arity
          join str tree ([hdr] :: body_chunks :: [ftr, wrap])
        | otherwise =
          aslots = llvm alloc slots num_slots
          fattrs = llvm fn attrs fid
          hdr = "define i64 @__rg_fn_{fid}(ptr %args) {fattrs} {{\nentry:\n  %acc = alloca i64, align 8\n  %frame = alloca [{aslots} x i64], align 8\n  store i64 0, ptr %acc, align 8\n  call void @__rg_rt_init_frame(ptr %frame, ptr %args, i64 {arity}, i64 {num_slots})\n  br label %tco_entry\ntco_entry:\n"
          body_chunks = emit llvm instr list instrs 0 num_slots rodata_len []
          ftr = "  br label %epilogue_exit\nepilogue_exit:\n  %a_end = load i64, ptr %acc, align 8\n  %r_end = call i64 @__rg_rt_epilogue(ptr %frame, i64 {num_slots}, i64 %a_end)\n  ret i64 %r_end\n}}\n\n"
          join str tree ([hdr] :: body_chunks :: [ftr])

fn :: emit llvm fn list [RNativeFn] Int [String] => [String]
      emit llvm fn list fns rodata_len acc =
        targets = llvm tail targets fns []
        emit llvm fn list linked fns rodata_len (sort by ints targets targets) acc

-- `targets`: the sorted fids of `NTailCallFn` targets. The functions come in
-- increasing fid order, so one pass drops the targets below the current fid.
fn :: emit llvm fn list linked [RNativeFn] Int [Int] [String] => [String]
      emit llvm fn list linked [] _ _ acc = list reverse acc
      emit llvm fn list linked ((NativeFn fid nm ar ns ins):fs) rodata_len targets acc =
        rest_t = llvm drop targets below targets fid
        fn_ir = emit llvm fn linked (NativeFn fid nm ar ns ins) rodata_len (llvm target linkage rest_t fid)
        emit llvm fn list linked fs rodata_len rest_t ([fn_ir] :: acc)

fn :: llvm drop targets below [Int] Int => [Int]
      llvm drop targets below [] _ = []
      llvm drop targets below (t:ts) fid
        | t < fid = llvm drop targets below ts fid
        | otherwise = [t] :: ts

fn :: llvm target linkage [Int] Int => String
      llvm target linkage (t:_) fid
        | t == fid = "weak_odr "
      llvm target linkage _ _ = ""

fn :: llvm tail targets [RNativeFn] [Int] => [Int]
      llvm tail targets [] acc = acc
      llvm tail targets ((NativeFn _ _ _ _ ins):fs) acc = llvm tail targets fs (llvm tail targets in ins acc)

fn :: llvm tail targets in [RNativeInstr] [Int] => [Int]
      llvm tail targets in [] acc = acc
      llvm tail targets in ((NTailCallFn f _ c _):rest) acc
        | f >= 5 and c >= 0 and c <= 8 = llvm tail targets in rest ([f] :: acc)
      llvm tail targets in (_:rest) acc = llvm tail targets in rest acc

fn :: llvm target triple String           => String
      llvm target triple "arm64"          =  "aarch64-unknown-linux-gnu"
      llvm target triple "arm64-linux"    =  "aarch64-unknown-linux-gnu"
      llvm target triple "aarch64"        =  "aarch64-unknown-linux-gnu"
      llvm target triple "aarch64-linux"  =  "aarch64-unknown-linux-gnu"
      llvm target triple "x86_64-macos"   =  "x86_64-apple-macosx11.0.0"
      llvm target triple "macos-x86_64"   =  "x86_64-apple-macosx11.0.0"
      llvm target triple "arm64-macos"    =  "arm64-apple-macosx11.0.0"
      llvm target triple "macos-arm64"    =  "arm64-apple-macosx11.0.0"
      llvm target triple "aarch64-macos"  =  "arm64-apple-macosx11.0.0"
      llvm target triple "x86_64-windows" =  "x86_64-pc-windows-msvc"
      llvm target triple "windows-x86_64" =  "x86_64-pc-windows-msvc"
      llvm target triple "win64"          =  "x86_64-pc-windows-msvc"
      llvm target triple "arm64-windows"  =  "aarch64-pc-windows-msvc"
      llvm target triple "windows-arm64"  =  "aarch64-pc-windows-msvc"
      llvm target triple _                =  "x86_64-unknown-linux-gnu"

-- The module of a program: the declarations of the runtime and the inline
-- helpers (abi/inline.ll, as text), one declaration for each helper that
-- lives in the runtime object (abi/helpers.ll), then the functions. The
-- builtins the runtime owns (channels, jobs, replies) are marked first, as the
-- pure encoder does, and go through `__rg_rt_builtin`.
-- ── Fused element-wise expressions (FR-COMP-031) ─────────────
-- `NHadamard (1000 + kinds) slot off len` runs the program whose text is in the read-only data at
-- `off`, on tensors of the element kinds in `kinds` (src/main/runtime/core/fuse.ll gives the format
-- and the meaning). Here each program with its kinds becomes a function of the module,
-- `@__rg_fuse_<off>_<kinds>`: one loop over untagged elements of the machine type of each kind,
-- with no call inside, so `opt` can keep the values in registers and use vector instructions. The
-- runtime keeps the general routine (`rg_fuse`) for the other back ends; both must give the same
-- result.
type RFz = FzT Int Int | FzS Int | FzC Int | FzX Int | FzW Int | FzL Int | FzO Int | FzG Int | FzR Int

fn :: fz scan String Int Int Int [RFz] => [RFz]
      fz scan s pos len nl acc
        | pos >= len = acc
        | otherwise = fz tok s pos len nl acc (str char at s pos)

fn :: fz tok String Int Int Int [RFz] Int => [RFz]
      fz tok s pos len nl acc 101 =  fz scan s (pos + 1) len (nl + 1) (acc :: [FzT 0 nl])
      fz tok s pos len nl acc 112 =  fz scan s (pos + 1) len (nl + 1) (acc :: [FzT 1 nl])
      fz tok s pos len nl acc 117 =  fz scan s (pos + 1) len (nl + 1) (acc :: [FzT 2 nl])
      fz tok s pos len nl acc 103 =  fz scan s (pos + 1) len (nl + 1) (acc :: [FzG nl])
      fz tok s pos len nl acc 115 =  fz scan s (pos + 1) len (nl + 1) (acc :: [FzS nl])
      fz tok s pos len nl acc 99 =  fz scan s (fz num end s (pos + 1) len) len nl (acc :: [FzC (fz num s (pos + 1) (fz num end s (pos + 1) len))])
      fz tok s pos len nl acc 120 =  fz scan s (fz num end s (pos + 1) len) len nl (acc :: [FzX (fz num s (pos + 1) (fz num end s (pos + 1) len))])
      fz tok s pos len nl acc 119 =  fz scan s (fz num end s (pos + 1) len) len nl (acc :: [FzW (fz num s (pos + 1) (fz num end s (pos + 1) len))])
      fz tok s pos len nl acc 108 =  fz scan s (fz num end s (pos + 1) len) len nl (acc :: [FzL (fz num s (pos + 1) (fz num end s (pos + 1) len))])
      fz tok s pos len nl acc 111 =  fz scan s (pos + 1) len nl (acc :: [FzO (fz outs acc 0)])
      fz tok s pos len nl acc 114 =  fz scan s (fz num end s (pos + 1) len) len nl (acc :: [FzR (fz num s (pos + 1) (fz num end s (pos + 1) len))])
      fz tok s pos len nl acc _ =  fz scan s (pos + 1) len nl acc

-- The number of results among the tokens (0: the program gives one tensor, the value left).
fn :: fz outs [RFz] Int => Int
      fz outs [] n =  n
      fz outs ((FzO _):ts) n =  fz outs ts (n + 1)
      fz outs (_:ts) n =  fz outs ts n

fn :: fz num end String Int Int => Int
      fz num end s pos len
        | pos >= len = pos
        | (str char at s pos) == 32 = pos
        | otherwise = fz num end s (pos + 1) len

fn :: fz num String Int Int => Int
      fz num s pos end
        | (str char at s pos) == 45 = 0 - (fz digits s (pos + 1) end 0)
        | otherwise = fz digits s pos end 0

fn :: fz digits String Int Int Int => Int
      fz digits s pos end acc
        | pos >= end = acc
        | otherwise = fz digits s (pos + 1) end ((acc * 10) + ((str char at s pos) - 48))

-- The kinds: a letter for each leaf ("" for a number), from the digits of `kinds`.
fn :: fz kind letter Int => String
      fz kind letter 2 =  "R"
      fz kind letter 3 =  "B"
      fz kind letter 4 =  "H"
      fz kind letter 5 =  "W"
      fz kind letter _ =  "N"

fn :: fz kind num String => Int
      fz kind num "R" =  2
      fz kind num "B" =  3
      fz kind num "H" =  4
      fz kind num "W" =  5
      fz kind num _ =  1

fn :: fz kind digit Int Int => Int
      fz kind digit kinds n
        | n > 19 = fz kind digit kinds 19
        | n <= 0 = kinds % 8
        | otherwise = fz kind digit (kinds / 8) (n - 1)

fn :: fz leaf kinds [RFz] Int Int [String] => [String]
      fz leaf kinds [] _ _ acc =  acc
      fz leaf kinds ((FzT _ _):ts) kinds n acc =  fz leaf kinds ts kinds (n + 1) (acc :: [fz kind letter (fz kind digit kinds n)])
      fz leaf kinds ((FzG _):ts) kinds n acc =  fz leaf kinds ts kinds (n + 1) (acc :: [fz kind letter (fz kind digit kinds n)])
      fz leaf kinds ((FzS _):ts) kinds n acc =  fz leaf kinds ts kinds n (acc :: [""])
      fz leaf kinds (_:ts) kinds n acc =  fz leaf kinds ts kinds n acc

fn :: fz ty String => String
      fz ty "R" =  "double"
      fz ty "B" =  "i8"
      fz ty "H" =  "i16"
      fz ty "W" =  "i32"
      fz ty _ =  "i64"

fn :: fz lg String => Int
      fz lg "B" =  0
      fz lg "H" =  1
      fz lg "W" =  2
      fz lg _ =  3

fn :: fz bits String => Int
      fz bits "B" =  8
      fz bits "H" =  16
      fz bits "W" =  32
      fz bits _ =  64

fn :: fz align String => Int
      fz align "R" =  8
      fz align "N" =  8
      fz align _ =  1

fn :: fz model [RFz] => Int
      fz model ((FzT 0 i):_) =  i
      fz model (_:ts) =  fz model ts
      fz model [] =  0

fn :: fz nested [RFz] => Bool
      fz nested [] =  False
      fz nested ((FzT 1 _):_) =  True
      fz nested ((FzT 2 _):_) =  True
      fz nested (_:ts) =  fz nested ts

fn :: fz reduces [RFz] => Bool
      fz reduces [] =  False
      fz reduces ((FzR _):_) =  True
      fz reduces (_:ts) =  fz reduces ts

fn :: fz gathers [RFz] => Bool
      fz gathers [] =  False
      fz gathers ((FzG _):_) =  True
      fz gathers (_:ts) =  fz gathers ts

-- The leaves: a tensor gives its elements (%p) and their number (%n), a number its word (%w). %lk
-- holds, for each leaf, its kind when it can take a result (a tensor read element by element).
fn :: fz load leaves [RFz] [String] [String] => [String]
      fz load leaves [] _ acc =  acc
      fz load leaves ((FzT mode i):ts) kinds acc =
        fz load leaves ts kinds (acc :: [fz load tensor i (fz lg (list nth or kinds i "N")) (fz take kind mode (list nth or kinds i "N"))])
      fz load leaves ((FzG i):ts) kinds acc =
        fz load leaves ts kinds (acc :: [fz load tensor i (fz lg (list nth or kinds i "N")) 0])
      fz load leaves ((FzS i):ts) kinds acc =
        fz load leaves ts kinds (acc :: ["  %sp{i} = getelementptr inbounds i64, ptr %slots, i64 {i}\n  %v{i} = load i64, ptr %sp{i}, align 8\n  %w{i} = call i64 @rg_raw_word(i64 %v{i})\n  %lka{i} = getelementptr inbounds i64, ptr %lk, i64 {i}\n  store i64 0, ptr %lka{i}, align 8\n"])
      fz load leaves (_:ts) kinds acc =  fz load leaves ts kinds acc

fn :: fz take kind Int String => Int
      fz take kind 0 k =  fz kind num k
      fz take kind _ _ =  0

fn :: fz load tensor Int Int Int => String
      fz load tensor i lg tk =
        "  %sp{i} = getelementptr inbounds i64, ptr %slots, i64 {i}\n  %t{i} = load i64, ptr %sp{i}, align 8\n  %np{i} = alloca i64, align 8\n  %d{i} = call i64 @rg_fuse_open(i64 %t{i}, i64 {lg}, ptr %np{i})\n  %n{i} = load i64, ptr %np{i}, align 8\n  %p{i} = inttoptr i64 %d{i} to ptr\n  %z{i} = icmp eq i64 %n{i}, 0\n  %q{i} = select i1 %z{i}, i64 1, i64 %n{i}\n  %lka{i} = getelementptr inbounds i64, ptr %lk, i64 {i}\n  store i64 {tk}, ptr %lka{i}, align 8\n"

-- The shapes: a tensor of the shape of the result has its number of elements; one of the first
-- dimensions divides the number of rows; one of the last dimensions is a whole number of rows.
fn :: fz checks [RFz] String [String] => String [String]
      fz checks [] prev acc =  (prev, acc)
      fz checks ((FzT 0 i):ts) prev acc =
        fz checks ts "%ok{i}" (acc :: ["  %c{i} = icmp eq i64 %n{i}, %total\n  %ok{i} = and i1 {prev}, %c{i}\n"])
      fz checks ((FzT 1 i):ts) prev acc =
        fz checks ts "%ok{i}" (acc :: ["  %r{i} = urem i64 %outer, %q{i}\n  %f{i} = icmp eq i64 %r{i}, 0\n  %nz{i} = xor i1 %z{i}, true\n  %g{i} = and i1 %f{i}, %nz{i}\n  %c{i} = or i1 %g{i}, %empty\n  %ok{i} = and i1 {prev}, %c{i}\n  %per0{i} = udiv i64 %outer, %q{i}\n  %perz{i} = icmp eq i64 %per0{i}, 0\n  %per{i} = select i1 %perz{i}, i64 1, i64 %per0{i}\n"])
      fz checks ((FzT _ i):ts) prev acc =
        fz checks ts "%ok{i}" (acc :: ["  %r{i} = urem i64 %n{i}, %inner\n  %f{i} = icmp eq i64 %r{i}, 0\n  %nz{i} = xor i1 %z{i}, true\n  %g{i} = and i1 %f{i}, %nz{i}\n  %c{i} = or i1 %g{i}, %empty\n  %ok{i} = and i1 {prev}, %c{i}\n  %blk0{i} = udiv i64 %n{i}, %inner\n  %blkz{i} = icmp eq i64 %blk0{i}, 0\n  %blk{i} = select i1 %blkz{i}, i64 1, i64 %blk0{i}\n"])
      fz checks (_:ts) prev acc =  fz checks ts prev acc

-- A tensor that is read by index and has no elements: every index is outside it.
fn :: fz empty tables [RFz] String [String] => String [String]
      fz empty tables [] prev acc =  (prev, acc)
      fz empty tables ((FzG i):ts) prev acc =  fz empty tables ts "%gz{i}" (acc :: ["  %gz{i} = or i1 {prev}, %z{i}\n"])
      fz empty tables (_:ts) prev acc =  fz empty tables ts prev acc

-- What a row needs before its elements: the element of each tensor of the first dimensions, and
-- where the row starts in each tensor of the last ones.
fn :: fz row heads [RFz] [String] [String] => [String]
      fz row heads [] _ acc =  acc
      fz row heads ((FzT 1 i):ts) kinds acc =
        ty = fz ty (list nth or kinds i "N")
        al = fz align (list nth or kinds i "N")
        fz row heads ts kinds (acc :: ["  %pi{i} = udiv i64 %o, %per{i}\n  %pa{i} = getelementptr inbounds {ty}, ptr %p{i}, i64 %pi{i}\n  %pv{i} = load {ty}, ptr %pa{i}, align {al}\n"])
      fz row heads ((FzT 2 i):ts) kinds acc =
        fz row heads ts kinds (acc :: ["  %um{i} = urem i64 %o, %blk{i}\n  %ub{i} = mul i64 %um{i}, %inner\n"])
      fz row heads (_:ts) kinds acc =  fz row heads ts kinds acc

-- The expression on element %e (%j inside its row). The state: the names and the kinds of the
-- values on the stack (the last one first; kind "" is a number that has not met a tensor yet: `#n`
-- an integer, else the word of a leaf), the values set by `w`, the kinds of the results, the
-- flags of the indices that were outside their tensor, and the lines.
type RFzSt = FzSt [String] [String] [(Int, String, String)] [String] [String] [String]

fn :: fz body [RFz] [String] Int RFzSt => RFzSt
      fz body [] _ _ st =  st
      fz body ((FzT 0 i):ts) kinds n (FzSt names ks locs outs flags code) =
        k = list nth or kinds i "N"
        ty = fz ty k
        al = fz align k
        fz body ts kinds (n + 1) (FzSt (["%x{n}"] :: names) ([k] :: ks) locs outs flags (code :: ["  %a{n} = getelementptr inbounds {ty}, ptr %p{i}, i64 %e\n  %x{n} = load {ty}, ptr %a{n}, align {al}, !llvm.access.group !7001\n"]))
      fz body ((FzT 1 i):ts) kinds n (FzSt names ks locs outs flags code) =
        fz body ts kinds (n + 1) (FzSt (["%pv{i}"] :: names) ([list nth or kinds i "N"] :: ks) locs outs flags code)
      fz body ((FzT _ i):ts) kinds n (FzSt names ks locs outs flags code) =
        k = list nth or kinds i "N"
        ty = fz ty k
        al = fz align k
        fz body ts kinds (n + 1) (FzSt (["%x{n}"] :: names) ([k] :: ks) locs outs flags (code :: ["  %u{n} = add i64 %ub{i}, %j\n  %a{n} = getelementptr inbounds {ty}, ptr %p{i}, i64 %u{n}\n  %x{n} = load {ty}, ptr %a{n}, align {al}, !llvm.access.group !7001\n"]))
      fz body ((FzS i):ts) kinds n (FzSt names ks locs outs flags code) =
        fz body ts kinds (n + 1) (FzSt (["%w{i}"] :: names) ([""] :: ks) locs outs flags code)
      fz body ((FzC c):ts) kinds n (FzSt names ks locs outs flags code) =
        fz body ts kinds (n + 1) (FzSt (["#" + (int to str c)] :: names) ([""] :: ks) locs outs flags code)
      fz body ((FzX id):ts) kinds n (FzSt (b:a:names) (kb:ka:ks) locs outs flags code) =
        k = fz op kind ka kb
        fz body ts kinds (n + 1) (FzSt (["%x{n}"] :: names) ([k] :: ks) locs outs flags (code :: [(fz typed line a ka k n "a") + (fz typed line b kb k n "b") + (fz op k id n (fz typed name a ka k n "a") (fz typed name b kb k n "b"))]))
      fz body ((FzW w):ts) kinds n (FzSt (top:names) (kt:ks) locs outs flags code) =
        fz body ts kinds (n + 1) (FzSt names ks ([(w, top, kt)] :: locs) outs flags code)
      fz body ((FzL w):ts) kinds n (FzSt names ks locs outs flags code) =
        fz body ts kinds (n + 1) (FzSt ([fz loc name locs w] :: names) ([fz loc kind locs w] :: ks) locs outs flags code)
      fz body ((FzO o):ts) kinds n (FzSt (top:names) (kt:ks) locs outs flags code) =
        k = fz op kind kt ""
        ty = fz ty k
        al = fz align k
        fz body ts kinds (n + 1) (FzSt names ks locs (outs :: [k]) flags (code :: [(fz typed line top kt k n "a") + "  %dst{n} = getelementptr inbounds {ty}, ptr %rp{o}, i64 %e\n  store {ty} " + (fz typed name top kt k n "a") + ", ptr %dst{n}, align {al}, !llvm.access.group !7001\n"]))
      fz body ((FzG i):ts) kinds n (FzSt (top:names) (kt:ks) locs outs flags code) =
        k = list nth or kinds i "N"
        ty = fz ty k
        al = fz align k
        ix = fz index name top kt n
        fz body ts kinds (n + 1) (FzSt (["%x{n}"] :: names) ([k] :: ks) locs outs (flags :: ["%gb{n}"]) (code :: [(fz index line top kt n) + "  %gb{n} = icmp uge i64 {ix}, %n{i}\n  %gs{n} = select i1 %gb{n}, i64 0, i64 {ix}\n  %ga{n} = getelementptr inbounds {ty}, ptr %p{i}, i64 %gs{n}\n  %x{n} = load {ty}, ptr %ga{n}, align {al}, !llvm.access.group !7001\n"]))
      fz body ((FzR id):ts) kinds n (FzSt (top:names) (kt:ks) locs outs flags code) =
        k = fz op kind kt ""
        fz body ts kinds (n + 1) (FzSt names ks locs ["=" + k] flags (code :: [(fz typed line top kt k n "a") + (fz join lines k id (fz typed name top kt k n "a"))]))
      fz body (_:ts) kinds n st =  fz body ts kinds (n + 1) st

-- `r<id>`: the value joined with those of the elements before (%acc), as a 64-bit integer or a
-- double: %acc1.
fn :: fz join lines String Int String => String
      fz join lines "R" 30 v =  "  %jc = fcmp olt double " + v + ", %acc
  %acc1 = select i1 %jc, double " + v + ", double %acc
"
      fz join lines "R" 31 v =  "  %jc = fcmp ogt double " + v + ", %acc
  %acc1 = select i1 %jc, double " + v + ", double %acc
"
      fz join lines "R" _ v =  "  %acc1 = fadd double %acc, " + v + "
"
      fz join lines k id v =  (fz join wide k v) + (fz join int id)

fn :: fz join wide String String => String
      fz join wide "N" v =  "  %jv = add i64 " + v + ", 0
"
      fz join wide k v =  "  %jv = zext " + (fz ty k) + " " + v + " to i64
"

fn :: fz join int Int => String
      fz join int 30 =  "  %jc = icmp slt i64 %jv, %acc
  %acc1 = select i1 %jc, i64 %jv, i64 %acc
"
      fz join int 31 =  "  %jc = icmp sgt i64 %jv, %acc
  %acc1 = select i1 %jc, i64 %jv, i64 %acc
"
      fz join int _ =  "  %acc1 = add i64 %acc, %jv
"

-- Where a reduction starts: nothing for a sum; for the smallest and the largest, the value no
-- element can pass.
fn :: fz join start String Int => String
      fz join start "R" 30 =  "double [ 0x7FF0000000000000"
      fz join start "R" 31 =  "double [ 0xFFF0000000000000"
      fz join start "R" _ =  "double [ 0.0"
      fz join start _ 30 =  "i64 [ 9223372036854775807"
      fz join start _ 31 =  "i64 [ -9223372036854775808"
      fz join start _ _ =  "i64 [ 0"

fn :: fz reduce id [RFz] => Int
      fz reduce id [] =  0
      fz reduce id ((FzR id):_) =  id
      fz reduce id (_:ts) =  fz reduce id ts

-- The kind of the result of an operator: that of the operand that has one; two numbers are
-- 64-bit integers.
fn :: fz op kind String String => String
      fz op kind "" "" =  "N"
      fz op kind "" kb =  kb
      fz op kind ka _ =  ka

-- A value as an operand of kind k: a value that has a kind is of that kind already; an integer
-- is written in that kind; the word of a leaf is cut to it (line) under a new name.
fn :: fz typed name String String String Int String => String
      fz typed name v "" k n side
        | str starts with v "#" = fz const k (fz num v 1 (str len v))
        | k == "N" = v
        | otherwise = "%t" + side + (int to str n)
      fz typed name v _ _ _ _ =  v

fn :: fz typed line String String String Int String => String
      fz typed line v "" k n side
        | (str starts with v "#") or k == "N" = ""
        | k == "R" = "  %t" + side + (int to str n) + " = bitcast i64 " + v + " to double\n"
        | otherwise = "  %t" + side + (int to str n) + " = trunc i64 " + v + " to " + (fz ty k) + "\n"
      fz typed line _ _ _ _ _ =  ""

-- A value as an index: a 64-bit integer.
fn :: fz index name String String Int => String
      fz index name v "" _
        | str starts with v "#" = str slice v 1 (str len v)
        | otherwise = v
      fz index name v "N" _ =  v
      fz index name _ _ n =  "%gi" + (int to str n)

fn :: fz index line String String Int => String
      fz index line _ "" _ =  ""
      fz index line _ "N" _ =  ""
      fz index line v "R" n =  "  %gi" + (int to str n) + " = fptoui double " + v + " to i64\n"
      fz index line v k n =  "  %gi" + (int to str n) + " = zext " + (fz ty k) + " " + v + " to i64\n"

fn :: fz loc name [(Int, String, String)] Int => String
      fz loc name [] _ =  "undef"
      fz loc name ((w, name, _):ls) want
        | w == want = name
        | otherwise = fz loc name ls want

fn :: fz loc kind [(Int, String, String)] Int => String
      fz loc kind [] _ =  ""
      fz loc kind ((w, _, kind):ls) want
        | w == want = kind
        | otherwise = fz loc kind ls want

-- An integer as an element of the kind: wrapped to its width.
fn :: fz const String Int => String
      fz const "B" c =  int to str (((c % 256) + 256) % 256)
      fz const "H" c =  int to str (((c % 65536) + 65536) % 65536)
      fz const "W" c =  int to str (((c % 4294967296) + 4294967296) % 4294967296)
      fz const "R" c =  (int to str c) + ".0"
      fz const _ c =  int to str c

fn :: fz op String Int Int String String => String
      fz op "R" 0 n a b =  "  %x{n} = fadd double {a}, {b}\n"
      fz op "R" 1 n a b =  "  %x{n} = fsub double {a}, {b}\n"
      fz op "R" 2 n a b =  "  %x{n} = fmul double {a}, {b}\n"
      fz op "R" _ n a b =  "  %x{n} = fdiv double {a}, {b}\n"
      fz op k 0 n a b =  fz plain op k "add" n a b
      fz op k 1 n a b =  fz plain op k "sub" n a b
      fz op k 2 n a b =  fz plain op k "mul" n a b
      fz op k 11 n a b =  fz plain op k "and" n a b
      fz op k 12 n a b =  fz plain op k "or" n a b
      fz op k 17 n a b =  fz shift op k "shl" n a b
      fz op k 18 n a b =  fz shift op k "lshr" n a b
      fz op k 19 n a b =  fz rot op k "fshr" n a b
      fz op k 20 n a b =  fz rot op k "fshl" n a b
      fz op k 21 n a b =  fz mulhi op k n a b
      fz op "N" 22 n a b =  "  %x{n} = call i64 @__rg_clmul(i64 {a}, i64 {b}, i64 0)\n"
      fz op "N" 23 n a b =  "  %x{n} = call i64 @__rg_clmul(i64 {a}, i64 {b}, i64 1)\n"
      fz op k 22 n a b =  fz clmul op k n a b 0
      fz op k 23 n a b =  fz clmul op k n a b (fz bits k)
      fz op "N" 3 n a b =
        "  %dz{n} = icmp eq i64 {b}, 0\n  %dm{n} = icmp eq i64 {b}, -1\n  %ds{n} = select i1 %dz{n}, i64 1, i64 {b}\n  %dt{n} = select i1 %dm{n}, i64 1, i64 %ds{n}\n  %dq{n} = sdiv i64 {a}, %dt{n}\n  %dn{n} = sub i64 0, {a}\n  %dr{n} = select i1 %dm{n}, i64 %dn{n}, i64 %dq{n}\n  %x{n} = select i1 %dz{n}, i64 0, i64 %dr{n}\n"
      fz op "N" 4 n a b =
        "  %dz{n} = icmp eq i64 {b}, 0\n  %dm{n} = icmp eq i64 {b}, -1\n  %ds{n} = select i1 %dz{n}, i64 1, i64 {b}\n  %dt{n} = select i1 %dm{n}, i64 1, i64 %ds{n}\n  %dq{n} = srem i64 {a}, %dt{n}\n  %db{n} = or i1 %dz{n}, %dm{n}\n  %x{n} = select i1 %db{n}, i64 0, i64 %dq{n}\n"
      fz op k 3 n a b =  fz udiv op k "udiv" n a b
      fz op k 4 n a b =  fz udiv op k "urem" n a b
      fz op k _ n a b =  fz plain op k "xor" n a b

-- The product without carries of two elements narrower than a word fits one: its low half is
-- the word cut to the element, its high half the word shifted down by the width.
fn :: fz clmul op String Int String String Int => String
      fz clmul op k n a b shift =
        ty = fz ty k
        "  %ca{n} = zext {ty} {a} to i64\n  %cb{n} = zext {ty} {b} to i64\n  %cp{n} = call i64 @__rg_clmul(i64 %ca{n}, i64 %cb{n}, i64 0)\n  %cs{n} = lshr i64 %cp{n}, {shift}\n  %x{n} = trunc i64 %cs{n} to {ty}\n"

-- The high half of the product: both operands widened to twice the element.
fn :: fz mulhi op String Int String String => String
      fz mulhi op k n a b =
        ty = fz ty k
        bits = fz bits k
        wide = bits * 2
        "  %ma{n} = zext {ty} {a} to i{wide}\n  %mb{n} = zext {ty} {b} to i{wide}\n  %mp{n} = mul i{wide} %ma{n}, %mb{n}\n  %ms{n} = lshr i{wide} %mp{n}, {bits}\n  %x{n} = trunc i{wide} %ms{n} to {ty}\n"

fn :: fz plain op String String Int String String => String
      fz plain op k name n a b =
        ty = fz ty k
        "  %x{n} = {name} {ty} {a}, {b}\n"

fn :: fz shift op String String Int String String => String
      fz shift op k name n a b =
        ty = fz ty k
        m = (fz bits k) - 1
        "  %sc{n} = and {ty} {b}, {m}\n  %x{n} = {name} {ty} {a}, %sc{n}\n"

fn :: fz rot op String String Int String String => String
      fz rot op k name n a b =
        ty = fz ty k
        "  %x{n} = call {ty} @llvm.{name}.{ty}({ty} {a}, {ty} {a}, {ty} {b})\n"

fn :: fz udiv op String String Int String String => String
      fz udiv op k name n a b =
        ty = fz ty k
        "  %dz{n} = icmp eq {ty} {b}, 0\n  %ds{n} = select i1 %dz{n}, {ty} 1, {ty} {b}\n  %dq{n} = {name} {ty} {a}, %ds{n}\n  %x{n} = select i1 %dz{n}, {ty} 0, {ty} %dq{n}\n"

-- A program without `o`: the value left is the one result.
fn :: fz finish RFzSt Int => RFzSt
      fz finish (FzSt (top:names) (kt:ks) locs [] flags code) n =
        k = fz op kind kt ""
        ty = fz ty k
        al = fz align k
        FzSt names ks locs [k] flags (code :: [(fz typed line top kt k n "a") + "  %dst = getelementptr inbounds {ty}, ptr %rp0, i64 %e\n  store {ty} " + (fz typed name top kt k n "a") + ", ptr %dst, align {al}, !llvm.access.group !7001\n"])
      fz finish st _ =  st

fn :: fz st outs RFzSt => [String]
      fz st outs (FzSt _ _ _ outs _ _) =  outs

fn :: fz st flags RFzSt => [String]
      fz st flags (FzSt _ _ _ _ flags _) =  flags

fn :: fz st code RFzSt => [String]
      fz st code (FzSt _ _ _ _ _ code) =  code

-- The result tensors: %rp<j> are their elements.
fn :: fz results [String] Int Int Int Int String => String
      fz results [] _ _ _ _ acc =  acc
      fz results (k:ks) m lgm nl j acc =
        kn = fz kind num k
        lg = fz lg k
        fz results ks m lgm nl (j + 1) (acc + "  %res{j} = call i64 @rg_fuse_take(i64 %si, i64 {nl}, i64 %lki, i64 {kn}, i64 %t{m}, i64 {lgm}, ptr %from)\n  %rd{j} = call i64 @rg_fuse_data(i64 %res{j}, i64 {lg})\n  %rp{j} = inttoptr i64 %rd{j} to ptr\n")

fn :: fz give Int Int => String
      fz give 0 _ =  "  ret i64 %res0\n"
      fz give nout _ =  "  %tp = alloca [{nout} x i64], align 8\n" + (fz give stores nout 0 "") + "  %tup = call i64 @__rg_rt_make_tuple(ptr %tp, i64 {nout})\n  ret i64 %tup\n"

fn :: fz give stores Int Int String => String
      fz give stores nout j acc
        | j >= nout = acc
        | otherwise = fz give stores nout (j + 1) (acc + "  %tpa{j} = getelementptr inbounds i64, ptr %tp, i64 {j}\n  store i64 %res{j}, ptr %tpa{j}, align 8\n")

-- The rows, for a program with tensors of the first or of the last dimensions only.
fn :: fz row shape Bool Int Int => String
      fz row shape False _ _ =  ""
      fz row shape True m lg =  "  %last = call i64 @rg_fuse_last(i64 %t{m}, i64 {lg})\n  %lz = icmp eq i64 %last, 0\n  %inner = select i1 %lz, i64 1, i64 %last\n  %outer = udiv i64 %total, %inner\n"

fn :: fz chk name (String, [String]) => String
      fz chk name (name, _) =  name

fn :: fz chk code (String, [String]) => [String]
      fz chk code (_, code) =  code

-- The flags of one element joined with those of the elements before (%bad).
fn :: fz bad lines [String] String Int String => String
      fz bad lines [] prev _ acc =  acc + "  %bad1 = or i1 " + prev + ", false\n"
      fz bad lines (f:fs) prev n acc =  fz bad lines fs ("%bo" + (int to str n)) (n + 1) (acc + "  %bo" + (int to str n) + " = or i1 " + prev + ", " + f + "\n")

fn :: llvm fuse loops Bool [RFz] [String] [String] String String String => [String]
      llvm fuse loops False _ _ body pre bad accphi =
        ["  br label %head\nhead:\n  %e = phi i64 [ 0, %" + pre + " ], [ %e1, %body ]\n  %bad = phi i1 [ false, %" + pre + " ], [ %bad1, %body ]\n" + accphi + "  %more = icmp ult i64 %e, %total\n  br i1 %more, label %body, label %done\nbody:\n"] :: body :: [bad, "  %e1 = add nuw i64 %e, 1\n  br label %head, !llvm.loop !7002\n"]
      llvm fuse loops True toks kinds body pre _ _ =
        ["  br label %ohead\nohead:\n  %o = phi i64 [ 0, %" + pre + " ], [ %o1, %olatch ]\n  %omore = icmp ult i64 %o, %outer\n  br i1 %omore, label %obody, label %done\nobody:\n  %base = mul i64 %o, %inner\n"] :: (fz row heads toks kinds []) :: ["  br label %head\nhead:\n  %j = phi i64 [ 0, %obody ], [ %j1, %body ]\n  %more = icmp ult i64 %j, %inner\n  br i1 %more, label %body, label %olatch\nbody:\n  %e = add i64 %base, %j\n"] :: body :: ["  %j1 = add nuw i64 %j, 1\n  br label %head, !llvm.loop !7002\nolatch:\n  %o1 = add nuw i64 %o, 1\n  br label %ohead\n"]

fn :: llvm fuse fn Int Int Int String => String
      llvm fuse fn off len kinds prog =
        toks = fz scan prog 0 (str len prog) 0 []
        llvm fuse fn pick off len kinds toks (((fz gathers toks) or (fz reduces toks)) and (fz nested toks))

-- A program that reads by index, or gives one number, and reads along rows at once runs in the
-- runtime.
fn :: llvm fuse fn pick Int Int Int [RFz] Bool => String
      llvm fuse fn pick off len kinds _ True =
        opk = 1000 + kinds
        "define internal i64 @__rg_fuse_{off}_{kinds}(ptr %slots) nounwind {{\nentry:\n  %p = getelementptr inbounds i8, ptr @__rg_rodata, i64 {off}\n  %r = call i64 @__rg_rt_hadamard(i64 {opk}, ptr %slots, i64 0, ptr %p, i64 {len})\n  ret i64 %r\n}}\n\n"
      llvm fuse fn pick off _ kinds toks False =
        llvm fuse fn of off kinds toks (fz leaf kinds toks kinds 0 []) (fz model toks) (fz nested toks)

fn :: llvm fuse fn of Int Int [RFz] [String] Int Bool => String
      llvm fuse fn of off kinds toks lkinds m nested =
        lgm = fz lg (list nth or lkinds m "N")
        nl = list len lkinds
        nla = llvm alloc slots nl
        loads = fz load leaves toks lkinds []
        chk = fz checks toks "true" []
        tabs = fz empty tables toks "false" []
        st = fz finish (fz body toks lkinds 0 (FzSt [] [] [] [] [] [])) 9000
        nout = fz outs toks 0
        gat = fz gathers toks
        head = "  %lk = alloca [{nla} x i64], align 8\n  %lki = ptrtoint ptr %lk to i64\n  %from = alloca i64, align 8\n  store i64 0, ptr %from, align 8\n"
        shape = "  %si = ptrtoint ptr %slots to i64\n  %total = add i64 %n{m}, 0\n  %empty = icmp eq i64 %total, 0\n" + (fz row shape nested m lgm)
        good = "  br i1 " + (fz chk name chk) + ", label %good, label %differ\ndiffer:\n  call void @rg_fuse_shapes()\n  unreachable\ngood:\n" + (fz results (fz tensor outs (fz st outs st)) m lgm nl 0 "") + (join str tree (fz chk code tabs)) + "  %full = xor i1 %empty, true\n  %gbad = and i1 " + (fz chk name tabs) + ", %full\n  br i1 %gbad, label %oob, label %start\noob:\n  call void @rg_oob()\n  unreachable\nstart:\n"
        done = "done:\n" + (fz done check nested) + "  call void @rg_drop_slots(i64 %si, i64 {nl})\n" + (fz give or number (fz st outs st) nout) + "}}\n\n"
        rest = join str tree ([head] :: loads :: [shape] :: (fz chk code chk) :: [good] :: (llvm fuse loops nested toks lkinds (fz st code st) "start" (fz bad lines (fz st flags st) "%bad" 0 "") (fz acc phi (fz st outs st) (fz reduce id toks))) :: [done])
        (llvm fuse dispatch off kinds) + (llvm fuse head off kinds "b" "") + rest + (llvm fuse head off kinds "x" " \"target-features\"=\"+avx,+avx2\"") + rest + (llvm fuse head off kinds "z" " \"target-features\"=\"+avx,+avx2,+avx512f,+avx512bw,+avx512dq,+avx512vl\" \"prefer-vector-width\"=\"512\"") + rest

-- A reduction has no result tensor: its one "result" is `=<kind>`.
fn :: fz tensor outs [String] => [String]
      fz tensor outs (k:[])
        | str starts with k "=" = []
      fz tensor outs outs =  outs

fn :: fz acc phi [String] Int => String
      fz acc phi (k:[]) id
        | str starts with k "=" = "  %acc = phi " + (fz join start (str slice k 1 (str len k)) id) + ", %start ], [ %acc1, %body ]\n"
      fz acc phi _ _ =  ""

fn :: fz give or number [String] Int => String
      fz give or number (k:[]) nout
        | k == "=R" = "  %num = select i1 %empty, double 0.0, double %acc\n  %numv = call i64 @rg_real(double %num)\n  ret i64 %numv\n"
        | str starts with k "=" = "  %num = select i1 %empty, i64 0, i64 %acc\n  %numv = call i64 @__rg_box_i64(i64 %num)\n  ret i64 %numv\n"
      fz give or number _ nout =  fz give nout 0

-- After the loop: an index that was outside its tensor stops the program.
fn :: fz done check Bool => String
      fz done check True =  ""
      fz done check False =  "  br i1 %bad, label %oob, label %fin\nfin:\n"

-- The same loop for the plain instructions (b), AVX2 (x) and AVX-512 (z); the program calls the
-- widest one the machine has (`rg_cpu_level`, fuse.ll).
fn :: llvm fuse head Int Int String String => String
      llvm fuse head off kinds v attrs =  "define internal i64 @__rg_fuse_{off}_{kinds}_{v}(ptr %slots) nounwind noinline" + attrs + " {{\nentry:\n"

fn :: llvm fuse dispatch Int Int => String
      llvm fuse dispatch off kinds =
        "define internal i64 @__rg_fuse_{off}_{kinds}(ptr %slots) nounwind {{\nentry:\n  %l = call i64 @rg_cpu_level()\n  switch i64 %l, label %b [ i64 3, label %x\n    i64 4, label %z ]\nb:\n  %rb = call i64 @__rg_fuse_{off}_{kinds}_b(ptr %slots)\n  ret i64 %rb\nx:\n  %rx = call i64 @__rg_fuse_{off}_{kinds}_x(ptr %slots)\n  ret i64 %rx\nz:\n  %rz = call i64 @__rg_fuse_{off}_{kinds}_z(ptr %slots)\n  ret i64 %rz\n}}\n\n"

-- The programs of a module: one function for each place in the read-only data and each set of
-- kinds. `seen` holds "<off>_<kinds>".
fn :: llvm fuse progs [RNativeFn] [String] [RNativeInstr] => [RNativeInstr]
      llvm fuse progs [] _ acc =  acc
      llvm fuse progs ((NativeFn _ _ _ _ ins):fs) seen acc =
        llvm fuse progs next fs (llvm fuse progs in ins seen acc)

fn :: llvm fuse progs next [RNativeFn] ([String], [RNativeInstr]) => [RNativeInstr]
      llvm fuse progs next fs (seen, acc) =  llvm fuse progs fs seen acc

fn :: llvm fuse progs in [RNativeInstr] [String] [RNativeInstr] => [String] [RNativeInstr]
      llvm fuse progs in [] seen acc =  (seen, acc)
      llvm fuse progs in ((NHadamard opk slot off len):rest) seen acc
        | opk >= 1000 and not (list contains seen ("{off}_{opk}")) = llvm fuse progs in rest (seen :: ["{off}_{opk}"]) (acc :: [NHadamard opk slot off len])
      llvm fuse progs in (_:rest) seen acc =  llvm fuse progs in rest seen acc

fn :: llvm fuse defs [RNativeInstr] String => [String]
      llvm fuse defs [] _ =  []
      llvm fuse defs progs rodata =
        ["declare i64 @rg_cpu_level()\ndeclare i64 @rg_fuse_open(i64, i64, ptr)\ndeclare i64 @rg_fuse_data(i64, i64)\ndeclare i64 @rg_fuse_last(i64, i64)\ndeclare i64 @rg_fuse_take(i64, i64, i64, i64, i64, i64, ptr)\ndeclare void @rg_fuse_shapes() noreturn\ndeclare void @rg_oob() noreturn\ndeclare i64 @rg_real(double)\ndeclare i64 @rg_raw_word(i64)\ndeclare void @rg_drop_slots(i64, i64)\ndeclare i8 @llvm.fshl.i8(i8, i8, i8)\ndeclare i8 @llvm.fshr.i8(i8, i8, i8)\ndeclare i16 @llvm.fshl.i16(i16, i16, i16)\ndeclare i16 @llvm.fshr.i16(i16, i16, i16)\ndeclare i32 @llvm.fshl.i32(i32, i32, i32)\n!7001 = distinct !{{}}\n!7002 = distinct !{{!7002, !{{!\"llvm.loop.parallel_accesses\", !7001}}}}\n\n"] :: (llvm fuse def list progs rodata [])

fn :: llvm fuse def list [RNativeInstr] String [String] => [String]
      llvm fuse def list ((NHadamard opk _ off len):ps) rodata acc =
        llvm fuse def list ps rodata (acc :: [llvm fuse fn off len (opk - 1000) (str slice rodata off (off + len))])
      llvm fuse def list _ _ acc =  acc

fn :: emit llvm ir RNativeProg => String
      emit llvm ir (NativeProg main_fid spawn_fid call2_fid binop_fid fns0 rodata_str) =
        fns = x86 mark ir fns False fns0 []
        rlen = llvm rodata len rodata_str
        resc = llvm escape rodata rodata_str
        mod_hdr = "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\ntarget triple = \"x86_64-unknown-linux-gnu\"\n\n@__rg_page0 = global {{ ptr, ptr, ptr, ptr, [3936 x i8] }} {{ ptr @__rg_fn_{main_fid}, ptr @__rg_fn_{spawn_fid}, ptr @__rg_fn_{call2_fid}, ptr @__rg_fn_{binop_fid}, [3936 x i8] zeroinitializer }}, section \".rg_page0\", align 8\n@__rg_rodata = private unnamed_addr constant [{rlen} x i8] c\"{resc}\", align 16\n\n"
        fn_chunks = emit llvm fn list fns rlen []
        fuse_chunks = llvm fuse defs (llvm fuse progs fns [] []) rodata_str
        join str tree ([mod_hdr, join str tree (llvm inline helper lines), "\n", join str tree (llvm helper declaration lines), "\n"] :: fuse_chunks :: fn_chunks :: ["!0 = !{{}}\n"])

-- ── Linker Script & llc + ld Execution Driver ───────────────

fn :: finish llvm link Int String String => Int
      finish llvm link 0 output_bin tmp_base =
        shell exec ("rm -f \"" + tmp_base + "\".*")
        sys chmod output_bin 493 -> check chmod status
      finish llvm link _ _ tmp_base =
        shell exec ("rm -f \"" + tmp_base + "\".*")
        echo "[ridgunc llvm] Error: llc/ld native compilation failed"
        1

-- The cached runtime and linker script are named by a fingerprint of their
-- content, so a compiler with a different runtime never links a stale copy
-- (a version-only name did: a builtin missing from the old copy crashed or
-- did nothing in LLVM builds while x86-64 builds worked).
fn :: rt fingerprint [Int] Int => Int
      rt fingerprint [] h =  h
      rt fingerprint (b:bs) h =  rt fingerprint bs (((h * 257) + b + 1) % 2147483629)

fn :: check host llc fd Int => Bool
      check host llc fd fd
        | fd >= 0 =
          sys close fd -> ()
          True
        | otherwise = False

fn :: has host llvm toolchain => Bool
      has host llvm toolchain =  check host llc fd (sys open "/usr/bin/llc" 0 0)

-- ── The IR runtime (ADR-0013) ────────────────────────────────
-- An executable for Linux on x86-64 links the IR runtime in place of the old
-- blob (RIDGUN_RUNTIME=old brings the blob back): one object that the compiler carries
-- (`x86rt.ridgun`, generated by src/main/runtime/build-linux-x86_64.sh
-- --module). It is written once to a cache file named by its id, and the
-- program is linked against it at the addresses the old blob used (page 0 at
-- 0x400080, code from 0x401000). Four agents on the Vonkeep benchmark run
-- 4.6 times faster than on the old blob. Shared libraries and the other
-- targets still use the blob.
fn :: ir runtime linker script => String
      ir runtime linker script =
        "ENTRY(_start)\nPHDRS {{\n  all PT_LOAD FILEHDR PHDRS FLAGS(7);\n}}\nSECTIONS {{\n  . = 0x400080;\n  .rg_page0 : {{ KEEP(*(.rg_page0)) }} :all\n  . = 0x401000;\n  .text : ALIGN(16) {{ *(.text .text.*) }} :all\n  .rodata : ALIGN(16) {{ *(.rodata .rodata.*) }} :all\n  .data : ALIGN(16) {{ *(.data .data.*) }} :all\n  .bss : ALIGN(16) {{ *(.bss .bss.* COMMON) }} :all\n  /DISCARD/ : {{ *(.note*) *(.eh_frame*) *(.comment*) }}\n}}\n"

fn :: ir runtime object path => String
      ir runtime object path =  "/tmp/__rg_llvm_rtobj_" + (int to str (x86 rt object id)) + ".o"

-- The cache file of the runtime object: written to a name of this process
-- and renamed, so a compiler running at the same time never reads half of it.
fn :: ensure ir runtime object String => ()
      ensure ir runtime object path
        | check host llc fd (sys open path 0 0) = ()
        | otherwise =
          tmp = path + "." + (int to str (sys getpid))
          write bytes tmp (x86 rt object bytes) -> ()
          rename path tmp path -> ()

-- ── Parallel and memoized LLVM (ADR-0015) ────────────────────
-- A large module is split by `llvm-split` into one part per core (it keeps
-- the symbols the parts share, such as the channel lock); the parts go through
-- `opt` and `llc` together; each object is kept in a cache named by the hash
-- of its part, the optimization level and the LLVM version, so a part that did
-- not change is not compiled again; `ld` links the objects with the runtime.
-- A small module (under 3 MB) takes the plain path, where splitting costs more
-- than it saves. RIDGUN_JOBS sets the number of parts (the number of cores by
-- default; 1 means no split). Measured on the compiler itself: opt and llc
-- from 151 s to 24 s on 16 cores.
fn :: ir build script text => String
      ir build script text =
        l0 = "# usage: LL OUT LDS RTOBJ BASE  (written by ridgunc, ADR-0015; llvm-split runs on a fixed relative name, because the bitcode keeps the name of its input and the cache key is the hash of the part)\n"
        l1 = "ll=$1; out=$2; lds=$3; rt=$4; base=$5\n"
        l2 = "if [ -z \"$RIDGUN_JOBS\" ]; then jobs=$(nproc); else jobs=$RIDGUN_JOBS; fi\n"
        l3 = "size=$(stat -c %s \"$ll\")\n"
        l4 = "if [ \"$size\" -lt 3000000 ] || [ \"$jobs\" -lt 2 ]; then\n"
        l5 = "  /usr/bin/opt -O2 \"$ll\" -o \"$base.bc\" && /usr/bin/llc -O2 -filetype=obj \"$base.bc\" -o \"$base.o\" && /usr/bin/ld -n --no-warn-rwx-segments -T \"$lds\" \"$base.o\" \"$rt\" -o \"$out\"\n"
        l6 = "  exit $?\n"
        l7 = "fi\n"
        l8 = "cache=/tmp/__rg_objcache\n"
        l9 = "mkdir -p \"$cache\" \"$base.d\" || exit 1\n"
        l10 = "find \"$cache\" -name '*.o' -mtime +7 -delete 2> /dev/null\n"
        l11 = "export RG_LLVM=$(/usr/bin/llc --version | md5sum | cut -c1-12)\n"
        l12 = "( cd \"$base.d\" && cp \"$ll\" in.ll && /usr/bin/llvm-split -j \"$jobs\" -o part in.ll && rm in.ll ) || exit 1\n"
        l13 = "ls \"$base.d\"/part* | xargs -P \"$jobs\" -I X sh -c 'k=$(md5sum < X | cut -c1-32)-$RG_LLVM; if [ -s /tmp/__rg_objcache/$k.o ]; then cp /tmp/__rg_objcache/$k.o X.o; else /usr/bin/opt -O2 X -o X.bc && /usr/bin/llc -O2 -filetype=obj X.bc -o X.o && cp X.o /tmp/__rg_objcache/$k.o.tmp$$ && mv /tmp/__rg_objcache/$k.o.tmp$$ /tmp/__rg_objcache/$k.o; fi' || { rm -rf \"$base.d\"; exit 1; }\n"
        l14 = "/usr/bin/ld -n --no-warn-rwx-segments -T \"$lds\" \"$base.d\"/part*.o \"$rt\" -o \"$out\"\n"
        l15 = "rc=$?\n"
        l16 = "rm -rf \"$base.d\"\n"
        l17 = "exit $rc\n"
        join str tree [l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15, l16, l17]

fn :: ir build script location => String
      ir build script location =  "/tmp/__rg_build_" + (int to str (rt fingerprint (str to bytes ir build script text) 13)) + ".sh"

fn :: ensure ir build script file String => ()
      ensure ir build script file path
        | check host llc fd (sys open path 0 0) = ()
        | otherwise =
          tmp = path + "." + (int to str (sys getpid))
          write file tmp ir build script text -> ()
          rename path tmp path -> ()

-- RIDGUN_KEEP_IR=<file> keeps a copy of the LLVM IR of the program, to read what a build made.
fn :: keep llvm ir String String => ()
      keep llvm ir "" _ =  ()
      keep llvm ir path ir_text =  write file path ir_text -> ()

fn :: build llvm ir runtime executable RNativeProg String => Int
      build llvm ir runtime executable nprog output_bin =
        pid_s = int to str (sys getpid)
        tmp_base = "/tmp/__rg_llvm_" + pid_s
        ll_path = tmp_base + ".ll"
        lds_path = tmp_base + ".lds"
        rt_obj = ir runtime object path
        script = ir build script location
        ensure ir runtime object rt_obj
        ensure ir build script file script
        t0 = timing now
        ir_text = emit llvm ir nprog
        write file ll_path ir_text -> ()
        keep llvm ir (sys getenv "RIDGUN_KEEP_IR") ir_text
        ir runtime linker script -> write file lds_path _
        timing report "write the LLVM IR" t0 timing now
        t1 = timing now
        cmd = "sh \"" + script + "\" \"" + ll_path + "\" \"" + output_bin + "\" \"" + lds_path + "\" \"" + rt_obj + "\" \"" + tmp_base + "\""
        status = shell exec cmd
        timing report "LLVM: split, opt, llc, link" t1 timing now
        finish llvm link status output_bin tmp_base

fn :: build llvm x8664 executable RNativeProg String     => Int
      build llvm x8664 executable nprog       output_bin
        | not (has host llvm toolchain) =
          nprog -> emit x8664 elf -> write elf64 executable output_bin _
        | otherwise = build llvm ir runtime executable nprog output_bin

-- ── Real tensor element reads (FR-COMP-020 §2) ───────────────
-- A tensor element is a raw 64-bit word, and `NIndex` returns it as an
-- `Int` (tagged, or boxed with header -2^63). For a `Real` tensor the
-- word holds f64 bits; this builds the `Real` RVal `[0, bits, 0]`.
-- Any other value (a row tensor from a partial index) passes through.

-- ── GenTensor helpers (FR-COMP-020) ──────────────────────────
-- A tensor of non-numeric elements is stored as a List RVal (tag 2):
-- [tag, vec, ...], vec = [cap, buf, len, rc]. `__rg_is_list` and
-- `__rg_is_gen` return the Bool immediates True (6) / False (2).
-- `__rg_list_set` stores an owned value in place and drops the old one;
-- the caller has checked the index.

fn :: llvm gt conv fn Int => String
      llvm gt conv fn 0 =  "@__rg_gt_list_copy(i64 %v_"
      llvm gt conv fn 1 =  "@__rg_gt_list_tensor(i64 %v_"
      llvm gt conv fn 4 =  "@__rg_gt_shape_tensor(i64 %v_"
      llvm gt conv fn 5 =  "@__rg_gt_repeat(i64 %v_"
      llvm gt conv fn _ =  "@__rg_gt_tensor_list(i64 %v_"

fn :: llvm gt conv extra Int => String
      llvm gt conv extra 2 =  ", i64 0"
      llvm gt conv extra 3 =  ", i64 1"
      llvm gt conv extra _ =  ""

