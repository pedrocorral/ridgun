-- ============================================================
-- src/main/ridgun/lib/wasm.ridgun
-- Pure-Ridgun WebAssembly backend: NIR to a wasm32 module (ADR-0011)
-- The runtime is the target-neutral LLVM IR runtime of src/main/runtime/,
-- prebuilt for wasm32 in wasmrt.ridgun and linked here (ADR-0013).
-- @implements FR-COMP-026
-- ============================================================

import elf64
import wasm32
import wasmrt

-- ── Module layout ────────────────────────────────────────────
-- The runtime module comes first: its imports, functions, globals, table and
-- data keep their indices and addresses. Memory: the shadow stack (8 MiB,
-- growing down from its top, overflow traps), then the runtime's data, then
-- the program's rodata, then the heap, which the runtime manages.
-- Ridgun values are i64 words, as on the native targets: a tagged Int
-- (2n + 1), a Bool (6 or 2), Unit (0) or the address of a heap object.

-- Memory pages beyond the rodata at start, for the first heap objects.
fn :: wasm heap pages => Int
      wasm heap pages =  16

-- The program's types, after the runtime's: 0 = NIR function (i32 arguments
-- address) -> i64; 1 = () -> i64; 2 = () -> ().
fn :: wasm types => [WasmType]
      wasm types =  [WasmType [wasm i32] [wasm i64], WasmType [] [wasm i64], WasmType [] []]

-- ── NIR functions ────────────────────────────────────────────
-- Locals of a NIR function: 0 = the arguments address (i32), 1 = the frame
-- address (i32), 2 = the accumulator (i64), 3 = the next block (i32).
-- Slot s of the frame is the i64 at frame + 8s.

-- Slots, labels (label id -> block index), functions (fid -> function index),
-- runtime functions (k -> function index) and the stack pointer global.
type WasmCtx = WasmCtx Int [RLabelEntry] [RLabelEntry] [RLabelEntry] Int

fn :: wasm ns WasmCtx => Int
      wasm ns (WasmCtx ns _ _ _ _) =  ns

fn :: wasm sp WasmCtx => Int
      wasm sp (WasmCtx _ _ _ _ sp) =  sp

fn :: wasm frame Int => [Int]
      wasm frame s =  (w local get 1) :: (w i32 const (s * 8)) :: w i32 add :: w i64 extend u

fn :: wasm fp64 => [Int]
      wasm fp64 =  (w local get 1) :: w i64 extend u

fn :: wasm peek Int => [Int]
      wasm peek s =  (w local get 1) :: (w i64 load (s * 8))

fn :: wasm acc => [Int]
      wasm acc =  w local get 2

-- Call runtime function k with the arguments already pushed. A function the
-- runtime does not have stops the program there.
fn :: wasm rt Int WasmCtx => [Int]
      wasm rt k (WasmCtx _ _ _ rts _) =  wasm rt call (lookup label offset rts k)

fn :: wasm rt call Int => [Int]
      wasm rt call idx
        | idx < 0 = w unreachable
        | otherwise = w call idx

-- Call runtime function k with the arguments already pushed; its result is the accumulator.
fn :: wasm rt acc Int WasmCtx => [Int]
      wasm rt acc k ctx =  (wasm rt k ctx) :: (w local set 2)

fn :: wasm c Int => [Int]
      wasm c v =  w i64 const v

-- Continue at block j, `d` labels away from the dispatch loop.
fn :: wasm goto Int Int => [Int]
      wasm goto j d =  (w i32 const j) :: (w local set 3) :: (w br d)

fn :: wasm label Int WasmCtx => Int
      wasm label lid (WasmCtx _ lbls _ _ _) =  lookup label offset lbls lid

-- One NIR instruction; `d` is the depth of the dispatch loop.
fn :: wasm instr RNativeInstr Int Int WasmCtx => [Int]
      wasm instr (NLabel _) _ _ ctx = []
      wasm instr (NJump lid) d _ ctx =
        wasm goto (wasm label lid ctx) d
      wasm instr (NJumpIfZero lid) d _ ctx =
        wasm acc :: w i64 eqz :: w if :: (wasm goto (wasm label lid ctx) (d + 1)) :: w end
      wasm instr (NJumpIfNonZero lid) d _ ctx =
        wasm acc :: w i64 eqz :: w i32 eqz :: w if :: (wasm goto (wasm label lid ctx) (d + 1)) :: w end
      wasm instr (NLoadImmInt n) _ _ ctx =  (wasm c ((n * 2) + 1)) :: (w local set 2)
      wasm instr (NLoadImmRaw raw) _ _ ctx =  (wasm c raw) :: (w local set 2)
      wasm instr (NLoadRealLit off len) _ ro ctx =  (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 11 ctx)
      wasm instr (NLoadStrLit off len) _ ro ctx =  (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 12 ctx)
      -- `sys os` and `sys arch`: the constructors `Linux` and `X86_64` of the rodata pool.
      wasm instr (NLoadAdt0 -2 0) _ ro ctx =  (wasm c (ro + 5)) :: (wasm c 5) :: (wasm rt acc 13 ctx)
      wasm instr (NLoadAdt0 -1 0) _ ro ctx =  (wasm c (ro + 22)) :: (wasm c 6) :: (wasm rt acc 13 ctx)
      wasm instr (NLoadAdt0 off len) _ ro ctx =  (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 13 ctx)
      wasm instr (NCloneSlot s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 5 ctx)
      wasm instr (NPeekSlot s) _ _ ctx =  (wasm peek s) :: (w local set 2)
      wasm instr (NForgetSlot s) _ _ ctx =  (w local get 1) :: (wasm c 0) :: (w i64 store (s * 8))
      wasm instr (NMoveSlot s) _ _ ctx =  (wasm frame s) :: (wasm rt acc 7 ctx)
      wasm instr (NStoreSlot s) _ _ ctx =  (wasm frame s) :: wasm acc :: (wasm rt acc 8 ctx)
      wasm instr (NRebindSlot s) _ _ ctx =  (wasm frame s) :: wasm acc :: (wasm rt acc 9 ctx)
      wasm instr (NCmmDropSlot s) _ _ ctx =  (wasm frame s) :: (wasm rt acc 10 ctx)
      wasm instr NDropVal _ _ ctx =  wasm acc :: (wasm rt acc 6 ctx)
      wasm instr (NClearLocals s e) _ _ ctx =  wasm fp64 :: (wasm c s) :: (wasm c e) :: (wasm rt acc 4 ctx)
      wasm instr (NMatchInt s n) _ _ ctx =  (wasm peek s) :: (wasm c n) :: (wasm rt acc 21 ctx)
      wasm instr (NMatchReal s off len) _ ro ctx =  (wasm peek s) :: (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 22 ctx)
      wasm instr (NMatchStr s off len) _ ro ctx =  (wasm peek s) :: (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 23 ctx)
      wasm instr (NMatchBool s b) _ _ ctx =  (wasm peek s) :: (wasm c b) :: (wasm rt acc 24 ctx)
      wasm instr (NMatchEmpty s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 25 ctx)
      wasm instr (NMatchNonEmpty s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 26 ctx)
      wasm instr (NMatchTuple s ar) _ _ ctx =  (wasm peek s) :: (wasm c ar) :: (wasm rt acc 29 ctx)
      -- A negative arity names a fixed check (as on x86_64); the runtime does it.
      wasm instr (NMatchAdt s off len ar) _ ro ctx =  (wasm peek s) :: (wasm c (ro + off)) :: (wasm c len) :: (wasm c ar) :: (wasm rt acc 31 ctx)
      wasm instr (NListHead s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 27 ctx)
      wasm instr (NListTail s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 28 ctx)
      wasm instr (NTupleGet s i) _ _ ctx =  (wasm peek s) :: (wasm c i) :: (wasm rt acc 30 ctx)
      wasm instr (NAdtField s i) _ _ ctx =  (wasm peek s) :: (wasm c i) :: (wasm rt acc 32 ctx)
      wasm instr (NPackSeq ar) _ _ ctx =  wasm fp64 :: (wasm c ar) :: (wasm rt acc 19 ctx)
      wasm instr NRealFromBits _ _ ctx =  wasm acc :: (wasm rt acc 62 ctx)
      wasm instr NRealToBits _ _ ctx =  wasm acc :: (wasm rt acc 63 ctx)
      wasm instr (NIsList s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 56 ctx)
      wasm instr (NIsGen s) _ _ ctx =  (wasm peek s) :: (wasm rt acc 57 ctx)
      wasm instr (NListSet b i) _ _ ctx =  (wasm peek b) :: (wasm peek i) :: wasm acc :: (wasm rt acc 58 ctx)
      wasm instr (NListGet b i) _ _ ctx =  (wasm peek b) :: (wasm peek i) :: (wasm rt acc 59 ctx)
      wasm instr (NSortBy s mode) _ _ ctx =  (wasm peek s) :: (wasm peek (s + 1)) :: (wasm c mode) :: (wasm rt acc 60 ctx)
      wasm instr (NGtConv s mode) _ _ ctx =  (wasm peek s) :: (wasm c mode) :: wasm acc :: (wasm rt acc 61 ctx)
      -- `@` on Real tensors: no fast path; 0 makes the loops run (as on x86_64).
      wasm instr (NEinsumReal _ _ _ _) _ _ ctx =  (wasm c 0) :: (w local set 2)
      wasm instr NAsBool _ _ ctx =  wasm acc :: (wasm rt acc 20 ctx)
      -- `not` of a tagged Int flips its bits and keeps the tag; others go to the runtime.
      wasm instr NNot _ _ ctx =
        wasm acc :: (wasm c 1) :: w i64 band :: w i64 eqz :: w if :: wasm acc :: (wasm rt acc 34 ctx) :: w else :: wasm acc :: (wasm c (0 - 2)) :: w i64 bxor :: (w local set 2) :: w end
      wasm instr NOut _ _ ctx =  wasm acc :: (wasm rt acc 35 ctx)
      wasm instr (NBinOp o lhs) _ _ ctx =  (wasm c o) :: (wasm frame lhs) :: wasm acc :: (wasm rt acc 37 ctx)
      wasm instr (NAdtSet r i) _ _ ctx =  (wasm frame r) :: (wasm c i) :: wasm acc :: (wasm rt acc 33 ctx)
      wasm instr (NMakeList s n) _ _ ctx =  (wasm frame s) :: (wasm c n) :: (wasm rt acc 15 ctx)
      wasm instr (NMakeTuple s n) _ _ ctx =  (wasm frame s) :: (wasm c n) :: (wasm rt acc 16 ctx)
      wasm instr (NMakeTensor s n) _ _ ctx =  (wasm frame s) :: (wasm c n) :: (wasm rt acc 17 ctx)
      wasm instr (NMakeAdt off len s n) _ ro ctx =  (wasm c (ro + off)) :: (wasm c len) :: (wasm frame s) :: (wasm c n) :: (wasm rt acc 14 ctx)
      wasm instr (NEcho s n) _ _ ctx =  (wasm frame s) :: (wasm c n) :: (wasm rt acc 36 ctx)
      wasm instr (NStrInterp s n) _ _ ctx =  (wasm frame s) :: (wasm c n) :: (wasm rt acc 18 ctx)
      -- A negative count is a borrowed base (as on x86_64); the runtime does it.
      wasm instr (NIndex b i n) _ _ ctx =  (wasm frame b) :: (wasm frame i) :: (wasm c n) :: (wasm rt acc 38 ctx)
      wasm instr (NIndexSet b i n) _ _ ctx =  (wasm frame b) :: (wasm frame i) :: (wasm c n) :: wasm acc :: (wasm rt acc 39 ctx)
      wasm instr (NSeqSelect off len) _ ro ctx =  wasm acc :: (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 40 ctx)
      wasm instr (NEinsum s n off len) _ ro ctx =  (wasm frame s) :: (wasm c n) :: (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 41 ctx)
      wasm instr (NHadamard o lhs off len) _ ro ctx =  (wasm c o) :: (wasm frame lhs) :: wasm acc :: (wasm c (ro + off)) :: (wasm c len) :: (wasm rt acc 42 ctx)
      wasm instr NEnterRegion _ _ ctx =  wasm rt acc 47 ctx
      wasm instr (NExitRegion quota) _ _ ctx =  (wasm c quota) :: wasm acc :: (wasm rt acc 48 ctx)
      wasm instr (NCallFn fid s _) _ _ (WasmCtx _ _ fns _ _) =
        (w local get 1) :: (w i32 const (s * 8)) :: w i32 add :: (w call (lookup label offset fns fid)) :: (w local set 2)
      -- `str char at s i` on a local `s` (builtin 91): s stays in its slot, i is the accumulator.
      wasm instr (NCallBuiltin 91 s _) _ _ ctx =  (wasm peek s) :: wasm acc :: (wasm rt acc 64 ctx)
      -- Builtin ids with their own x86_64 routines are told apart by the runtime.
      wasm instr (NCallBuiltin b s n) _ _ ctx =  (wasm c b) :: (wasm frame s) :: (wasm c n) :: (wasm rt acc 55 ctx)
      wasm instr (NCallIndirect1 f a) _ _ ctx =  (wasm peek f) :: (wasm frame a) :: (wasm rt acc 53 ctx)
      wasm instr (NCallIndirect2 f s) _ _ ctx =  (wasm peek f) :: (wasm frame s) :: (wasm rt acc 54 ctx)
      -- A self tail call moves the arguments to slots 0.. and starts the body again.
      wasm instr (NTailCall s ar) d _ ctx =
        wasm fp64 :: (wasm c s) :: (wasm c ar) :: (wasm c (wasm ns ctx)) :: (wasm rt acc 3 ctx) :: (wasm goto 0 d)
      -- A tail call to another function (OPT-019), as on x86-64: the arguments move to slots
      -- 0.. and every other slot is dropped (tco_copy), then to the base of a frame of the
      -- callee's size at the top of ours (tail_frame); our frame is given back and
      -- `return_call` jumps to the callee, which returns straight to our caller.
      wasm instr (NTailCallFn fid s n cs) d ro (WasmCtx ns lbls fns rts sp)
        | n >= 0 and cs >= n =
          ctx = WasmCtx ns lbls fns rts sp
          copy = wasm fp64 :: (wasm c s) :: (wasm c n) :: (wasm c ns) :: (wasm rt acc 3 ctx)
          move = wasm fp64 :: (wasm c ns) :: (wasm c n) :: (wasm c cs) :: (wasm rt acc 65 ctx)
          release = (w local get 1) :: (w i32 const (ns * 8)) :: w i32 add :: (w global set sp)
          jump = wasm acc :: w i32 wrap :: (w return call (lookup label offset fns fid))
          copy :: move :: release :: jump
        | otherwise =
          ctx = WasmCtx ns lbls fns rts sp
          (wasm instr (NCallFn fid s n) d ro ctx) :: (wasm instr NReturn d ro ctx)
      wasm instr NReturn _ _ ctx =
        wasm fp64 :: (wasm c (wasm ns ctx)) :: wasm acc :: (wasm rt acc 2 ctx) :: (w local get 1) :: (w i32 const ((wasm ns ctx) * 8)) :: w i32 add :: (w global set (wasm sp ctx)) :: wasm acc :: w return

fn :: wasm instrs [RNativeInstr] Int Int WasmCtx [Int] => [Int]
      wasm instrs [] _ _ _ acc = acc
      wasm instrs (i:is) d ro ctx acc = wasm instrs is d ro ctx (acc :: (wasm instr i d ro ctx))

-- The blocks of a function: the instructions before the first label, then one per label.
fn :: wasm blocks [RNativeInstr] [RNativeInstr] [[RNativeInstr]] => [[RNativeInstr]]
      wasm blocks [] cur acc = acc :: [cur]
      wasm blocks ((NLabel _):rest) cur acc = wasm blocks rest [] (acc :: [cur])
      wasm blocks (i:rest) cur acc = wasm blocks rest (cur :: [i]) acc

-- Label id -> block index (the first label starts block 1).
fn :: wasm label table [RNativeInstr] Int [RLabelEntry] => [RLabelEntry]
      wasm label table [] _ acc = acc
      wasm label table ((NLabel lid):rest) k acc = wasm label table rest (k + 1) (acc :: [LabelEntry lid (k + 1)])
      wasm label table (_:rest) k acc = wasm label table rest k acc

-- Block k of n follows the end of its wasm block, inside the n - 1 - k outer ones.
fn :: wasm blocks code [[RNativeInstr]] Int Int Int WasmCtx [Int] => [Int]
      wasm blocks code [] _ _ _ _ acc = acc
      wasm blocks code (b:bs) k n ro ctx acc =
        code = wasm instrs b (n - 1 - k) ro ctx []
        wasm blocks code bs (k + 1) n ro ctx (acc :: (w end) :: code)

fn :: wasm repeat [Int] Int [Int] => [Int]
      wasm repeat _ 0 acc = acc
      wasm repeat xs n acc = wasm repeat xs (n - 1) (acc :: xs)

fn :: wasm range Int Int [Int] => [Int]
      wasm range lo hi acc
        | lo >= hi = acc
        | otherwise = wasm range (lo + 1) hi (acc :: [lo])

-- Take a frame of `ns` slots from the shadow stack and move the `arity`
-- arguments into it. A stack overflow wraps below address 0 and traps.
fn :: wasm prologue Int Int WasmCtx => [Int]
      wasm prologue arity ns ctx =
        take = (w global get (wasm sp ctx)) :: (w i32 const (ns * 8)) :: w i32 sub :: (w local tee 1) :: (w global set (wasm sp ctx))
        init = wasm fp64 :: (w local get 0) :: w i64 extend u :: (wasm c arity) :: (wasm c ns) :: (wasm rt 1 ctx) :: w drop
        take :: init

-- A NIR function: a loop around a `br_table` that selects the next block.
fn :: wasm nir func RNativeFn [RLabelEntry] [RLabelEntry] Int Int Int => WasmFunc
      wasm nir func (NativeFn _ _ arity ns instrs) fns rts sp ro ty =
        blocks = wasm blocks instrs [] []
        n = list len blocks
        ctx = WasmCtx ns (wasm label table instrs 0 []) fns rts sp
        dispatch = (w local get 3) :: (w br table (wasm range 0 n []) (n - 1))
        body = (wasm prologue arity ns ctx) :: w loop :: (wasm repeat (w block) n []) :: dispatch :: (wasm blocks code blocks 0 n ro ctx []) :: w end :: w unreachable
        WasmFunc ty [wasm i32, wasm i64, wasm i32] body

-- fid -> function index, in the order of the functions.
fn :: wasm fn table [RNativeFn] Int [RLabelEntry] => [RLabelEntry]
      wasm fn table [] _ acc = acc
      wasm fn table ((NativeFn fid _ _ _ _):rest) idx acc = wasm fn table rest (idx + 1) (acc :: [LabelEntry fid idx])

-- ── Runtime ──────────────────────────────────────────────────
-- Runtime function k is the export `__rg_rt_<name>` of the runtime module,
-- with the names of the LLVM backend (`llvm runtime declarations`). Every
-- parameter and the result are i64 words (addresses too).

fn :: wasm rt name Int => String
      wasm rt name 0  =  "start"
      wasm rt name 1  =  "init_frame"
      wasm rt name 2  =  "epilogue"
      wasm rt name 3  =  "tco_copy"
      wasm rt name 4  =  "clear_locals"
      wasm rt name 5  =  "clone_slot"
      wasm rt name 6  =  "drop_val"
      wasm rt name 7  =  "cmm_move"
      wasm rt name 8  =  "store_slot"
      wasm rt name 9  =  "rebind_slot"
      wasm rt name 10 =  "cmm_drop_slot"
      wasm rt name 11 =  "load_real_lit"
      wasm rt name 12 =  "load_str_lit"
      wasm rt name 13 =  "load_adt0"
      wasm rt name 14 =  "make_adt"
      wasm rt name 15 =  "make_list"
      wasm rt name 16 =  "make_tuple"
      wasm rt name 17 =  "make_tensor"
      wasm rt name 18 =  "str_interp"
      wasm rt name 19 =  "pack_seq"
      wasm rt name 20 =  "as_bool"
      wasm rt name 21 =  "match_int"
      wasm rt name 22 =  "match_real"
      wasm rt name 23 =  "match_str"
      wasm rt name 24 =  "match_bool"
      wasm rt name 25 =  "match_empty"
      wasm rt name 26 =  "match_nonempty"
      wasm rt name 27 =  "list_head"
      wasm rt name 28 =  "list_tail"
      wasm rt name 29 =  "match_tuple"
      wasm rt name 30 =  "tuple_get"
      wasm rt name 31 =  "match_adt"
      wasm rt name 32 =  "adt_field"
      wasm rt name 33 =  "adt_set"
      wasm rt name 34 =  "bool_inv"
      wasm rt name 35 =  "out"
      wasm rt name 36 =  "echo"
      wasm rt name 37 =  "bin_op"
      wasm rt name 38 =  "index"
      wasm rt name 39 =  "index_set"
      wasm rt name 40 =  "seq_select"
      wasm rt name 41 =  "einsum"
      wasm rt name 42 =  "hadamard"
      wasm rt name 47 =  "enter_region"
      wasm rt name 48 =  "exit_region"
      wasm rt name 53 =  "call_indirect1"
      wasm rt name 54 =  "call_indirect2"
      wasm rt name 55 =  "builtin"
      wasm rt name 56 =  "is_list"
      wasm rt name 57 =  "is_gen"
      wasm rt name 58 =  "list_set"
      wasm rt name 59 =  "list_get"
      wasm rt name 60 =  "sort_by"
      wasm rt name 61 =  "gt_conv"
      wasm rt name 62 =  "real_from_bits"
      wasm rt name 63 =  "real_to_bits"
      wasm rt name 64 =  "char_at"
      wasm rt name 65 =  "tail_frame"
      wasm rt name _  =  ""

-- k -> function index of the runtime exports (-1 for a name it does not export).
fn :: wasm rt table [WasmLinkExport] Int [RLabelEntry] => [RLabelEntry]
      wasm rt table es k acc
        | k > 65 = acc
        | otherwise = wasm rt table es (k + 1) (acc :: [LabelEntry k (wasm rt export es k)])

fn :: wasm rt export [WasmLinkExport] Int => Int
      wasm rt export es k
        | (wasm rt name k) == "" = 0 - 1
        | otherwise = wasm export index es ("__rg_rt_" + (wasm rt name k))

-- ── Module ───────────────────────────────────────────────────

fn :: wasm align16 Int => Int
      wasm align16 v =  ((v + 15) / 16) * 16

-- The module of a NIR program, linked to the runtime. The program's
-- functions follow the runtime's; they are also put in the runtime's table
-- after its own entries, so the runtime can call them (`call_indirect`):
-- function value of fid = table base + its position. Exports: the memory,
-- `ridgun_main` (runs main, gives its value) and `_start` (runs main).
-- Both first call the runtime's `start` with the heap start and the function
-- values of main and of the spawn, call2 and binop dispatchers.
fn :: emit wasm module RNativeProg => [Int]
      emit wasm module (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) =
        secs = wasm parse module (wasm hex bytes (wasm rt module hex))
        es = wasm read exports secs
        n_types = wasm count of (wasm section of 1 secs)
        n_imports = wasm count of (wasm section of 2 secs)
        n_rtf = wasm count of (wasm section of 3 secs)
        nir_base = n_imports + n_rtf
        rts = wasm rt table es 0 []
        sp = wasm export index es "__stack_pointer"
        ro_base = wasm align16 (wasm global init secs (wasm export index es "__heap_base"))
        ro = str to bytes rodata_str
        heap_start = wasm align16 (ro_base + (list len ro))
        pages = (heap_start / 65536) + 1 + (wasm heap pages)
        tbase = wasm table min secs
        nfns = list len fns
        fn_tbl = wasm fn table fns nir_base []
        nir = map (f => wasm nir func f fn_tbl rts sp ro_base n_types) fns
        main_idx = nir_base + nfns
        e_of = map (fid => wasm c (tbase + (lookup label offset fn_tbl fid) - nir_base)) [main_fid, spawn_fid, call2_fid, binop_fid]
        boot = (wasm c heap_start) :: (wasm concat e_of) :: (wasm rt call (lookup label offset rts 0))
        f_main = WasmFunc (n_types + 1) [] boot
        f_start = WasmFunc (n_types + 2) [] ((w call main_idx) :: w drop)
        funcs = nir :: [f_main, f_start]
        types = map (t => wasm type item t) (wasm types)
        s1 = wasm raw section 1 (n_types + 3) ((wasm body of (wasm section of 1 secs)) :: (wasm concat types))
        s2 = wasm raw section 2 n_imports (wasm body of (wasm section of 2 secs))
        s3 = wasm raw section 3 (n_rtf + nfns + 2) ((wasm body of (wasm section of 3 secs)) :: (wasm concat (map (f => wasm func index item f) funcs)))
        s4 = wasm raw section 4 1 ([112, 0] :: (wasm uleb (tbase + nfns)))
        s5 = wasm section 5 (wasm memory items pages 0)
        s6 = wasm raw section 6 (wasm count of (wasm section of 6 secs)) (wasm body of (wasm section of 6 secs))
        e_mem = WasmExport "memory" (wasm export memory) 0
        e_main = WasmExport "ridgun_main" (wasm export func) main_idx
        e_start = WasmExport "_start" (wasm export func) (main_idx + 1)
        s7 = wasm section 7 (map (x => wasm export item x) [e_mem, e_main, e_start])
        elem = [0] :: ((w i32 const tbase) :: (w end :: (wasm vec (map (i => wasm uleb i) (wasm range nir_base (nir_base + nfns) [])))))
        n_elem = wasm count of (wasm section of 9 secs)
        s9 = wasm raw section 9 (n_elem + 1) ((wasm body of (wasm section of 9 secs)) :: elem)
        s10 = wasm raw section 10 (n_rtf + nfns + 2) ((wasm body of (wasm section of 10 secs)) :: (wasm concat (map (f => wasm code item f) funcs)))
        n_data = wasm count of (wasm section of 11 secs)
        s11 = wasm raw section 11 (n_data + 1) ((wasm body of (wasm section of 11 secs)) :: (wasm data item (WasmData ro_base ro)))
        wasm concat [wasm header, s1, s2, s3, s4, s5, s6, s7, s9, s10, s11]
