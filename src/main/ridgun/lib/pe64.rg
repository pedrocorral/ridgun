-- ============================================================
-- src/main/ridgun/lib/pe64.rg
-- Pure-Ridgun Windows 64-bit PE32+ (.exe & .dll) Binary Emitter
-- x86_64: Windows system layer in `.rgsys` (ADR-0007); arm64: Linux runtime only
-- Supports x86_64-windows (IMAGE_FILE_MACHINE_AMD64 = 0x8664)
-- and arm64-windows (IMAGE_FILE_MACHINE_ARM64 = 0xAA64)
-- with KERNEL32.dll Import Directory / IAT (.idata)
-- @implements FR-COMP-015
-- ============================================================

import elf64
import x86_64
import arm64

module :: root

fn :: pad pe str String Int       => [Int]
      pad pe str s      total_len =
        bs = str to bytes s
        blen = str len s
        bs :: (zero bytes (total_len - blen))

-- ── Target-Specific Instruction Specialization (Windows) ─────

fn :: specialize windows instr RNativeInstr     => RNativeInstr
      specialize windows instr (NLoadAdt0 -2 0) =  NLoadAdt0 15 7
      specialize windows instr (NLoadAdt0 5 5)  =  NLoadAdt0 15 7
      specialize windows instr ins              =  ins

fn :: specialize windows instr list [RNativeInstr] [RNativeInstr] => [RNativeInstr]
      specialize windows instr list [] acc = acc
      specialize windows instr list (i:is) acc =
        specialize windows instr list is (acc :: [specialize windows instr i])

fn :: specialize windows fn RNativeFn => RNativeFn
      specialize windows fn (NativeFn fid name arity nslots instrs) =
        NativeFn fid name arity nslots (specialize windows instr list instrs [])

fn :: specialize windows fn list [RNativeFn] [RNativeFn] => [RNativeFn]
      specialize windows fn list [] acc = acc
      specialize windows fn list (f:fs) acc =
        specialize windows fn list fs (acc :: [specialize windows fn f])

fn :: specialize nprog for windows RNativeProg => RNativeProg
      specialize nprog for windows (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) =
        NativeProg main_fid spawn_fid call2_fid binop_fid (specialize windows fn list fns []) rodata_str

-- ── DOS Header (64B) + Stub (64B) + Page0 Dispatch (32B) ─────

fn :: build pe64 dos and page0 Int Int Int Int => [Int]
      build pe64 dos and page0 main_vaddr spawn_vaddr call2_vaddr binop_vaddr =
        -- Offset 0..64: IMAGE_DOS_HEADER ('MZ' at 0, e_lfanew = 256 at 0x3C)
        dos_hdr = [77, 90, 144, 0, 3, 0, 0, 0, 4, 0, 0, 0, 255, 255, 0, 0, 184, 0, 0, 0, 0, 0, 0, 0, 64, 0, 0, 0, 0, 0, 0, 0] :: (zero bytes 28) :: (u32 le 256)
        -- Offset 64..128: 64-byte DOS stub
        dos_stub = [14, 31, 186, 14, 0, 180, 9, 205, 33, 184, 1, 76, 205, 33] :: (pad pe str "This program requires 64-bit Windows.\r\n$" 50)
        -- Offset 128..160 (0x400080..0x4000A0): Ridgun page-0 dispatch table pointers
        table_ptrs = (u64 le main_vaddr) :: (u64 le spawn_vaddr) :: (u64 le call2_vaddr) :: (u64 le binop_vaddr)
        -- Offset 160..256: 96 zero bytes before PE\0\0 at 256 (0x100)
        dos_hdr :: dos_stub :: table_ptrs :: (zero bytes 96)

-- ── COFF Header (20B) + Optional Header PE32+ (240B) ─────────

fn :: build pe64 coff header Int Int => [Int]
      build pe64 coff header machine chars =
        -- "PE\0\0" (4B) + Machine (2B) + NumberOfSections=2 (2B) + TimeDateStamp=0 (4B) + SymTable=0 (8B) + SizeOfOpt=240 (2B) + Characteristics (2B)
        [80, 69, 0, 0] :: (u16 le machine) :: (u16 le 2) :: (u32 le 0) :: (u32 le 0) :: (u32 le 0) :: (u16 le 240) :: (u16 le chars)

fn :: build pe64 data directories Int       => [Int]
      build pe64 data directories idata_rva =
        -- 16 IMAGE_DATA_DIRECTORY entries (128 bytes): [1] = Import Table (40B), [12] = IAT (64B)
        dir0 = (u32 le 0) :: (u32 le 0)
        dir1_import = (u32 le idata_rva) :: (u32 le 40)
        dir2_to_11 = zero bytes 80
        dir12_iat = (u32 le (idata_rva + 128)) :: (u32 le 64)
        dir13_to_15 = zero bytes 24
        dir0 :: dir1_import :: dir2_to_11 :: dir12_iat :: dir13_to_15

fn :: build pe64 optional header Int Int => [Int]
      build pe64 optional header text_aligned idata_rva =
        -- Magic = 0x020B (523), EntryPoint = 0x1000 (4096), ImageBase = 0x400000 (4194304)
        size_of_image = 4096 + text_aligned + 4096 + 131072
        std_fields = (u16 le 523) :: [14, 0] :: (u32 le text_aligned) :: (u32 le 4096) :: (u32 le 131072) :: (u32 le 4096) :: (u32 le 4096)
        win_fields1 = (u64 le 4194304) :: (u32 le 4096) :: (u32 le 4096) :: (u16 le 6) :: (u16 le 0) :: (u16 le 0) :: (u16 le 0) :: (u16 le 6) :: (u16 le 0) :: (u32 le 0)
        win_fields2 = (u32 le size_of_image) :: (u32 le 4096) :: (u32 le 0) :: (u16 le 3) :: (u16 le 0) :: (u64 le 8388608) :: (u64 le 65536) :: (u64 le 16777216) :: (u64 le 65536) :: (u32 le 0) :: (u32 le 16)
        std_fields :: win_fields1 :: win_fields2 :: (build pe64 data directories idata_rva)

fn :: build pe64 section headers Int Int Int => [Int]
      build pe64 section headers payload_len text_aligned idata_rva =
        -- Section 1: .text (RVA = 4096, VirtualSize = text_aligned + 131072, RawData = 4096, Characteristics = 0xE0000060 = 3758096480)
        text_vsize = text_aligned + 131072
        s_text = (pad pe str ".text" 8) :: (u32 le text_vsize) :: (u32 le 4096) :: (u32 le text_aligned) :: (u32 le 4096) :: (u32 le 0) :: (u32 le 0) :: (u16 le 0) :: (u16 le 0) :: (u32 le 3758096480)
        -- Section 2: .idata (RVA = idata_rva, VirtualSize = 4096, RawOffset = 4096 + text_aligned, Characteristics = 0xC0000040 = 3221225536)
        idata_raw_off = 4096 + text_aligned
        s_idata = (pad pe str ".idata" 8) :: (u32 le 4096) :: (u32 le idata_rva) :: (u32 le 4096) :: (u32 le idata_raw_off) :: (u32 le 0) :: (u32 le 0) :: (u16 le 0) :: (u16 le 0) :: (u32 le 3221225536)
        s_text :: s_idata

-- ── KERNEL32.dll Import Section (.idata, 4096B) ──────────────

fn :: build pe64 hint name String Int => [Int]
      build pe64 hint name sym padded_len =
        (u16 le 0) :: (pad pe str sym (padded_len - 2))

fn :: build pe64 idata section Int       => [Int]
      build pe64 idata section idata_rva =
        -- Layout inside .idata (4096 bytes at RVA = idata_rva):
        -- 0..40   : IMAGE_IMPORT_DESCRIPTOR for KERNEL32.dll + null terminator descriptor
        -- 40..64  : "KERNEL32.dll\0" padded to 24 bytes
        -- 64..128 : Import Lookup Table (ILT: 7 x u64 + null u64 = 64 bytes)
        -- 128..192: Import Address Table (IAT: 7 x u64 + null u64 = 64 bytes)
        -- 192..416: Hint/Name entries (7 x 32 bytes = 224 bytes)
        ilt_rva = idata_rva + 64
        name_rva = idata_rva + 40
        iat_rva = idata_rva + 128
        hn_base = idata_rva + 192
        imp_desc = (u32 le ilt_rva) :: (u32 le 0) :: (u32 le 0) :: (u32 le name_rva) :: (u32 le iat_rva) :: (zero bytes 20)
        dll_name = pad pe str "KERNEL32.dll" 24
        thunks = (u64 le (hn_base + 0)) :: (u64 le (hn_base + 32)) :: (u64 le (hn_base + 64)) :: (u64 le (hn_base + 96)) :: (u64 le (hn_base + 128)) :: (u64 le (hn_base + 160)) :: (u64 le (hn_base + 192)) :: (u64 le 0)
        hns = (build pe64 hint name "GetStdHandle" 32) :: (build pe64 hint name "WriteFile" 32) :: (build pe64 hint name "ReadFile" 32) :: (build pe64 hint name "CreateFileA" 32) :: (build pe64 hint name "CloseHandle" 32) :: (build pe64 hint name "VirtualAlloc" 32) :: (build pe64 hint name "ExitProcess" 32)
        imp_desc :: dll_name :: thunks :: thunks :: hns :: (zero bytes (4096 - 416))

fn :: build pe64 page0 Int Int Int Int Int Int Int Int Int => [Int]
      build pe64 page0 machine chars payload_len text_aligned idata_rva main_vaddr spawn_vaddr call2_vaddr binop_vaddr =
        dos_block = build pe64 dos and page0 main_vaddr spawn_vaddr call2_vaddr binop_vaddr
        coff = build pe64 coff header machine chars
        opt = build pe64 optional header text_aligned idata_rva
        sects = build pe64 section headers payload_len text_aligned idata_rva
        -- 256 + 24 + 240 + 80 = 600 bytes; pad 3496 bytes to reach 4096 (0x1000)
        dos_block :: coff :: opt :: sects :: (zero bytes (4096 - 600))

fn :: build pe64 image kind Int Int Int Int Int Int [Int] Int [Int] Int String => [Int]
      build pe64 image kind machine chars main_vaddr spawn_vaddr call2_vaddr binop_vaddr rt_bytes rt_len code_bytes code_len rodata_str =
        rodata_bytes = str to bytes rodata_str
        rodata_len = str len rodata_str
        payload_len = rt_len + code_len + rodata_len
        text_aligned = align up payload_len 4096
        pad_text = zero bytes (text_aligned - payload_len)
        idata_rva = 4096 + text_aligned + 131072
        page0 = build pe64 page0 machine chars payload_len text_aligned idata_rva main_vaddr spawn_vaddr call2_vaddr binop_vaddr
        idata = build pe64 idata section idata_rva
        page0 :: rt_bytes :: code_bytes :: rodata_bytes :: pad_text :: idata

-- ── Public Windows x86_64 & ARM64 PE32+ Image Builders ───────

-- ── Windows x86_64 System Layer (FR-COMP-015, ADR-0007) ───────
--
-- The x86_64 runtime and the code generator make Linux system calls. In a
-- Windows image each `syscall` (15, 5) becomes `ud2` (15, 11), and the
-- section `.rgsys` holds a translation layer (`rtw.c`, docs/etc/runtime_windows.md):
-- it starts the image, catches the `ud2` with a vectored exception handler
-- and does the call with KERNEL32.
--
-- Image layout (ImageBase 0x400000, no relocations):
--   page 0      : DOS header, page-0 dispatch table (0x80..0xA0), PE headers at 0x400;
--                 the runtime's page-0 variables (0x158..0x178, 0xF00..0x1000) stay zero
--   .text       : runtime, program, rodata, then 128 KiB of zero memory (RWX)
--   .idata      : import descriptors, lookup tables, names (4 KiB)
--   .rgsys      : the layer; its import address table is at offset 16 (RWX, entry point)

-- KERNEL32.dll, in the order of the `I_*` indexes of rtw.c.
fn :: win kernel32 imports => [String]
      win kernel32 imports =  ["GetStdHandle", "WriteFile", "ReadFile", "CreateFileW", "CloseHandle", "VirtualAlloc", "VirtualFree", "VirtualProtect", "VirtualQuery", "ExitProcess", "ExitThread", "AddVectoredExceptionHandler", "GetCommandLineW", "GetEnvironmentStringsW", "GetLastError", "SetConsoleOutputCP", "SetConsoleCP", "GetConsoleOutputCP", "GetConsoleCP", "GetFileType", "GetFileInformationByHandle", "SetFilePointerEx", "SetEndOfFile", "FlushFileBuffers", "FindFirstFileW", "FindNextFileW", "FindClose", "CreateDirectoryW", "RemoveDirectoryW", "DeleteFileW", "MoveFileExW", "GetCurrentDirectoryW", "SetCurrentDirectoryW", "GetFileAttributesW", "GetFileAttributesExW", "GetModuleFileNameW", "GetTempPathW", "SearchPathW", "CreateProcessW", "WaitForSingleObject", "GetExitCodeProcess", "TerminateProcess", "CreateThread", "Sleep", "SwitchToThread", "QueryPerformanceCounter", "QueryPerformanceFrequency", "GetSystemTimePreciseAsFileTime", "GetCurrentProcessId", "GetCurrentThreadId", "GetCurrentProcess", "CreatePipe", "DuplicateHandle", "PeekNamedPipe", "SetHandleInformation", "GetProcessHeap", "HeapAlloc", "HeapFree"]

fn :: win synch imports => [String]
      win synch imports =  ["WaitOnAddress", "WakeByAddressSingle", "WakeByAddressAll"]

fn :: win advapi imports => [String]
      win advapi imports =  ["SystemFunction036"]

-- n thunks to hint/name entries 40 bytes apart from `at`, then the null thunk.
fn :: win thunks Int Int [Int] => [Int]
      win thunks _  0 acc =  acc :: (u64 le 0)
      win thunks at n acc =  win thunks (at + 40) (n - 1) (acc :: (u64 le at))

fn :: win hint names [String] [Int] => [Int]
      win hint names []     acc =  acc
      win hint names (s:ss) acc =  win hint names ss (acc :: (u16 le 0) :: (pad pe str s 38))

-- The lookup tables of the three DLLs; also the initial import address table.
fn :: win thunk tables Int => [Int]
      win thunk tables idata_rva =
        nk = list len (win kernel32 imports)
        ns = list len (win synch imports)
        na = list len (win advapi imports)
        hn_k = idata_rva + 160 + ((nk + ns + na + 3) * 8)
        hn_s = hn_k + (nk * 40)
        hn_a = hn_s + (ns * 40)
        (win thunks hn_k nk []) :: (win thunks hn_s ns []) :: (win thunks hn_a na [])

fn :: win import desc Int Int Int => [Int]
      win import desc ilt_rva name_rva iat_rva =
        (u32 le ilt_rva) :: (u32 le 0) :: (u32 le 0) :: (u32 le name_rva) :: (u32 le iat_rva)

-- .idata: 0 descriptors (3 + null), 80 DLL names, 160 lookup tables, then hint/name entries.
fn :: win idata section Int Int => [Int]
      win idata section idata_rva iat_rva =
        nk = list len (win kernel32 imports)
        ns = list len (win synch imports)
        ilt_s = (nk + 1) * 8
        ilt_a = ilt_s + ((ns + 1) * 8)
        descs = (win import desc (idata_rva + 160) (idata_rva + 80) iat_rva) :: (win import desc (idata_rva + 160 + ilt_s) (idata_rva + 96) (iat_rva + ilt_s)) :: (win import desc (idata_rva + 160 + ilt_a) (idata_rva + 136) (iat_rva + ilt_a)) :: (zero bytes 20)
        names = (pad pe str "KERNEL32.dll" 16) :: (pad pe str "api-ms-win-core-synch-l1-2-0.dll" 40) :: (pad pe str "ADVAPI32.dll" 24)
        hns = win hint names (win advapi imports) (win hint names (win synch imports) (win hint names (win kernel32 imports) []))
        body = descs :: names :: (win thunk tables idata_rva) :: hns
        body :: (zero bytes (4096 - (list len body)))

fn :: win iat size => Int
      win iat size =  ((list len (win kernel32 imports)) + (list len (win synch imports)) + (list len (win advapi imports)) + 3) * 8

-- ── Syscall Sites ─────────────────────────────────────────────

-- Offsets from 0x401000 of the 99 `syscall` instructions of `build x8664 rt kernel`
-- (found by disassembly; two more 15, 5 byte pairs, at 0x9043 and 0x1607A, are
-- inside `mov edi, 0x50F00` and stay as they are).
fn :: win rt sites => [Int]
      win rt sites =  [10023, 10072, 10262, 10286, 10301, 14651, 15654, 15732, 19034, 29856, 30186, 30429, 30622, 30796, 31064, 32682, 32869, 32896, 32999, 33131, 33288, 33301, 33337, 33395, 33427, 33440, 36884, 36912, 36937, 37795, 37814, 40515, 40525, 41657, 41685, 43700, 44636, 44661, 45048, 45232, 45402, 45758, 49400, 49822, 50102, 50370, 50815, 50837, 50892, 50943, 51311, 51398, 52039, 52096, 55420, 87771, 87934, 88080, 88767, 88859, 88924, 88976, 89048, 89179, 89317, 89551, 89633, 89838, 89869, 90192, 90220, 90240, 90360, 90733, 90743, 91420, 91464, 91578, 91612, 92243, 92689, 92886, 93569, 94682, 94745, 94876, 94918, 94979, 95005, 95054, 95077, 95341, 95399, 95434, 95457, 96029, 96272, 96324, 96947]

-- Offsets of the `syscall` instructions inside the encoding of an instruction
-- (prefix bytes + offset in the snippet: `x86 sort by` 720, `x86 list get` 97,
-- `x86 tensor bounds` 106, `x86 builtin bytes` 96: 5, 97: 23 82, 98: 43 76,
-- 99: 25, 50: 42, 32: 46 136, 57: 20 30 94).
fn :: win sys sites RNativeInstr => [Int]
      win sys sites (NSortBy _ _)          =  [741]
      win sys sites (NListGet _ _)         =  [113]
      win sys sites (NIndex _ _ -1)        =  [148]
      win sys sites (NIndex _ _ -2)        =  [148]
      win sys sites (NIndex _ _ _)         =  [132]
      win sys sites (NIndexSet _ _ _)      =  [132]
      win sys sites (NCallBuiltin 86 _ _)  =  [18]
      win sys sites (NCallBuiltin 87 _ _)  =  [42]
      win sys sites (NCallBuiltin 96 _ _)  =  [5]
      win sys sites (NCallBuiltin 97 _ _)  =  [41, 100]
      win sys sites (NCallBuiltin 98 _ _)  =  [71, 104]
      win sys sites (NCallBuiltin 99 _ _)  =  [33]
      win sys sites (NCallBuiltin 1 _ _)   =  [80]
      win sys sites (NCallBuiltin 32 _ 0)  =  [80]
      win sys sites (NCallBuiltin 32 _ _)  =  [64, 154]
      win sys sites (NCallBuiltin 33 _ _)  =  [80]
      win sys sites (NCallBuiltin 50 _ _)  =  [80]
      win sys sites (NCallBuiltin 57 _ _)  =  [38, 48, 112]
      win sys sites _                      =  []

-- Turn the `syscall` (15, 5) at each offset, ascending, into `ud2` (15, 11).
-- A site that does not hold 15, 5 stops the patching (the unit test checks
-- that no site is missed).
fn :: patch ud2 [Int] [Int] => [Int]
      patch ud2 bytes []     =  bytes
      patch ud2 bytes (s:ss) =  patch ud2 walk bytes 0 s ss []

fn :: patch ud2 walk [Int] Int Int [Int] [Int] => [Int]
      patch ud2 walk []     _ _ _  acc =  acc
      patch ud2 walk (b:bs) i s ss acc
        | i < s = patch ud2 walk bs (i + 1) s ss (acc :: [b])
        | i == s and b == 15 and (list nth or bs 0 0) == 5 = patch ud2 next (list drop bs 1) (i + 2) ss (acc :: [15, 11])
        | otherwise = acc :: [b] :: bs

fn :: patch ud2 next [Int] Int [Int] [Int] => [Int]
      patch ud2 next bytes _ []     acc =  acc :: bytes
      patch ud2 next bytes i (s:ss) acc =  patch ud2 walk bytes i s ss acc

-- `x8664 encode instrs` / `x8664 encode fns` with the sites of each instruction patched.
fn :: win encode instrs [RNativeInstr] Int Int Int Int [RLabelEntry] [RLabelEntry] [Int] => [Int]
      win encode instrs [] _ _ _ _ _ _ acc = acc
      win encode instrs (ins:rest) cur_vaddr fn_vaddr num_slots rodata_vaddr lbl_table fn_table acc =
        sz = x8664 instr size ins
        bytes = patch ud2 (x8664 encode instr ins cur_vaddr fn_vaddr num_slots rodata_vaddr lbl_table fn_table) (win sys sites ins)
        win encode instrs rest (cur_vaddr + sz) fn_vaddr num_slots rodata_vaddr lbl_table fn_table (acc :: bytes)

fn :: win encode fns [RNativeFn] Int [RLabelEntry] [Int] => [Int]
      win encode fns [] _ _ acc = acc
      win encode fns ((NativeFn fid _ arity num_slots instrs):rest) rodata_vaddr fn_table acc =
        fn_vaddr = lookup label offset fn_table fid
        sr = x8664 scan instrs instrs (fn_vaddr + 42) []
        lbl_table = scan labels sr
        pro = x8664 prologue fn_vaddr arity num_slots
        fn_bytes = win encode instrs instrs (fn_vaddr + 42) fn_vaddr num_slots rodata_vaddr lbl_table fn_table pro
        win encode fns rest rodata_vaddr fn_table (acc :: fn_bytes)

-- ── The Layer (bytes of rtw.bin) ─────────────────────────────
-- rtw.bin = head (16 bytes: jump to the start) :: import address table (640 bytes,
-- written by `win layer`) :: body. Built with clang 19.1.7 (docs/etc/runtime_windows.md).

fn :: win layer head => [Int]
      win layer head =  [233, 37, 3, 0, 0, 102, 46, 15, 31, 132, 0, 0, 0, 0, 0, 144]

fn :: win layer body => [Int]
