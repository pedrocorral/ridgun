fn :: win layer Int => [Int]
      win layer idata_rva =
        iat = win thunk tables idata_rva
        (win layer head) :: iat :: (zero bytes (640 - (list len iat))) :: (win layer body)

-- ── Headers ───────────────────────────────────────────────────

fn :: build win64 page0 Int Int Int Int Int Int Int => [Int]
      build win64 page0 chars text_aligned layer_len main_vaddr spawn_vaddr call2_vaddr binop_vaddr =
        dos_hdr = [77, 90, 144, 0, 3, 0, 0, 0, 4, 0, 0, 0, 255, 255, 0, 0, 184, 0, 0, 0, 0, 0, 0, 0, 64, 0, 0, 0, 0, 0, 0, 0] :: (zero bytes 28) :: (u32 le 1024)
        dos_stub = [14, 31, 186, 14, 0, 180, 9, 205, 33, 184, 1, 76, 205, 33] :: (pad pe str "This program requires 64-bit Windows.\r\n$" 50)
        table_ptrs = (u64 le main_vaddr) :: (u64 le spawn_vaddr) :: (u64 le call2_vaddr) :: (u64 le binop_vaddr)
        idata_rva = 4096 + text_aligned + 131072
        rgsys_rva = idata_rva + 4096
        layer_aligned = align up layer_len 4096
        -- COFF: AMD64, 3 sections, optional header 240 bytes
        coff = [80, 69, 0, 0] :: (u16 le 34404) :: (u16 le 3) :: (u32 le 0) :: (u32 le 0) :: (u32 le 0) :: (u16 le 240) :: (u16 le chars)
        std_fields = (u16 le 523) :: [14, 0] :: (u32 le text_aligned) :: (u32 le (4096 + layer_aligned)) :: (u32 le 131072) :: (u32 le rgsys_rva) :: (u32 le 4096)
        win_fields1 = (u64 le 4194304) :: (u32 le 4096) :: (u32 le 4096) :: (u16 le 6) :: (u16 le 0) :: (u16 le 0) :: (u16 le 0) :: (u16 le 6) :: (u16 le 0) :: (u32 le 0)
        -- Stack: 8 MiB reserved and committed (runtime frames reach 16 KiB, past a guard page).
        win_fields2 = (u32 le (rgsys_rva + layer_aligned)) :: (u32 le 4096) :: (u32 le 0) :: (u16 le 3) :: (u16 le 0) :: (u64 le 8388608) :: (u64 le 8388608) :: (u64 le 16777216) :: (u64 le 65536) :: (u32 le 0) :: (u32 le 16)
        dirs = (zero bytes 8) :: (u32 le idata_rva) :: (u32 le 80) :: (zero bytes 80) :: (u32 le (rgsys_rva + 16)) :: (u32 le (win iat size)) :: (zero bytes 24)
        s_text = (pad pe str ".text" 8) :: (u32 le (text_aligned + 131072)) :: (u32 le 4096) :: (u32 le text_aligned) :: (u32 le 4096) :: (zero bytes 12) :: (u32 le 3758096480)
        s_idata = (pad pe str ".idata" 8) :: (u32 le 4096) :: (u32 le idata_rva) :: (u32 le 4096) :: (u32 le (4096 + text_aligned)) :: (zero bytes 12) :: (u32 le 3221225536)
        s_rgsys = (pad pe str ".rgsys" 8) :: (u32 le layer_len) :: (u32 le rgsys_rva) :: (u32 le layer_aligned) :: (u32 le (8192 + text_aligned)) :: (zero bytes 12) :: (u32 le 3758096480)
        headers = coff :: std_fields :: win_fields1 :: win_fields2 :: dirs :: s_text :: s_idata :: s_rgsys
        dos_hdr :: dos_stub :: table_ptrs :: (zero bytes 864) :: headers :: (zero bytes (3072 - (list len headers)))

fn :: build win64 image Int Int Int Int Int [Int] Int [Int] Int String => [Int]
      build win64 image chars main_vaddr spawn_vaddr call2_vaddr binop_vaddr rt_bytes rt_len code_bytes code_len rodata_str =
        rodata_bytes = str to bytes rodata_str
        payload_len = rt_len + code_len + (str len rodata_str)
        text_aligned = align up payload_len 4096
        idata_rva = 4096 + text_aligned + 131072
        layer = win layer idata_rva
        layer_len = list len layer
        page0 = build win64 page0 chars text_aligned layer_len main_vaddr spawn_vaddr call2_vaddr binop_vaddr
        page0 :: rt_bytes :: code_bytes :: rodata_bytes :: (zero bytes (text_aligned - payload_len)) :: (win idata section idata_rva (idata_rva + 4096 + 16)) :: layer :: (zero bytes ((align up layer_len 4096) - layer_len))

fn :: emit x8664 pe64 spec Int RNativeProg => [Int]
      emit x8664 pe64 spec chars (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) =
        rt_bytes = patch ud2 (build x8664 rt kernel) (win rt sites)
        rt_len = list len rt_bytes
        region2_vaddr = 4198400 + rt_len
        sr = x8664 scan fns fns region2_vaddr []
        rodata_vaddr = scan offset sr
        fn_table = scan labels sr
        code_len = rodata_vaddr - region2_vaddr
        code_bytes = win encode fns fns rodata_vaddr fn_table []
        main_vaddr = lookup label offset fn_table main_fid
        spawn_vaddr = lookup label offset fn_table spawn_fid
        call2_vaddr = lookup label offset fn_table call2_fid
        binop_vaddr = lookup label offset fn_table binop_fid
        build win64 image chars main_vaddr spawn_vaddr call2_vaddr binop_vaddr rt_bytes rt_len code_bytes code_len rodata_str

fn :: emit x8664 pe64 kind Int RNativeProg => [Int]
      emit x8664 pe64 kind chars nprog =
        emit x8664 pe64 spec chars (specialize nprog for windows nprog)

fn :: emit x8664 pe64 RNativeProg => [Int]
      emit x8664 pe64 nprog       =  emit x8664 pe64 kind 35 nprog

fn :: emit x8664 dll pe64 RNativeProg => [Int]
      emit x8664 dll pe64 nprog       =  emit x8664 pe64 kind 8226 nprog

fn :: emit arm64 pe64 spec Int RNativeProg => [Int]
      emit arm64 pe64 spec chars (NativeProg main_fid spawn_fid call2_fid binop_fid fns rodata_str) =
        rt_bytes = build arm64 rt kernel
        rt_len = list len rt_bytes
        region2_vaddr = 4198400 + rt_len
        sr = arm64 scan fns fns region2_vaddr []
        rodata_vaddr = scan offset sr
        fn_table = scan labels sr
        code_len = rodata_vaddr - region2_vaddr
        code_bytes = arm64 encode fns fns rodata_vaddr fn_table []
        main_vaddr = lookup label offset fn_table main_fid
        spawn_vaddr = lookup label offset fn_table spawn_fid
        call2_vaddr = lookup label offset fn_table call2_fid
        binop_vaddr = lookup label offset fn_table binop_fid
        -- IMAGE_FILE_MACHINE_ARM64 = 43620 (0xAA64)
        build pe64 image kind 43620 chars main_vaddr spawn_vaddr call2_vaddr binop_vaddr rt_bytes rt_len code_bytes code_len rodata_str

fn :: emit arm64 pe64 kind Int RNativeProg => [Int]
      emit arm64 pe64 kind chars nprog =
        emit arm64 pe64 spec chars (specialize nprog for windows nprog)

fn :: emit arm64 pe64 RNativeProg => [Int]
      emit arm64 pe64 nprog       =  emit arm64 pe64 kind 34 nprog

fn :: emit arm64 dll pe64 RNativeProg => [Int]
      emit arm64 dll pe64 nprog       =  emit arm64 pe64 kind 8226 nprog
