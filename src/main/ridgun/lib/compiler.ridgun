-- The element-wise operations of two tensors of the same shape that builtin 90 does word by word
-- (vectorised by the LLVM backend, OPT-012): the bit operations for any subscripts, the arithmetic
-- ones when both tensors have the same subscripts.
fn :: hadamard word op RBinOp => Bool
      hadamard word op OpXor  =  True
      hadamard word op OpAnd  =  True
      hadamard word op OpOr   =  True
      hadamard word op OpShl  =  True
      hadamard word op OpShr  =  True
      hadamard word op OpRotl =  True
      hadamard word op OpRotr =  True
      hadamard word op _      =  False

fn :: hadamard arith op RBinOp => Bool
      hadamard arith op OpAdd =  True
      hadamard arith op OpSub =  True
      hadamard arith op OpMul =  True
      hadamard arith op OpDiv =  True
      hadamard arith op OpMod =  True
      hadamard arith op _     =  False

-- The code builtin 90 gets: the operator's id, or 100 + id for + - * / on two tensors of Reals
-- (their words are the bits of the Reals, so the Int operation would give nonsense).
fn :: hadamard op code RNativeEnv RBinOp RExpr RExpr => Int
      hadamard op code env bop leftE rightE
        | (all real operands env [leftE, rightE]) and ((binop id bop) <= 3) = 100 + (binop id bop)
        | otherwise = binop id bop

fn :: lower bitwise hadamard RNativeEnv RBinOp RExpr RExpr [String] Int RNativeCode => RNativeCode
      lower bitwise hadamard env bop leftE rightE boundLocals sp st =
        st1 = lower expr env leftE boundLocals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower expr env rightE boundLocals (sp + 1) st2
        st4 = nc emit st3 (NStoreSlot (sp + 1)) (sp + 2)
        opCode = hadamard op code env bop leftE rightE
        ins = [NLoadImmInt opCode, NStoreSlot (sp + 2), NCallBuiltin 90 sp 3]
        nc emit list st4 ins (sp + 4)

fn :: is agent call name String             => Bool
      is agent call name "agent"            =  True
      is agent call name "agent_sink"       =  True
      is agent call name "__gagent_get__"   =  True
      is agent call name "__with_agent__"   =  True
      is agent call name "send_to"          =  True
      is agent call name "ask_to"           =  True
      is agent call name "receive_from"     =  True
      is agent call name "try_receive_from" =  True
      is agent call name "stop"             =  True
      is agent call name "agent_alive"      =  True
      is agent call name "agent_dropped"    =  True
      is agent call name "agent_flush"      =  True
      is agent call name "agent_state"      =  True
      is agent call name _                  =  False

fn :: agent fn mode RNativeEnv RExpr [String] => Int
      agent fn mode env (EVar fname) bound_locals
        | (lookup local bound_locals fname) < 0 and (env fn is heavy env fname) = 3
        | (lookup local bound_locals fname) < 0 and (env fn arity env fname) == 2 = 4
        | otherwise = 1
      agent fn mode env (ECall fname _) bound_locals
        | (lookup local bound_locals fname) < 0 and (env fn is heavy env fname) = 3
        | otherwise = 1
      agent fn mode _ _ _ = 1

-- A stateful agent's mode tells how to read its step's result (FR-COMP-009): 7 when the step returns
-- (new state, reply), 8 when it returns the new state, which is also the reply. Both are decided from the
-- step's signature. 2 is a step the compiler cannot see (a lambda, a function passed as a value): its
-- result is read with the run-time rule.
fn :: stateful step mode RNativeEnv RExpr [String] => Int
      stateful step mode env (EVar fname) bound_locals
        | (lookup local bound_locals fname) < 0 = known step mode (env fn arity env (":stform:0:" + fname))
        | otherwise = 2
      stateful step mode env (ECall fname args) bound_locals
        | (lookup local bound_locals fname) < 0 = known step mode (env fn arity env (":stform:" + (int to str (list len args)) + ":" + fname))
        | otherwise = 2
      stateful step mode _ _ _ = 2

-- A lambda or a function value has no signature mark; the type checker
-- records its form as ":agstep:<name>:<k>" (RG-115).
fn :: typed step mode RNativeEnv RExpr Int => Int
      typed step mode env (EVar n) 2 =  step mode of kind (env tensor kind env (":agstep:" + n + ":0"))
      typed step mode env (ECall n args) 2 =  step mode of kind (env tensor kind env (":agstep:" + n + ":" + (int to str (list len args))))
      typed step mode _ _ mode =  mode

fn :: step mode of kind String => Int
      step mode of kind "7" =  7
      step mode of kind "8" =  8
      step mode of kind _ =  2

fn :: known step mode Int => Int
      known step mode 7 =  7
      known step mode 8 =  8
      known step mode _ =  2

-- Marks ":stform:<k>:<name>" for every function that can be a stateful step once k arguments are applied:
-- the state is parameter k and at least one message parameter follows.
fn :: add step form marks [RFnDef] RStrIntMap => RStrIntMap
      add step form marks [] m = m
      add step form marks ((FnDef name params ret _):fs) m =  add step form marks fs (add step form marks for name params ret 0 m)

fn :: add step form marks for String [String] String Int RStrIntMap => RStrIntMap
      add step form marks for _    []        _   _ m =  m
      add step form marks for _    (_:[])    _   _ m =  m
      add step form marks for name (p:ps) ret k m =
        add step form marks for name ps ret (k + 1) (str int map insert m (":stform:" + (int to str k) + ":" + name) (step form of p ret))

-- 8 when the step returns its state type, 7 when it returns (state type, reply type), 2 otherwise.
fn :: step form of String String => Int
      step form of state ret
        | (type key ret) == (type key state) = 8
        | (str starts with ret "(") and ((str char at ret ((str len ret) - 1)) == 41) = pair form of state (top level parts (str slice ret 1 ((str len ret) - 1)) 0 0 0 [])
        | otherwise = 2

fn :: pair form of String [String] => Int
      pair form of state (first:_:[])
        | (type key first) == (type key state) = 7
        | otherwise = 2
      pair form of _ _ = 2

-- Signatures are stored normalized by the parser ("(A, B)" for two return types), so trimming is enough.
fn :: type key String => String
      type key t =  trim str t

-- The comma-separated parts of s at bracket depth 0.
fn :: top level parts String Int Int Int [String] => [String]
      top level parts s i start depth acc
        | i >= (str len s) = list reverse ([trim str (str slice s start i)] :: acc)
        | ((str char at s i) == 44) and (depth == 0) = top level parts s (i + 1) (i + 1) depth ([trim str (str slice s start i)] :: acc)
        | ((str char at s i) == 40) or ((str char at s i) == 91) = top level parts s (i + 1) start (depth + 1) acc
        | ((str char at s i) == 41) or ((str char at s i) == 93) = top level parts s (i + 1) start (depth - 1) acc
        | otherwise = top level parts s (i + 1) start depth acc

-- Mode checks for the stateful branch: modes 2, 7 and 8 are stateful agents.
fn :: stateful mode check Int Int Int => [RNativeInstr]
      stateful mode check slot fail_lbl ok_lbl =
        [NMatchInt slot 2, NJumpIfNonZero ok_lbl, NMatchInt slot 7, NJumpIfNonZero ok_lbl, NMatchInt slot 8, NJumpIfZero fail_lbl, NLabel ok_lbl]

-- Reads a step result by the agent's static form; mode 2 falls through to the run-time rule.
fn :: step form branch Int Int Int => [RNativeInstr]
      step form branch mode_slot same_lbl split_lbl =
        [NMatchInt mode_slot 7, NJumpIfNonZero split_lbl, NMatchInt mode_slot 8, NJumpIfNonZero same_lbl]

fn :: stateful agent mode RNativeEnv RExpr [String] => Int
      stateful agent mode env (EVar fname) bound_locals
        | (lookup local bound_locals fname) < 0 and (env fn is heavy env fname) = 1
        | otherwise = 0
      stateful agent mode env (ECall fname _) bound_locals
        | (lookup local bound_locals fname) < 0 and (env fn is heavy env fname) = 1
        | otherwise = 0
      stateful agent mode _ _ _ = 0

fn :: emit indirect1 call Int Int Int Int => [RNativeInstr]
      emit indirect1 call fn_slot arg_slot tmp_sp plain_lbl =
        done_lbl = plain_lbl + 1
        [NMatchTuple fn_slot 2, NJumpIfZero plain_lbl, NTupleGet fn_slot 0, NStoreSlot tmp_sp, NTupleGet fn_slot 1, NStoreSlot (tmp_sp + 1), NMoveSlot arg_slot, NStoreSlot (tmp_sp + 2), NMakeList (tmp_sp + 2) 1, NBinOp 14 (tmp_sp + 1), NStoreSlot (tmp_sp + 1), NListHead (tmp_sp + 1), NStoreSlot (tmp_sp + 2), NListTail (tmp_sp + 1), NStoreSlot (tmp_sp + 3), NMoveSlot (tmp_sp + 2), NStoreSlot (tmp_sp + 1), NMoveSlot (tmp_sp + 3), NStoreSlot (tmp_sp + 2), NMakeAdt (rest tag off) 11 (tmp_sp + 2) 1, NStoreSlot (tmp_sp + 2), NCallIndirect2 tmp_sp (tmp_sp + 1), NJump done_lbl, NLabel plain_lbl, NCallIndirect1 fn_slot arg_slot, NLabel done_lbl]

fn :: emit indirect2 call Int Int Int Int => [RNativeInstr]
      emit indirect2 call fn_slot arg1_slot tmp_sp plain_lbl =
        done_lbl = plain_lbl + 1
        [NMatchTuple fn_slot 2, NJumpIfZero plain_lbl, NTupleGet fn_slot 0, NStoreSlot tmp_sp, NTupleGet fn_slot 1, NStoreSlot (tmp_sp + 1), NMakeList arg1_slot 2, NBinOp 14 (tmp_sp + 1), NStoreSlot (tmp_sp + 1), NListHead (tmp_sp + 1), NStoreSlot (tmp_sp + 2), NListTail (tmp_sp + 1), NStoreSlot (tmp_sp + 3), NMoveSlot (tmp_sp + 2), NStoreSlot (tmp_sp + 1), NMoveSlot (tmp_sp + 3), NStoreSlot (tmp_sp + 2), NMakeAdt (rest tag off) 11 (tmp_sp + 2) 1, NStoreSlot (tmp_sp + 2), NCallIndirect2 tmp_sp (tmp_sp + 1), NJump done_lbl, NLabel plain_lbl, NCallIndirect2 fn_slot arg1_slot, NLabel done_lbl]

fn :: emit sink state copy Bool Int => [RNativeInstr]
      emit sink state copy False _ = []
      emit sink state copy True sp = [NCloneSlot (sp + 6), NStoreSlot (sp + 10)]

fn :: emit sink flush or state Bool Int Int => [RNativeInstr]
      emit sink flush or state want_state sp base_lbl =
        sink_lbl = base_lbl
        restore_lbl = base_lbl + 1
        loop_lbl = base_lbl + 2
        step6_lbl = base_lbl + 3
        save_lbl = base_lbl + 4
        st2_lbl = base_lbl + 5
