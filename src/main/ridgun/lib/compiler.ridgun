        nc emit list st3 ins_post (sp + 3)
      lower agent call env "__with_agent__" (ag_e:rep_e:body_e:[]) bound_locals sp st =
        ag_name = extract gagent name ag_e
        k = env field idx env (":gagent:" + ag_name)
