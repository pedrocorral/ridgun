        st1 = nc emit list st [NCallFn fid sp 0, NDropVal, NLoadImmInt k, NStoreSlot sp, NCallBuiltin 32 sp 1, NStoreSlot sp] (sp + 1)
        st2 = lower expr env rep_e bound_locals (sp + 1) st1
