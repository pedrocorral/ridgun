fn :: lower fold or closure fold RNativeEnv [RExpr] [String] Int RNativeCode => RNativeCode
      lower fold or closure fold env ((EVar target_fn):init_e:list_e:[]) bound_locals sp st
        | (lookup local bound_locals target_fn) < 0 and (env fn arity env target_fn) == 2 =
          fid = env fn id env target_fn
          loop_lbl = nc lbl st
          done_lbl = loop_lbl + 1
          st0 = nc set lbl st (loop_lbl + 2)
          st1 = lower expr list to slots env [init_e, list_e] bound_locals sp 0 st0
          ins = [NLabel loop_lbl, NMatchNonEmpty (sp + 1), NJumpIfZero done_lbl, NMoveSlot sp, NStoreSlot (sp + 2), NListHead (sp + 1), NStoreSlot (sp + 3), NCallFn fid (sp + 2) 2, NStoreSlot sp, NListTail (sp + 1), NStoreSlot (sp + 1), NJump loop_lbl, NLabel done_lbl, NClearLocals (sp + 1) (sp + 4), NMoveSlot sp]
          nc emit list st1 ins (sp + 4)
      lower fold or closure fold env (fn_e:init_e:list_e:[]) bound_locals sp st =
        plain_lbl = nc lbl st
        loop_lbl = plain_lbl + 1
        done_lbl = plain_lbl + 2
        after_lbl = plain_lbl + 3
        st0 = nc set lbl st (plain_lbl + 4)
        st1 = lower expr list to slots env [fn_e, init_e, list_e] bound_locals sp 0 st0
        ins_clos = [NMatchTuple sp 2, NJumpIfZero plain_lbl, NLabel loop_lbl, NMatchNonEmpty (sp + 2), NJumpIfZero done_lbl, NTupleGet sp 0, NStoreSlot (sp + 3), NTupleGet sp 1, NStoreSlot (sp + 4), NMoveSlot (sp + 1), NStoreSlot (sp + 5), NListHead (sp + 2), NStoreSlot (sp + 6), NMakeList (sp + 5) 2, NBinOp 14 (sp + 4), NStoreSlot (sp + 4), NListHead (sp + 4), NStoreSlot (sp + 5), NListTail (sp + 4), NStoreSlot (sp + 6), NMoveSlot (sp + 5), NStoreSlot (sp + 4), NMoveSlot (sp + 6), NStoreSlot (sp + 5), NMakeAdt (rest tag off) 11 (sp + 5) 1, NStoreSlot (sp + 5), NCallIndirect2 (sp + 3) (sp + 4), NStoreSlot (sp + 1), NListTail (sp + 2), NStoreSlot (sp + 2), NJump loop_lbl, NLabel done_lbl, NCmmDropSlot sp, NClearLocals (sp + 2) (sp + 7), NMoveSlot (sp + 1), NJump after_lbl, NLabel plain_lbl, NCallBuiltin 61 sp 3, NLabel after_lbl]
        nc emit list st1 ins_clos (sp + 7)
      lower fold or closure fold env args bound_locals sp st =
        count = list len args
        st1 = lower expr list to slots env args bound_locals sp 0 st
        nc emit st1 (NCallBuiltin 61 sp count) (sp + count + 1)

fn :: lower direct or partial call RNativeEnv String [RExpr] Int Int [String] Int RNativeCode => RNativeCode
      lower direct or partial call env fname args count fn_ar bound_locals sp st
        | count > 0 and fn_ar > count =
          off = env str off env fname
          slen = str len fname
          st1 = nc emit list st [NLoadStrLit off slen, NStoreSlot sp] (sp + 1)
          st2 = lower expr list to slots env args bound_locals (sp + 1) 0 st1
          nc emit list st2 [NMakeList (sp + 1) count, NStoreSlot (sp + 1), NMakeTuple sp 2] (sp + count + 2)
        | count == fn_ar and (env borrow mask env fname) > 0 =
          lower borrow call env fname args count count (env borrow mask env fname) bound_locals sp st
        | count == fn_ar =
          st1 = lower expr list to slots env args bound_locals sp 0 st
          nc emit st1 (NCallFn (env fn id env fname) sp count) (sp + count + 1)
        | (env borrow mask env fname) > 0 =
          lower borrow call env fname args count (0 - 1) (env borrow mask env fname) bound_locals sp st
        | otherwise =
          st1 = lower expr list to slots env args bound_locals sp 0 st
          nc emit st1 (NCallFn (env fn id env fname) sp (0 - 1)) (sp + count + 1)

-- ── Borrowed parameters (TASK-0059) ─────────────────────────
-- A parameter is borrowed when every clause matches it with a pattern that
-- only reads it (a constructor, tuple, `[]`, string or `_` pattern): the
-- value itself is never bound to a name. The callee then leaves the value
-- alone: it reads fields from the argument slot and empties the slot without
-- a drop before it returns (`NForgetSlot`). The caller keeps ownership:
--   * a local variable is passed as is (`NPeekSlot`), without a clone;
--   * any other value is computed, parked in a scratch slot, passed as is,
--     and dropped after the call.
-- `borrow masks` decides which functions do this (bit i = parameter i).
fn :: env borrow mask RNativeEnv String => Int
      env borrow mask env fname = env fn arity env ("#b " + fname)

fn :: borrow pow Int => Int
      borrow pow n
        | n <= 0 = 1
        | otherwise = 2 * (borrow pow (n - 1))

fn :: borrow bit Int Int => Bool
      borrow bit mask idx = ((mask / (borrow pow idx)) % 2) == 1

fn :: borrow local arg RExpr [String] => Bool
      borrow local arg (EVar v) bound_locals = (lookup local bound_locals v) >= 0
      borrow local arg _ _ = False

fn :: borrow var slot RNativeEnv RExpr => Int
      borrow var slot env (EVar v) = env var slot env v
      borrow var slot _ _ = 0

fn :: lower borrow call RNativeEnv String [RExpr] Int Int Int [String] Int RNativeCode => RNativeCode
      lower borrow call env fname args count call_count mask bound_locals sp st =
        top = sp + (2 * count) + 1
        st1 = lower borrow args env args mask bound_locals sp 0 st
        st2 = nc emit list st1 (borrow fixup ins env args mask bound_locals sp count 0 []) top
        st3 = nc emit st2 (NCallFn (env fn id env fname) sp call_count) top
        drops = borrow drop ins args mask bound_locals sp count 0 []
        lower borrow cleanup drops (sp + (2 * count)) top st3

fn :: lower borrow args RNativeEnv [RExpr] Int [String] Int Int RNativeCode => RNativeCode
      lower borrow args _ [] _ _ _ _ st = st
      lower borrow args env (e:es) mask bound_locals sp idx st
        | (borrow bit mask idx) and (borrow local arg e bound_locals) =
          lower borrow args env es mask bound_locals sp (idx + 1) st
        | otherwise =
          cur_slot = sp + idx
          st1 = lower expr env e bound_locals cur_slot st
          st2 = nc emit st1 (NStoreSlot cur_slot) (cur_slot + 1)
          lower borrow args env es mask bound_locals sp (idx + 1) st2

fn :: borrow fixup ins RNativeEnv [RExpr] Int [String] Int Int Int [RNativeInstr] => [RNativeInstr]
      borrow fixup ins _ [] _ _ _ _ _ acc = acc
      borrow fixup ins env (e:es) mask bound_locals sp count idx acc
        | not (borrow bit mask idx) = borrow fixup ins env es mask bound_locals sp count (idx + 1) acc
        | borrow local arg e bound_locals =
          borrow fixup ins env es mask bound_locals sp count (idx + 1) (acc :: [NPeekSlot (borrow var slot env e), NStoreSlot (sp + idx)])
        | otherwise =
          scr = sp + count + idx
          borrow fixup ins env es mask bound_locals sp count (idx + 1) (acc :: [NMoveSlot (sp + idx), NStoreSlot scr, NPeekSlot scr, NStoreSlot (sp + idx)])

fn :: borrow drop ins [RExpr] Int [String] Int Int Int [RNativeInstr] => [RNativeInstr]
      borrow drop ins [] _ _ _ _ _ acc = acc
      borrow drop ins (e:es) mask bound_locals sp count idx acc
        | (borrow bit mask idx) and (not (borrow local arg e bound_locals)) =
          borrow drop ins es mask bound_locals sp count (idx + 1) (acc :: [NCmmDropSlot (sp + count + idx)])
        | otherwise = borrow drop ins es mask bound_locals sp count (idx + 1) acc

fn :: lower borrow cleanup [RNativeInstr] Int Int RNativeCode => RNativeCode
      lower borrow cleanup [] _ _ st = st
      lower borrow cleanup drops res top st =
        nc emit list st ([NStoreSlot res] :: drops :: [NMoveSlot res]) top

fn :: borrow pat ok RPattern => Bool
      borrow pat ok (PatCtor ":tensor-pat:" _) = False
      borrow pat ok (PatCtor ":as:" _) = False
      borrow pat ok (PatCtor c _) = (prim type tag id c) <= 0
      borrow pat ok (PatTuple _) = True
      borrow pat ok PatWild = True
      borrow pat ok PatEmpty = True
      borrow pat ok (PatStr _) = True
      borrow pat ok _ = False

fn :: borrow nth pat [RPattern] Int => RPattern
      borrow nth pat [] _ = PatVar ""
      borrow nth pat (p:ps) i
        | i <= 0 = p
        | otherwise = borrow nth pat ps (i - 1)

fn :: borrow param ok [RFnCase] Int => Bool
      borrow param ok [] _ = True
      borrow param ok ((FnCase pats _ _):cs) i = (borrow pat ok (borrow nth pat pats i)) and (borrow param ok cs i)

fn :: borrow cases shape ok [RFnCase] Int => Bool
      borrow cases shape ok [] _ = True
      borrow cases shape ok ((FnCase pats _ _):cs) arity = ((list len pats) == arity) and (not (borrow has seq bind pats)) and (borrow cases shape ok cs arity)

fn :: borrow has seq bind [RPattern] => Bool
      borrow has seq bind [] = False
      borrow has seq bind ((PatSeqBind _):_) = True
      borrow has seq bind (_:ps) = borrow has seq bind ps

fn :: borrow mask of [RFnCase] Int Int Int => Int
      borrow mask of cases i arity acc
        | i >= arity = acc
        | borrow param ok cases i = borrow mask of cases (i + 1) arity (acc + (borrow pow i))
        | otherwise = borrow mask of cases (i + 1) arity acc

fn :: fn borrow mask String [RFnCase] RStrSet RStrIntMap => Int
      fn borrow mask name cases excluded ar_map
        | (str len name) >= 2 and (str slice name 0 2) == "__" = 0
        | str set has excluded name = 0
        | is overloadable binop name name = 0
        | (str int map lookup ar_map name) < 1 or (str int map lookup ar_map name) > 20 = 0
        | not (borrow cases shape ok cases (str int map lookup ar_map name)) = 0
        | list contains (collect refs cases cases []) name = 0
        | otherwise = borrow mask of cases 0 (str int map lookup ar_map name) 0

fn :: put borrow mask RStrIntMap String Int => RStrIntMap
      put borrow mask m name mask
        | mask > 0 = str int map insert m ("#b " + name) mask
        | otherwise = m

-- A call in tail position must stay the last instruction of the caller, so
-- the backend can turn it into a jump (`a` returns `b x`, `b` returns `a y`
-- and so on, without stack growth). A borrowed call drops its scratch
-- values after the call returns, which would turn every such tail call into
-- a real call and overflow the stack on long chains. Functions that some
-- caller calls in tail position therefore never borrow.
fn :: borrow tail targets RExpr [String] => [String]
      borrow tail targets (ECall f _) acc = acc :: [f]
      borrow tail targets (EBlock stmts) acc = borrow tail stmts stmts acc
      borrow tail targets (EGuard gs) acc = borrow tail guards gs acc
      borrow tail targets (EWhere body _) acc = borrow tail targets body acc
      borrow tail targets _ acc = acc

fn :: borrow tail stmts [RStmt] [String] => [String]
      borrow tail stmts [] acc = acc
      borrow tail stmts ((StmtExpr e):[]) acc = borrow tail targets e acc
      borrow tail stmts (_:ss) acc = borrow tail stmts ss acc

fn :: borrow tail guards [RGuard] [String] => [String]
      borrow tail guards [] acc = acc
      borrow tail guards ((GuardBranch _ body):gs) acc = borrow tail guards gs (borrow tail targets body acc)

fn :: borrow tail cases [RFnCase] [String] => [String]
      borrow tail cases [] acc = acc
      borrow tail cases ((FnCase _ gs body):cs) acc = borrow tail cases cs (borrow tail targets body (borrow tail guards gs acc))

fn :: borrow tail fns [RFnDef] [String] => [String]
      borrow tail fns [] acc = acc
      borrow tail fns ((FnDef _ _ _ cases):fs) acc = borrow tail fns fs (borrow tail cases cases acc)

-- Functions in `excluded` can be called with owned arguments (function
-- values, partial application, dispatch by name, agents, entry points) or
-- are called in tail position, so they never borrow.
fn :: borrow masks [RFnDef] RStrSet RStrIntMap RStrIntMap => RStrIntMap
      borrow masks [] _ _ m = m
      borrow masks ((FnDef name _ _ cases):fs) excluded ar_map m =
        borrow masks fs excluded ar_map (put borrow mask m name (fn borrow mask name cases excluded ar_map))

-- Callee side: empty borrowed argument slots before every return.
fn :: borrow forget ins Int Int Int [RNativeInstr] => [RNativeInstr]
      borrow forget ins mask i arity acc
        | i >= arity = acc
        | borrow bit mask i = borrow forget ins mask (i + 1) arity (acc :: [NForgetSlot i])
        | otherwise = borrow forget ins mask (i + 1) arity acc

fn :: add borrow forgets [RNativeInstr] [RNativeInstr] [RNativeInstr] => [RNativeInstr]
      add borrow forgets [] forgets rev_acc = rev native instrs (rev native instrs forgets rev_acc) []
      add borrow forgets (NReturn:rest) forgets rev_acc =
        add borrow forgets rest forgets (rev native instrs (forgets :: [NReturn]) rev_acc)
      add borrow forgets ((NTailCallFn f a c k):rest) forgets rev_acc =
        add borrow forgets rest forgets (rev native instrs (forgets :: [NTailCallFn f a c k]) rev_acc)
      add borrow forgets (ins:rest) forgets rev_acc =
        add borrow forgets rest forgets ([ins] :: rev_acc)

fn :: lower call expr RNativeEnv String [RExpr] [String] Int RNativeCode => RNativeCode
      lower call expr env "__chain__" (fn_e:call_args) bound_locals sp st =
        st1 = lower expr env fn_e bound_locals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        lower indirect call slots env sp call_args bound_locals (sp + 1) st2
      lower call expr env fname args bound_locals sp st
        | is agent call name fname = lower agent call env fname args bound_locals sp st
        | is tensor helper name fname = lower tensor helper env fname args bound_locals sp st
        | (lookup local bound_locals fname) >= 0 =
          lower indirect call slots env (env var slot env fname) args bound_locals sp st
      lower call expr env fname [] _ sp st
        | fname == "sys_os" =
          nc emit st (NLoadAdt0 (0 - 2) 0) sp
        | fname == "sys_arch" =
          nc emit st (NLoadAdt0 (0 - 1) 0) sp
      lower call expr env fname (a1:[]) bound_locals sp st
        | (prim type tag id fname) > 0 =
          lower expr env a1 bound_locals sp st
      lower call expr env fname (rec_e:call_args) bound_locals sp st
        | (env has field env fname) and (env fn arity env fname) == 1 and (list len call_args) >= 1 =
          st1 = lower expr env rec_e bound_locals sp st
          st2 = lower field call fn env fname sp st1
          lower indirect call slots env sp call_args bound_locals (sp + 1) st2
        | (env has field env fname) and (env is getter env fname) and (list len call_args) == 0 =
          lower named field read env fname rec_e bound_locals sp st
      lower call expr env fname args bound_locals sp st
        | is upper ident fname =
          count = list len args
          c_tag = ident base name fname
          off = env str off env c_tag
          slen = str len c_tag
          lower adt ctor call env args bound_locals off slen count sp st
        | fname == "map" or fname == "||map" or fname == "seq_map" or fname == "par_map" =
          lower map or closure map env fname args bound_locals sp st
        | fname == "filter" or fname == "||filter" or fname == "seq_filter" or fname == "par_filter" =
          lower filter or closure filter env fname args bound_locals sp st
        | fname == "fold" =
          lower fold or closure fold env args bound_locals sp st
      lower call expr env "sha256_raw" (d:[]) bound_locals sp st
        | (lookup local bound_locals "sha256_raw") < 0 and (expr tensor kind env d) == "B" =
          st1 = lower expr list to slots env [d] bound_locals sp 0 st
          nc emit st1 (NCallBuiltin 117 sp 1) (sp + 2)
      lower call expr env "sha256_raw" ((EBin OpAdd a b):[]) bound_locals sp st
        | (lookup local bound_locals "sha256_raw") < 0 =
          st1 = lower expr list to slots env [a, b] bound_locals sp 0 st
          nc emit st1 (NCallBuiltin 89 sp 2) (sp + 3)
      lower call expr env "str_char_at" ((EVar s_var):idx_e:[]) bound_locals sp st
        | (lookup local bound_locals "str_char_at") < 0 and (lookup local bound_locals s_var) >= 0 =
          s_slot = env var slot env s_var
          st1 = lower expr env idx_e bound_locals sp st
          nc emit st1 (NCallBuiltin 91 s_slot 0) sp
      lower call expr env "str_to_int" (a1:[]) bound_locals sp st
        | (env fn name env) != (s2i helper name) and (env fn arity env (s2i helper name)) == 1 =
          lower call expr env (s2i helper name) [a1] bound_locals sp st
      lower call expr env "send_through" (msg_e:ch_e:[]) bound_locals sp st
        | msg needs copy env msg_e = lower call expr env "send_through" [msg copy expr env msg_e, ch_e] bound_locals sp st
      lower call expr env "chan_send" (msg_e:ch_e:[]) bound_locals sp st
        | msg needs copy env msg_e = lower call expr env "chan_send" [msg copy expr env msg_e, ch_e] bound_locals sp st
      lower call expr env fname args bound_locals sp st
        | fname == "sys_call" =
          pargs = pad syscall args args
          st1 = lower expr list to slots env pargs bound_locals sp 0 st
          nc emit st1 (NCallBuiltin 116 sp 7) (sp + 8)
        | (builtin call id fname) >= 0 and (not ((is wrapable builtin fn fname) and (list len args) > 0 and (list len args) < (std builtin arity fname))) =
          count = list len args
          bid = select par collection builtin env fname args bound_locals
          st1 = lower expr list to slots env args bound_locals sp 0 st
          nc emit st1 (NCallBuiltin bid sp count) (sp + count + 1)
        | otherwise =
          count = list len args
          fn_ar = env fn arity env fname
          lower direct or partial call env fname args count fn_ar bound_locals sp st

fn :: pad syscall args [RExpr] => [RExpr]
      pad syscall args args
        | (list len args) >= 7 = args
        | otherwise = pad syscall args (args :: [EInt 0])

fn :: build tuple unpack instrs Int Int Int => [RNativeInstr]
      build tuple unpack instrs tup_slot count idx
        | idx >= count = []
        | otherwise =
          [NTupleGet tup_slot idx, NStoreSlot (tup_slot + 1 + idx)] :: (build tuple unpack instrs tup_slot count (idx + 1))

fn :: lower adt ctor call RNativeEnv [RExpr] [String] Int Int Int Int RNativeCode => RNativeCode
      lower adt ctor call _ [] _ off slen 0 sp st =
        nc emit st (NLoadAdt0 off slen) sp
      lower adt ctor call env args bound_locals off slen count sp st =
        st1 = lower expr list to slots env args bound_locals sp 0 st
        nc emit st1 (NMakeAdt off slen sp count) (sp + count + 1)

fn :: lower expr RNativeEnv RExpr [String] Int RNativeCode => RNativeCode
      lower expr env (ECall fname ((EVar tr):[])) bound_locals sp st
        | str starts with fname "#take " = lower take field env (str slice fname 6 (str len fname)) tr sp st
      lower expr env (ECall "#move" ((EVar u):[])) _ sp st =
        nc emit st (NMoveSlot (env var slot env u)) sp
      lower expr _ (EInt n) _ sp st =
        lower int lit n sp st
      lower expr env (EReal r) _ sp st =
        off = env str off env r
        nc emit st (NLoadRealLit off (str len r)) sp
      lower expr env (EStr s) _ sp st =
        off = env str off env s
        nc emit st (NLoadStrLit off (str len s)) sp
      lower expr env (EStrInterp raw_parts) bound_locals sp st =
        parts = show tensor expr list env raw_parts
        count = list len parts
        st1 = lower expr list to slots env parts bound_locals sp 0 st
        nc emit st1 (NStrInterp sp count) (sp + count + 1)
      lower expr _ (EBool True) _ sp st =
        nc emit st (NLoadImmRaw 6) sp
      lower expr _ (EBool False) _ sp st =
        nc emit st (NLoadImmRaw 2) sp
      lower expr _ EUnit _ sp st =
        nc emit st (NLoadImmRaw 0) sp
      lower expr env (EVar name) bound_locals sp st =
        lower var expr env name bound_locals sp st
      lower expr env (ENot inner) bound_locals sp st =
        st1 = lower expr env inner bound_locals sp st
        nc emit st1 NNot sp
      lower expr env (EOut inner) bound_locals sp st =
        st1 = lower expr env inner bound_locals sp st
        nc emit st1 NOut sp
      lower expr env (EBin OpAnd l r) bound_locals sp st =
        sc_lbl = nc lbl st
        done_lbl = sc_lbl + 1
        st0 = nc set lbl st (sc_lbl + 2)
        st1 = lower expr env l bound_locals sp st0
        st2 = nc emit list st1 [NStoreSlot sp, NMatchBool sp 0, NJumpIfNonZero sc_lbl] (sp + 1)
        st3 = lower expr env r bound_locals (sp + 1) st2
        nc emit list st3 [NBinOp 11 sp, NJump done_lbl, NLabel sc_lbl, NClearLocals sp (sp + 1), NLoadImmRaw 2, NLabel done_lbl] (sp + 2)
      lower expr env (EBin OpOr l r) bound_locals sp st =
        sc_lbl = nc lbl st
        done_lbl = sc_lbl + 1
        st0 = nc set lbl st (sc_lbl + 2)
        st1 = lower expr env l bound_locals sp st0
        st2 = nc emit list st1 [NStoreSlot sp, NMatchBool sp 1, NJumpIfNonZero sc_lbl] (sp + 1)
        st3 = lower expr env r bound_locals (sp + 1) st2
        nc emit list st3 [NBinOp 12 sp, NJump done_lbl, NLabel sc_lbl, NClearLocals sp (sp + 1), NLoadImmRaw 6, NLabel done_lbl] (sp + 2)
      lower expr env (EBin bop l r) bound_locals sp st =
        st1 = lower expr env l bound_locals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower expr env r bound_locals (sp + 1) st2
        nc emit st3 (NBinOp (binop id bop) sp) (sp + 1)
      lower expr env (ECall "__rg_gt_is_gen" ((EVar v):_)) _ sp st =  nc emit st (NIsGen (env var slot env v)) sp
      lower expr env (ECall "__rg_gt_is_list" ((EVar v):_)) _ sp st =  nc emit st (NIsList (env var slot env v)) sp
      lower expr env (ECall "__rg_gt_repeat" (v:n:_)) bound_locals sp st =
        st1 = lower expr env (EList [v, n]) bound_locals sp st
        nc emit list st1 [NStoreSlot sp, NGtConv sp 5, NStoreSlot (sp + 1), NCmmDropSlot sp, NMoveSlot (sp + 1)] (sp + 2)
      lower expr env (ECall "__rg_gt_list_copy" ((EVar v):_)) _ sp st =  nc emit st (NGtConv (env var slot env v) 0) sp
      lower expr env (ECall "__rg_gt_list_tensor" ((EVar v):_)) _ sp st =  nc emit st (NGtConv (env var slot env v) 1) sp
      lower expr env (ECall "__rg_gt_tensor_ints" ((EVar v):_)) _ sp st =  nc emit st (NGtConv (env var slot env v) 2) sp
      lower expr env (ECall "__rg_gt_tensor_reals" ((EVar v):_)) _ sp st =  nc emit st (NGtConv (env var slot env v) 3) sp
      lower expr env (ECall "__rg_gt_len" ((EVar v):_)) _ sp st =  nc emit st (NAdtField (env var slot env v) (0 - 1)) sp
      lower expr env (ECall "__rg_gt_tlen" ((EVar v):_)) _ sp st =  nc emit st (NAdtField (env var slot env v) (0 - 2)) sp
      lower expr env (ECall "__rg_gt_real_bits" (e:_)) bound_locals sp st =
        st1 = lower expr env e bound_locals sp st
        nc emit st1 NRealFromBits sp
      lower expr env (ECall ":msg-copy:" (e:_)) bound_locals sp st =  lower msg copy env e bound_locals sp st
      lower expr env (ECall ":real-bits:" (e:_)) bound_locals sp st =
        st1 = lower expr env e bound_locals sp st
        nc emit st1 NRealToBits sp
      lower expr env (ECall ":char-zero:" []) bound_locals sp st =  lower expr env (ECall "char_from_code" [EInt 0]) bound_locals sp st
      lower expr env (ECall ":tensor-with:" args) bound_locals sp st =  lower shape tensor env args bound_locals sp st
      lower expr env (ECall ":gt-new:" (d:n:[])) bound_locals sp st =  lower expr env (ECall "__rg_gt_new1" [d, n]) bound_locals sp st
      lower expr env (ECall ":gt-new:" (d:r:c:_)) bound_locals sp st =  lower expr env (ECall "__rg_gt_new2" [d, r, c]) bound_locals sp st
      lower expr env (ECall "sort_by_ints" (xs:ks:_)) bound_locals sp st =  lower sort by env 0 xs ks bound_locals sp st
      lower expr env (ECall "sort_by_texts" (xs:ks:_)) bound_locals sp st =  lower sort by env 1 xs ks bound_locals sp st
      lower expr env (ECall "tensor_from_list" (x:_)) bound_locals sp st =  lower expr env (ECall "__rg_gt_from_list" [x]) bound_locals sp st
      lower expr env (ECall "tensor_to_list" (x:_)) bound_locals sp st
        | (expr tensor kind env x) == "B" =
          st1 = lower expr list to slots env [x] bound_locals sp 0 st
          nc emit st1 (NCallBuiltin 110 sp 1) (sp + 2)
      lower expr env (ECall ":u8-words:" (x:_)) bound_locals sp st =
        st1 = lower expr list to slots env [x] bound_locals sp 0 st
        nc emit st1 (NCallBuiltin 111 sp 1) (sp + 2)
      lower expr env (ECall "tensor_to_list" ((EVar v):_)) bound_locals sp st
        | env is real tensor env v = lower expr env (ECall "__rg_gt_to_list_real" [EVar v]) bound_locals sp st
      lower expr env (ECall "tensor_to_list" (x:_)) bound_locals sp st =  lower expr env (ECall "__rg_gt_to_list" [x]) bound_locals sp st
      lower expr env (ECall "__record_update__" (base_e:rest_args)) bound_locals sp st =
        st1 = lower expr env base_e bound_locals sp st
        lower record updates env rest_args bound_locals sp st1
      lower expr env (ECall "__unpack2__" ((EVar fn_target):single_arg:[])) bound_locals sp st =
        part_lbl = nc lbl st
        done_lbl = part_lbl + 1
        st0 = nc set lbl st (part_lbl + 2)
        st1 = lower expr env single_arg bound_locals sp st0
        fid = env fn id env fn_target
        arity = max int (env fn arity env fn_target) 2
        off = env str off env fn_target
        slen = str len fn_target
        unpack_ins = build tuple unpack instrs sp arity 0
        ins_list = [NStoreSlot sp, NMatchTuple sp arity, NJumpIfZero part_lbl] :: unpack_ins :: [NClearLocals sp (sp + 1), NCallFn fid (sp + 1) arity, NJump done_lbl, NLabel part_lbl, NMoveSlot sp, NStoreSlot (sp + 1), NMakeList (sp + 1) 1, NStoreSlot (sp + 1), NLoadStrLit off slen, NStoreSlot sp, NMakeTuple sp 2, NLabel done_lbl]
        nc emit list st1 ins_list (sp + arity + 2)
      lower expr env (ECall fname args) bound_locals sp st =
        lower call expr env fname args bound_locals sp st
      lower expr env (EEcho raw_args) bound_locals sp st =
        args = show tensor expr list env raw_args
        count = list len args
        st1 = lower expr list to slots env args bound_locals sp 0 st
        nc emit st1 (NEcho sp count) (sp + count + 1)
      lower expr env (EList elems) bound_locals sp st =
        count = list len elems
        st1 = lower expr list to slots env elems bound_locals sp 0 st
        nc emit st1 (NMakeList sp count) (sp + count + 1)
      lower expr env (ETuple elems) bound_locals sp st =
        count = list len elems
        st1 = lower expr list to slots env elems bound_locals sp 0 st
        nc emit st1 (NMakeTuple sp count) (sp + count + 1)
      lower expr env (ETensor raw_elems) bound_locals sp st =
        elems = real bits leaves raw_elems
        count = list len elems
        st1 = lower expr list to slots env elems bound_locals sp 0 st
        nc emit st1 (NMakeTensor sp count) (sp + count + 1)
      lower expr env (EEinsum es subs) bound_locals sp st
        | all real operands env es = lower real einsum env es subs bound_locals sp st
        | otherwise =
          count = list len es
          spec = str join subs ","
          off = env str off env spec
          st1 = lower expr list to slots env es bound_locals sp 0 st
          nc emit st1 (NEinsum sp count off (str len spec)) (sp + count + 1)
      lower expr env (EHadamard bop l s1 r s2) bound_locals sp st
        | (hadamard word op bop) or (s1 == s2 and (hadamard arith op bop)) =
          lower bitwise hadamard env bop l r bound_locals sp st
        | otherwise =
          subs = s1 + "," + s2
          off = env str off env subs
          st1 = lower expr env l bound_locals sp st
          st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
          st3 = lower expr env r bound_locals (sp + 1) st2
          nc emit st3 (NHadamard (binop id bop) sp off (str len subs)) (sp + 1)
      lower expr env (EIndex (EVar v) ((EInt idx):[])) _ sp st
        | (str starts with v ":tup-") or (str starts with v ":idx-tup-") =
          nc emit st (NTupleGet (env var slot env v) idx) sp
      lower expr env (EIndex (EVar v) idxs) bound_locals sp st =
        lower var index read env v idxs bound_locals sp st
      lower expr env (EIndex base idxs) bound_locals sp st =
        lower base index read env base idxs bound_locals sp st
      lower expr env (EIndexAssign target idxs val_e) bound_locals sp st =
        count = list len idxs
        tslot = env var slot env target
        st1 = lower expr list to slots env idxs bound_locals sp 0 st
        st2 = lower expr env val_e bound_locals (sp + count) st1
        nc emit (emit tensor store env target tslot sp count st2) (NCloneSlot tslot) (sp + count + 1)
      lower expr env (ESeqSelect base mask) bound_locals sp st =
        off = env str off env mask
        st1 = lower expr env base bound_locals sp st
        nc emit st1 (NSeqSelect off (str len mask)) sp
      lower expr env (EBlock stmts) bound_locals sp st =
        lower stmts cmm env stmts bound_locals [] sp st
      lower expr env (EGuard guards) bound_locals sp st =
        end_lbl = nc lbl st
        st1 = nc set lbl st (end_lbl + 1)
        lower expr guards env guards bound_locals end_lbl sp st1
      lower expr env (EWhere body binds) bound_locals sp st =
        lower where cmm env binds body bound_locals [] sp st
      lower expr env (EParPipe branches) bound_locals sp st
        | (list len branches) >= 2 and (all exprs par eval env branches bound_locals) =
          count = list len branches
          par_off = env str off env "__rg_par_eval__"
          st1 = lower par eval list env branches bound_locals sp 0 st
          st2 = nc emit list st1 [NMakeList sp count, NStoreSlot (sp + 1), NLoadStrLit par_off 15, NStoreSlot sp, NCallBuiltin 54 sp 2, NStoreSlot sp] (sp + count + 2)
          st3 = unpack par list to slots sp count 0 st2
          nc emit list st3 [NClearLocals sp (sp + 1), NMakeTuple (sp + 1) count] (sp + count + 2)
        | otherwise =
          count = list len branches
          st1 = lower expr list to slots env branches bound_locals sp 0 st
          nc emit st1 (NMakeTuple sp count) (sp + count + 1)
      lower expr env (EWithCtx _ val_e body) bound_locals sp st =
        st1 = lower expr env val_e bound_locals sp st
        st2 = nc emit list st1 [NStoreSlot sp, NCallBuiltin 84 sp 1] (sp + 1)
        st3 = lower expr env body bound_locals sp st2
        nc emit list st3 [NStoreSlot sp, NCallBuiltin 85 sp 1] (sp + 1)
      lower expr env (EWithRegion quota body) bound_locals sp st =
        st1 = nc emit st NEnterRegion sp
        st2 = lower expr env body bound_locals sp st1
        nc emit st2 (NExitRegion quota) sp

fn :: lower expr guards RNativeEnv [RGuard] [String] Int Int RNativeCode => RNativeCode
      lower expr guards _ [] _ end_lbl sp st =
        nc emit list st [NLoadImmRaw 0, NLabel end_lbl] sp
      lower expr guards env ((GuardBranch cond body):gs) bound_locals end_lbl sp st =
        next_lbl = nc lbl st
        st1 = nc set lbl st (next_lbl + 1)
        st2 = lower expr env cond bound_locals sp st1
        st3 = nc emit list st2 [NAsBool, NJumpIfZero next_lbl] sp
        st4 = lower expr env body bound_locals sp st3
        st5 = nc emit list st4 [NJump end_lbl, NLabel next_lbl] sp
        lower expr guards env gs bound_locals end_lbl sp st5

fn :: lower final block expr RNativeEnv RExpr [String] [String] Int RNativeCode => RNativeCode
      lower final block expr env (EVar v) bound_locals _ sp st
        | (lookup local bound_locals v) >= 0 =
          nc emit st (NMoveSlot (env var slot env v)) sp
      lower final block expr env e bound_locals [] sp st =
        lower expr env e bound_locals sp st
      lower final block expr env e bound_locals dead_vars sp st =
        st1 = lower expr env e bound_locals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower cmm drops env dead_vars (sp + 1) st2
        nc emit st3 (NMoveSlot sp) (sp + 1)

fn :: lower let binding stmt RNativeEnv String RExpr [String] [String] [RStmt] Int RNativeCode => RNativeCode
      lower let binding stmt env v e bound_locals scope_vars rest sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm stmts vars rest []
        live_with_v = add unique str v live_after
        dead_inputs = cmm filter not in list (cmm remove str v used_in_e) live_with_v
        st1 = lower expr env e bound_locals sp st
        st2 = lower let var store env v bound_locals sp st1
        st3 = lower cmm drops env dead_inputs sp st2
        st4 = lower unused let drop env v live_after sp st3
        lower stmts cmm env rest (add unique str v bound_locals) (add unique str v scope_vars) sp st4

fn :: lower stmts cmm RNativeEnv [RStmt] [String] [String] Int RNativeCode => RNativeCode
      lower stmts cmm _ [] _ _ sp st =
        nc emit st (NLoadImmRaw 0) sp
      lower stmts cmm env ((StmtExpr e):[]) bound_locals scope_vars sp st =
        used = cmm filter in list (cmm expr vars e []) scope_vars
        lower final block expr env e bound_locals used sp st
      lower stmts cmm env ((StmtIndexAssign t idxs e):[]) bound_locals scope_vars sp st =
        count = list len idxs
        tslot = env var slot env t
        st1 = lower expr list to slots env idxs bound_locals sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env t tslot sp count st2
        st4 = lower cmm drops env (cmm remove str t scope_vars) (sp + count + 1) st3
        nc emit st4 (NCloneSlot tslot) (sp + count + 1)
      lower stmts cmm env ((StmtLet v e):[]) bound_locals scope_vars sp st
        | v == "_" =
          used = cmm filter in list (cmm expr vars e []) scope_vars
          st1 = lower expr env e bound_locals sp st
          st2 = nc emit st1 NDropVal sp
          st3 = lower cmm drops env used sp st2
          nc emit st3 (NLoadImmRaw 0) sp
        | otherwise =
          used = cmm remove str v (cmm filter in list (cmm expr vars e []) scope_vars)
          st1 = lower expr env e bound_locals sp st
          st2 = lower let var store env v bound_locals sp st1
          st3 = lower cmm drops env used sp st2
          nc emit st3 (NMoveSlot (env var slot env v)) sp
      lower stmts cmm env ((StmtMut v e):[]) bound_locals scope_vars sp st =
        lower stmts cmm env [StmtLet v e] bound_locals scope_vars sp st
      lower stmts cmm env ((StmtLet v e):rest) bound_locals scope_vars sp st
        | v == "_" =
          used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
          live_after = cmm stmts vars rest []
          dead_now = cmm filter not in list used_in_e live_after
          st1 = lower expr env e bound_locals sp st
          st2 = nc emit st1 NDropVal sp
          st3 = lower cmm drops env dead_now sp st2
          lower stmts cmm env rest bound_locals scope_vars sp st3
        | otherwise =
          lower let binding stmt env v e bound_locals scope_vars rest sp st
      lower stmts cmm env ((StmtMut v e):rest) bound_locals scope_vars sp st =
        lower let binding stmt env v e bound_locals scope_vars rest sp st
      lower stmts cmm env ((StmtIndexAssign t idxs e):rest) bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e (cmm expr list vars idxs [])) scope_vars
        live_after = add unique str t (cmm stmts vars rest [])
        dead_now = cmm filter not in list used_in_e live_after
        count = list len idxs
        tslot = env var slot env t
        st1 = lower expr list to slots env idxs bound_locals sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env t tslot sp count st2
        st4 = lower cmm drops env dead_now (sp + count + 1) st3
        lower stmts cmm env rest bound_locals scope_vars sp st4
      lower stmts cmm env ((StmtExpr e):rest) bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm stmts vars rest []
        dead_now = cmm filter not in list used_in_e live_after
        st1 = lower expr env e bound_locals sp st
        st2 = nc emit st1 NDropVal sp
        st3 = lower cmm drops env dead_now sp st2
        lower stmts cmm env rest bound_locals scope_vars sp st3

fn :: can par eval expr RNativeEnv RExpr [String] => Bool
      can par eval expr env (ECall fname args) bound_locals =
        arity = env fn arity env fname
        nargs = list len args
        (lookup local bound_locals fname) < 0 and (not (is upper ident fname)) and (builtin call id fname) < 0 and (not (is agent call name fname)) and fname != "sys_os" and fname != "sys_arch" and fname != "__record_update__" and fname != "__unpack2__" and arity >= 0 and arity <= 3 and nargs == arity and (env fn is heavy env fname)
      can par eval expr _ _ _ = False

fn :: all exprs par eval RNativeEnv [RExpr] [String] => Bool
      all exprs par eval _ [] _ = True
      all exprs par eval env (e:es) bound_locals
        | can par eval expr env e bound_locals = all exprs par eval env es bound_locals
        | otherwise = False

fn :: lower par eval arg RNativeEnv [RExpr] [String] Int RNativeCode => RNativeCode
      lower par eval arg _ [] _ slot st =
        nc emit list st [NLoadImmInt 0, NStoreSlot slot] (slot + 1)
      lower par eval arg env (a1:[]) bound_locals slot st =
        st1 = lower expr env a1 bound_locals slot st
        nc emit st1 (NStoreSlot slot) (slot + 1)
      lower par eval arg env args bound_locals slot st =
        count = list len args
        st1 = lower expr list to slots env args bound_locals slot 0 st
        nc emit list st1 [NMakeTuple slot count, NStoreSlot slot] (slot + count + 1)

fn :: lower par eval item RNativeEnv RExpr [String] Int RNativeCode => RNativeCode
      lower par eval item env (ECall fname args) bound_locals slot st =
        off = env str off env fname
        st1 = nc emit list st [NLoadStrLit off (str len fname), NStoreSlot slot] (slot + 1)
        st2 = lower par eval arg env args bound_locals (slot + 1) st1
        nc emit list st2 [NMakeTuple slot 2, NStoreSlot slot] (slot + 2)
      lower par eval item _ _ _ _ st = st

fn :: lower par eval list RNativeEnv [RExpr] [String] Int Int RNativeCode => RNativeCode
      lower par eval list _ [] _ _ _ st = st
      lower par eval list env (e:es) bound_locals sp idx st =
        st1 = lower par eval item env e bound_locals (sp + idx) st
        lower par eval list env es bound_locals sp (idx + 1) st1

fn :: unpack par list to slots Int Int Int RNativeCode => RNativeCode
      unpack par list to slots _ count idx st
        | idx >= count = st
      unpack par list to slots list_slot count idx st =
        dst = list_slot + 1 + idx
        st1 = nc emit list st [NListHead list_slot, NStoreSlot dst, NListTail list_slot, NStoreSlot list_slot] (dst + 1)
        unpack par list to slots list_slot count (idx + 1) st1

fn :: can par where pair RNativeEnv RExpr String RExpr String [String] => Bool
      can par where pair env e1 v1 e2 v2 bound_locals =
        v1 != "_" and v2 != "_" and v1 != v2 and (can par eval expr env e1 bound_locals) and (can par eval expr env e2 bound_locals) and (not (list contains (cmm expr vars e2 []) v1))

fn :: emit par where pair RNativeEnv RExpr String RExpr String [RWhereBind] RExpr [String] [String] Int RNativeCode => RNativeCode
      emit par where pair env e1 v1 e2 v2 wbs body bound_locals scope_vars sp st =
        used_in_pair = cmm filter in list (cmm expr vars e2 (cmm expr vars e1 [])) scope_vars
        live_after = cmm where vars wbs body []
        live_with_vs = add unique str v1 (add unique str v2 live_after)
        dead_inputs = cmm filter not in list (cmm remove str v1 (cmm remove str v2 used_in_pair)) live_with_vs
        par_off = env str off env "__rg_par_eval__"
        st1 = lower par eval list env [e1, e2] bound_locals sp 0 st
        st2 = nc emit list st1 [NMakeList sp 2, NStoreSlot (sp + 1), NLoadStrLit par_off 15, NStoreSlot sp, NCallBuiltin 54 sp 2, NStoreSlot sp, NListHead sp] (sp + 4)
        st3 = lower let var store env v1 bound_locals (sp + 4) st2
        st4 = nc emit list st3 [NListTail sp, NStoreSlot sp, NListHead sp] (sp + 4)
        locals1 = add unique str v1 bound_locals
        st5 = lower let var store env v2 locals1 (sp + 4) st4
        st6 = nc emit st5 (NClearLocals sp (sp + 1)) (sp + 4)
        st7 = lower cmm drops env dead_inputs sp st6
        st8 = lower unused let drop env v1 (add unique str v2 live_after) sp st7
        lower unused let drop env v2 live_after sp st8

fn :: lower where cmm RNativeEnv [RWhereBind] RExpr [String] [String] Int RNativeCode => RNativeCode
      lower where cmm env [] body bound_locals scope_vars sp st =
        used = cmm filter in list (cmm expr vars body []) scope_vars
        lower final block expr env body bound_locals used sp st
      lower where cmm env ((WhereBind e1 v1 []):(WhereBind e2 v2 []):wbs) body bound_locals scope_vars sp st
        | can par where pair env e1 v1 e2 v2 bound_locals =
          st1 = emit par where pair env e1 v1 e2 v2 wbs body bound_locals scope_vars sp st
          locals2 = add unique str v2 (add unique str v1 bound_locals)
          scope2 = add unique str v2 (add unique str v1 scope_vars)
          lower where cmm env wbs body locals2 scope2 sp st1
      lower where cmm env ((WhereBind e v []):wbs) body bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm where vars wbs body []
        live_with_v = add unique str v live_after
        dead_inputs = cmm filter not in list (cmm remove str v used_in_e) live_with_v
        st1 = lower expr env e bound_locals sp st
        st2 = lower let var store env v bound_locals sp st1
        st3 = lower cmm drops env dead_inputs sp st2
        st4 = lower unused let drop env v live_after sp st3
        lower where cmm env wbs body (add unique str v bound_locals) (add unique str v scope_vars) sp st4
      lower where cmm env ((WhereBind e v idxs):wbs) body bound_locals scope_vars sp st =
        count = list len idxs
        tslot = env var slot env v
        st1 = lower int list to slots idxs sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env v tslot sp count st2
        lower where cmm env wbs body bound_locals scope_vars sp st3

-- ── Tail-Call Optimization (TCO) & Tail Return Lowering ─────

fn :: expr has self tail call String RExpr => Bool
      expr has self tail call target (ECall fname _) = fname == target
      expr has self tail call target (EBlock stmts) = stmts have self tail call target stmts
      expr has self tail call target (EGuard guards) = guards have self tail call target guards
      expr has self tail call target (EWhere body _) = expr has self tail call target body
      expr has self tail call _ _ = False

fn :: stmts have self tail call String [RStmt] => Bool
      stmts have self tail call _ [] = False
      stmts have self tail call target ((StmtExpr e):[]) = expr has self tail call target e
      stmts have self tail call target (_:rest) = stmts have self tail call target rest

fn :: guards have self tail call String [RGuard] => Bool
      guards have self tail call _ [] = False
      guards have self tail call target ((GuardBranch _ body):gs)
        | expr has self tail call target body = True
        | otherwise = guards have self tail call target gs

-- OPT-019: a guard branch that ends in a direct call to another function
-- is lowered by `lower tail guards cmm`, so the call stays in tail position.
fn :: expr has direct tail call RNativeEnv RExpr [String] => Bool
      expr has direct tail call env (ECall fname args) bound_locals = is direct call target env fname args bound_locals
      expr has direct tail call env (EBlock stmts) bound_locals = stmts have direct tail call env stmts bound_locals
      expr has direct tail call env (EGuard guards) bound_locals = guards have direct tail call env guards bound_locals
      expr has direct tail call env (EWhere body _) bound_locals = expr has direct tail call env body bound_locals
      expr has direct tail call _ _ _ = False

fn :: stmts have direct tail call RNativeEnv [RStmt] [String] => Bool
      stmts have direct tail call _ [] _ = False
      stmts have direct tail call env ((StmtExpr e):[]) bound_locals = expr has direct tail call env e bound_locals
      stmts have direct tail call env (_:rest) bound_locals = stmts have direct tail call env rest bound_locals

fn :: guards have direct tail call RNativeEnv [RGuard] [String] => Bool
      guards have direct tail call _ [] _ = False
      guards have direct tail call env ((GuardBranch _ body):gs) bound_locals
        | expr has direct tail call env body bound_locals = True
        | otherwise = guards have direct tail call env gs bound_locals

fn :: can move param var String [String] [String] [String] => Bool
      can move param var v locals scope_vars later_vars =
        ((lookup local locals v) >= 0) and (not (list contains scope_vars v)) and (not (list contains later_vars v))

-- A call to a user function with all its arguments (no builtin, constructor,
-- agent, tensor helper, record getter with extra arguments, local function
-- value or borrowing callee): lowered as a direct `NCallFn`, and in tail
-- position as `NTailCallFn` (OPT-019).
fn :: is plain call target RNativeEnv String [RExpr] [String] => Bool
      is plain call target env fname args bound_locals =
        (lookup local bound_locals fname) < 0 and (not (is upper ident fname)) and (builtin call id fname) < 0 and (not (is agent call name fname)) and (not (is tensor helper name fname)) and (not (is gt pseudo name fname)) and fname != "sys_os" and fname != "sys_arch" and fname != "__record_update__" and fname != "__unpack2__" and fname != "__chain__" and (list len args) == (env fn arity env fname) and (not ((env has field env fname) and (env fn arity env fname) == 1 and (list len args) > 1))

fn :: is direct call target RNativeEnv String [RExpr] [String] => Bool
      is direct call target env fname args bound_locals =
        (is plain call target env fname args bound_locals) and (env borrow mask env fname) <= 0

-- The same call to a callee that borrows some parameters (OPT-018).
fn :: is borrow call target RNativeEnv String [RExpr] [String] => Bool
      is borrow call target env fname args bound_locals =
        (env borrow mask env fname) > 0 and (is plain call target env fname args bound_locals)

fn :: lower tco arg expr RNativeEnv RExpr [RExpr] [String] [String] Int RNativeCode => RNativeCode
      lower tco arg expr env (EVar v) es bound_locals scope_vars sp st
        | can move param var v bound_locals scope_vars (cmm expr list vars es []) =
          nc emit st (NMoveSlot (env var slot env v)) sp
      lower tco arg expr env (EBin OpConcat l r) es bound_locals scope_vars sp st =
        st1 = lower tco arg expr env l ([r] :: es) bound_locals scope_vars sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower tco arg expr env r es bound_locals scope_vars (sp + 1) st2
        nc emit st3 (NBinOp 14 sp) (sp + 1)
      lower tco arg expr env (EBin OpAdd l r) es bound_locals scope_vars sp st
        | str add chain env l =
          st1 = lower tco arg expr env l ([r] :: es) bound_locals scope_vars sp st
          st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
          st3 = lower tco arg expr env r es bound_locals scope_vars (sp + 1) st2
          done_lbl = nc lbl st3
          st4 = nc set lbl st3 (done_lbl + 1)
          nc emit list st4 [NStoreSlot (sp + 1), NCallBuiltin 121 sp 2, NJumpIfNonZero done_lbl, NMoveSlot (sp + 1), NBinOp (binop id OpAdd) sp, NLabel done_lbl] (sp + 2)
      lower tco arg expr env (ETuple elems) es bound_locals scope_vars sp st =
        count = list len elems
        st1 = lower tco arg list to slots env elems es bound_locals scope_vars sp 0 st
        nc emit st1 (NMakeTuple sp count) (sp + count + 1)
      lower tco arg expr env (ECall fname args) es bound_locals scope_vars sp st
        | is direct call target env fname args bound_locals =
          count = list len args
          st1 = lower tco arg list to slots env args es bound_locals scope_vars sp 0 st
          nc emit st1 (NCallFn (env fn id env fname) sp count) (sp + count + 1)
        | is borrow call target env fname args bound_locals =
          lower tco borrow call env fname args es bound_locals scope_vars sp st
      lower tco arg expr env e _ bound_locals _ sp st =
        lower expr env e bound_locals sp st

-- `v + r` on Strings in a tail position (OPT-020): `v` is moved on its
-- last use, and runtime extension builtin 121 appends `r` to it in place
-- when it has one owner, so `loop (n - 1) (acc + x)` is linear. Builtin
-- 121 returns 0 and leaves both slots alone otherwise (shared or not two
-- Strings); then the usual `+` makes a new String. A chain
-- `acc + sep + x` appends twice: the inner result is a new String or `acc`
-- itself, owned once.
fn :: str add chain RNativeEnv RExpr => Bool
      str add chain env (EVar v) =  (env tensor kind env ("$" + v)) == "S"
      str add chain env (EBin OpAdd l _) =  str add chain env l
      str add chain _ _ =  False

-- A call to a borrowing callee in a tail position (`loop s (emit step acc)`):
-- its owned arguments are moved on their last use, as for any other callee,
-- so `acc :: [h]` inside it appends in place (Solstice report 2026-11-10:
-- cloning `acc` made the loop quadratic). A local passed to a borrowed
-- parameter is read after the owned arguments are computed, so it counts as
-- a later use and is never moved by them.
fn :: lower tco borrow call RNativeEnv String [RExpr] [RExpr] [String] [String] Int RNativeCode => RNativeCode
      lower tco borrow call env fname args after bound_locals scope_vars sp st =
        count = list len args
        mask = env borrow mask env fname
        top = sp + (2 * count) + 1
        peeked = borrow peeked args args mask bound_locals 0 []
        st1 = lower tco borrow args env args (peeked :: after) mask bound_locals scope_vars sp 0 st
        st2 = nc emit list st1 (borrow fixup ins env args mask bound_locals sp count 0 []) top
        st3 = nc emit st2 (NCallFn (env fn id env fname) sp count) top
        drops = borrow drop ins args mask bound_locals sp count 0 []
        lower borrow cleanup drops (sp + (2 * count)) top st3

fn :: borrow peeked args [RExpr] Int [String] Int [RExpr] => [RExpr]
      borrow peeked args [] _ _ _ acc = acc
      borrow peeked args (e:es) mask bound_locals idx acc
        | (borrow bit mask idx) and (borrow local arg e bound_locals) = borrow peeked args es mask bound_locals (idx + 1) (acc :: [e])
        | otherwise = borrow peeked args es mask bound_locals (idx + 1) acc

fn :: lower tco borrow args RNativeEnv [RExpr] [RExpr] Int [String] [String] Int Int RNativeCode => RNativeCode
      lower tco borrow args _ [] _ _ _ _ _ _ st = st
      lower tco borrow args env (e:es) after mask bound_locals scope_vars sp idx st
        | (borrow bit mask idx) and (borrow local arg e bound_locals) =
          lower tco borrow args env es after mask bound_locals scope_vars sp (idx + 1) st
        | otherwise =
          cur_slot = sp + idx
          st1 = lower tco arg expr env e (es :: after) bound_locals scope_vars cur_slot st
          st2 = nc emit st1 (NStoreSlot cur_slot) (cur_slot + 1)
          lower tco borrow args env es after mask bound_locals scope_vars sp (idx + 1) st2

fn :: lower tco arg list to slots RNativeEnv [RExpr] [RExpr] [String] [String] Int Int RNativeCode => RNativeCode
      lower tco arg list to slots _ [] _ _ _ _ _ st = st
      lower tco arg list to slots env (e:es) after bound_locals scope_vars sp idx st =
        cur_slot = sp + idx
        st1 = lower tco arg expr env e (es :: after) bound_locals scope_vars cur_slot st
        st2 = nc emit st1 (NStoreSlot cur_slot) (cur_slot + 1)
        lower tco arg list to slots env es after bound_locals scope_vars sp (idx + 1) st2

-- Self tail call: a parameter passed as a plain argument and read again by a
-- later argument (`loop r (acc + field r)`) is moved into its argument slot
-- after the other arguments are computed, instead of being cloned. The later
-- arguments read it from its own slot. Parameters cannot be reassigned, so
-- the value is the same at either point.
fn :: env is param RNativeEnv String => Bool
      env is param (NativeEnv _ arity all_locals _ _ _ _ _ _) name =
        idx = lookup local all_locals name
        idx >= 0 and idx < arity

fn :: tco deferred vars RNativeEnv [RExpr] [String] [String] [String] => [String]
      tco deferred vars _ [] _ _ acc = acc
      tco deferred vars env ((EVar v):es) locals scope_vars acc
        | (lookup local locals v) >= 0 and (env is param env v) and (not (list contains scope_vars v)) and (not (list contains acc v)) and (list contains (cmm expr list vars es []) v) =
          tco deferred vars env es locals scope_vars (acc :: [v])
      tco deferred vars env (_:es) locals scope_vars acc =
        tco deferred vars env es locals scope_vars acc

fn :: tco deferred arg RExpr [String] [String] => String
      tco deferred arg (EVar v) deferred seen
        | (list contains deferred v) and (not (list contains seen v)) = v
      tco deferred arg _ _ _ = ""

fn :: lower tco args deferred RNativeEnv [RExpr] [String] [String] [String] [String] Int Int RNativeCode => RNativeCode
      lower tco args deferred _ [] _ _ _ _ _ _ st = st
      lower tco args deferred env (e:es) deferred seen bound_locals scope_vars sp idx st
        | (tco deferred arg e deferred seen) != "" =
          lower tco args deferred env es deferred (seen :: [tco deferred arg e deferred seen]) bound_locals scope_vars sp (idx + 1) st
        | otherwise =
          cur_slot = sp + idx
          st1 = lower tco arg expr env e es bound_locals (scope_vars :: deferred) cur_slot st
          st2 = nc emit st1 (NStoreSlot cur_slot) (cur_slot + 1)
          lower tco args deferred env es deferred seen bound_locals scope_vars sp (idx + 1) st2

fn :: lower tco deferred moves RNativeEnv [RExpr] [String] [String] Int Int RNativeCode => RNativeCode
      lower tco deferred moves _ [] _ _ _ _ st = st
      lower tco deferred moves env (e:es) deferred seen sp idx st
        | (tco deferred arg e deferred seen) != "" =
          v = tco deferred arg e deferred seen
          cur_slot = sp + idx
          st1 = nc emit list st [NMoveSlot (env var slot env v), NStoreSlot cur_slot] (cur_slot + 1)
          lower tco deferred moves env es deferred (seen :: [v]) sp (idx + 1) st1
        | otherwise = lower tco deferred moves env es deferred seen sp (idx + 1) st

fn :: lower tail return RNativeEnv RExpr [String] Int RNativeCode => RNativeCode
      lower tail return env expr bound_locals sp st =
        lower tail return cmm env expr bound_locals [] sp st

fn :: lower tail return cmm RNativeEnv RExpr [String] [String] Int RNativeCode => RNativeCode
      lower tail return cmm env (ECall fname args) bound_locals scope_vars sp st
        | (builtin call id fname) < 0 and fname == (env fn name env) and (list len args) == (env arity env) and (lookup local bound_locals fname) < 0 =
          arity = env arity env
          deferred = tco deferred vars env args bound_locals scope_vars []
          st0 = lower tco args deferred env args deferred [] bound_locals scope_vars sp 0 st
          st1 = lower tco deferred moves env args deferred [] sp 0 st0
          st2 = lower cmm drops env scope_vars (sp + arity + 1) st1
          nc emit st2 (NTailCall sp arity) (sp + arity + 1)
      lower tail return cmm env (EBlock stmts) bound_locals scope_vars sp st =
        lower tail stmts cmm env stmts bound_locals scope_vars sp st
      lower tail return cmm env (EGuard guards) bound_locals scope_vars sp st
        | (guards have self tail call (env fn name env) guards) or (guards have direct tail call env guards bound_locals) =
          lower tail guards cmm env guards bound_locals scope_vars sp st
      lower tail return cmm env (EWhere body binds) bound_locals scope_vars sp st =
        lower tail where cmm env binds body bound_locals scope_vars sp st
      lower tail return cmm env (EVar v) bound_locals _ sp st
        | (lookup local bound_locals v) >= 0 =
          nc emit list st [NMoveSlot (env var slot env v), NReturn] sp
      lower tail return cmm env expr bound_locals scope_vars sp st =
        used = cmm filter in list (cmm expr vars expr []) scope_vars
        lower tail return expr env expr bound_locals scope_vars used sp st

fn :: lower tail return expr RNativeEnv RExpr [String] [String] [String] Int RNativeCode => RNativeCode
      lower tail return expr env (ECall fname args) bound_locals scope_vars used sp st
        | is direct call target env fname args bound_locals =
          count = list len args
          st1 = lower tco arg list to slots env args [] bound_locals scope_vars sp 0 st
          st2 = lower cmm drops env used (sp + count + 1) st1
          nc emit st2 (NTailCallFn (env fn id env fname) sp count 0) (sp + count + 1)
      lower tail return expr env expr bound_locals scope_vars [] sp st =
        st1 = lower tco arg expr env expr [] bound_locals scope_vars sp st
        nc emit st1 NReturn sp
      lower tail return expr env expr bound_locals scope_vars used sp st =
        st1 = lower tco arg expr env expr [] bound_locals scope_vars sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower cmm drops env used (sp + 1) st2
        nc emit list st3 [NMoveSlot sp, NReturn] (sp + 1)

fn :: lower tail guards cmm RNativeEnv [RGuard] [String] [String] Int RNativeCode => RNativeCode
      lower tail guards cmm env [] _ scope_vars sp st =
        st1 = lower cmm drops env scope_vars sp st
        nc emit list st1 [NLoadImmRaw 0, NReturn] sp
      lower tail guards cmm env ((GuardBranch cond body):gs) bound_locals scope_vars sp st =
        next_lbl = nc lbl st
        st1 = nc set lbl st (next_lbl + 1)
        st2 = lower expr env cond bound_locals sp st1
        st3 = nc emit list st2 [NAsBool, NJumpIfZero next_lbl] sp
        st4 = lower tail return cmm env body bound_locals scope_vars sp st3
        st5 = nc emit st4 (NLabel next_lbl) sp
        lower tail guards cmm env gs bound_locals scope_vars sp st5

fn :: lower tail let stmt RNativeEnv String RExpr [String] [String] [RStmt] Int RNativeCode => RNativeCode
      lower tail let stmt env v e bound_locals scope_vars rest sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm stmts vars rest []
        live_with_v = add unique str v live_after
        dead_inputs = cmm filter not in list (cmm remove str v used_in_e) live_with_v
        st1 = lower expr env e bound_locals sp st
        st2 = lower let var store env v bound_locals sp st1
        st3 = lower cmm drops env dead_inputs sp st2
        st4 = lower unused let drop env v live_after sp st3
        lower tail stmts cmm env rest (add unique str v bound_locals) (add unique str v scope_vars) sp st4

fn :: lower tail stmts cmm RNativeEnv [RStmt] [String] [String] Int RNativeCode => RNativeCode
      lower tail stmts cmm _ [] _ _ sp st =
        nc emit list st [NLoadImmRaw 0, NReturn] sp
      lower tail stmts cmm env ((StmtExpr e):[]) bound_locals scope_vars sp st =
        lower tail return cmm env e bound_locals scope_vars sp st
      lower tail stmts cmm env ((StmtLet v e):rest) bound_locals scope_vars sp st
        | v == "_" =
          used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
          live_after = cmm stmts vars rest []
          dead_now = cmm filter not in list used_in_e live_after
          st1 = lower expr env e bound_locals sp st
          st2 = nc emit st1 NDropVal sp
          st3 = lower cmm drops env dead_now sp st2
          lower tail stmts cmm env rest bound_locals scope_vars sp st3
        | otherwise =
          lower tail let stmt env v e bound_locals scope_vars rest sp st
      lower tail stmts cmm env ((StmtMut v e):rest) bound_locals scope_vars sp st =
        lower tail let stmt env v e bound_locals scope_vars rest sp st
      lower tail stmts cmm env ((StmtIndexAssign t idxs e):[]) bound_locals scope_vars sp st =
        count = list len idxs
        tslot = env var slot env t
        st1 = lower expr list to slots env idxs bound_locals sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env t tslot sp count st2
        st4 = lower cmm drops env (cmm remove str t scope_vars) (sp + count + 1) st3
        nc emit list st4 [NMoveSlot tslot, NReturn] (sp + count + 1)
      lower tail stmts cmm env ((StmtIndexAssign t idxs e):rest) bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e (cmm expr list vars idxs [])) scope_vars
        live_after = add unique str t (cmm stmts vars rest [])
        dead_now = cmm filter not in list used_in_e live_after
        count = list len idxs
        tslot = env var slot env t
        st1 = lower expr list to slots env idxs bound_locals sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env t tslot sp count st2
        st4 = lower cmm drops env dead_now (sp + count + 1) st3
        lower tail stmts cmm env rest bound_locals scope_vars sp st4
      lower tail stmts cmm env ((StmtExpr e):rest) bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm stmts vars rest []
        dead_now = cmm filter not in list used_in_e live_after
        st1 = lower expr env e bound_locals sp st
        st2 = nc emit st1 NDropVal sp
        st3 = lower cmm drops env dead_now sp st2
        lower tail stmts cmm env rest bound_locals scope_vars sp st3

fn :: lower tail where cmm RNativeEnv [RWhereBind] RExpr [String] [String] Int RNativeCode => RNativeCode
      lower tail where cmm env [] body bound_locals scope_vars sp st =
        lower tail return cmm env body bound_locals scope_vars sp st
      lower tail where cmm env ((WhereBind e1 v1 []):(WhereBind e2 v2 []):wbs) body bound_locals scope_vars sp st
        | can par where pair env e1 v1 e2 v2 bound_locals =
          st1 = emit par where pair env e1 v1 e2 v2 wbs body bound_locals scope_vars sp st
          locals2 = add unique str v2 (add unique str v1 bound_locals)
          scope2 = add unique str v2 (add unique str v1 scope_vars)
          lower tail where cmm env wbs body locals2 scope2 sp st1
      lower tail where cmm env ((WhereBind e v []):wbs) body bound_locals scope_vars sp st =
        used_in_e = cmm filter in list (cmm expr vars e []) scope_vars
        live_after = cmm where vars wbs body []
        live_with_v = add unique str v live_after
        dead_inputs = cmm filter not in list (cmm remove str v used_in_e) live_with_v
        st1 = lower expr env e bound_locals sp st
        st2 = lower let var store env v bound_locals sp st1
        st3 = lower cmm drops env dead_inputs sp st2
        st4 = lower unused let drop env v live_after sp st3
        lower tail where cmm env wbs body (add unique str v bound_locals) (add unique str v scope_vars) sp st4
      lower tail where cmm env ((WhereBind e v idxs):wbs) body bound_locals scope_vars sp st =
        count = list len idxs
        tslot = env var slot env v
        st1 = lower int list to slots idxs sp 0 st
        st2 = lower expr env e bound_locals (sp + count) st1
        st3 = emit tensor store env v tslot sp count st2
        lower tail where cmm env wbs body bound_locals scope_vars sp st3

-- ── Pattern Matching & Binding Lowering ──────────────────────

fn :: pat needs check RPattern       => Bool
      pat needs check PatWild        =  False
      pat needs check (PatVar _)     =  False
      pat needs check (PatSeqBind _) =  False
      pat needs check _              =  True

fn :: pat has vars RPattern         => Bool
      pat has vars (PatVar _)       =  True
      pat has vars (PatSeqBind _)   =  True
      pat has vars (PatCons h t)    =  (pat has vars h) or (pat has vars t)
      pat has vars (PatTuple ps)    =  pat list has vars ps
      pat has vars (PatCtor _ args) =  pat list has vars args
      pat has vars _                =  False

fn :: pat list has vars [RPattern] => Bool
      pat list has vars []         =  False
      pat list has vars (p:ps)
        | pat has vars p = True
        | otherwise = pat list has vars ps

fn :: lower pat cond RNativeEnv RPattern Int Int Int RNativeCode => RNativeCode
      lower pat cond _ PatWild _ _ _ st = st
      lower pat cond _ (PatVar _) _ _ _ st = st
      lower pat cond _ (PatSeqBind _) _ _ _ st = st
      lower pat cond _ (PatInt n) slot fail_lbl sp st
        | fits tagged int n =
          nc emit list st [NMatchInt slot n, NJumpIfZero fail_lbl] sp
        | otherwise =
          st1 = nc emit list st [NCloneSlot slot, NStoreSlot sp] (sp + 1)
          st2 = lower int lit n (sp + 1) st1
          nc emit list st2 [NBinOp (binop id OpEq) sp, NAsBool, NJumpIfZero fail_lbl] (sp + 2)
      lower pat cond env (PatReal r) slot fail_lbl sp st =
        off = env str off env r
        nc emit list st [NMatchReal slot off (str len r), NJumpIfZero fail_lbl] sp
      lower pat cond env (PatStr s) slot fail_lbl sp st =
        off = env str off env s
        nc emit list st [NMatchStr slot off (str len s), NJumpIfZero fail_lbl] sp
      lower pat cond _ (PatBool True) slot fail_lbl sp st =
        nc emit list st [NMatchBool slot 1, NJumpIfZero fail_lbl] sp
      lower pat cond _ (PatBool False) slot fail_lbl sp st =
        nc emit list st [NMatchBool slot 0, NJumpIfZero fail_lbl] sp
      lower pat cond _ PatEmpty slot fail_lbl sp st =
        nc emit list st [NMatchEmpty slot, NJumpIfZero fail_lbl] sp
      lower pat cond env (PatCons h t) slot fail_lbl sp st =
        st1 = nc emit list st [NMatchNonEmpty slot, NJumpIfZero fail_lbl] sp
        st2 = lower pat cons sub env h slot True fail_lbl sp st1
        lower pat cons sub env t slot False fail_lbl sp st2
      lower pat cond env (PatTuple ps) slot fail_lbl sp st =
        arity = list len ps
        st1 = nc emit list st [NMatchTuple slot arity, NJumpIfZero fail_lbl] sp
        lower tuple pat conds env ps slot 0 fail_lbl sp st1
      lower pat cond env (PatCtor ":as:" (_:p:[])) slot fail_lbl sp st =  lower pat cond env p slot fail_lbl sp st
      lower pat cond env (PatCtor ":tensor-pat:" (t_pat:rank_pat:dim_pats)) slot fail_lbl sp st =
        lower tensor pat cond env (tensor pat mode env t_pat) t_pat rank_pat dim_pats slot fail_lbl sp st
      lower pat cond env (PatCtor c (sub_p:[])) slot fail_lbl sp st
        | (prim type tag id c) > 0 =
          st1 = nc emit list st [NMatchAdt slot 0 0 (0 - (prim type tag id c)), NJumpIfZero fail_lbl] sp
          lower pat cond env sub_p slot fail_lbl sp st1
      lower pat cond env (PatCtor c args) slot fail_lbl sp st =
        arity = list len args
        c_tag = ident base name c
        off = env str off env c_tag
        st1 = nc emit list st [NMatchAdt slot off (str len c_tag) arity, NJumpIfZero fail_lbl] sp
        lower adt pat conds env args slot 0 fail_lbl sp st1

-- ── Tensor shape patterns on GenTensors (FR-COMP-020) ─────────
-- A pattern such as `(Tensor[String * r * c] t)` checks the heap tag and
-- the shape of a numeric tensor with `NMatchAdt` and `NAdtField`. A
-- GenTensor is a list, so its rank and dimensions come from the
-- `__rg_gt_shape` helper. The mode says which code to emit: "N" numeric
-- only, "G" or "L" GenTensor only (the element kind of the pattern
-- variable), "D" both, chosen at run time with `NIsList`.

fn :: env has gt shape RNativeEnv => Bool
      env has gt shape env =  (env fn arity env "__rg_gt_shape") == 3

fn :: tensor pat kind RNativeEnv RPattern => String
      tensor pat kind env (PatVar v) =  env tensor kind env v
      tensor pat kind _ _ =  "U"

fn :: tensor pat mode RNativeEnv RPattern => String
      tensor pat mode env p =  tensor pat mode of (env has gt shape env) (tensor pat kind env p)

fn :: tensor pat mode of Bool String => String
      tensor pat mode of _ "B" =  "B"
      tensor pat mode of False _ =  "N"
      tensor pat mode of True "N" =  "N"
      tensor pat mode of True "R" =  "N"
      tensor pat mode of True "G" =  "G"
      tensor pat mode of True "L" =  "L"
      tensor pat mode of True _ =  "D"

fn :: gen tensor pat flag String => Int
      gen tensor pat flag "L" =  1
      gen tensor pat flag "B" =  2
      gen tensor pat flag _ =  0

fn :: lower tensor pat cond RNativeEnv String RPattern RPattern [RPattern] Int Int Int RNativeCode => RNativeCode
      lower tensor pat cond env "N" t_pat rank_pat dim_pats slot fail_lbl sp st =
        st1 = nc emit list st [NMatchAdt slot 0 0 (0 - 5), NJumpIfZero fail_lbl] sp
        st2 = lower pat cond env t_pat slot fail_lbl sp st1
        st3 = lower tensor dim cond env rank_pat slot (0 - 1) fail_lbl sp st2
        lower tensor dims cond list env dim_pats slot 0 fail_lbl sp st3
      lower tensor pat cond env "B" t_pat rank_pat dim_pats slot fail_lbl sp st =
        st1 = nc emit list st [NMatchAdt slot 0 0 (0 - 5), NJumpIfZero fail_lbl] sp
        lower gen tensor pat cond env 2 t_pat rank_pat dim_pats slot fail_lbl sp st1
      lower tensor pat cond env "D" t_pat rank_pat dim_pats slot fail_lbl sp st =
        num_lbl = nc lbl st
        end_lbl = num_lbl + 1
        st0 = nc set lbl st (num_lbl + 2)
        st1 = nc emit list st0 [NIsList slot, NAsBool, NJumpIfZero num_lbl] sp
        st2 = lower gen tensor pat cond env 0 t_pat rank_pat dim_pats slot fail_lbl sp st1
        st3 = nc emit list st2 [NJump end_lbl, NLabel num_lbl] sp
        st4 = lower tensor pat cond env "N" t_pat rank_pat dim_pats slot fail_lbl sp st3
        nc emit st4 (NLabel end_lbl) sp
      lower tensor pat cond env kind t_pat rank_pat dim_pats slot fail_lbl sp st =
        st1 = nc emit list st [NIsList slot, NAsBool, NJumpIfZero fail_lbl] sp
        lower gen tensor pat cond env (gen tensor pat flag kind) t_pat rank_pat dim_pats slot fail_lbl sp st1

fn :: lower gen tensor pat cond RNativeEnv Int RPattern RPattern [RPattern] Int Int Int RNativeCode => RNativeCode
      lower gen tensor pat cond env flag t_pat rank_pat dim_pats slot fail_lbl sp st =
        st1 = lower pat cond env t_pat slot fail_lbl sp st
        st2 = lower gen shape cond env flag rank_pat slot 0 fail_lbl sp st1
        lower gen shape conds env flag dim_pats slot 1 fail_lbl sp st2

fn :: lower gen shape conds RNativeEnv Int [RPattern] Int Int Int Int RNativeCode => RNativeCode
      lower gen shape conds _ _ [] _ _ _ _ st =  st
      lower gen shape conds env flag (p:ps) slot k fail_lbl sp st =
        st1 = lower gen shape cond env flag p slot k fail_lbl sp st
        lower gen shape conds env flag ps slot (k + 1) fail_lbl sp st1

fn :: lower gen shape cond RNativeEnv Int RPattern Int Int Int Int RNativeCode => RNativeCode
      lower gen shape cond env flag p slot k fail_lbl sp st
        | not (pat needs check p) = st
        | otherwise =
          st1 = lower gen shape value env flag slot k sp st
          st2 = lower pat cond env p sp fail_lbl (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

-- Calls `__rg_gt_shape t k flag` (k: 0 rank, 1 rows, 2 columns) and leaves
-- the result in slot sp.
fn :: lower gen shape value RNativeEnv Int Int Int Int RNativeCode => RNativeCode
      lower gen shape value env 2 slot k sp st =
        nc emit list st [NLoadImmInt k, NStoreSlot sp, NPeekSlot slot, NStoreSlot (sp + 1), NCallBuiltin 107 sp 2, NStoreSlot sp] (sp + 2)
      lower gen shape value env flag slot k sp st =
        nc emit list st [NCloneSlot slot, NStoreSlot sp, NLoadImmInt k, NStoreSlot (sp + 1), NLoadImmInt flag, NStoreSlot (sp + 2), NCallFn (env fn id env "__rg_gt_shape") sp 3, NStoreSlot sp] (sp + 4)

fn :: lower tensor pat binds RNativeEnv String RPattern RPattern [RPattern] Int Bool Int RNativeCode => RNativeCode
      lower tensor pat binds env "N" t_pat rank_pat dim_pats slot move_ok sp st =
        st1 = lower tensor dim bind env rank_pat slot (0 - 1) sp st
        st2 = lower tensor dims bind list env dim_pats slot 0 sp st1
        lower pat binds env t_pat slot move_ok sp st2
      lower tensor pat binds env "D" t_pat rank_pat dim_pats slot move_ok sp st =
        num_lbl = nc lbl st
        end_lbl = num_lbl + 1
        st0 = nc set lbl st (num_lbl + 2)
        st1 = nc emit list st0 [NIsList slot, NAsBool, NJumpIfZero num_lbl] sp
        st2 = lower gen tensor pat binds env 0 t_pat rank_pat dim_pats slot move_ok sp st1
        st3 = nc emit list st2 [NJump end_lbl, NLabel num_lbl] sp
        st4 = lower tensor pat binds env "N" t_pat rank_pat dim_pats slot move_ok sp st3
        nc emit st4 (NLabel end_lbl) sp
      lower tensor pat binds env kind t_pat rank_pat dim_pats slot move_ok sp st =
        lower gen tensor pat binds env (gen tensor pat flag kind) t_pat rank_pat dim_pats slot move_ok sp st

fn :: lower gen tensor pat binds RNativeEnv Int RPattern RPattern [RPattern] Int Bool Int RNativeCode => RNativeCode
      lower gen tensor pat binds env flag t_pat rank_pat dim_pats slot move_ok sp st =
        st1 = lower gen shape bind env flag rank_pat slot 0 sp st
        st2 = lower gen shape binds env flag dim_pats slot 1 sp st1
        lower pat binds env t_pat slot move_ok sp st2

fn :: lower gen shape binds RNativeEnv Int [RPattern] Int Int Int RNativeCode => RNativeCode
      lower gen shape binds _ _ [] _ _ _ st =  st
      lower gen shape binds env flag (p:ps) slot k sp st =
        st1 = lower gen shape bind env flag p slot k sp st
        lower gen shape binds env flag ps slot (k + 1) sp st1

fn :: lower gen shape bind RNativeEnv Int RPattern Int Int Int RNativeCode => RNativeCode
      lower gen shape bind env flag p slot k sp st
        | not (pat has vars p) = st
        | otherwise =
          st1 = lower gen shape value env flag slot k sp st
          st2 = lower pat binds env p sp True (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

fn :: lower tensor dim cond RNativeEnv RPattern Int Int Int Int RNativeCode => RNativeCode
      lower tensor dim cond env p slot field_code fail_lbl sp st
        | not (pat needs check p) = st
        | otherwise =
          st1 = nc emit list st [NAdtField slot field_code, NStoreSlot sp] (sp + 1)
          st2 = lower pat cond env p sp fail_lbl (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

fn :: lower tensor dims cond list RNativeEnv [RPattern] Int Int Int Int RNativeCode => RNativeCode
      lower tensor dims cond list _ [] _ _ _ _ st = st
      lower tensor dims cond list env (p:ps) slot idx fail_lbl sp st =
        st1 = lower tensor dim cond env p slot ((0 - 10) - idx) fail_lbl sp st
        lower tensor dims cond list env ps slot (idx + 1) fail_lbl sp st1

fn :: lower pat cons sub RNativeEnv RPattern Int Bool Int Int RNativeCode => RNativeCode
      lower pat cons sub env sub_p slot is_head fail_lbl sp st
        | not (pat needs check sub_p) = st
        | is_head =
          st1 = nc emit list st [NListHead slot, NStoreSlot sp] (sp + 1)
          st2 = lower pat cond env sub_p sp fail_lbl (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
        | otherwise =
          st1 = nc emit list st [NListTail slot, NStoreSlot sp] (sp + 1)
          st2 = lower pat cond env sub_p sp fail_lbl (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

fn :: lower tuple pat conds RNativeEnv [RPattern] Int Int Int Int RNativeCode => RNativeCode
      lower tuple pat conds _ [] _ _ _ _ st = st
      lower tuple pat conds env (p:ps) slot idx fail_lbl sp st
        | not (pat needs check p) = lower tuple pat conds env ps slot (idx + 1) fail_lbl sp st
        | otherwise =
          st1 = nc emit list st [NTupleGet slot idx, NStoreSlot sp] (sp + 1)
          st2 = lower pat cond env p sp fail_lbl (sp + 1) st1
          st3 = nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
          lower tuple pat conds env ps slot (idx + 1) fail_lbl sp st3

fn :: lower adt pat conds RNativeEnv [RPattern] Int Int Int Int RNativeCode => RNativeCode
      lower adt pat conds _ [] _ _ _ _ st = st
      lower adt pat conds env (p:ps) slot idx fail_lbl sp st
        | not (pat needs check p) = lower adt pat conds env ps slot (idx + 1) fail_lbl sp st
        | otherwise =
          st1 = nc emit list st [NAdtField slot idx, NStoreSlot sp] (sp + 1)
          st2 = lower pat cond env p sp fail_lbl (sp + 1) st1
          st3 = nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
          lower adt pat conds env ps slot (idx + 1) fail_lbl sp st3

fn :: lower pat list cond RNativeEnv [RPattern] Int Int Int RNativeCode => RNativeCode
      lower pat list cond _ [] _ _ _ st = st
      lower pat list cond env (p:ps) idx fail_lbl sp st =
        st1 = lower pat cond env p idx fail_lbl sp st
        lower pat list cond env ps (idx + 1) fail_lbl sp st1

fn :: lower pat binds RNativeEnv RPattern Int Bool Int RNativeCode => RNativeCode
      lower pat binds env (PatVar v) slot True sp st =
        nc emit list st [NMoveSlot slot, NStoreSlot (env var slot env v)] sp
      lower pat binds env (PatVar v) slot False sp st =
        nc emit list st [NCloneSlot slot, NStoreSlot (env var slot env v)] sp
      lower pat binds env (PatSeqBind v) slot True sp st =
        nc emit list st [NMoveSlot slot, NStoreSlot (env var slot env v)] sp
      lower pat binds env (PatSeqBind v) slot False sp st =
        nc emit list st [NCloneSlot slot, NStoreSlot (env var slot env v)] sp
      lower pat binds env (PatCons h t) slot _ sp st =
        st1 = lower pat cons bind env h slot True sp st
        lower pat cons bind env t slot False sp st1
      lower pat binds env (PatTuple ps) slot _ sp st =
        lower tuple pat binds env ps slot 0 sp st
      lower pat binds env (PatCtor ":as:" ((PatVar v):p:[])) slot move_ok sp st =
        st1 = nc emit list st [NCloneSlot slot, NStoreSlot (env var slot env v)] sp
        lower pat binds env p slot move_ok sp st1
      lower pat binds env (PatCtor ":tensor-pat:" (t_pat:rank_pat:dim_pats)) slot move_ok sp st =
        lower tensor pat binds env (tensor pat mode env t_pat) t_pat rank_pat dim_pats slot move_ok sp st
      lower pat binds env (PatCtor c (sub_p:[])) slot move_ok sp st
        | (prim type tag id c) > 0 =
          lower pat binds env sub_p slot move_ok sp st
      lower pat binds env (PatCtor _ args) slot _ sp st =
        lower adt pat binds env args slot 0 sp st
      lower pat binds _ _ _ _ _ st = st

fn :: lower tensor dim bind RNativeEnv RPattern Int Int Int RNativeCode => RNativeCode
      lower tensor dim bind env p slot field_code sp st
        | not (pat has vars p) = st
        | otherwise =
          st1 = nc emit list st [NAdtField slot field_code, NStoreSlot sp] (sp + 1)
          st2 = lower pat binds env p sp True (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

fn :: lower tensor dims bind list RNativeEnv [RPattern] Int Int Int RNativeCode => RNativeCode
      lower tensor dims bind list _ [] _ _ _ st = st
      lower tensor dims bind list env (p:ps) slot idx sp st =
        st1 = lower tensor dim bind env p slot ((0 - 10) - idx) sp st
        lower tensor dims bind list env ps slot (idx + 1) sp st1

fn :: lower pat cons bind RNativeEnv RPattern Int Bool Int RNativeCode => RNativeCode
      lower pat cons bind env sub_p slot is_head sp st
        | not (pat has vars sub_p) = st
        | is_head =
          st1 = nc emit list st [NListHead slot, NStoreSlot sp] (sp + 1)
          st2 = lower pat binds env sub_p sp True (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
        | otherwise =
          st1 = nc emit list st [NListTail slot, NStoreSlot sp] (sp + 1)
          st2 = lower pat binds env sub_p sp True (sp + 1) st1
          nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)

fn :: lower tuple pat binds RNativeEnv [RPattern] Int Int Int RNativeCode => RNativeCode
      lower tuple pat binds _ [] _ _ _ st = st
      lower tuple pat binds env (p:ps) slot idx sp st
        | not (pat has vars p) = lower tuple pat binds env ps slot (idx + 1) sp st
        | otherwise =
          st1 = nc emit list st [NTupleGet slot idx, NStoreSlot sp] (sp + 1)
          st2 = lower pat binds env p sp True (sp + 1) st1
          st3 = nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
          lower tuple pat binds env ps slot (idx + 1) sp st3

fn :: lower adt pat binds RNativeEnv [RPattern] Int Int Int RNativeCode => RNativeCode
      lower adt pat binds _ [] _ _ _ st = st
      lower adt pat binds env (p:ps) slot idx sp st
        | not (pat has vars p) = lower adt pat binds env ps slot (idx + 1) sp st
        | otherwise =
          st1 = nc emit list st [NAdtField slot idx, NStoreSlot sp] (sp + 1)
          st2 = lower pat binds env p sp True (sp + 1) st1
          st3 = nc emit st2 (NClearLocals sp (sp + 1)) (sp + 1)
          lower adt pat binds env ps slot (idx + 1) sp st3

fn :: lower pat list binds RNativeEnv [RPattern] Int Int Bool Int RNativeCode => RNativeCode
      lower pat list binds _ [] _ _ _ _ st = st
      lower pat list binds env ((PatSeqBind v):[]) _ arity _ sp st =
        nc emit list st [NPackSeq arity, NStoreSlot (env var slot env v)] sp
      lower pat list binds env ((PatVar v):ps) idx arity True sp st =
        st1 = nc emit list st [NMoveSlot idx, NStoreSlot (env var slot env v)] sp
        lower pat list binds env ps (idx + 1) arity True sp st1
      lower pat list binds env (p:ps) idx arity move_args sp st =
        st1 = lower pat binds env p idx False sp st
        lower pat list binds env ps (idx + 1) arity move_args sp st1

fn :: guards have otherwise [RGuard] => Bool
      guards have otherwise []       =  False
      guards have otherwise ((GuardBranch (EBool True) _):_) = True
      guards have otherwise (_:gs)   =  guards have otherwise gs

fn :: lower case guards RNativeEnv [RGuard] [String] Int RNativeCode => RNativeCode
      lower case guards _ [] _ _ st = st
      lower case guards env ((GuardBranch cond body):gs) bound_locals sp st =
        next_lbl = nc lbl st
        st1 = nc set lbl st (next_lbl + 1)
        st2 = lower expr env cond bound_locals sp st1
        st3 = nc emit list st2 [NAsBool, NJumpIfZero next_lbl] sp
        st4 = lower tail return env body bound_locals sp st3
        st5 = nc emit st4 (NLabel next_lbl) sp
        lower case guards env gs bound_locals sp st5

fn :: lower single case RNativeEnv RFnCase Bool Int RNativeCode => RNativeCode
      lower single case env (FnCase pats [] body) _ sp st =
        arity = env arity env
        fail_lbl = nc lbl st
        bound_locals = collect pat list vars pats []
        st -> nc set lbl (fail_lbl + 1)
          -> lower pat list cond env pats 0 fail_lbl sp _
          -> lower pat list binds env pats 0 arity True sp _
          -> lower tail return env body bound_locals sp _
          -> st4
        st4 -> nc emit list [NLabel fail_lbl, NClearLocals arity (nc max sp st4)] sp
      lower single case env (FnCase pats guards _) is_last sp st =
        arity = env arity env
        fail_lbl = nc lbl st
        move_args = is_last or (guards have otherwise guards)
        bound_locals = collect pat list vars pats []
        st -> nc set lbl (fail_lbl + 1)
          -> lower pat list cond env pats 0 fail_lbl sp _
          -> lower pat list binds env pats 0 arity move_args sp _
          -> lower case guards env guards bound_locals sp _
          -> st4
        st4 -> nc emit list [NLabel fail_lbl, NClearLocals arity (nc max sp st4)] sp

fn :: lower cases list RNativeEnv [RFnCase] Int RNativeCode => RNativeCode
      lower cases list _ [] _ st = st
      lower cases list env (c:[]) sp st = lower single case env c True sp st
      lower cases list env (c:cs) sp st =
        st1 = lower single case env c False sp st
        lower cases list env cs sp st1

fn :: wrap unit return stmts String RStrIntMap [RStmt] => [RStmt]
      wrap unit return stmts _ _ [] = [StmtExpr EUnit]
      wrap unit return stmts _ _ ((StmtExpr EUnit):[]) = [StmtExpr EUnit]
      wrap unit return stmts name units ((StmtExpr e):[])
        | unit tail call ok name units e = [StmtExpr (wrap unit return expr name units e)]
        | otherwise = [StmtExpr e, StmtExpr EUnit]
      wrap unit return stmts _ _ (last_s:[]) = [last_s, StmtExpr EUnit]
      wrap unit return stmts name units (s:rest) = [s] :: (wrap unit return stmts name units rest)

fn :: wrap unit return guards String RStrIntMap [RGuard] => [RGuard]
      wrap unit return guards _ _ [] = []
      wrap unit return guards name units ((GuardBranch c b):gs) =
        [GuardBranch c (wrap unit return expr name units b)] :: (wrap unit return guards name units gs)

-- A unit function keeps a call in tail position as it is (no `()` after it)
-- when it calls itself, or (OPT-019) another unit function with all its
-- arguments: that call already returns `()`, and stays a tail call.
fn :: unit tail call ok String RStrIntMap RExpr => Bool
      unit tail call ok name units (ECall fname args)
        | fname == name = True
        | otherwise = (str int map lookup units ("#u " + fname)) == 1 and (str int map lookup units fname) == (list len args) and (not (is agent call name fname))
      unit tail call ok name _ e = expr has self tail call name e

fn :: wrap unit return expr String RStrIntMap RExpr => RExpr
      wrap unit return expr _ _ EUnit = EUnit
      wrap unit return expr name units (EBlock stmts) =
        EBlock (wrap unit return stmts name units stmts)
      wrap unit return expr name units (EGuard guards) =
        EGuard (wrap unit return guards name units guards)
      wrap unit return expr name units (EWhere body binds) =
        EWhere (wrap unit return expr name units body) binds
      wrap unit return expr name units e
        | unit tail call ok name units e = e
        | otherwise = EBlock [StmtExpr e, StmtExpr EUnit]

fn :: wrap unit return cases String RStrIntMap [RFnCase] => [RFnCase]
      wrap unit return cases _ _ [] = []
      wrap unit return cases name units ((FnCase pats [] body):cs) =
        [FnCase pats [] (wrap unit return expr name units body)] :: (wrap unit return cases name units cs)
      wrap unit return cases name units ((FnCase pats guards body):cs) =
        [FnCase pats (wrap unit return guards name units guards) body] :: (wrap unit return cases name units cs)

fn :: is unit ret String => Bool
      is unit ret ret =  ret == "()" or ret == "Unit"

fn :: maybe wrap unit cases String String RStrIntMap [RFnCase] => [RFnCase]
      maybe wrap unit cases name ret units cases
        | is unit ret ret = wrap unit return cases name units cases
        | otherwise = cases

-- ── A rebuilt cons pattern is the matched list (FR-COMP-024) ──
-- `f (a:b:rest) = ... (b:rest)`: the clause rebuilds a list its pattern
-- took apart. The parser makes `(b:rest)` the concatenation `[b] :: rest`,
-- a new list built from `rest`. This pass names the list matched by every
-- cons node `(h1: ... :hk:r)` (all of them variables) whose rebuild
-- `[h1, ..., hk] :: r` occurs in the clause: the node becomes the pattern
-- `:as:` (the name, then the node), and each rebuild becomes the name. The
-- rebuild costs nothing and copies nothing. A clause that binds one of
-- those names again in its body keeps the concatenation.

fn :: share cons cases [RFnCase] => [RFnCase]
      share cons cases [] =  []
      share cons cases ((FnCase pats guards body):cs) =  [share cons case pats guards body] :: (share cons cases cs)

fn :: share cons case [RPattern] [RGuard] RExpr => RFnCase
      share cons case pats guards body =
        bound = collect expr list bound vars (guard kids guards []) (collect expr bound vars body [])
        keys = share cons keys (pat list cons cands pats []) bound []
        share cons apply pats guards body keys

fn :: share cons apply [RPattern] [RGuard] RExpr [String] => RFnCase
      share cons apply pats guards body [] =  FnCase pats guards body
      share cons apply pats guards body keys =
        guards2 = guards map exprs guards (x => share cons expr x keys)
        body2 = share cons expr body keys
        used = cmm expr vars (EGuard guards2) (cmm expr vars body2 [])
        FnCase (share cons pat list pats used) guards2 body2

-- The names of an all-variable cons node, heads first, then the tail.
fn :: cons node names RPattern [String] => [String]
      cons node names (PatCons (PatVar h) (PatVar r)) acc =  acc :: [h, r]
      cons node names (PatCons (PatVar h) t) acc =  cons node names t (acc :: [h])
      cons node names _ _ =  []

fn :: share cons key [String] => String
      share cons key names =  ":as:" + (share cons join names)

fn :: share cons join [String] => String
      share cons join [] =  ""
      share cons join (n:[]) =  n
      share cons join (n:ns) =  n + " " + (share cons join ns)

fn :: pat cons cands RPattern [[String]] => [[String]]
      pat cons cands (PatCons h t) acc =  pat cons cands t (pat cons cands h (add cons cand (cons node names (PatCons h t) []) acc))
      pat cons cands (PatTuple ps) acc =  pat list cons cands ps acc
      pat cons cands (PatCtor _ args) acc =  pat list cons cands args acc
      pat cons cands _ acc =  acc

fn :: pat list cons cands [RPattern] [[String]] => [[String]]
      pat list cons cands [] acc =  acc
      pat list cons cands (p:ps) acc =  pat list cons cands ps (pat cons cands p acc)

fn :: add cons cand [String] [[String]] => [[String]]
      add cons cand [] acc =  acc
      add cons cand names acc =  acc :: [names]

-- The keys of the candidates none of whose names the body binds again.
fn :: share cons keys [[String]] [String] [String] => [String]
      share cons keys [] _ acc =  acc
      share cons keys (names:rest) bound acc
        | cons names rebound names bound = share cons keys rest bound acc
        | otherwise = share cons keys rest bound (acc :: [share cons key names])

fn :: cons names rebound [String] [String] => Bool
      cons names rebound [] _ =  False
      cons names rebound (n:ns) bound
        | list contains bound n = True
        | otherwise = cons names rebound ns bound

-- The names of a rebuild `[h1, ..., hk] :: r` (variables only), or [].
fn :: rebuild names [RExpr] String [String] => [String]
      rebuild names [] r acc =  acc :: [r]
      rebuild names ((EVar h):es) r acc =  rebuild names es r (acc :: [h])
      rebuild names _ _ _ =  []

fn :: rebuild key [RExpr] String => String
      rebuild key [] _ =  ""
      rebuild key elems r =  rebuild key of (rebuild names elems r [])

fn :: rebuild key of [String] => String
      rebuild key of [] =  ""
      rebuild key of names =  share cons key names

fn :: share cons pat RPattern [String] => RPattern
      share cons pat (PatCons h t) used =  share cons wrap (cons node names (PatCons h t) []) (PatCons (share cons pat h used) (share cons pat t used)) used
      share cons pat (PatTuple ps) used =  PatTuple (share cons pat list ps used)
      share cons pat (PatCtor c args) used =  PatCtor c (share cons pat list args used)
      share cons pat p _ =  p

fn :: share cons pat list [RPattern] [String] => [RPattern]
      share cons pat list [] _ =  []
      share cons pat list (p:ps) used =  [share cons pat p used] :: (share cons pat list ps used)

fn :: share cons wrap [String] RPattern [String] => RPattern
      share cons wrap [] p _ =  p
      share cons wrap names p used
        | list contains used (share cons key names) = PatCtor ":as:" [PatVar (share cons key names), p]
        | otherwise = p

fn :: share cons expr RExpr [String] => RExpr
      share cons expr (EBin OpConcat (EList elems) (EVar r)) keys
        | list contains keys (rebuild key elems r) = EVar (rebuild key elems r)
      share cons expr (EBin bop l r) keys =  EBin bop (share cons expr l keys) (share cons expr r keys)
      share cons expr e keys =  expr map kids e (x => share cons expr x keys)

fn :: share cons exprs [RExpr] [String] => [RExpr]
      share cons exprs es keys =  map (e => share cons expr e keys) es

-- ── OPT-022: a record field read at the last use of the record moves out ──
-- `in_record i n acc = ... Acc ([i] :: (a_list acc)) ...` read the list with a
-- field read, which clones it: the list was held twice (by the record and by
-- the new value), so the prepend copied it at every step. When a parameter
-- that the function owns is used in a clause only through field reads, and
-- each field of a large type (a list or a String) is read once, the read
-- takes the field out of the record: the record keeps a zero word in its
-- place and the value has one holder. A record that is still shared is
-- copied by the runtime, so a caller never sees the change.

-- Marks "#fb f" in the field map for a field whose type is a list or a String.
fn :: add big field marks [RTypeDef] RStrIntMap => RStrIntMap
      add big field marks [] mp =  mp
      add big field marks ((TypeDef _ _ fields):ts) mp =
        add big field marks ts (add big field marks of fields mp)

fn :: add big field marks of [RField] RStrIntMap => RStrIntMap
      add big field marks of [] mp =  mp
      add big field marks of ((TypeField fname ftype):fs) mp
        | is big field type ftype = add big field marks of fs (str int map insert mp ("#fb " + fname) 1)
        | otherwise = add big field marks of fs mp

fn :: is big field type String => Bool
      is big field type ftype =  ftype == "String" or ((str len ftype) >= 2 and (str slice ftype 0 1) == "[")

-- A getter whose field can be taken: a plain accessor of a large field with one position.
-- ── OPT-023: the only use of a name moves instead of cloning ──────────────
-- `st1 = f st x` clones `st` into the argument, so the callee sees two owners and an in-place
-- update inside it (`ins :: [one]`) copies. A chain of such states made every step cost the size of
-- the state: lowering a list literal of 32 000 numbers took 10 s. Here, in a clause, a name that
-- is bound once (a parameter the function owns, or a `let`) and mentioned once, as a plain
-- argument of a call written as `let` (not the last statement: that call is a tail call and moves
-- its arguments already), becomes `#move name`: lowering loads the slot and empties it. Only calls of
-- user functions with all their arguments (the arguments of the positions the callee owns), and
-- constructors. Not rewritten: conditions of guards (a failed guard goes on to the next clause, which
-- would read the name again), the right sides of `where`, and anything below a call.
fn :: move once cases [RFnCase] String RStrIntMap => [RFnCase]
      move once cases cs name fam =  map (c => move once case c name fam) cs

fn :: move once case RFnCase String RStrIntMap => RFnCase
      move once case (FnCase pats guards body) name fam =
        mask = non neg int (str int map lookup fam ("#b " + name))
        everything = (guard kids guards []) :: [body]
        uses = move count uses everything StrIntEmpty
        binders = move count binders everything (move count pat names (collect pat list vars pats []) StrIntEmpty)
        owned = move owned params pats 0 mask []
        once = move pick once ((move let names everything []) :: owned) uses binders StrSetEmpty
        move apply (FnCase pats guards body) once fam

fn :: move apply RFnCase RStrSet RStrIntMap => RFnCase
      move apply (FnCase pats guards body) once fam
        | once == StrSetEmpty = FnCase pats guards body
        | otherwise = FnCase pats (move branches guards once fam) (move body body once fam)

-- The names of the parameters the function owns that a plain variable pattern binds.
fn :: move owned params [RPattern] Int Int [String] => [String]
      move owned params [] _ _ acc =  acc
      move owned params ((PatVar r):ps) i mask acc
        | borrow bit mask i = move owned params ps (i + 1) mask acc
        | otherwise = move owned params ps (i + 1) mask (acc :: [r])
      move owned params (_:ps) i mask acc =  move owned params ps (i + 1) mask acc

-- The names a `let` binds, in every block of the clause.
fn :: move let names [RExpr] [String] => [String]
      move let names [] acc =  acc
      move let names (e:es) acc =  move let names es (move let name expr e acc)

fn :: move let name expr RExpr [String] => [String]
      move let name expr (EBlock stmts) acc =  move let names (stmt kids stmts []) (move let stmt names stmts acc)
      move let name expr e acc =  move let names (expr kids e) acc

fn :: move let stmt names [RStmt] [String] => [String]
      move let stmt names [] acc =  acc
      move let stmt names ((StmtLet v _):ss) acc =  move let stmt names ss (acc :: [v])
      move let stmt names (_:ss) acc =  move let stmt names ss acc

-- How many times each name is mentioned (as a variable, or called) in the expressions.
fn :: move count uses [RExpr] RStrIntMap => RStrIntMap
      move count uses [] m =  m
      move count uses (e:es) m =  move count uses es (move count use e m)

fn :: move count use RExpr RStrIntMap => RStrIntMap
      move count use (EVar n) m =  move bump m n
      move count use (ECall f args) m =  move count uses args (move bump m f)
      move count use e m =  move count uses (expr kids e) m

fn :: move bump RStrIntMap String => RStrIntMap
      move bump m n =  str int map insert m n (1 + (non neg int (str int map lookup m n)))

-- How many places bind each name: the parameters' patterns, `let`, `let mut`, index assignment,
-- the targets of `where`.
fn :: move count binders [RExpr] RStrIntMap => RStrIntMap
      move count binders [] m =  m
      move count binders (e:es) m =  move count binders es (move count binders one e m)

fn :: move count binders one RExpr RStrIntMap => RStrIntMap
      move count binders one (EBlock stmts) m =  move count binders (stmt kids stmts []) (move count binder stmts stmts m)
      move count binders one (EWhere b binds) m =  move count binders (expr kids (EWhere b binds)) (move count where binds m)
      move count binders one e m =  move count binders (expr kids e) m

fn :: move count binder stmts [RStmt] RStrIntMap => RStrIntMap
      move count binder stmts [] m =  m
      move count binder stmts ((StmtLet v _):ss) m =  move count binder stmts ss (move bump m v)
      move count binder stmts ((StmtMut v _):ss) m =  move count binder stmts ss (move bump m v)
      move count binder stmts ((StmtIndexAssign t _ _):ss) m =  move count binder stmts ss (move bump m t)
      move count binder stmts (_:ss) m =  move count binder stmts ss m

fn :: move count where [RWhereBind] RStrIntMap => RStrIntMap
      move count where [] m =  m
      move count where ((WhereBind _ t _):ws) m =  move count where ws (move bump m t)

fn :: move count pat names [String] RStrIntMap => RStrIntMap
      move count pat names [] m =  m
      move count pat names (n:ns) m =  move count pat names ns (move bump m n)

-- The names bound once and mentioned once.
fn :: move pick once [String] RStrIntMap RStrIntMap RStrSet => RStrSet
      move pick once [] _ _ acc =  acc
      move pick once (n:ns) uses binders acc
        | (str int map lookup uses n) == 1 and (str int map lookup binders n) == 1 = move pick once ns uses binders (str set add acc n)
        | otherwise = move pick once ns uses binders acc

fn :: move branches [RGuard] RStrSet RStrIntMap => [RGuard]
      move branches gs once fam =  map (g => move branch g once fam) gs

fn :: move branch RGuard RStrSet RStrIntMap => RGuard
      move branch (GuardBranch c b) once fam =  GuardBranch c (move body b once fam)

fn :: move body RExpr RStrSet RStrIntMap => RExpr
      move body (EBlock stmts) once fam =  EBlock (move stmts stmts [] once fam)
      move body (EGuard gs) once fam =  EGuard (move branches gs once fam)
      move body (EWhere b binds) once fam =  EWhere (move body b once fam) binds
      move body e _ _ =  e

fn :: move stmts [RStmt] [RStmt] RStrSet RStrIntMap => [RStmt]
      move stmts [] acc _ _ =  acc
      move stmts (s:[]) acc once fam =  acc :: [move last stmt s once fam]
      move stmts (s:ss) acc once fam =  move stmts ss (acc :: [move stmt s once fam]) once fam

fn :: move stmt RStmt RStrSet RStrIntMap => RStmt
      move stmt (StmtLet v (ECall f args)) once fam =  StmtLet v (move call f args once fam)
      move stmt s _ _ =  s

fn :: move last stmt RStmt RStrSet RStrIntMap => RStmt
      move last stmt (StmtExpr e) once fam =  StmtExpr (move body e once fam)
      move last stmt s once fam =  move stmt s once fam

fn :: move call String [RExpr] RStrSet RStrIntMap => RExpr
      move call f args once fam
        | move callee ok f (list len args) fam = ECall f (move args args (non neg int (str int map lookup fam ("#b " + f))) 0 once [])
        | otherwise = ECall f args

-- Only the arguments in the positions the callee owns: a borrowed position takes a plain variable as it is.
fn :: move args [RExpr] Int Int RStrSet [RExpr] => [RExpr]
      move args [] _ _ _ acc =  acc
      move args (a:as) mask i once acc
        | borrow bit mask i = move args as mask (i + 1) once (acc :: [a])
        | otherwise = move args as mask (i + 1) once (acc :: [move arg a once])

fn :: move arg RExpr RStrSet => RExpr
      move arg (EVar u) once
        | str set has once u = ECall "#move" [EVar u]
      move arg e _ =  e

fn :: move callee ok String Int RStrIntMap => Bool
      move callee ok f n fam
        | (str len f) == 0 = False
        | (str starts with f "#") or (str starts with f "__") = False
        | is upper ident f = True
        | otherwise = (str int map lookup fam f) == n

fn :: take field ok String RStrIntMap RStrIntMap => Bool
      take field ok g fam fm =  (str int map lookup fam ("#g " + g)) == 1 and (str int map lookup fm ("#fb " + g)) == 1 and (non neg int (str int map lookup fm ("#fa " + g))) == 0

fn :: take field cases [RFnCase] String RStrIntMap RStrIntMap => [RFnCase]
      take field cases [] _ _ _ =  []
      take field cases (c:cs) name fam fm =  [take field case c name fam fm] :: (take field cases cs name fam fm)

fn :: take field case RFnCase String RStrIntMap RStrIntMap => RFnCase
      take field case (FnCase pats guards body) name fam fm =
        rebound = collect expr list bound vars (guard kids guards []) (collect expr bound vars body [])
        mask = non neg int (str int map lookup fam ("#b " + name))
        take field params (FnCase pats guards body) pats 0 mask rebound fam fm

fn :: take field params RFnCase [RPattern] Int Int [String] RStrIntMap RStrIntMap => RFnCase
      take field params c [] _ _ _ _ _ =  c
      take field params c ((PatVar r):ps) i mask rebound fam fm
        | (borrow bit mask i) or (list contains rebound r) = take field params c ps (i + 1) mask rebound fam fm
        | otherwise = take field params (take field var c r fam fm) ps (i + 1) mask rebound fam fm
      take field params c (_:ps) i mask rebound fam fm =  take field params c ps (i + 1) mask rebound fam fm

-- Each branch body of a clause, and the clause body, is looked at on its own:
-- only one of them runs, so a branch that returns the record whole (`| done = acc`)
-- does not stop the branch that rebuilds it. The conditions are not rewritten.
fn :: take field var RFnCase String RStrIntMap RStrIntMap => RFnCase
      take field var (FnCase pats guards body) r fam fm =
        FnCase pats (take branches guards r fam fm) (take body one body r fam fm)

fn :: take branches [RGuard] String RStrIntMap RStrIntMap => [RGuard]
      take branches [] _ _ _ =  []
      take branches ((GuardBranch c b):gs) r fam fm =
        [GuardBranch c (take body one b r fam fm)] :: (take branches gs r fam fm)

fn :: take body one RExpr String RStrIntMap RStrIntMap => RExpr
      take body one e r fam fm =  take body pick e (take reads expr e r fam fm []) r fam fm

fn :: take body pick RExpr [String] String RStrIntMap RStrIntMap => RExpr
      take body pick e reads r fam fm
        | (take reads ok reads []) and (take reads some reads) = take expr e r fam fm
        | otherwise = e

fn :: take reads some [String] => Bool
      take reads some [] =  False
      take reads some (x:xs)
        | x == "#get" or x == "#other" = take reads some xs
        | otherwise = True

-- The reads of the variable r in an expression: the name of each takeable
-- getter applied to r, "#get" for any other getter, and "#other" for every
-- other mention of r (passed whole, matched, updated).
fn :: take reads expr RExpr String RStrIntMap RStrIntMap [String] => [String]
      take reads expr (ECall g ((EVar r2):[])) r fam fm acc
        | r2 == r and (take field ok g fam fm) = acc :: [g]
        | r2 == r and (str int map lookup fam ("#g " + g)) == 1 = acc :: ["#get"]
      take reads expr (EVar r2) r _ _ acc
        | r2 == r = acc :: ["#other"]
        | otherwise = acc
      take reads expr (ECall _ args) r fam fm acc =  take reads exprs args r fam fm acc
      take reads expr (EIndexAssign t idxs v) r fam fm acc
        | t == r = acc :: ["#other"]
        | otherwise = take reads expr v r fam fm (take reads exprs idxs r fam fm acc)
      take reads expr (EBlock stmts) r fam fm acc =  take reads stmts stmts r fam fm acc
      take reads expr e r fam fm acc =  take reads exprs (expr kids e) r fam fm acc

fn :: take reads exprs [RExpr] String RStrIntMap RStrIntMap [String] => [String]
      take reads exprs [] _ _ _ acc =  acc
      take reads exprs (e:es) r fam fm acc =  take reads exprs es r fam fm (take reads expr e r fam fm acc)

fn :: take reads stmts [RStmt] String RStrIntMap RStrIntMap [String] => [String]
      take reads stmts [] _ _ _ acc =  acc
      take reads stmts ((StmtLet _ e):ss) r fam fm acc =  take reads stmts ss r fam fm (take reads expr e r fam fm acc)
      take reads stmts ((StmtMut v e):ss) r fam fm acc
        | v == r = acc :: ["#other"]
        | otherwise = take reads stmts ss r fam fm (take reads expr e r fam fm acc)
      take reads stmts ((StmtExpr e):ss) r fam fm acc =  take reads stmts ss r fam fm (take reads expr e r fam fm acc)
      take reads stmts ((StmtIndexAssign t idxs e):ss) r fam fm acc
        | t == r = acc :: ["#other"]
        | otherwise = take reads stmts ss r fam fm (take reads expr e r fam fm (take reads exprs idxs r fam fm acc))

-- True when no mention of r is outside a getter and no takeable field is read twice.
fn :: take reads ok [String] [String] => Bool
      take reads ok [] _ =  True
      take reads ok (x:xs) seen
        | x == "#other" = False
        | x == "#get" = take reads ok xs seen
        | list contains seen x = False
        | otherwise = take reads ok xs ([x] :: seen)

-- The rewrite: `g r` for a takeable getter becomes `#take g` applied to r.
fn :: take expr RExpr String RStrIntMap RStrIntMap => RExpr
      take expr (ECall g ((EVar r2):[])) r fam fm
        | r2 == r and (take field ok g fam fm) = ECall ("#take " + g) [EVar r]
      take expr (ECall f args) r fam fm =  ECall f (take exprs args r fam fm)
      take expr e r fam fm =  expr map kids e (x => take expr x r fam fm)

fn :: take exprs [RExpr] String RStrIntMap RStrIntMap => [RExpr]
      take exprs es r fam fm =  map (e => take expr e r fam fm) es

-- Lowering of the marker: read the field, put zero in its place, give the value.
fn :: lower take field RNativeEnv String String Int RNativeCode => RNativeCode
      lower take field env g r sp st =
        slot = env var slot env r
        idx = env field idx env g
        nc emit list st [NAdtField slot idx, NStoreSlot sp, NLoadImmRaw 0, NAdtSet slot idx, NStoreSlot slot, NMoveSlot sp] (sp + 1)

-- Marks unit functions in the arity map ("#u " + name), read by `unit tail call ok`.
fn :: add unit marks [RFnDef] RStrIntMap => RStrIntMap
      add unit marks [] m = m
      add unit marks ((FnDef name _ ret _):fs) m
        | is unit ret ret = add unit marks fs (str int map insert m ("#u " + name) 1)
        | otherwise = add unit marks fs m

fn :: lower fndef RFnDef RStrIntMap RStrIntMap RStrIntMap RStrSet RStrIntMap [String] => RNativeFn
      lower fndef (FnDef name params ret raw_cases) str_map fn_id_map fn_arity_map heavy_set field_map infos =
        cases1 = share cons cases (maybe wrap unit cases name ret fn_arity_map raw_cases)
        cases2 = take field cases cases1 name fn_arity_map field_map
        cases = move once cases cases2 name fn_arity_map
        fid = lookup fn id map fn_id_map name
        arity = infer fndef arity params cases
        all_locals = collect cases all locals cases []
        base_sp = arity + (list str len all_locals)
        elem_vars = fn tensor elems infos (name + "|") []
        env = NativeEnv name arity all_locals str_map fn_id_map fn_arity_map heavy_set field_map elem_vars
        init_st = RNativeCode [] 1 (max int (base_sp + 1) 2)
        st1 = lower cases list env cases base_sp init_st
        st2 = lower no match tail env name cases base_sp st1
        bmask = env borrow mask env name
        NativeFn fid name arity (nc max sp st2) (borrow fn instrs bmask arity (nc instrs st2))

fn :: borrow fn instrs Int Int [RNativeInstr] => [RNativeInstr]
      borrow fn instrs mask arity ins
        | mask > 0 = add borrow forgets ins (borrow forget ins mask 0 arity []) []
        | otherwise = ins

-- ── No matching clause (RG-114) ─────────────────────────────
-- When the last clause can fail (a refutable pattern, or guards without
-- `otherwise`), a call that matches no clause prints a runtime error to
-- stderr and exits with status 1 instead of returning the zero value.
-- The message string is added to the string pool by `no match msgs`.

fn :: no match msg String => String
      no match msg fname =  "runtime error: no clause of function '" + (decode literal underscores fname) + "' matches its arguments\n"

fn :: pat refutable RPattern => Bool
      pat refutable (PatTuple ps) =  pat list refutable ps
      pat refutable p =  pat needs check p

fn :: pat list refutable [RPattern] => Bool
      pat list refutable [] =  False
      pat list refutable (p:ps) =  (pat refutable p) or (pat list refutable ps)

fn :: case can fail RFnCase => Bool
      case can fail (FnCase pats [] _) =  pat list refutable pats
      case can fail (FnCase pats guards _) =  (pat list refutable pats) or (not (guards have otherwise guards))

fn :: last case can fail [RFnCase] => Bool
      last case can fail [] =  False
      last case can fail (c:[]) =  case can fail c
      last case can fail (_:cs) =  last case can fail cs

fn :: no match msgs [RFnDef] => [String]
      no match msgs [] =  []
      no match msgs ((FnDef fname _ _ cases):fs)
        | last case can fail cases = [no match msg fname] :: (no match msgs fs)
        | otherwise = no match msgs fs

fn :: lower no match tail RNativeEnv String [RFnCase] Int RNativeCode => RNativeCode
      lower no match tail env fname cases sp st
        | last case can fail cases =
          st1 = lower expr env (ECall "sys_write_fd" [EInt 2, EStr (no match msg fname)]) [] sp st
          st2 = nc emit st1 NDropVal (sp + 1)
          st3 = lower expr env (ECall "sys_exit" [EInt 1]) [] sp st2
          nc emit list st3 [NLoadImmRaw 0, NReturn] (sp + 1)
        | otherwise = nc emit list st [NLoadImmRaw 0, NReturn] (sp + 1)

fn :: lower fndef list acc [RFnDef] RStrIntMap RStrIntMap RStrIntMap RStrSet RStrIntMap [String] [RNativeFn] => [RNativeFn]
      lower fndef list acc [] _ _ _ _ _ _ acc = list reverse acc
      lower fndef list acc (f:fs) str_map fn_id_map fn_arity_map heavy_set field_map real_fns acc =
        nf = lower fndef f str_map fn_id_map fn_arity_map heavy_set field_map real_fns
        lower fndef list acc fs str_map fn_id_map fn_arity_map heavy_set field_map real_fns ([nf] :: acc)

fn :: lower field getter fns [RFieldEntry] RStrSet RStrIntMap RStrIntMap RStrIntMap [RNativeFn] => [RNativeFn]
      lower field getter fns [] _ _ _ _ acc = list reverse acc
      lower field getter fns ((FieldEntry fname idx):rest) fn_name_set fn_id_map str_map field_map acc
        | str set has fn_name_set fname = lower field getter fns rest fn_name_set fn_id_map str_map field_map acc
        | otherwise =
          fid = lookup fn id map fn_id_map fname
          nf = field getter fn fid fname idx (NativeEnv fname 1 [] str_map fn_id_map StrIntEmpty StrSetEmpty field_map [])
          lower field getter fns rest fn_name_set fn_id_map str_map field_map ([nf] :: acc)

fn :: field getter fn Int String Int RNativeEnv => RNativeFn
      field getter fn fid fname idx env
        | env field is alt env fname =
          st = lower field alt env fname 0 (0 - 1) 1 (RNativeCode [] 1 2)
          NativeFn fid fname 1 (nc max sp st) ((nc instrs st) :: [NReturn])
        | otherwise = NativeFn fid fname 1 2 [NAdtField 0 idx, NReturn]

-- ── Call-Graph Tree-Shaking & Dispatch Function Synthesis ────

fn :: collect refs expr RExpr              [String] => [String]
      collect refs expr (EVar name)        acc      =  add unique str name acc
      collect refs expr (EBin bop l r)     acc      =  acc -> add unique str (binop op tag bop) _ -> collect refs expr l _ -> collect refs expr r _
      collect refs expr (ECall ":typed-tensor:" ((EStr ty):rest)) acc
        | is poly elem name ty = acc -> add unique str ":typed-tensor:" _ -> add unique str "__rg_gt_poly" _ -> collect refs expr list rest _
        | otherwise = acc -> add unique str ":typed-tensor:" _ -> collect refs expr list rest _
      collect refs expr (ECall fname args) acc      =  acc -> add unique str fname _ -> collect refs expr list args _
      collect refs expr e                  acc      =  collect refs expr list (expr kids e) acc

fn :: collect refs expr list [RExpr] [String] => [String]
      collect refs expr list [] acc = acc
      collect refs expr list (e:es) acc = acc -> collect refs expr e _ -> collect refs expr list es _

fn :: collect refs cases [RFnCase] [String] => [String]
      collect refs cases []        acc      =  acc
      collect refs cases ((FnCase _ guards body):cs) acc =
        acc -> collect refs expr list (guard kids guards []) _ -> collect refs expr body _ -> collect refs cases cs _

type RFnRefsMap = FnRefsEmpty | FnRefsNode String [String] RFnRefsMap RFnRefsMap

fn :: fn refs map lookup RFnRefsMap String => [String]
      fn refs map lookup FnRefsEmpty _ = []
      fn refs map lookup (FnRefsNode k v l r) key
        | key == k = v
        | (cmp str bst key k) < 0 = fn refs map lookup l key
        | otherwise = fn refs map lookup r key

fn :: fn refs map insert RFnRefsMap String [String] => RFnRefsMap
      fn refs map insert FnRefsEmpty key val = FnRefsNode key val FnRefsEmpty FnRefsEmpty
      fn refs map insert (FnRefsNode k v l r) key val
        | key == k = FnRefsNode k val l r
        | (cmp str bst key k) < 0 = FnRefsNode k v (fn refs map insert l key val) r
        | otherwise = FnRefsNode k v l (fn refs map insert r key val)

fn :: build fn refs map [RFnDef] RFnRefsMap => RFnRefsMap
      build fn refs map [] mp = mp
      build fn refs map ((FnDef name _ _ cases):fs) mp =
        build fn refs map fs (fn refs map insert mp name (collect refs cases cases []))

fn :: expand reachable worklist [String] RFnRefsMap RStrSet => RStrSet
      expand reachable worklist [] _ visited = visited
      expand reachable worklist (w:ws) refs_map visited
        | str set has visited w = expand reachable worklist ws refs_map visited
        | otherwise =
          refs = fn refs map lookup refs_map w
          expand reachable worklist (rev str list refs ws) refs_map (str set add visited w)

fn :: filter reachable fndefs [RFnDef] RStrSet [RFnDef] => [RFnDef]
      filter reachable fndefs [] _ acc = list reverse acc
      filter reachable fndefs ((FnDef name params ret cases):fs) reachable acc
        | str set has reachable name = filter reachable fndefs fs reachable ([FnDef name params ret cases] :: acc)
        | otherwise = filter reachable fndefs fs reachable acc

fn :: collect fn names [RFnDef] => [String]
      collect fn names []       =  []
      collect fn names ((FnDef name _ _ _):fs) = [name] :: (collect fn names fs)

fn :: find entry fn name [RFnDef] String => String
      find entry fn name [] fallback = fallback
      find entry fn name ((FnDef name params _ cases):fs) fallback
        | name == "main" = "main"
        | name == "demo_all" = "demo_all"
        | (infer fndef arity params cases) == 0 = find entry fn name fs name
        | otherwise = find entry fn name fs fallback

-- ── Dynamic Dispatch Target Collection ──────────────────────

fn :: collect disp par items [RExpr] RStrIntMap RStrSet => RStrSet
      collect disp par items [] _ acc = acc
      collect disp par items ((ECall fname args):es) ar_map acc =
        collect disp par items es ar_map (collect disp expr list args ar_map (str set add acc fname))
      collect disp par items (e:es) ar_map acc =
        collect disp par items es ar_map (collect disp expr e ar_map acc)

fn :: collect disp expr RExpr RStrIntMap RStrSet => RStrSet
      collect disp expr (EStr s) _ acc = str set add acc s
      collect disp expr (EVar v) _ acc = str set add acc v
      collect disp expr (ECall "__unpack2__" ((EVar fn_target):args)) ar_map acc =
        collect disp expr list args ar_map (str set add acc fn_target)
      collect disp expr (ECall fname args) ar_map acc
        | (list len args) > 0 and (str int map lookup ar_map fname) > (list len args) =
          collect disp expr list args ar_map (str set add acc fname)
        | otherwise = collect disp expr list args ar_map acc
      collect disp expr (EWhere body binds) ar_map acc = collect disp where binds ar_map (collect disp expr body ar_map acc)
      collect disp expr (EParPipe branches) ar_map acc = collect disp par items branches ar_map acc
      collect disp expr e ar_map acc = collect disp expr list (expr kids e) ar_map acc

fn :: collect disp expr list [RExpr] RStrIntMap RStrSet => RStrSet
      collect disp expr list [] _ acc = acc
      collect disp expr list (e:es) ar_map acc = collect disp expr list es ar_map (collect disp expr e ar_map acc)

fn :: collect disp where [RWhereBind] RStrIntMap RStrSet => RStrSet
      collect disp where [] _ acc = acc
      collect disp where ((WhereBind (ECall fname args) _ _):wbs) ar_map acc =
        collect disp where wbs ar_map (collect disp expr list args ar_map (str set add acc fname))
      collect disp where ((WhereBind e _ _):wbs) ar_map acc =
        collect disp where wbs ar_map (collect disp expr e ar_map acc)

fn :: collect disp cases [RFnCase] RStrIntMap RStrSet => RStrSet
      collect disp cases [] _ acc = acc
      collect disp cases ((FnCase _ gs b):cs) ar_map acc =
        collect disp cases cs ar_map (collect disp expr b ar_map (collect disp expr list (guard kids gs []) ar_map acc))

fn :: collect disp fndefs [RFnDef] RStrIntMap RStrSet => RStrSet
      collect disp fndefs [] _ acc = acc
      collect disp fndefs ((FnDef _ _ _ cases):fs) ar_map acc =
        collect disp fndefs fs ar_map (collect disp cases cases ar_map acc)

fn :: build spawn dispatch entry [RFnEntry] RStrIntMap RStrSet => [RNativeInstr]
      build spawn dispatch entry fn_tbl str_map disp_set =
        par_off = lookup str off str_map "__rg_par_eval__"
        par_hdr = [NMatchStr 0 par_off 15, NJumpIfZero 1, NTupleGet 1 0, NStoreSlot 2, NTupleGet 1 1, NStoreSlot 1, NMoveSlot 2, NStoreSlot 0, NLabel 1]
        clos_hdr = [NMatchTuple 0 2, NJumpIfZero 2, NTupleGet 0 0, NStoreSlot 2, NTupleGet 0 1, NStoreSlot 3, NMoveSlot 1, NStoreSlot 4, NMakeList 4 1, NBinOp 14 3, NStoreSlot 3, NListHead 3, NStoreSlot 4, NListTail 3, NStoreSlot 5, NMoveSlot 4, NStoreSlot 3, NMoveSlot 5, NStoreSlot 4, NMakeAdt (rest tag off) 11 4 1, NStoreSlot 4, NCallIndirect2 2 3, NReturn, NLabel 2]
        init_rev = rev native instrs (par_hdr :: clos_hdr) []
        build spawn dispatch instrs fn_tbl str_map disp_set 3 init_rev

fn :: build spawn dispatch instrs [RFnEntry] RStrIntMap RStrSet Int [RNativeInstr] => [RNativeInstr]
      build spawn dispatch instrs [] _ _ _ rev_acc =
        rev native instrs (rev native instrs [NLoadImmRaw 0, NReturn] rev_acc) []
      build spawn dispatch instrs ((FnEntry name fid arity):rest) str_map disp_set lbl rev_acc
        | not (str set has disp_set name) =
          build spawn dispatch instrs rest str_map disp_set lbl rev_acc
        | arity == 0 =
          off = lookup str off str_map name
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl, NCallFn fid 2 0, NReturn, NLabel lbl]
          build spawn dispatch instrs rest str_map disp_set (lbl + 1) (rev native instrs arm rev_acc)
        | arity == 1 =
          off = lookup str off str_map name
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl, NMoveSlot 1, NStoreSlot 2, NCallFn fid 2 1, NReturn, NLabel lbl]
          build spawn dispatch instrs rest str_map disp_set (lbl + 1) (rev native instrs arm rev_acc)
        | arity == 2 =
          off = lookup str off str_map name
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl, NTupleGet 1 0, NStoreSlot 2, NTupleGet 1 1, NStoreSlot 3, NCallFn fid 2 2, NReturn, NLabel lbl]
          build spawn dispatch instrs rest str_map disp_set (lbl + 1) (rev native instrs arm rev_acc)
        | arity == 3 =
          off = lookup str off str_map name
          lbl2 = lbl + 1
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl2, NMatchTuple 1 2, NJumpIfZero lbl, NTupleGet 1 0, NStoreSlot 2, NTupleGet 1 1, NStoreSlot 5, NTupleGet 5 0, NStoreSlot 3, NTupleGet 5 1, NStoreSlot 4, NCallFn fid 2 3, NReturn, NLabel lbl, NTupleGet 1 0, NStoreSlot 2, NTupleGet 1 1, NStoreSlot 3, NTupleGet 1 2, NStoreSlot 4, NCallFn fid 2 3, NReturn, NLabel lbl2]
          build spawn dispatch instrs rest str_map disp_set (lbl + 2) (rev native instrs arm rev_acc)
        | otherwise =
          build spawn dispatch instrs rest str_map disp_set lbl rev_acc

fn :: highest entry arity [RFnEntry] => Int
      highest entry arity []         =  0
      highest entry arity ((FnEntry _ _ arity):rest) =
        max int arity (highest entry arity rest)

fn :: build call2 unpack tuple Int Int => [RNativeInstr]
      build call2 unpack tuple idx count
        | idx >= count = []
        | otherwise =
          [NTupleGet 2 idx, NStoreSlot (4 + idx)] :: (build call2 unpack tuple (idx + 1) count)

fn :: build call2 unpack list Int Int => [RNativeInstr]
      build call2 unpack list idx count
        | idx >= count = []
        | otherwise =
          [NListHead 2, NStoreSlot (4 + idx), NListTail 2, NStoreSlot 2] :: (build call2 unpack list (idx + 1) count)

-- `__rg_dispatch_call2` gets (name, first argument, rest). A closure call
-- passes the rest as a list inside the reserved constructor `__rg_rest__`;
-- any other call passes the second argument itself (arity 2) or a tuple of
-- the others (arity 3+). A list argument stays whole: it is never taken for
-- a closure's rest (RG-115). Not a 1-tuple: a 1-element list matches one.
fn :: build call2 dispatch instrs [RFnEntry] RStrIntMap RStrSet Int [RNativeInstr] => [RNativeInstr]
      build call2 dispatch instrs [] _ _ _ rev_acc =
        rev native instrs (rev native instrs [NLoadImmRaw 0, NReturn] rev_acc) []
      build call2 dispatch instrs ((FnEntry name fid arity):rest) str_map disp_set lbl rev_acc
        | not (str set has disp_set name) =
          build call2 dispatch instrs rest str_map disp_set lbl rev_acc
        | arity == 2 =
          off = lookup str off str_map name
          lbl_plain = lbl + 1
          lbl_next = lbl + 2
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl_next, NMoveSlot 1, NStoreSlot 3, NMatchAdt 2 (rest tag off) 11 1, NJumpIfZero lbl_plain, NAdtField 2 0, NStoreSlot 2, NListHead 2, NStoreSlot 4, NJump lbl, NLabel lbl_plain, NMoveSlot 2, NStoreSlot 4, NLabel lbl, NCallFn fid 3 2, NReturn, NLabel lbl_next]
          build call2 dispatch instrs rest str_map disp_set (lbl + 3) (rev native instrs arm rev_acc)
        | arity >= 3 =
          off = lookup str off str_map name
          lbl_tuple = lbl + 1
          lbl_next = lbl + 2
          unpack_list = build call2 unpack list 0 (arity - 1)
          unpack_tup = build call2 unpack tuple 0 (arity - 1)
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl_next, NMoveSlot 1, NStoreSlot 3, NMatchAdt 2 (rest tag off) 11 1, NJumpIfZero lbl_tuple, NAdtField 2 0, NStoreSlot 2] :: unpack_list :: [NJump lbl, NLabel lbl_tuple] :: unpack_tup :: [NLabel lbl, NCallFn fid 3 arity, NReturn, NLabel lbl_next]
          build call2 dispatch instrs rest str_map disp_set (lbl + 3) (rev native instrs arm rev_acc)
        | otherwise =
          build call2 dispatch instrs rest str_map disp_set lbl rev_acc

fn :: is overloadable binop name String => Bool
      is overloadable binop name "+"    =  True
      is overloadable binop name "-"    =  True
      is overloadable binop name "*"    =  True
      is overloadable binop name "/"    =  True
      is overloadable binop name "%"    =  True
      is overloadable binop name _      =  False

fn :: build binop dispatch instrs [RFnEntry] RStrIntMap Int [RNativeInstr] => [RNativeInstr]
      build binop dispatch instrs [] _ _ rev_acc =
        rev native instrs (rev native instrs [NLoadImmRaw 0, NReturn] rev_acc) []
      build binop dispatch instrs ((FnEntry name fid arity):rest) str_map lbl rev_acc
        | arity == 2 and (is overloadable binop name name) =
          off = lookup str off str_map name
          arm = [NMatchStr 0 off (str len name), NJumpIfZero lbl, NMoveSlot 1, NStoreSlot 3, NMoveSlot 2, NStoreSlot 4, NCallFn fid 3 2, NReturn, NLabel lbl]
          build binop dispatch instrs rest str_map (lbl + 1) (rev native instrs arm rev_acc)
        | otherwise =
          build binop dispatch instrs rest str_map lbl rev_acc

fn :: is wrapable builtin fn String => Bool
      is wrapable builtin fn name =
        bid = builtin call id name
        ar = std builtin arity name
        bid >= 10 and bid != 53 and bid != 54 and bid != 55 and bid != 56 and bid != 61 and ar >= 1 and ar <= 3

fn :: make builtin wrapper fndef String Int => RFnDef
      make builtin wrapper fndef name 1 =
        FnDef name ["A"] "B" [FnCase [PatVar "__p0"] [] (ECall name [EVar "__p0"])]
      make builtin wrapper fndef name 2 =
        FnDef name ["A", "B"] "C" [FnCase [PatVar "__p0", PatVar "__p1"] [] (ECall name [EVar "__p0", EVar "__p1"])]
      make builtin wrapper fndef name _ =
        FnDef name ["A", "B", "C"] "D" [FnCase [PatVar "__p0", PatVar "__p1", PatVar "__p2"] [] (ECall name [EVar "__p0", EVar "__p1", EVar "__p2"])]

fn :: collect builtin val expr RExpr [String] => [String]
      collect builtin val expr (EVar name) acc
        | is wrapable builtin fn name = add unique str name acc
        | otherwise = acc
      collect builtin val expr (ECall fname args) acc
        | (is wrapable builtin fn fname) and (list len args) > 0 and (list len args) < (std builtin arity fname) =
          collect builtin val expr list args (add unique str fname acc)
        | otherwise = collect builtin val expr list args acc
      collect builtin val expr e acc =  collect builtin val expr list (expr kids e) acc

fn :: collect builtin val expr list [RExpr] [String] => [String]
      collect builtin val expr list [] acc = acc
      collect builtin val expr list (e:es) acc = collect builtin val expr list es (collect builtin val expr e acc)

fn :: collect builtin val cases [RFnCase] [String] => [String]
      collect builtin val cases [] acc = acc
      collect builtin val cases ((FnCase _ gs b):cs) acc =
        collect builtin val cases cs (collect builtin val expr b (collect builtin val expr list (guard kids gs []) acc))

fn :: collect builtin val fndefs [RFnDef] [String] => [String]
      collect builtin val fndefs [] acc = acc
      collect builtin val fndefs ((FnDef _ _ _ cases):fs) acc =
        collect builtin val fndefs fs (collect builtin val cases cases acc)

fn :: build builtin wrapper fndefs [String] RStrSet => [RFnDef]
      build builtin wrapper fndefs [] _ = []
      build builtin wrapper fndefs (b:bs) existing_set
        | str set has existing_set b = build builtin wrapper fndefs bs existing_set
        | otherwise = [make builtin wrapper fndef b (std builtin arity b)] :: (build builtin wrapper fndefs bs existing_set)

fn :: collect gagent names [RFnDef] => [String]
      collect gagent names [] = []
      collect gagent names ((FnDef name _ "__sink_agent__" _):fs) =
        [name] :: (collect gagent names fs)
      collect gagent names (_:fs) = collect gagent names fs

fn :: insert gagent ids [String] Int RStrIntMap => RStrIntMap
      insert gagent ids [] _ mp = mp
      insert gagent ids (name:rest) idx mp =
        mp1 = str int map insert mp (":gagent:" + name) idx
        mp2 = str int map insert mp1 (":gagent:" + (ident base name name)) idx
        insert gagent ids rest (idx + 1) mp2

fn :: build gagent chan instrs [String] => [RNativeInstr]
      build gagent chan instrs [] = []
      build gagent chan instrs (_:rest) =
        [NCallBuiltin 1 1 0, NStoreSlot 1, NLoadImmInt 0, NStoreSlot 0, NCallBuiltin 50 0 2, NDropVal] :: (build gagent chan instrs rest)

fn :: build gagent call instrs [String] RStrIntMap => [RNativeInstr]
      build gagent call instrs [] _ = []
      build gagent call instrs (name:rest) fn_id_map =
        fid = lookup fn id map fn_id_map name
        [NCallFn fid 0 0, NDropVal] :: (build gagent call instrs rest fn_id_map)

fn :: build gagent drain instrs [String] RStrIntMap Int => [RNativeInstr]
      build gagent drain instrs [] _ _ = []
      build gagent drain instrs (name:rest) fn_id_map lbl_base =
        fid = lookup fn id map fn_id_map name
        [NCallFn fid 1 0, NStoreSlot 1] :: (emit sink flush or state False 1 lbl_base) :: [NDropVal] :: (build gagent drain instrs rest fn_id_map (lbl_base + 10))

fn :: build main wrapper fndef Int [String] RStrIntMap => RNativeFn
      build main wrapper fndef entry_fid [] _ =
        NativeFn 1 "__rg_entry_main" 0 2 [NCallFn entry_fid 0 (0 - 1), NReturn]
      build main wrapper fndef entry_fid gagent_names fn_id_map =
        chan_ins = build gagent chan instrs gagent_names
        call_ins = build gagent call instrs gagent_names fn_id_map
        drain_ins = build gagent drain instrs (rev str list gagent_names []) fn_id_map 1
        main_ins = chan_ins :: call_ins :: [NCallFn entry_fid 0 (0 - 1), NStoreSlot 0] :: drain_ins :: [NMoveSlot 0, NReturn]
        NativeFn 1 "__rg_entry_main" 0 20 main_ins

-- ── 64-bit `str_to_int` (RG-113) ────────────────────────────
-- The runtime builtin (id 13) parses correctly but tags its result without
-- heap-boxing, so values with |n| >= 2^62 lose bit 62. Calls to `str_to_int`
-- are lowered to the Ridgun helper below, which keeps the builtin for strings
-- of at most 17 characters (always |n| < 2^62) and otherwise parses with
-- 64-bit arithmetic. Semantics match the builtin: trim ASCII whitespace
-- (9..13, 32), ignore '_', optional sign, "0x"/"0X" hex prefix before the
-- sign, and 0 for invalid or out-of-range input.

fn :: s2i helper name => String
      s2i helper name =  "__rg_s2i_wide"

fn :: s2i src wide => String
      s2i src wide =  "fn :: __rg_s2i_wide String => Int\n      __rg_s2i_wide s\n        | (str_len s) <= 17 = str_to_int s\n        | otherwise = __rg_s2i_parse s\n"

fn :: s2i src min => String
      s2i src min =  "fn :: __rg_s2i_min => Int\n      __rg_s2i_min =  (0 - (4611686018427387903 * 2)) - 2\n"

fn :: s2i src space => String
      s2i src space =  "fn :: __rg_s2i_space Int => Bool\n      __rg_s2i_space c =  c == 32 or (c >= 9 and c <= 13)\n"

fn :: s2i src lo => String
      s2i src lo =  "fn :: __rg_s2i_lo String Int Int => Int\n      __rg_s2i_lo s i n\n        | i < n and (__rg_s2i_space (str_char_at s i)) = __rg_s2i_lo s (i + 1) n\n        | otherwise = i\n"

fn :: s2i src hi => String
      s2i src hi =  "fn :: __rg_s2i_hi String Int Int => Int\n      __rg_s2i_hi s lo j\n        | j > lo and (__rg_s2i_space (str_char_at s (j - 1))) = __rg_s2i_hi s lo (j - 1)\n        | otherwise = j\n"

fn :: s2i src skip => String
      s2i src skip =  "fn :: __rg_s2i_skip String Int Int => Int\n      __rg_s2i_skip s i hi\n        | i < hi and (str_char_at s i) == 95 = __rg_s2i_skip s (i + 1) hi\n        | otherwise = i\n"

fn :: s2i src digit => String
      s2i src digit =  "fn :: __rg_s2i_digit Int Int => Int\n      __rg_s2i_digit c base\n        | c >= 48 and c <= 57 = c - 48\n        | base == 16 and c >= 65 and c <= 70 = c - 55\n        | base == 16 and c >= 97 and c <= 102 = c - 87\n        | otherwise = 0 - 1\n"

fn :: s2i src acc => String
      s2i src acc =  "fn :: __rg_s2i_acc String Int Int Int Int => Int\n      __rg_s2i_acc s i hi base acc\n        | i >= hi = acc\n        | (str_char_at s i) == 95 = __rg_s2i_acc s (i + 1) hi base acc\n        | otherwise = __rg_s2i_step s i hi base acc (__rg_s2i_digit (str_char_at s i) base)\n"

fn :: s2i src step => String
      s2i src step =  "fn :: __rg_s2i_step String Int Int Int Int Int => Int\n      __rg_s2i_step s i hi base acc d\n        | d < 0 = 1\n        | acc < ((__rg_s2i_min + d) / base) = 1\n        | otherwise = __rg_s2i_acc s (i + 1) hi base ((acc * base) - d)\n"

fn :: s2i src finish => String
      s2i src finish =  "fn :: __rg_s2i_finish Bool Int => Int\n      __rg_s2i_finish _ 1 = 0\n      __rg_s2i_finish True acc = acc\n      __rg_s2i_finish False acc\n        | acc == __rg_s2i_min = 0\n        | otherwise = 0 - acc\n"

fn :: s2i src signed => String
      s2i src signed =  "fn :: __rg_s2i_signed String Int Int Int => Int\n      __rg_s2i_signed s i hi base\n        | i < hi and (str_char_at s i) == 45 = __rg_s2i_finish True (__rg_s2i_acc s (__rg_s2i_skip s (i + 1) hi) hi base 0)\n        | i < hi and (str_char_at s i) == 43 = __rg_s2i_finish False (__rg_s2i_acc s (__rg_s2i_skip s (i + 1) hi) hi base 0)\n        | otherwise = __rg_s2i_finish False (__rg_s2i_acc s i hi base 0)\n"

fn :: s2i src is x => String
      s2i src is x =  "fn :: __rg_s2i_is_x Int => Bool\n      __rg_s2i_is_x c =  c == 120 or c == 88\n"

fn :: s2i src body => String
      s2i src body =  "fn :: __rg_s2i_body String Int Int => Int\n      __rg_s2i_body s p hi\n        | p < hi and (str_char_at s p) == 48 and (__rg_s2i_skip s (p + 1) hi) < hi and (__rg_s2i_is_x (str_char_at s (__rg_s2i_skip s (p + 1) hi))) =\n          __rg_s2i_signed s (__rg_s2i_skip s ((__rg_s2i_skip s (p + 1) hi) + 1) hi) hi 16\n        | otherwise = __rg_s2i_signed s p hi 10\n"

fn :: s2i src parse => String
      s2i src parse =  "fn :: __rg_s2i_parse String => Int\n      __rg_s2i_parse s =\n        lo = __rg_s2i_lo s 0 (str_len s)\n        hi = __rg_s2i_hi s lo (str_len s)\n        __rg_s2i_body s (__rg_s2i_skip s lo hi) hi\n"

fn :: s2i helper src => String
      s2i helper src =  join str tree [(s2i src wide), (s2i src min), (s2i src space), (s2i src lo), (s2i src hi), (s2i src skip), (s2i src digit), (s2i src acc), (s2i src step), (s2i src finish), (s2i src signed), (s2i src is x), (s2i src body), (s2i src parse)]

fn :: s2i helper fndefs => [RFnDef]
      s2i helper fndefs =  fndefs of program (parse tokens (tokenize src (s2i helper src)))

fn :: fndefs of program RProgram => [RFnDef]
      fndefs of program (Program fns _) =  fns

fn :: has fndef named [RFnDef] String => Bool
      has fndef named [] _ =  False
      has fndef named ((FnDef fname _ _ _):fs) target
        | fname == target = True
        | otherwise = has fndef named fs target

fn :: with s2i helper [RFnDef] => [RFnDef]
      with s2i helper fns
        | has fndef named fns (s2i helper name) = fns
        | otherwise = fns :: (s2i helper fndefs)

fn :: add s2i ref RFnRefsMap => RFnRefsMap
      add s2i ref mp =  fn refs map insert mp "str_to_int" [(s2i helper name)]

fn :: fndefs call s2i [RFnDef] => Bool
      fndefs call s2i [] =  False
      fndefs call s2i ((FnDef _ _ _ cases):fs)
        | list contains (collect refs cases cases []) "str_to_int" = True
        | otherwise = fndefs call s2i fs

fn :: lib with s2i helper [RFnDef] => [RFnDef]
      lib with s2i helper fns
        | fndefs call s2i fns = with s2i helper fns
        | otherwise = fns

-- ADR-0008: a user definition shadows a builtin of the same name. A program that defines a function named like a
-- builtin (`sys rename` in a library, `stop` in a test) gets its own function: the definition and every call to that
-- name are renamed before lowering, so no builtin path sees them. Programs without such a name are left as they are.
fn :: is shadowable builtin name String => Bool
      is shadowable builtin name name =  (builtin call id name) >= 0 or (is std builtin name) or (is agent call name name)

fn :: shadowed builtin names [RFnDef] => [String]
      shadowed builtin names []                     =  []
      shadowed builtin names ((FnDef name _ _ _):fs)
        | is shadowable builtin name name = [name] :: (shadowed builtin names fs)
        | otherwise                       = shadowed builtin names fs

fn :: shadow name String RStrSet => String
      shadow name n names
        | str set has names n = "__user__" + n
        | otherwise           = n

fn :: shadow expr RExpr RStrSet => RExpr
      shadow expr (EVar v) names                    =  EVar (shadow name v names)
      shadow expr (ECall f args) names              =  ECall (shadow name f names) (shadow exprs args names)
      shadow expr e names                              =  expr map kids e (x => shadow expr x names)

fn :: shadow exprs [RExpr] RStrSet => [RExpr]
      shadow exprs es names =  map (e => shadow expr e names) es

fn :: shadow cases [RFnCase] RStrSet => [RFnCase]
      shadow cases []                       _     =  []
      shadow cases ((FnCase ps gs b):cs)    names =  [FnCase ps (guards map exprs gs (x => shadow expr x names)) (shadow expr b names)] :: (shadow cases cs names)

fn :: shadow fndefs [RFnDef] RStrSet => [RFnDef]
      shadow fndefs []                         _     =  []
      shadow fndefs ((FnDef n tps r cs):fs)    names =  [FnDef (shadow name n names) tps r (shadow cases cs names)] :: (shadow fndefs fs names)

fn :: shadow builtins [RFnDef] => [RFnDef]
      shadow builtins fns =  shadow builtins with fns (shadowed builtin names fns)

fn :: shadow builtins with [RFnDef] [String] => [RFnDef]
      shadow builtins with fns []    =  fns
      shadow builtins with fns names =  shadow fndefs fns (str list to set names StrSetEmpty)

fn :: lower program to native RProgram [String] => RNativeProg
      lower program to native (Program user_fns0 tys) infos =
        user_fns = shadow builtins user_fns0
        raw_fns = with gt helpers (with s2i helper user_fns)
        entry_name = find entry fn name raw_fns "main"
        gagent_roots = collect gagent names raw_fns
        refs_map0 = add gt refs (add s2i ref (build fn refs map raw_fns FnRefsEmpty))
        show_roots = tensor show roots infos
        reach_set0 = expand reachable worklist ([entry_name] :: gagent_roots :: show_roots) refs_map0 StrSetEmpty
        reach_raw = filter reachable fndefs raw_fns reach_set0 []
        field_tbl = collect typedef fields tys []
        raw_fn_names = collect fn names reach_raw
        raw_fn_set = str list to set raw_fn_names StrSetEmpty
        b_val_names = collect builtin val fndefs reach_raw []
        b_wrappers = build builtin wrapper fndefs b_val_names raw_fn_set
        sigs = (build cg sigs reach_raw) :: (build field cg sigs field_tbl raw_fn_set)
        all_fns = (opt fndef list (prep fndef list reach_raw sigs)) :: b_wrappers
        refs_map = add gt refs (add s2i ref (build fn refs map all_fns FnRefsEmpty))
        reachable_set = expand reachable worklist ([entry_name] :: gagent_roots :: show_roots) refs_map StrSetEmpty
        fns = filter reachable fndefs all_fns reachable_set []
        gagent_names = collect gagent names fns
        fn_names = collect fn names fns
        fn_name_set = str list to set fn_names StrSetEmpty
        field_names = collect field names field_tbl
        field_alts = ambiguous field alts (collect field alts tys []) (collect field alts tys [])
        str_pool = build str pool fns (field_names :: (field alt strs field_alts) :: (no match msgs fns) :: [gen tensor oob msg])
        rodata_str = pool rodata str_pool
        str_map = pool str map str_pool
        fn_tbl1 = build fn table fndefs fns 5 []
        fn_tbl = build fn table fields field_tbl fn_name_set (5 + (list str len fn_names)) (list reverse fn_tbl1)
        fn_id_map = build fn id map fn_tbl StrIntEmpty
        fn_arity_map = build fn arity map fn_tbl StrIntEmpty
        heavy_set = compute heavy fn set fns
        field_map = add big field marks tys (add field alts field_alts str_map (insert gagent ids gagent_names 0 (build field idx map field_tbl StrIntEmpty)))
        disp_set0 = str list to set field_names (str list to set b_val_names StrSetEmpty)
        disp_set = collect disp fndefs fns fn_arity_map disp_set0
        borrow_excl = str list to set ([entry_name] :: gagent_names :: show_roots :: (borrow tail fns fns [])) disp_set
        fn_arity_map_b = add step form marks fns (add unit marks fns (add getter marks field_tbl fn_name_set (borrow masks fns borrow_excl fn_arity_map fn_arity_map)))
        entry_fid = lookup fn id map fn_id_map entry_name
        main_wrapper = build main wrapper fndef entry_fid gagent_names fn_id_map
        spawn_disp = NativeFn 2 "__rg_dispatch_spawn" 2 6 (build spawn dispatch entry fn_tbl str_map disp_set)
        call2_slots = max int 7 (4 + (highest entry arity fn_tbl))
        call2_disp = NativeFn 3 "__rg_dispatch_call2" 3 call2_slots (build call2 dispatch instrs fn_tbl str_map disp_set 1 [])
        binop_disp = NativeFn 4 "__rg_dispatch_binop" 3 6 (build binop dispatch instrs fn_tbl str_map 1 [])
        user_native_fns = lower fndef list acc fns str_map fn_id_map fn_arity_map_b heavy_set field_map infos []
        field_native_fns = lower field getter fns field_tbl fn_name_set fn_id_map str_map field_map []
        all_native_fns = [main_wrapper, spawn_disp, call2_disp, binop_disp] :: user_native_fns :: field_native_fns
        NativeProg 1 2 3 4 (fill tail call fns all_native_fns (tail callee slots all_native_fns StrIntEmpty) []) rodata_str

-- OPT-019: `NTailCallFn fid start count slots` carries the callee's frame
-- size, which the x86-64 encoder needs to resize the frame before the jump.
-- Callees are lowered after their callers, so it is filled in here.
fn :: tail callee slots [RNativeFn] RStrIntMap => RStrIntMap
      tail callee slots [] m = m
      tail callee slots ((NativeFn fid _ _ ns _):fs) m = tail callee slots fs (str int map insert m (int to str fid) ns)

fn :: instrs have tail call fn [RNativeInstr] => Bool
      instrs have tail call fn [] = False
      instrs have tail call fn ((NTailCallFn _ _ _ _):_) = True
      instrs have tail call fn (_:rest) = instrs have tail call fn rest

fn :: fill tail call instrs [RNativeInstr] RStrIntMap [RNativeInstr] => [RNativeInstr]
      fill tail call instrs [] _ acc = rev native instrs acc []
      fill tail call instrs ((NTailCallFn f a c _):rest) m acc =
        fill tail call instrs rest m ([NTailCallFn f a c (str int map lookup m (int to str f))] :: acc)
      fill tail call instrs (i:rest) m acc = fill tail call instrs rest m ([i] :: acc)

fn :: fill tail call fns [RNativeFn] RStrIntMap [RNativeFn] => [RNativeFn]
      fill tail call fns [] _ acc = list reverse acc
      fill tail call fns ((NativeFn fid nm ar ns ins):fs) m acc
        | instrs have tail call fn ins = fill tail call fns fs m ([NativeFn fid nm ar ns (fill tail call instrs ins m [])] :: acc)
        | otherwise = fill tail call fns fs m ([NativeFn fid nm ar ns ins] :: acc)

fn :: build lib entry wrapper Int       => RNativeFn
      build lib entry wrapper 0         =  NativeFn 1 "__rg_entry_main" 0 2 [NLoadImmRaw 0, NReturn]
      build lib entry wrapper entry_fid =  NativeFn 1 "__rg_entry_main" 0 2 [NCallFn entry_fid 0 (0 - 1), NReturn]

fn :: lower library to native RProgram [String] => RNativeProg
      lower library to native (Program user_fns0 tys) infos =
        user_fns = shadow builtins user_fns0
        raw_fns = lib with gt helpers (lib with s2i helper user_fns)
        field_tbl = collect typedef fields tys []
        raw_fn_names = collect fn names raw_fns
        raw_fn_set = str list to set raw_fn_names StrSetEmpty
        b_val_names = collect builtin val fndefs raw_fns []
        b_wrappers = build builtin wrapper fndefs b_val_names raw_fn_set
        sigs = (build cg sigs raw_fns) :: (build field cg sigs field_tbl raw_fn_set)
        fns = (opt fndef list (prep fndef list raw_fns sigs)) :: b_wrappers
        gagent_names = collect gagent names fns
        fn_names = collect fn names fns
        fn_name_set = str list to set fn_names StrSetEmpty
        field_names = collect field names field_tbl
        field_alts = ambiguous field alts (collect field alts tys []) (collect field alts tys [])
        str_pool = build str pool fns (field_names :: (field alt strs field_alts) :: (no match msgs fns) :: [gen tensor oob msg])
        rodata_str = pool rodata str_pool
        str_map = pool str map str_pool
        fn_tbl1 = build fn table fndefs fns 5 []
        fn_tbl = build fn table fields field_tbl fn_name_set (5 + (list str len fn_names)) (list reverse fn_tbl1)
        fn_id_map = build fn id map fn_tbl StrIntEmpty
        fn_arity_map = build fn arity map fn_tbl StrIntEmpty
        heavy_set = compute heavy fn set fns
        field_map = add big field marks tys (add field alts field_alts str_map (insert gagent ids gagent_names 0 (build field idx map field_tbl StrIntEmpty)))
        disp_set = str list to set field_names fn_name_set
        entry_fid = lookup fn id map fn_id_map "main"
        main_wrapper = build lib entry wrapper entry_fid
        spawn_disp = NativeFn 2 "__rg_dispatch_spawn" 2 6 (build spawn dispatch entry fn_tbl str_map disp_set)
        call2_slots = max int 7 (4 + (highest entry arity fn_tbl))
        call2_disp = NativeFn 3 "__rg_dispatch_call2" 3 call2_slots (build call2 dispatch instrs fn_tbl str_map disp_set 1 [])
        binop_disp = NativeFn 4 "__rg_dispatch_binop" 3 6 (build binop dispatch instrs fn_tbl str_map 1 [])
        user_native_fns = lower fndef list acc fns str_map fn_id_map (add unit marks fns (add getter marks field_tbl fn_name_set fn_arity_map)) heavy_set field_map infos []
        field_native_fns = lower field getter fns field_tbl fn_name_set fn_id_map str_map field_map []
        all_native_fns = [main_wrapper, spawn_disp, call2_disp, binop_disp] :: user_native_fns :: field_native_fns
        NativeProg 1 2 3 4 (fill tail call fns all_native_fns (tail callee slots all_native_fns StrIntEmpty) []) rodata_str

-- ── Library (.ridgunlib / .so) & ELF64 Emission ─

fn :: join summaries [String] => String
      join summaries []       =  ""
      join summaries (s:ss)   =  "-- SUMMARY: {s}\n" + (join summaries ss)

fn :: emit rglib payload RProgram String  => String
      emit rglib payload prog     raw_src =
        prog -> count fn defs -> fn_count
        prog -> count type defs -> ty_count
        prog -> analyze rprogram -> join summaries -> summaries
        "-- RIDGUNLIB1\n-- SELF_HOSTED_COMPILER: ridgunc v0.9.8\n-- FUNCTIONS: {fn_count}\n-- TYPES: {ty_count}\n{summaries}{raw_src}"

fn :: emit rglib file String     String      => Int
      emit rglib file input_path output_path =
        input_path -> load rg own source -> own_src
        input_path -> load rg with libs -> full_src
        emit rglib file loaded input_path output_path own_src full_src

fn :: emit rglib file loaded String String String String => Int
      emit rglib file loaded input_path _ "" _ =
        echo "[ridgunc build --lib] Error: empty or missing source file: {input_path}"
        1
      emit rglib file loaded _ output_path own_src full_src =
        full_src -> tokenize src -> parse tokens -> typecheck program -> errs
        own_src -> tokenize src -> parse tokens -> own_prog
        emit rglib after check own_prog own_src output_path errs

fn :: emit rglib after check RProgram String String [RTypeError] => Int
      emit rglib after check prog raw_src output_path []
        | ((count fn defs prog) == 0) and ((count type defs prog) == 0) =
          echo "[ridgunc build --lib] Error: no functions or types found in source"
          1
        | otherwise =
          prog -> emit rglib payload raw_src -> write file output_path _
          0
      emit rglib after check _ _ _ errs =
        echo (format type errors errs)
        1

fn :: emit elf for target RNativeProg String           => [Int]
      emit elf for target nprog       "arm64"          =  emit arm64 elf nprog
      emit elf for target nprog       "arm64-linux"    =  emit arm64 elf nprog
      emit elf for target nprog       "aarch64"        =  emit arm64 elf nprog
      emit elf for target nprog       "aarch64-linux"  =  emit arm64 elf nprog
      emit elf for target nprog       "x86_64-macos"   =  emit x8664 macho64 nprog
      emit elf for target nprog       "macos-x86_64"   =  emit x8664 macho64 nprog
      emit elf for target nprog       "macos"          =  emit x8664 macho64 nprog
      emit elf for target nprog       "darwin"         =  emit x8664 macho64 nprog
      emit elf for target nprog       "arm64-macos"    =  emit arm64 macho64 nprog
      emit elf for target nprog       "macos-arm64"    =  emit arm64 macho64 nprog
      emit elf for target nprog       "aarch64-macos"  =  emit arm64 macho64 nprog
      emit elf for target nprog       "apple-silicon"  =  emit arm64 macho64 nprog
      emit elf for target nprog       "x86_64-windows" =  emit x8664 pe64 nprog
      emit elf for target nprog       "windows-x86_64" =  emit x8664 pe64 nprog
      emit elf for target nprog       "windows"        =  emit x8664 pe64 nprog
      emit elf for target nprog       "win64"          =  emit x8664 pe64 nprog
      emit elf for target nprog       "pe64"           =  emit x8664 pe64 nprog
      emit elf for target nprog       "arm64-windows"  =  emit arm64 pe64 nprog
      emit elf for target nprog       "windows-arm64"  =  emit arm64 pe64 nprog
      emit elf for target nprog       "aarch64-windows" = emit arm64 pe64 nprog
      emit elf for target nprog       "wasm32"         =  emit wasm module nprog
      emit elf for target nprog       "wasm"           =  emit wasm module nprog
      emit elf for target nprog       _                =  emit x8664 elf nprog

fn :: emit so elf for target RNativeProg String           => [Int]
      emit so elf for target nprog       "x86_64-macos"   =  emit x8664 dylib macho64 nprog
      emit so elf for target nprog       "macos-x86_64"   =  emit x8664 dylib macho64 nprog
      emit so elf for target nprog       "macos"          =  emit x8664 dylib macho64 nprog
      emit so elf for target nprog       "darwin"         =  emit x8664 dylib macho64 nprog
      emit so elf for target nprog       "arm64-macos"    =  emit arm64 dylib macho64 nprog
      emit so elf for target nprog       "macos-arm64"    =  emit arm64 dylib macho64 nprog
      emit so elf for target nprog       "aarch64-macos"  =  emit arm64 dylib macho64 nprog
      emit so elf for target nprog       "apple-silicon"  =  emit arm64 dylib macho64 nprog
      emit so elf for target nprog       "x86_64-windows" =  emit x8664 dll pe64 nprog
      emit so elf for target nprog       "windows-x86_64" =  emit x8664 dll pe64 nprog
      emit so elf for target nprog       "windows"        =  emit x8664 dll pe64 nprog
      emit so elf for target nprog       "win64"          =  emit x8664 dll pe64 nprog
      emit so elf for target nprog       "pe64"           =  emit x8664 dll pe64 nprog
      emit so elf for target nprog       "arm64-windows"  =  emit arm64 dll pe64 nprog
      emit so elf for target nprog       "windows-arm64"  =  emit arm64 dll pe64 nprog
      emit so elf for target nprog       "aarch64-windows" = emit arm64 dll pe64 nprog
      emit so elf for target nprog       _                =  []

fn :: build native target for arch RNativeProg String String => Int
      build native target for arch nprog output_bin "x86_64" =
        build llvm x8664 executable nprog output_bin
      build native target for arch nprog output_bin "x86_64-linux" =
        build llvm x8664 executable nprog output_bin
      build native target for arch nprog output_bin "linux" =
        build llvm x8664 executable nprog output_bin
      build native target for arch nprog output_bin target_arch =
        emit elf for target nprog target_arch -> write elf64 executable output_bin _

-- Only the Mach-O and PE targets still emit a shared library here. A Linux
-- shared object was removed (ADR-0016): the ELF file had no dynamic section and
-- exported nothing a program could call.
fn :: build native so for arch RNativeProg String String => Int
      build native so for arch nprog output_so target_arch =
        write so bytes (emit so elf for target nprog target_arch) output_so target_arch

fn :: write so bytes [Int] String String => Int
      write so bytes [] _ target_arch =
        echo "[ridgunc build --so] Error: shared libraries for {target_arch} are not supported (ADR-0016); use a .ridgunlib"
        1
      write so bytes bytes output_so _ =
        write elf64 executable output_so bytes

fn :: build native target executable String String String => Int
      build native target executable input_path output_bin target_arch =
        t0 = timing now
        raw_src = load rg with libs input_path
        timing report "load source and imports" t0 timing now
        build native target loaded input_path output_bin target_arch raw_src

fn :: build native target loaded String String String String => Int
      build native target loaded input_path _ _ "" =
        echo "[ridgunc build] Error: empty or missing source file: {input_path}"
        1
      build native target loaded _ output_bin target_arch raw_src =
        t0 = timing now
        toks = tokenize src raw_src
        t1 = timing now
        prog = parse tokens toks
        t2 = timing now
        all_errs = typecheck program all prog
        t3 = timing now
        timing report "tokenize" t0 t1
        timing report "parse" t1 t2
        timing report "typecheck and analysis" t2 t3
        build native target after check prog output_bin target_arch (drop tensor infos all_errs []) (tensor infos of all_errs [])

fn :: build native target after check RProgram String String [RTypeError] [String] => Int
      build native target after check prog output_bin target_arch [] infos
        | (count fn defs prog) == 0 =
          echo "[ridgunc build] Error: no functions found in source"
          1
        | otherwise =
          t0 = timing now
          nprog = lower program to native prog infos
          timing report "lower to native code" t0 timing now
          build native target for arch nprog output_bin target_arch
      build native target after check _ _ _ errs _ =
        echo (format type errors errs)
        1

fn :: build native target so library String String String => Int
      build native target so library input_path output_so target_arch =
        input_path -> load rg with libs -> build native so loaded input_path output_so target_arch _

fn :: build native so loaded String String String String => Int
      build native so loaded input_path _ _ "" =
        echo "[ridgunc build --so] Error: empty or missing source file: {input_path}"
        1
      build native so loaded _ output_so target_arch raw_src =
        raw_src -> tokenize src -> parse tokens -> prog
        all_errs = typecheck program all prog
        build native so after check prog output_so target_arch (drop tensor infos all_errs []) (tensor infos of all_errs [])

fn :: build native so after check RProgram String String [RTypeError] [String] => Int
      build native so after check prog output_so target_arch [] infos
        | ((count fn defs prog) == 0) and ((count type defs prog) == 0) =
          echo "[ridgunc build --so] Error: no functions or types found in source"
          1
        | otherwise =
          build native so for arch (lower library to native prog infos) output_so target_arch
      build native so after check _ _ _ errs _ =
        echo (format type errors errs)
        1

fn :: build native so library String String => Int
      build native so library input_path output_so =
        build native target so library input_path output_so "x86_64-linux"

fn :: build native executable String     String     => Int
      build native executable input_path output_bin =
        build native target executable input_path output_bin "x86_64-linux"

fn :: build native fast executable String String => Int
      build native fast executable input_path output_bin =
        build native target executable input_path output_bin "x86_64-linux"

-- ── Tensor element reads ─────────────────────────────────────
-- `NIndex` leaves the raw element word in acc. For a `Real` tensor,
-- `lower expr` adds `NRealFromBits` after it (FR-COMP-020 §2).

fn :: lower tensor read RNativeEnv RExpr [RExpr] [String] Int RNativeCode => RNativeCode
      lower tensor read env (EVar v) idxs bound_locals sp st
        | (lookup local bound_locals v) >= 0 and ((list len idxs) == 1 or (list len idxs) == 2) =
          count = list len idxs
          vslot = env var slot env v
          st1 = lower expr list to slots env idxs bound_locals sp 0 st
          nc emit st1 (NIndex vslot sp (0 - count)) (sp + count + 1)
      lower tensor read env base idxs bound_locals sp st =
        count = list len idxs
        st1 = lower expr env base bound_locals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower expr list to slots env idxs bound_locals (sp + 1) 0 st2
        nc emit st3 (NIndex sp (sp + 1) count) (sp + count + 2)


-- ── Tensor element access by element kind (FR-COMP-020) ──────
-- The type checker reports the element kind of each tensor variable
-- (`tensor infos of` in typecheck.ridgun): "N" (Int), "R" (Real), "L" (lists),
-- "G" (any other type) or "U" (unknown). A tensor of "G" or "L" elements is a GenTensor,
-- stored as a List RVal (nested for two dimensions), so `echo`, `==` and
-- RMM (child cascade on drop) come from the runtime. "U" tensors are
-- checked at run time (`NIsList`). GenTensor accesses check bounds.

fn :: fn tensor elems [String] String [String] => [String]
      fn tensor elems [] _ acc =  acc
      fn tensor elems (i:is) key acc
        | str starts with i key = fn tensor elems is key ([str slice i (str len key) (str len i)] :: acc)
        | otherwise = fn tensor elems is key acc

fn :: env tensor kind RNativeEnv String => String
      env tensor kind (NativeEnv _ _ _ _ _ _ _ _ elems) v =  tensor kind lookup elems (v + "|") ""

fn :: tensor kind lookup [String] String String => String
      tensor kind lookup [] _ "" =  "U"
      tensor kind lookup [] _ found =  found
      tensor kind lookup (e:es) key found
        | str starts with e key = tensor kind lookup es key (merge tensor kind found (str slice e (str len key) (str len e)))
        | otherwise = tensor kind lookup es key found

fn :: merge tensor kind String String => String
      merge tensor kind "" k =  k
      merge tensor kind a b
        | a == b = a
        | otherwise = "U"

-- ── Packed byte tensors (FR-COMP-022) ─────────────────────────
-- A `Tensor[U8]` (kind "B") is handled by the shared runtime extension
-- (builtins 104-111, `docs/etc/runtime_ext.md`). The type checker makes
-- sure that every packed tensor that is read, shown, hashed or turned
-- into a list is one of the expressions below.
fn :: is u8 elem name String => Bool
      is u8 elem name s =  s == "U8" or s == "Byte"

fn :: expr tensor kind RNativeEnv RExpr => String
      expr tensor kind env (EVar v) =  env tensor kind env v
      expr tensor kind _ (ECall ":typed-tensor:" ((EStr ty):_))
        | is u8 elem name ty = "B"
      expr tensor kind env (ECall ":tensor-clone:" (b:_)) =  expr tensor kind env b
      expr tensor kind env (ECall f _)
        | not (str starts with f ":") = env tensor kind env ("()" + f)
      expr tensor kind _ _ =  "U"

-- `t_(i ...)` on a `Tensor[U8]`: builtin 105 with slots [i ..., t]; t is
-- borrowed (`NPeekSlot`), a temporary base is dropped after the read.
fn :: lower u8 read RNativeEnv RExpr [RExpr] [String] Int RNativeCode => RNativeCode
      lower u8 read env (EVar v) idxs bound_locals sp st
        | (lookup local bound_locals v) >= 0 =
          k = list len idxs
          st1 = lower expr list to slots env idxs bound_locals sp 0 st
          nc emit list st1 [NPeekSlot (env var slot env v), NStoreSlot (sp + k), NCallBuiltin 105 sp (k + 1)] (sp + k + 1)
      lower u8 read env base idxs bound_locals sp st =
        k = list len idxs
        st1 = lower expr env base bound_locals sp st
        st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
        st3 = lower expr list to slots env idxs bound_locals (sp + 1) 0 st2
        nc emit list st3 [NPeekSlot sp, NStoreSlot (sp + k + 1), NCallBuiltin 105 (sp + 1) (k + 1), NStoreSlot (sp + k + 2), NCmmDropSlot sp, NMoveSlot (sp + k + 2)] (sp + k + 3)

fn :: env is real tensor RNativeEnv String => Bool
      env is real tensor env v =  (env tensor kind env v) == "R"

-- ── Tensors in messages (FR-COMP-020) ─────────────────────────
-- A tensor sent to an agent or a channel, or given as an agent's initial
-- state, is copied. The type checker marks the tensor variables and the
-- calls returning a tensor in each message (`:tensor-elem:` facts); this
-- wraps them in `:msg-copy:`, also inside a tuple.

fn :: tensor fact found [String] String => Bool
      tensor fact found [] _ =  False
      tensor fact found (e:es) key
        | str starts with e key = True
        | otherwise = tensor fact found es key

fn :: env has tensor fact RNativeEnv String => Bool
      env has tensor fact (NativeEnv _ _ _ _ _ _ _ _ elems) v =  tensor fact found elems (v + "|")

fn :: msg copy expr RNativeEnv RExpr => RExpr
      msg copy expr env (EVar v)
        | env has tensor fact env v = ECall ":msg-copy:" [EVar v]
      msg copy expr env (ETuple es) =  ETuple (msg copy expr list env es)
      msg copy expr env (ECall f args)
        | (not (str starts with f ":")) and (env has tensor fact env ("()" + f)) = ECall ":msg-copy:" [ECall f args]
      msg copy expr _ e =  e

fn :: msg copy expr list RNativeEnv [RExpr] => [RExpr]
      msg copy expr list _ [] =  []
      msg copy expr list env (e:es) =  [msg copy expr env e] :: (msg copy expr list env es)

fn :: msg needs copy RNativeEnv RExpr => Bool
      msg needs copy env (EVar v) =  env has tensor fact env v
      msg needs copy env (ETuple es) =  msg list needs copy env es
      msg needs copy env (ECall f _) =  (not (str starts with f ":")) and (env has tensor fact env ("()" + f))
      msg needs copy _ _ =  False

fn :: msg list needs copy RNativeEnv [RExpr] => Bool
      msg list needs copy _ [] =  False
      msg list needs copy env (e:es)
        | msg needs copy env e = True
        | otherwise = msg list needs copy env es

-- The value goes to slot sp. A list (a GenTensor) is copied by
-- `__rg_gt_copy_any` (rows too); a numeric tensor (heap tag 5) by the
-- same element-wise copy as `t_`; any other value passes unchanged.
fn :: lower msg copy RNativeEnv RExpr [String] Int RNativeCode => RNativeCode
      lower msg copy env e bound_locals sp st =
        num_lbl = nc lbl st
        pass_lbl = num_lbl + 1
        end_lbl = num_lbl + 2
        st0 = nc set lbl st (num_lbl + 3)
        st1 = lower expr env e bound_locals sp st0
        ins = [NStoreSlot sp, NIsList sp, NAsBool, NJumpIfZero num_lbl, NCallFn (env fn id env "__rg_gt_copy_any") sp 1, NJump end_lbl, NLabel num_lbl, NMatchAdt sp 0 0 (0 - 5), NJumpIfZero pass_lbl, NCloneSlot sp, NStoreSlot (sp + 1), NLoadImmInt 12, NStoreSlot (sp + 2), NCallBuiltin 90 sp 3, NJump end_lbl, NLabel pass_lbl, NMoveSlot sp, NLabel end_lbl]
        nc emit list st1 ins (sp + 3)

fn :: gen tensor oob msg => String
      gen tensor oob msg =  "runtime error: tensor index out of range\n"

-- `v_(i ...)`, `v` a variable.
fn :: lower var index read RNativeEnv String [RExpr] [String] Int RNativeCode => RNativeCode
      lower var index read env v idxs bound_locals sp st
        | (env tensor kind env v) == "B" = lower u8 read env (EVar v) idxs bound_locals sp st
        | (env tensor kind env v) == "R" =
          st1 = lower tensor read env (EVar v) idxs bound_locals sp st
          nc emit st1 NRealFromBits sp
        | (env tensor kind env v) == "N" = lower tensor read env (EVar v) idxs bound_locals sp st
        | (lookup local bound_locals v) >= 0 and ((list len idxs) == 1 or (list len idxs) == 2) =
          count = list len idxs
          st1 = lower expr list to slots env idxs bound_locals sp 0 st
          lower slot index read env (env tensor kind env v) (env var slot env v) sp count st1
        | otherwise = lower base index read env (EVar v) idxs bound_locals sp st

-- `base_(i ...)`, `base` any expression: it is evaluated into slot sp.
fn :: lower base index read RNativeEnv RExpr [RExpr] [String] Int RNativeCode => RNativeCode
      lower base index read env base idxs bound_locals sp st
        | (expr tensor kind env base) == "B" = lower u8 read env base idxs bound_locals sp st
        | (list len idxs) == 1 or (list len idxs) == 2 =
          count = list len idxs
          st1 = lower expr env base bound_locals sp st
          st2 = nc emit st1 (NStoreSlot sp) (sp + 1)
          st3 = lower expr list to slots env idxs bound_locals (sp + 1) 0 st2
          st4 = lower slot index read env "U" sp (sp + 1) count st3
          nc emit list st4 [NStoreSlot (sp + count + 1), NCmmDropSlot sp, NMoveSlot (sp + count + 1)] (sp + count + 2)
        | otherwise = lower tensor read env base idxs bound_locals sp st

-- The base is in slot b (borrowed), the indices in slots i0 and i0 + 1.
fn :: lower slot index read RNativeEnv String Int Int Int RNativeCode => RNativeCode
      lower slot index read env "G" b i0 count st =  lower gen read env b i0 count st
      lower slot index read env "L" b i0 count st =  lower gen read env b i0 count st
      lower slot index read env _ b i0 count st =
        num_lbl = nc lbl st
        end_lbl = num_lbl + 1
        st0 = nc set lbl st (num_lbl + 2)
        st1 = nc emit list st0 [NIsList b, NAsBool, NJumpIfZero num_lbl] (i0 + count)
        st2 = lower gen read env b i0 count st1
        nc emit list st2 [NJump end_lbl, NLabel num_lbl, NIndex b i0 (0 - count), NLabel end_lbl] (i0 + count + 1)

fn :: lower gen read RNativeEnv Int Int Int RNativeCode => RNativeCode
      lower gen read env b i0 1 st =  nc emit st (NListGet b i0) (i0 + 2)
      lower gen read env b i0 _ st =
        row = i0 + 2
        nc emit list st [NListGet b i0, NStoreSlot row, NListGet row (i0 + 1), NStoreSlot (i0 + 3), NCmmDropSlot row, NMoveSlot (i0 + 3)] (i0 + 4)

-- Stop with a runtime error unless 0 <= slot is < length of the List in
-- slot b (FR-COMP-020 §8). Slot t is a scratch slot.
fn :: lower gen bounds RNativeEnv Int Int Int RNativeCode => RNativeCode
      lower gen bounds env b is t st =  lower dim bounds env b (0 - 1) is t st

-- The same check against `NAdtField b field`: `-1` is the length of a List,
-- `-10 - k` dimension k of a numeric tensor (row and column slices).
fn :: lower dim bounds RNativeEnv Int Int Int Int RNativeCode => RNativeCode
      lower dim bounds env b field is t st =
        oob_lbl = nc lbl st
        ok_lbl = oob_lbl + 1
        st0 = nc set lbl st (oob_lbl + 2)
        st1 = nc emit list st0 [NCloneSlot is, NStoreSlot t, NAdtField b field, NBinOp (binop id OpLt) t, NAsBool, NJumpIfZero oob_lbl, NCloneSlot is, NStoreSlot t, NLoadImmInt 0, NBinOp (binop id OpGtEq) t, NAsBool, NJumpIfZero oob_lbl, NJump ok_lbl, NLabel oob_lbl] (t + 1)
        st2 = lower expr env (ECall "sys_write_fd" [EInt 2, EStr (gen tensor oob msg)]) [] (t + 1) st1
        st3 = nc emit st2 NDropVal (t + 2)
        st4 = lower expr env (ECall "sys_exit" [EInt 1]) [] (t + 1) st3
        nc emit st4 (NLabel ok_lbl) (t + 1)

-- ── `@` on Real tensors (libs report 2026-11-07, 2026-11-08) ──
-- The runtime contraction multiplies Int words, so on `Tensor[Real]`
-- operands it multiplied f64 bits. When every operand is a `Tensor[Real]`
-- variable, `@` lowers to loops instead, with the runtime's rules: a letter
-- in more than one operand is summed, a letter in one operand stays in the
-- result, in order of first appearance; summing every letter gives a
-- tensor of shape [1]. `NEinsumReal` first tries a native contraction of two
-- rank-2 operands (LLVM `@__rg_fast_einsum_real`); acc 0 means it did not
-- apply and the loops run. Slots from sp: the n operands, a dimension and an
-- index slot per letter, then r (result), r + 1 (sum), r + 2 (product),
-- r + 3 (base copy), r + 4 ... (index arguments), r + 12 (scratch).
fn :: all real operands RNativeEnv [RExpr] => Bool
      all real operands _ [] =  True
      all real operands env ((EVar v):es)
        | (env tensor kind env v) == "R" = all real operands env es
        | otherwise = False
      all real operands _ _ =  False

fn :: ein uniq [String] String => String
      ein uniq [] acc =  acc
      ein uniq (s:ss) acc =  ein uniq ss (ein uniq str s 0 acc)

fn :: ein uniq str String Int String => String
      ein uniq str s i acc
        | i >= (str len s) = acc
        | str contains acc (str slice s i (i + 1)) = ein uniq str s (i + 1) acc
        | otherwise = ein uniq str s (i + 1) (acc + (str slice s i (i + 1)))

fn :: ein occurs [String] String Int => Int
      ein occurs [] _ k =  k
      ein occurs (s:ss) l k
        | str contains s l = ein occurs ss l (k + 1)
        | otherwise = ein occurs ss l k

-- The letters of lets that stay in the result (want True) or are summed.
fn :: ein pick String [String] Bool Int String => String
      ein pick lets subs want i acc
        | i >= (str len lets) = acc
        | want and (ein occurs subs (str slice lets i (i + 1)) 0) == 1 = ein pick lets subs want (i + 1) (acc + (str slice lets i (i + 1)))
        | (not want) and (ein occurs subs (str slice lets i (i + 1)) 0) > 1 = ein pick lets subs want (i + 1) (acc + (str slice lets i (i + 1)))
        | otherwise = ein pick lets subs want (i + 1) acc

fn :: ein pos String String Int => Int
      ein pos s l i
        | i >= (str len s) = 0 - 1
        | (str slice s i (i + 1)) == l = i
        | otherwise = ein pos s l (i + 1)

fn :: ein src op [String] String Int => Int
      ein src op [] _ _ =  0
      ein src op (s:ss) l k
        | str contains s l = k
        | otherwise = ein src op ss l (k + 1)

fn :: ein dslot Int Int String String => Int
      ein dslot sp n lets l =  sp + n + (ein pos lets l 0)

fn :: ein islot Int Int String String => Int
      ein islot sp n lets l =  sp + n + (str len lets) + (ein pos lets l 0)

fn :: lower real einsum RNativeEnv [RExpr] [String] [String] Int RNativeCode => RNativeCode
      lower real einsum env es subs bound_locals sp st =
        n = list len es
        lets = ein uniq subs ""
        outs = ein pick lets subs True 0 ""
        sums = ein pick lets subs False 0 ""
        r = sp + n + 2 * (str len lets)
        spec = str join subs ","
        st0 = lower expr list to slots env es bound_locals sp 0 st
        fast = nc lbl st0
        st1 = nc emit list (nc set lbl st0 (fast + 2)) [NEinsumReal sp n (env str off env spec) (str len spec), NJumpIfNonZero fast] (r + 14)
        st2 = nc emit list st1 (ein dim ins subs sp n lets 0) (r + 14)
        st3 = nc emit list st2 (ein result ins sp n lets outs r) (r + 14)
        st4 = ein out loops subs sp n lets outs sums outs r st3
        nc emit list st4 ((ein drop ops sp n 0) :: [NMoveSlot r, NJump (fast + 1), NLabel fast, NLabel (fast + 1)]) (r + 14)

fn :: ein dim ins [String] Int Int String Int => [RNativeInstr]
      ein dim ins subs sp n lets i
        | i >= (str len lets) = []
        | otherwise =
          l = str slice lets i (i + 1)
          k = ein src op subs l 0
          p = ein pos (list nth or subs k "") l 0
          [NAdtField (sp + k) (0 - 10 - p), NStoreSlot (sp + n + i)] :: (ein dim ins subs sp n lets (i + 1))

-- The zero result tensor: `NGtConv` mode 4 on [0, d1, ..., dn].
fn :: ein result ins Int Int String String Int => [RNativeInstr]
      ein result ins sp n lets outs r
        | (str len outs) == 0 = [NLoadImmInt 0, NStoreSlot (r + 3), NLoadImmInt 1, NStoreSlot (r + 4), NMakeList (r + 3) 2, NStoreSlot (r + 12), NGtConv (r + 12) 4, NStoreSlot r, NCmmDropSlot (r + 12)]
        | otherwise = [NLoadImmInt 0, NStoreSlot (r + 3)] :: (ein dim copies sp n lets outs 0 (r + 4)) :: [NMakeList (r + 3) ((str len outs) + 1), NStoreSlot (r + 12), NGtConv (r + 12) 4, NStoreSlot r, NCmmDropSlot (r + 12)]

fn :: ein dim copies Int Int String String Int Int => [RNativeInstr]
      ein dim copies sp n lets ls j dst
        | j >= (str len ls) = []
        | otherwise = [NCloneSlot (ein dslot sp n lets (str slice ls j (j + 1))), NStoreSlot (dst + j)] :: (ein dim copies sp n lets ls (j + 1) dst)

fn :: ein idx ins String Int Int String Int Int => [RNativeInstr]
      ein idx ins ls sp n lets j dst
        | j >= (str len ls) = []
        | otherwise = [NCloneSlot (ein islot sp n lets (str slice ls j (j + 1))), NStoreSlot (dst + j)] :: (ein idx ins ls sp n lets (j + 1) dst)

fn :: ein loop head Int Int String String Int Int => [RNativeInstr]
      ein loop head sp n lets l top r =
        i = ein islot sp n lets l
        [NLoadImmInt 0, NStoreSlot i, NLabel top, NCloneSlot i, NStoreSlot (r + 12), NCloneSlot (ein dslot sp n lets l), NBinOp (binop id OpLt) (r + 12), NAsBool, NJumpIfZero (top + 1)]

fn :: ein loop tail Int Int String String Int Int => [RNativeInstr]
      ein loop tail sp n lets l top r =
        i = ein islot sp n lets l
        [NCloneSlot i, NStoreSlot (r + 12), NLoadImmInt 1, NBinOp (binop id OpAdd) (r + 12), NStoreSlot i, NJump top, NLabel (top + 1)]

fn :: ein out loops [String] Int Int String String String String Int RNativeCode => RNativeCode
      ein out loops subs sp n lets outs sums rest r st
        | (str len rest) == 0 =
          st1 = nc emit list st [NLoadImmInt 0, NRealFromBits, NStoreSlot (r + 1)] (r + 14)
          st2 = ein sum loops subs sp n lets sums r st1
          nc emit list st2 (ein store ins sp n lets outs r) (r + 14)
        | otherwise =
          l = str slice rest 0 1
          top = nc lbl st
          st0 = nc set lbl st (top + 2)
          st1 = nc emit list st0 (ein loop head sp n lets l top r) (r + 14)
          st2 = ein out loops subs sp n lets outs sums (str slice rest 1 (str len rest)) r st1
          nc emit list st2 (ein loop tail sp n lets l top r) (r + 14)

fn :: ein sum loops [String] Int Int String String Int RNativeCode => RNativeCode
      ein sum loops subs sp n lets rest r st
        | (str len rest) == 0 = nc emit list st (ein product ins subs sp n lets r 0) (r + 14)
        | otherwise =
          l = str slice rest 0 1
          top = nc lbl st
          st0 = nc set lbl st (top + 2)
          st1 = nc emit list st0 (ein loop head sp n lets l top r) (r + 14)
          st2 = ein sum loops subs sp n lets (str slice rest 1 (str len rest)) r st1
          nc emit list st2 (ein loop tail sp n lets l top r) (r + 14)

-- Multiply the operand elements at the current indices into r + 2, then
-- add that product to the sum in r + 1.
fn :: ein product ins [String] Int Int String Int Int => [RNativeInstr]
      ein product ins [] _ _ _ r _ =  [NMoveSlot (r + 2), NBinOp (binop id OpAdd) (r + 1), NStoreSlot (r + 1)]
      ein product ins (s:ss) sp n lets r k
        | k == 0 = (ein read ins s sp n lets r k) :: [NStoreSlot (r + 2)] :: (ein product ins ss sp n lets r (k + 1))
        | otherwise = (ein read ins s sp n lets r k) :: [NBinOp (binop id OpMul) (r + 2), NStoreSlot (r + 2)] :: (ein product ins ss sp n lets r (k + 1))

fn :: ein read ins String Int Int String Int Int => [RNativeInstr]
      ein read ins s sp n lets r k
        | (str len s) <= 2 = (ein idx ins s sp n lets 0 (r + 4)) :: [NIndex (sp + k) (r + 4) (0 - (str len s)), NRealFromBits]
        | otherwise = [NCloneSlot (sp + k), NStoreSlot (r + 3)] :: (ein idx ins s sp n lets 0 (r + 4)) :: [NIndex (r + 3) (r + 4) (str len s), NRealFromBits]

fn :: ein store ins Int Int String String Int => [RNativeInstr]
      ein store ins sp n lets outs r
        | (str len outs) == 0 = [NLoadImmInt 0, NStoreSlot (r + 4), NMoveSlot (r + 1), NIndexSet r (r + 4) 1, NStoreSlot r]
        | otherwise = (ein idx ins outs sp n lets 0 (r + 4)) :: [NMoveSlot (r + 1), NIndexSet r (r + 4) (str len outs), NStoreSlot r]

fn :: ein drop ops Int Int Int => [RNativeInstr]
      ein drop ops sp n k
        | k >= n = []
        | otherwise = [NCmmDropSlot (sp + k)] :: (ein drop ops sp n (k + 1))

-- `t_(i ...) = v`: the value is in acc, the indices in slots sp ...
-- A `Tensor[Int]` or `Tensor[Real]` (kind "N" / "R") may hold a List at run
-- time when a generic function made it (`Tensor[V * n] with v`), so with one
-- or two indices it checks like the reads do (libs report 2026-11-08).
-- Only a program that creates such a tensor (`__rg_gt_poly` is reachable)
-- pays for the check; elsewhere `Tensor[Int]` and `Tensor[Real]` are numeric.
fn :: is poly elem name String => Bool
      is poly elem name s =  (str len s) == 1 and (str char at s 0) >= 65 and (str char at s 0) <= 90

fn :: emit tensor store RNativeEnv String Int Int Int RNativeCode => RNativeCode
      emit tensor store env t tslot sp count st
        | (env tensor kind env t) == "B" =
          nc emit list st [NStoreSlot (sp + count), NPeekSlot tslot, NStoreSlot (sp + count + 1), NCallBuiltin 106 sp (count + 2)] (sp + count + 2)
        | count > 2 or (((env tensor kind env t) == "N" or (env tensor kind env t) == "R") and (env fn arity env "__rg_gt_poly") != 1) =
          nc emit list st [NIndexSet tslot sp count, NStoreSlot tslot] (sp + count + 1)
        | (env tensor kind env t) == "G" or (env tensor kind env t) == "L" =
          st1 = nc emit st (NStoreSlot (sp + count)) (sp + count + 1)
          lower gen write env tslot sp count (sp + count) st1
        | otherwise =
          vs = sp + count
          num_lbl = nc lbl st
          end_lbl = num_lbl + 1
          st0 = nc set lbl st (num_lbl + 2)
          st1 = nc emit list st0 [NStoreSlot vs, NIsList tslot, NAsBool, NJumpIfZero num_lbl] (vs + 1)
          st2 = lower gen write env tslot sp count vs st1
          nc emit list st2 [NJump end_lbl, NLabel num_lbl, NMoveSlot vs, NIndexSet tslot sp count, NStoreSlot tslot, NLabel end_lbl] (vs + 1)

-- The value is in slot vs, the List in tslot (borrowed).
fn :: lower gen write RNativeEnv Int Int Int Int RNativeCode => RNativeCode
      lower gen write env tslot sp 1 vs st =
        st1 = lower gen bounds env tslot sp (vs + 1) st
        nc emit list st1 [NMoveSlot vs, NListSet tslot sp] (vs + 2)
      lower gen write env tslot sp _ vs st =
        row = vs + 1
        st1 = lower gen bounds env tslot sp (vs + 2) st
        st2 = nc emit list st1 [NIndex tslot sp (0 - 1), NStoreSlot row] (vs + 2)
        st3 = lower gen bounds env row (sp + 1) (vs + 2) st2
        nc emit list st3 [NMoveSlot vs, NListSet row (sp + 1), NCmmDropSlot row] (vs + 3)

-- ── GenTensor helper functions (FR-COMP-020) ──────────────────
-- Added to every program like the `str_to_int` helper. The `__rg_gt_is_gen`,
-- `__rg_gt_is_list`, `__rg_gt_len`, `__rg_gt_tlen`, `__rg_gt_real_bits`,
-- `__rg_gt_list_copy`, `__rg_gt_list_tensor`, `__rg_gt_tensor_ints`,
-- `__rg_gt_tensor_reals`
-- stubs give the parser their arity; `lower expr`
-- replaces calls to them with native instructions.

fn :: gt helper src stubs => String
      gt helper src stubs =  "fn :: __rg_gt_is_gen A => Bool\n      __rg_gt_is_gen v =  False\nfn :: __rg_gt_is_list A => Bool\n      __rg_gt_is_list v =  False\nfn :: __rg_gt_len A => Int\n      __rg_gt_len v =  0\nfn :: __rg_gt_tlen A => Int\n      __rg_gt_tlen v =  0\nfn :: __rg_gt_real_bits A => Real\n      __rg_gt_real_bits v =  0.0\nfn :: __rg_gt_list_copy A => A\n      __rg_gt_list_copy v =  v\nfn :: __rg_gt_list_tensor A => T\n      __rg_gt_list_tensor v =  v\nfn :: __rg_gt_tensor_ints T => [Int]\n      __rg_gt_tensor_ints v =  []\nfn :: __rg_gt_tensor_reals T => [Real]\n      __rg_gt_tensor_reals v =  []\nfn :: __rg_gt_repeat A Int => [A]\n      __rg_gt_repeat v n =  []\nfn :: __rg_gt_poly Int => Int\n      __rg_gt_poly n =  n\n"

fn :: gt helper src alloc => String
      gt helper src alloc =  "fn :: __rg_gt_new1 A Int => [A]\n      __rg_gt_new1 v n =  __rg_gt_repeat v n\nfn :: __rg_gt_rows A Int Int [[A]] => [[A]]\n      __rg_gt_rows v c r acc\n        | r <= 0 = acc\n        | otherwise = __rg_gt_rows v c (r - 1) (acc :: [(__rg_gt_new1 v c)])\nfn :: __rg_gt_new2 A Int Int => [[A]]\n      __rg_gt_new2 v r c =  __rg_gt_rows v c r []\nfn :: __rg_gt_shape [A] Int Int => Int\n      __rg_gt_shape xs k flag\n        | k == 1 = __rg_gt_len xs\n        | (__rg_gt_len xs) == 0 = __rg_gt_shape_pick k 1 0\n        | otherwise = __rg_gt_shape_pick k (__rg_gt_rank_of xs_(0) flag) (__rg_gt_row_len xs_(0))\nfn :: __rg_gt_row_len A => Int\n      __rg_gt_row_len h\n        | __rg_gt_is_list h = __rg_gt_len h\n        | otherwise = 0\nfn :: __rg_gt_rank_of A Int => Int\n      __rg_gt_rank_of h flag\n        | not (__rg_gt_is_list h) = 1\n        | flag == 0 = 2\n        | (__rg_gt_len h) == 0 = 1\n        | otherwise = __rg_gt_rank_inner h_(0)\nfn :: __rg_gt_rank_inner A => Int\n      __rg_gt_rank_inner e\n        | __rg_gt_is_list e = 2\n        | otherwise = 1\nfn :: __rg_gt_shape_pick Int Int Int => Int\n      __rg_gt_shape_pick 0 rank _ =  rank\n      __rg_gt_shape_pick _ 1 _ =  0\n      __rg_gt_shape_pick _ _ rowlen =  rowlen\n"

fn :: gt helper src lists => String
      gt helper src lists =  "fn :: __rg_gt_copy [A] => [A]\n      __rg_gt_copy xs =  __rg_gt_list_copy xs\nfn :: __rg_gt_deep_copy [[A]] Int Int [[A]] => [[A]]\n      __rg_gt_deep_copy xs i n acc\n        | i >= n = acc\n        | otherwise = __rg_gt_deep_copy xs (i + 1) n (acc :: [(__rg_gt_copy xs_(i))])\nfn :: __rg_gt_copy_any [A] => [A]\n      __rg_gt_copy_any xs\n        | (__rg_gt_len xs) == 0 = []\n        | otherwise = __rg_gt_copy_first xs xs_(0)\nfn :: __rg_gt_copy_first [A] A => [A]\n      __rg_gt_copy_first xs h\n        | __rg_gt_is_list h = __rg_gt_deep_copy xs 0 (__rg_gt_len xs) []\n        | otherwise = __rg_gt_copy xs\nfn :: __rg_gt_from_list [A] => [A]\n      __rg_gt_from_list xs\n        | (__rg_gt_len xs) == 0 = []\n        | otherwise = __rg_gt_from_first xs xs_(0)\nfn :: __rg_gt_from_first [A] A => [A]\n      __rg_gt_from_first xs h\n        | __rg_gt_is_gen h = __rg_gt_copy xs\n        | otherwise = __rg_gt_list_tensor xs\nfn :: __rg_gt_to_list T => [A]\n      __rg_gt_to_list t\n        | __rg_gt_is_list t = __rg_gt_copy_any t\n        | otherwise = __rg_gt_tensor_ints t\nfn :: __rg_gt_to_list_real T => [Real]\n      __rg_gt_to_list_real t =  __rg_gt_tensor_reals t\n"

fn :: gt helper fndefs => [RFnDef]
      gt helper fndefs =  fndefs of program (parse tokens (tokenize src ((gt helper src stubs) + (gt helper src alloc) + (gt helper src lists) + (gt helper src show))))

-- `echo t` and `"{t}"` on a numeric tensor: the runtime text keeps the
-- shape part (`Tensor(shape=[2, 3]`), and the data part is the list of
-- elements with their type (`[1, 2]`, `[1.5, 2.5]`).
fn :: gt helper src show => String
      gt helper src show =  "fn :: __rg_tensor_show_real T => String\n      __rg_tensor_show_real t =\n        xs = __rg_gt_tensor_reals t\n        __rg_tensor_show_join \"{{t}}\" \"{{xs}}\"\nfn :: __rg_tensor_show_int T => String\n      __rg_tensor_show_int t =\n        xs = __rg_gt_tensor_ints t\n        __rg_tensor_show_join \"{{t}}\" \"{{xs}}\"\nfn :: __rg_tensor_show_join String String => String\n      __rg_tensor_show_join s data =  (str_slice s 0 (__rg_tensor_shape_end s 0 (str_len s))) + \", data=\" + data + \")\"\nfn :: __rg_tensor_shape_end String Int Int => Int\n      __rg_tensor_shape_end s i n\n        | i >= n = n\n        | (str_char_at s i) == 93 = i + 1\n        | otherwise = __rg_tensor_shape_end s (i + 1) n\n"

-- A tensor stores raw 64-bit words. A `Real` element of a tensor literal
-- is stored as its bits (`NRealToBits`); an `Int` passes unchanged.
fn :: real bits leaves [RExpr] => [RExpr]
      real bits leaves es =  map (e => real bits leaf e) es

fn :: real bits leaf RExpr => RExpr
      real bits leaf (EInt n) =  EInt n
      real bits leaf (EList es) =  EList (real bits leaves es)
      real bits leaf (ETensor es) =  ETensor es
      real bits leaf e =  ECall ":real-bits:" [e]

-- `sort by ints xs keys` (mode 0) and `sort by texts xs keys` (mode 1),
-- FR-COMP-021: the lists go to slots sp and sp + 1 (borrowed by
-- `NSortBy`), the sorted list to acc; then both slots are dropped.
fn :: lower sort by RNativeEnv Int RExpr RExpr [String] Int RNativeCode => RNativeCode
      lower sort by env mode xs ks bound_locals sp st =
        st1 = lower expr list to slots env [xs, ks] bound_locals sp 0 st
        nc emit list st1 [NSortBy sp mode, NStoreSlot (sp + 2), NCmmDropSlot sp, NCmmDropSlot (sp + 1), NMoveSlot (sp + 2)] (sp + 3)

fn :: tensor show roots [String] => [String]
      tensor show roots [] =  []
      tensor show roots (i:is)
        | str contains i "|:show|" = ["__rg_tensor_show_real", "__rg_tensor_show_int"]
        | otherwise = tensor show roots is

-- Wraps a shown numeric tensor in its show helper. Only when the helper
-- was kept (a library without GenTensor helpers keeps the runtime text).
fn :: show tensor expr list RNativeEnv [RExpr] => [RExpr]
      show tensor expr list _ [] =  []
      show tensor expr list env (e:es) =  [show tensor expr env e] :: (show tensor expr list env es)

fn :: show tensor expr RNativeEnv RExpr => RExpr
      show tensor expr env e
        | (env fn arity env "__rg_tensor_show_real") != 1 = e
        | otherwise = show tensor wrap (show tensor kind env e) e

fn :: show tensor kind RNativeEnv RExpr => String
      show tensor kind env (EVar v) =  env tensor kind env v
      show tensor kind env (ECall ":typed-tensor:" args) =  expr tensor kind env (ECall ":typed-tensor:" args)
      show tensor kind env (ECall ":tensor-clone:" (b:_)) =  show tensor kind env b
      show tensor kind env (ECall ":tensor-row-slice:" (b:_)) =  show tensor kind env b
      show tensor kind env (ECall ":tensor-col-slice:" (b:_)) =  show tensor kind env b
      show tensor kind _ (ETensor es) =  literal show kind es ""
      show tensor kind env (EEinsum (e:_) _) =  show tensor kind env e
      show tensor kind env (ECall f _)
        | not (str starts with f ":") = env tensor kind env ("()" + f)
      show tensor kind _ _ =  "U"

-- A literal written in `echo`: "N" when every leaf is an Int literal,
-- "R" when every leaf is a Real literal, "U" otherwise.
fn :: literal show kind [RExpr] String => String
      literal show kind [] k
        | k == "" = "U"
        | otherwise = k
      literal show kind ((EList xs):es) k =  literal show kind es (literal show kind xs k)
      literal show kind ((EInt _):es) k =  literal show kind es (merge tensor kind k "N")
      literal show kind ((EReal _):es) k =  literal show kind es (merge tensor kind k "R")
      literal show kind _ _ =  "U"

fn :: show tensor wrap String RExpr => RExpr
      show tensor wrap "R" e =  ECall "__rg_tensor_show_real" [e]
      show tensor wrap "N" e =  ECall "__rg_tensor_show_int" [e]
      show tensor wrap "B" e =  ECall "__rg_tensor_show_int" [ECall ":u8-words:" [e]]
      show tensor wrap _ e =  e

fn :: with gt helpers [RFnDef] => [RFnDef]
      with gt helpers fns
        | has fndef named fns "__rg_gt_new1" = fns
        | otherwise = fns :: (gt helper fndefs)

fn :: lib with gt helpers [RFnDef] => [RFnDef]
      lib with gt helpers fns
        | fndefs call gt fns = with gt helpers fns
        | otherwise = fns

fn :: gt trigger names => [String]
      gt trigger names =  [":gt-new:", "tensor_from_list", "tensor_to_list"] :: msg send names

fn :: fndefs call gt [RFnDef] => Bool
      fndefs call gt [] =  False
      fndefs call gt ((FnDef _ _ _ cases):fs)
        | any str in list (gt trigger names) (collect refs cases cases []) = True
        | otherwise = fndefs call gt fs

fn :: any str in list [String] [String] => Bool
      any str in list [] _ =  False
      any str in list (x:xs) ys =  (list contains ys x) or (any str in list xs ys)

fn :: add gt refs RFnRefsMap => RFnRefsMap
      add gt refs mp =
        m1 = fn refs map insert mp ":gt-new:" ["__rg_gt_new1", "__rg_gt_new2", "__rg_gt_shape"]
        m2 = m1
        m3 = fn refs map insert m2 "tensor_from_list" ["__rg_gt_from_list", "__rg_gt_shape"]
        m4 = add msg copy refs m3 msg send names
        fn refs map insert m4 "tensor_to_list" ["__rg_gt_to_list", "__rg_gt_to_list_real"]

-- Sends copy GenTensors with `__rg_gt_copy_any` (`lower msg copy`).
fn :: msg send names => [String]
      msg send names =  ["send_to", "ask_to", "send_through", "chan_send", "agent", "agent_sink"]

fn :: add msg copy refs RFnRefsMap [String] => RFnRefsMap
      add msg copy refs mp [] =  mp
      add msg copy refs mp (n:ns) =  add msg copy refs (fn refs map insert mp n ["__rg_gt_copy_any"]) ns
