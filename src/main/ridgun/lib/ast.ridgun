-- ============================================================
-- src/main/ridgun/ast.ridgun
-- Token, AST, Type System, Analyzer, and Bytecode ADTs
-- for the Self-Hosted Ridgun Compiler (100% v0.9.0 Spec)
-- ============================================================

-- 1. Lexical Tokens produced by lexer.ridgun
-- TokBadInt holds the source text of an integer literal outside the Int range.
-- TokIntMin holds the text of the decimal literal 9223372036854775808, which is
-- valid only after a unary minus (-9223372036854775808 is the Int minimum).
type RToken = TokFn | TokOp | TokType | TokImport | TokWith | TokDo | TokHardware | TokOtherwise | TokMut | TokTrue | TokFalse | TokAnd | TokOr | TokXor | TokNot | TokIdent String | TokInt Int | TokReal String | TokStr String | TokRawStr String | TokColonColon | TokColon | TokFatArrow | TokArrow | TokEquals | TokEqEq | TokNeq | TokGt | TokLt | TokGtEq | TokLtEq | TokPlus | TokMinus | TokStar | TokSlash | TokPercent | TokAt | TokPipe | TokPipeDot | TokDoublePipe | TokDoublePipeDot | TokLParen | TokRParen | TokLBracket | TokIdxLBracket | TokRBracket | TokComma | TokEllipsis | TokNewline | TokEof | TokBadInt String | TokIntMin String

-- 2. Patterns in Function & Operator Cases
type RPattern = PatInt Int | PatReal String | PatStr String | PatBool Bool | PatVar String | PatWild | PatEmpty | PatCons RPattern RPattern | PatTuple [RPattern] | PatCtor String [RPattern] | PatSeqBind String

-- 3. Binary Operators
-- @implements FR-COMP-010
type RBinOp = OpAdd | OpSub | OpMul | OpDiv | OpMod | OpEq | OpNeq | OpGt | OpLt | OpGtEq | OpLtEq | OpAnd | OpOr | OpXor | OpConcat | OpFlatJoin | OpMatMul | OpShl | OpShr | OpRotr | OpRotl

-- 4. Statements inside an indented block
type RStmt = StmtLet String RExpr | StmtMut String RExpr | StmtExpr RExpr | StmtIndexAssign String [RExpr] RExpr

-- 5. Where-block Producer-Consumer Binding (expr -> target_var or expr -> target_var[i, j])
type RWhereBind = WhereBind RExpr String [Int]

-- 6. Guarded branch (| cond = body)
type RGuard = GuardBranch RExpr RExpr

-- 7. Expressions (Full Ridgun v0.9.0 AST)
type RExpr = EInt Int | EReal String | EStr String | EStrInterp [RExpr] | EBool Bool | EUnit | EVar String | ENot RExpr | EOut RExpr | EBin RBinOp RExpr RExpr | ECall String [RExpr] | EEcho [RExpr] | EList [RExpr] | ETuple [RExpr] | ETensor [RExpr] | EEinsum [RExpr] [String] | EHadamard RBinOp RExpr String RExpr String | EIndex RExpr [RExpr] | EIndexAssign String [RExpr] RExpr | ESeqSelect RExpr String | EBlock [RStmt] | EGuard [RGuard] | EWhere RExpr [RWhereBind] | EParPipe [RExpr] | EWithCtx String RExpr RExpr | EWithRegion Int RExpr

-- 8. Function Case & Function Definition
type RFnCase = FnCase [RPattern] [RGuard] RExpr

type RFnDef = FnDef String [String] String [RFnCase]

-- 9. Type Declarations (Sum Variants & Product Record Fields)
type RVariant = TypeVariant String [String]

type RField = TypeField String String

type RTypeDef = TypeDef String [RVariant] [RField]

-- 10. Complete Parsed Program
type RProgram = Program [RFnDef] [RTypeDef]

-- 11. Type System ADTs (for typecheck.ridgun)
type RType = TyInt | TyReal | TyChar | TyString | TyBool | TyUnit | TyList RType | TyTuple [RType] | TyTensor RType [String] | TyVariadic RType | TyFun [RType] RType | TyVar String

type RTypeBind = TypeBind String RType

type RDimBind = DimBind String String

type RTypeError = TypeError String String

-- 12. Static Analyzer ADTs (for analyzer.ridgun)
type RParamEffect = EffReadOnly | EffMutates

type RCostTier = TierTrivial | TierHeavyCPU | TierDynamicRecursive

type RExecStrategy = StratInlineSequential | StratKernelWorkerJob | StratLazyStealableTask | StratFullGreenThread

type RFnSummary = FnSummary String [RParamEffect] Bool RCostTier RExecStrategy

type RAnalysisError = ErrWhereCycle String String | ErrParallelMutation String String | ErrUseAfterSend String String

-- 13. Self-Hosted Bytecode Instruction Set
type RInstr = BPushInt Int | BPushReal String | BPushStr String | BStrInterp Int | BPushBool Bool | BPushUnit | BPushListEmpty | BListConcat Int | BListHead | BListTail | BMakeTuple Int | BTupleGet Int | BMakeAdt String Int | BAdtField Int | BMakeTensor Int | BTensorGet Int | BTensorSet Int | BTensorMatMul | BTensorEinsum [String] | BTensorHadamard RBinOp String String | BSeqFlatJoin | BPackSeq Int Int | BSeqSelectMask String | BLoadLocal Int | BStoreLocal Int | BPop | BAdd | BSub | BMul | BDiv | BMod | BCmpEq | BCmpNeq | BCmpGt | BCmpLt | BCmpGtEq | BCmpLtEq | BAnd | BOr | BXor | BNot | BEcho Int | BOut | BCall String Int | BPushCtx String | BPopCtx String | BEnterRegion Int | BExitRegion | BJump Int | BJumpIfFalse Int | BJumpIfNeq Int | BJumpIfEmpty Int | BJumpIfNotEmpty Int | BJumpIfNotAdt String Int | BReturn

type RCompiledFn = CompiledFn String Int [RInstr]

type RCompiledProg = CompiledProg [RCompiledFn]

-- 14. Generic traversal of expressions
-- `expr kids e`: the direct sub-expressions of e, in evaluation order (the
-- expressions of the statements, guards and where-bindings of e included).
-- A pass that only does something of its own on a few constructors writes
-- those clauses and ends with one clause over `expr kids`; it then needs no
-- helper for statements, guards or where-bindings.
-- A pass that must see binders (the names a statement or a where-binding
-- introduces), or that must not descend into some constructor, keeps its own
-- clauses for those.
-- EXCEPTIONS (passes that keep a clause for every constructor, on purpose):
--   `lower expr`, `compile rexpr` (compiler), `check expr` (typecheck),
--   `check expr safety` (analyzer): each constructor has work of its own.
--   `lift expr lambdas` (parser): it threads the list of lifted functions.
--   `expr has heavy ops` (compiler): it stops at some constructors by design
--   of the cost estimate; a clause marked KEPT AS IT WAS in a converted pass
--   records the same kind of stop.
fn :: expr kids RExpr => [RExpr]
      expr kids (EStrInterp es)        =  es
      expr kids (ENot e)               =  [e]
      expr kids (EOut e)               =  [e]
      expr kids (EBin _ a b)           =  [a, b]
      expr kids (ECall _ args)         =  args
      expr kids (EEcho es)             =  es
      expr kids (EList es)             =  es
      expr kids (ETuple es)            =  es
      expr kids (ETensor es)           =  es
      expr kids (EEinsum es _)         =  es
      expr kids (EHadamard _ a _ b _)  =  [a, b]
      expr kids (EIndex e es)          =  [e] :: es
      expr kids (EIndexAssign _ es e)  =  es :: [e]
      expr kids (ESeqSelect e _)       =  [e]
      expr kids (EBlock ss)            =  stmt kids ss []
      expr kids (EGuard gs)            =  guard kids gs []
      expr kids (EWhere e ws)          =  where kids ws [e]
      expr kids (EParPipe es)          =  es
      expr kids (EWithCtx _ a b)       =  [a, b]
      expr kids (EWithRegion _ e)      =  [e]
      expr kids _                      =  []

fn :: stmt kids [RStmt] [RExpr] => [RExpr]
      stmt kids [] acc = acc
      stmt kids ((StmtLet _ e):ss) acc =  stmt kids ss (acc :: [e])
      stmt kids ((StmtMut _ e):ss) acc =  stmt kids ss (acc :: [e])
      stmt kids ((StmtExpr e):ss) acc  =  stmt kids ss (acc :: [e])
      stmt kids ((StmtIndexAssign _ es e):ss) acc =  stmt kids ss (acc :: es :: [e])

fn :: guard kids [RGuard] [RExpr] => [RExpr]
      guard kids [] acc = acc
      guard kids ((GuardBranch c e):gs) acc =  guard kids gs (acc :: [c, e])

fn :: where kids [RWhereBind] [RExpr] => [RExpr]
      where kids [] acc = acc
      where kids ((WhereBind e _ _):ws) acc =  where kids ws (acc :: [e])

-- `expr map kids e f`: e with f applied to each direct sub-expression (the
-- same sub-expressions as `expr kids`). A rewriting pass writes the clauses
-- of the constructors it changes and ends with one clause over this.
fn :: expr map kids RExpr (RExpr => RExpr) => RExpr
      expr map kids (EStrInterp es) f        =  EStrInterp (map f es)
      expr map kids (ENot e) f               =  ENot (f e)
      expr map kids (EOut e) f               =  EOut (f e)
      expr map kids (EBin bop a b) f         =  EBin bop (f a) (f b)
      expr map kids (ECall name args) f      =  ECall name (map f args)
      expr map kids (EEcho es) f             =  EEcho (map f es)
      expr map kids (EList es) f             =  EList (map f es)
      expr map kids (ETuple es) f            =  ETuple (map f es)
      expr map kids (ETensor es) f           =  ETensor (map f es)
      expr map kids (EEinsum es subs) f      =  EEinsum (map f es) subs
      expr map kids (EHadamard bop a sa b sb) f =  EHadamard bop (f a) sa (f b) sb
      expr map kids (EIndex e es) f          =  EIndex (f e) (map f es)
      expr map kids (EIndexAssign t es e) f  =  EIndexAssign t (map f es) (f e)
      expr map kids (ESeqSelect e sel) f     =  ESeqSelect (f e) sel
      expr map kids (EBlock ss) f            =  EBlock (stmts map exprs ss f)
      expr map kids (EGuard gs) f            =  EGuard (guards map exprs gs f)
      expr map kids (EWhere e ws) f          =  EWhere (f e) (wheres map exprs ws f)
      expr map kids (EParPipe es) f          =  EParPipe (map f es)
      expr map kids (EWithCtx c a b) f       =  EWithCtx c (f a) (f b)
      expr map kids (EWithRegion q e) f      =  EWithRegion q (f e)
      expr map kids e _                      =  e

fn :: stmts map exprs [RStmt] (RExpr => RExpr) => [RStmt]
      stmts map exprs ss f =  map (s => stmt map exprs one s f) ss

fn :: stmt map exprs one RStmt (RExpr => RExpr) => RStmt
      stmt map exprs one (StmtLet v e) f   =  StmtLet v (f e)
      stmt map exprs one (StmtMut v e) f   =  StmtMut v (f e)
      stmt map exprs one (StmtExpr e) f    =  StmtExpr (f e)
      stmt map exprs one (StmtIndexAssign t es e) f =  StmtIndexAssign t (map f es) (f e)

fn :: guards map exprs [RGuard] (RExpr => RExpr) => [RGuard]
      guards map exprs gs f =  map (g => guard map exprs one g f) gs

fn :: guard map exprs one RGuard (RExpr => RExpr) => RGuard
      guard map exprs one (GuardBranch c e) f =  GuardBranch (f c) (f e)

fn :: wheres map exprs [RWhereBind] (RExpr => RExpr) => [RWhereBind]
      wheres map exprs ws f =  map (w => where map exprs one w f) ws

fn :: where map exprs one RWhereBind (RExpr => RExpr) => RWhereBind
      where map exprs one (WhereBind e v idxs) f =  WhereBind (f e) v idxs

-- ── Fused element-wise expressions (FR-COMP-031) ─────────────
-- @implements FR-COMP-031
-- `((a_ij + b_ij) xor d_ij) rotl 16` is one node, `ECall ":fuse:" ((EStr code):leaves)`, and one loop
-- when it runs. `code` is the expression in postfix, its tokens separated by one space:
--   t<subs>   the next leaf: a tensor read with those subscripts
--   s         the next leaf: a number, the same for every element
--   c<n>      the integer n
--   x<id>     a binary operator (`binop id`)
--   w<k>      take the value on top as value k        (several statements in one loop:
--   l<k>      value k                                  `fuse blocks`, parser.ridgun)
--   o         take the value on top as the next result
-- A program with `o` gives a tuple of tensors, one for each `o`.
-- Leaves are taken in the order of their tokens. The parser builds the node, the type checker types
-- it, lowering puts the element kind in front (`W|code`) and every back end reads the same text.
type RFuseTok = FtTensor String | FtScalar | FtConst Int | FtOp Int | FtSet Int | FtGet Int | FtOut

fn :: fuse toks String => [RFuseTok]
      fuse toks code =  fuse toks loop code 0 0 (str len code) []

fn :: fuse toks loop String Int Int Int [RFuseTok] => [RFuseTok]
      fuse toks loop code from pos len acc
        | pos >= len and from >= len = acc
        | pos >= len = acc :: [fuse tok (str slice code from len)]
        | (str char at code pos) == 32 = fuse toks loop code (pos + 1) (pos + 1) len (acc :: [fuse tok (str slice code from pos)])
        | otherwise = fuse toks loop code from (pos + 1) len acc

fn :: fuse tok String => RFuseTok
      fuse tok s
        | (str char at s 0) == 116 = FtTensor (str slice s 1 (str len s))
        | (str char at s 0) == 115 = FtScalar
        | (str char at s 0) == 99 = FtConst (fuse int s 1)
        | (str char at s 0) == 119 = FtSet (fuse int s 1)
        | (str char at s 0) == 108 = FtGet (fuse int s 1)
        | (str char at s 0) == 111 = FtOut
        | otherwise = FtOp (fuse int s 1)

fn :: fuse int String Int => Int
      fuse int s pos
        | (str char at s pos) == 45 = 0 - (fuse digits s (pos + 1) (str len s) 0)
        | otherwise = fuse digits s pos (str len s) 0

fn :: fuse digits String Int Int Int => Int
      fuse digits s pos len acc
        | pos >= len = acc
        | otherwise = fuse digits s (pos + 1) len ((acc * 10) + ((str char at s pos) - 48))

-- The subscripts of the result: those of the tensor read with the most of them.
fn :: fuse out subs [RFuseTok] String => String
      fuse out subs [] acc =  acc
      fuse out subs ((FtTensor subs):ts) acc
        | (str len subs) > (str len acc) = fuse out subs ts subs
      fuse out subs (_:ts) acc =  fuse out subs ts acc

-- A tensor read fits a result when its subscripts are the result's, their first ones (it is the same
-- along the others) or their last ones.
fn :: fuse subs fit String String => Bool
      fuse subs fit subs out =
        n = str len subs
        m = str len out
        n <= m and (((str slice out 0 n) == subs) or ((str slice out (m - n) m) == subs))

fn :: fuse all fit [RFuseTok] String => Bool
      fuse all fit [] _ =  True
      fuse all fit ((FtTensor subs):ts) out =  (fuse subs fit subs out) and (fuse all fit ts out)
      fuse all fit (_:ts) out =  fuse all fit ts out

fn :: binop id RBinOp     => Int
      binop id OpAdd      =  0
      binop id OpSub      =  1
      binop id OpMul      =  2
      binop id OpDiv      =  3
      binop id OpMod      =  4
      binop id OpEq       =  5
      binop id OpNeq      =  6
      binop id OpGt       =  7
      binop id OpLt       =  8
      binop id OpGtEq     =  9
      binop id OpLtEq     =  10
      binop id OpAnd      =  11
      binop id OpOr       =  12
      binop id OpXor      =  13
      binop id OpConcat   =  14
      binop id OpFlatJoin =  15
      binop id OpMatMul   =  16
      binop id OpShl      =  17
      binop id OpShr      =  18
      binop id OpRotr     =  19
      binop id OpRotl     =  20

-- The program the runtime reads (src/main/runtime/core/fuse.ll): each tensor read says how it lies
-- in the result: `e` the same shape, `p` its first dimensions, `u` its last ones.
fn :: fuse rt code String => String
      fuse rt code code =
        toks = fuse toks code
        fuse rt toks toks (fuse out subs toks "") ""

fn :: fuse rt toks [RFuseTok] String String => String
      fuse rt toks [] _ acc =  acc
      fuse rt toks (t:ts) out acc =  fuse rt toks ts out (fuse rt add acc (fuse rt tok t out))

fn :: fuse rt add String String => String
      fuse rt add "" tok =  tok
      fuse rt add acc tok =  acc + " " + tok

fn :: fuse rt tok RFuseTok String => String
      fuse rt tok (FtTensor subs) out
        | subs == out = "e"
        | (str slice out 0 (str len subs)) == subs = "p"
        | otherwise = "u"
      fuse rt tok FtScalar _ =  "s"
      fuse rt tok (FtConst n) _ =  "c" + (int to str n)
      fuse rt tok (FtOp id) _ =  "x" + (int to str id)
      fuse rt tok (FtSet k) _ =  "w" + (int to str k)
      fuse rt tok (FtGet k) _ =  "l" + (int to str k)
      fuse rt tok FtOut _ =  "o"

-- The number of results of a program (0: one tensor, not a tuple).
fn :: fuse outs [RFuseTok] Int => Int
      fuse outs [] n =  n
      fuse outs (FtOut:ts) n =  fuse outs ts (n + 1)
      fuse outs (_:ts) n =  fuse outs ts n
