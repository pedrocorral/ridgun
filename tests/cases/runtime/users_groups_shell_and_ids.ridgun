-- @tests TS-VM-002
-- case: sys username, sys lookup uid gid and sys user groups read /etc/passwd and /etc/group (an unknown name gives (-1, -1) and []), sys getuid and sys getgid answer, sys setresuid and sys setresgid with our own ids give 0, and shell exec gives the status byte of /bin/sh -c with the environment set by sys setenv (TASK-0096)
-- source: FR-VM-002 §2, §3
-- expect-output:
--   root
--   (0, 0)
--   (-1, -1)
--   (-1, -1)
--   True
--   []
--   True
--   0 0
--   3
--   0
--   44
--   1
--   127
--   0

fn :: main => ()
      main =
        echo (sys username 0)
        echo (sys lookup uid gid "root")
        echo (sys lookup uid gid "nonexistent-user-rg")
        echo (sys lookup uid gid "")
        echo (list contains (sys user groups "root") "root")
        echo (sys user groups "nonexistent-user-rg")
        echo ((sys getuid) >= 0 and (sys getgid) >= 0)
        echo (sys setresuid (sys getuid)) (sys setresgid (sys getgid))
        echo (shell exec "exit 3")
        echo (shell exec "true")
        echo (shell exec "exit 300")
        echo (shell exec "exit 1")
        echo (shell exec "nonexistent_cmd_rg 2>/dev/null")
        sys setenv "RG_SH_T" "v"
        echo (shell exec "test \"$RG_SH_T\" = v")
