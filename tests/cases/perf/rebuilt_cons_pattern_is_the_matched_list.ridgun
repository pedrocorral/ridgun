-- @tests TS-COMP-011
-- case: a clause that rebuilds the list its cons pattern took apart (`(a:b:rest)` then `(b:rest)`) reuses the matched list: 100 000 elements walk in linear time (a copy per round would be about 40 GB) and little memory; heads in a guard, two heads, a cons inside a tuple and a clause that binds a name again keep their results
-- source: FR-COMP-011 OPT-021; sort by request 2026-11-15 (TASK-0088 wasm32 perf cases)
-- expect-output:
--   True
--   False
--   100000
--   [2, 3]
--   [9, 3]
--   [1, 2, 3]
--   (7, [5, 6])
-- max-ms: 1000
-- max-rss-mb: 256

fn :: count up Int Int [Int] => [Int]
      count up i n acc
        | i >= n = acc
        | otherwise = count up (i + 1) n (acc :: [i])

fn :: ordered [Int] => Bool
      ordered (a:b:rest) =  (a <= b) and (ordered (b:rest))
      ordered _ =  True

fn :: walk [Int] Int => Int
      walk (a:b:rest) n
        | a > b = 0
        | otherwise = walk (b:rest) (n + 1)
      walk (_:[]) n =  n + 1
      walk [] n =  n

fn :: drop first [Int] => [Int]
      drop first (_:b:rest) =  (b:rest)
      drop first xs =  xs

fn :: rebound [Int] => [Int]
      rebound (a:b:rest) =
        b = 9
        (b:rest)
      rebound xs =  xs

fn :: keep two [Int] => [Int]
      keep two (a:b:rest) =  (a:b:rest)
      keep two xs =  xs

fn :: tail of pair (Int, [Int]) => Int [Int]
      tail of pair (k, (_:y:ys)) =  (k, (y:ys))
      tail of pair p =  p

fn :: main => ()
      main =
        xs = count up 0 100000 []
        echo (ordered xs)
        echo (ordered [1, 3, 2, 4])
        echo (walk xs 0)
        echo (drop first [1, 2, 3])
        echo (rebound [1, 2, 3])
        echo (keep two [1, 2, 3])
        echo (tail of pair (7, [4, 5, 6]))
