-- Four agents against one thread on work that makes small texts: the work
-- the Vonkeep benchmark reported (tests/segments/run.sh, runtime-scaling).
import str
import io
import posix

fn :: work Int => Int
      work n   =  go n 0 300000

fn :: go Int Int Int => Int
      go n   acc left =
        | left <= 0 = acc
        | otherwise = go n ((acc + (str_len (str repeat "seven" 2)) + n) % 1000003) (left - 1)

fn :: seq Int Int Int => Int
      seq i   n   acc =
        | i >= n    = acc
        | otherwise = seq (i + 1) n (acc + (work i))

fn :: send4 Agent Agent Agent Agent Int Int => ()
      send4 a1    a2    a3    a4    i   n   =
        | i >= n    = ()
        | otherwise =
          send i to a1
          send (i + 1) to a2
          send (i + 2) to a3
          send (i + 3) to a4
          send4 a1 a2 a3 a4 (i + 4) n

fn :: get Agent => Int
      get ag    =
        receive from ag -> r
        r

fn :: get4 Agent Agent Agent Agent Int Int => Int
      get4 a1    a2    a3    a4    i   n   =
        | i >= n    = 0
        | otherwise = (get a1) + (get a2) + (get a3) + (get a4) + (get4 a1 a2 a3 a4 (i + 4) n)

fn :: main => ()
      main =
        t0 = sys monotonic ms
        a = seq 0 16 0
        t1 = sys monotonic ms
        echo ("one thread:  " + (int_to_str (t1 - t0)) + " ms for 16 units")
        a1 = agent work
        a2 = agent work
        a3 = agent work
        a4 = agent work
        t2 = sys monotonic ms
        send4 a1 a2 a3 a4 0 16
        b = get4 a1 a2 a3 a4 0 16
        t3 = sys monotonic ms
        echo ("four agents: " + (int_to_str (t3 - t2)) + " ms for 16 units (" + (int_to_str (a + b)) + ")")
