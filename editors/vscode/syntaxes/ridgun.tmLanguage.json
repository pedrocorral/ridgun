{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ridgun",
  "patterns": [
    { "include": "#comment" },
    { "include": "#fn-declaration" },
    { "include": "#op-declaration" },
    { "include": "#keywords" },
    { "include": "#interpolated-string" },
    { "include": "#raw-string" },
    { "include": "#seq-selector" },
    { "include": "#list-type" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.ridgun",
      "match": "--.*$"
    },
    "interpolated-string": {
      "name": "string.quoted.double.ridgun",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ridgun",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.ridgun",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ridgun" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.ridgun" } },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "raw-string": {
      "name": "string.quoted.single.ridgun",
      "begin": "'",
      "end": "'"
    },
    "fn-declaration": {
      "match": "\\b(fn)\\s*(::)",
      "captures": {
        "1": { "name": "keyword.other.fn.ridgun" },
        "2": { "name": "punctuation.separator.type.ridgun" }
      }
    },
    "op-declaration": {
      "match": "\\b(op)\\s*(::)",
      "captures": {
        "1": { "name": "keyword.other.op.ridgun" },
        "2": { "name": "punctuation.separator.type.ridgun" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.ridgun",
          "match": "\\b(fn|op|where)\\b"
        },
        {
          "name": "constant.language.bool.ridgun",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "keyword.operator.logical.ridgun",
          "match": "\\b(AND|OR|XOR|NOT)\\b"
        },
        {
          "name": "keyword.operator.arrow.ridgun",
          "match": "=>"
        },
        {
          "name": "keyword.operator.bind.ridgun",
          "match": "->"
        }
      ]
    },
    "list-type": {
      "name": "meta.type.list.ridgun",
      "match": "\\[\\s*(Int|Real|Bool|String|Complex)\\s*\\]",
      "captures": {
        "1": { "name": "storage.type.ridgun" }
      }
    },
    "seq-selector": {
      "name": "variable.other.seq-bind.ridgun",
      "comment": "Seq selectors like s(+_) use existing paren and operator rules"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.concat.ridgun",
          "match": "(?<=\\s)::(?=\\s)"
        },
        {
          "name": "keyword.operator.arrow.ridgun",
          "match": "->"
        },
        {
          "name": "keyword.operator.arithmetic.ridgun",
          "match": "[+\\-*/%@]"
        },
        {
          "name": "keyword.operator.comparison.ridgun",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ridgun",
          "match": "(?<!=>|->)=(?!>)"
        },
        {
          "name": "keyword.operator.cons.ridgun",
          "match": "(?<!:):(?!:)"
        },
        {
          "name": "keyword.operator.pipe.ridgun",
          "match": "^\\s*\\|\\|"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.ridgun",
      "match": "\\b[0-9]+\\b"
    },
    "types": {
      "comment": "Any identifier starting with an uppercase letter is a type or constructor",
      "name": "storage.type.ridgun",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.ridgun",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.ridgun",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.ridgun",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.ridgun",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.list.ridgun",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.comma.ridgun",
          "match": ","
        },
        {
          "name": "punctuation.separator.type.ridgun",
          "match": "::"
        }
      ]
    }
  },
  "scopeName": "source.ridgun"
}
